eu-gdpr:C1 a impacto:eu-gdpr-DPIARequiredProcess ;
    skos:definition "A process which requires a DPIA according to GDPR Article 35-3b and which involves large scale processing of special category personal data"@en ;
    dpv:hasProcessingScale dpv:LargeScaleProcessing ;
    dpv:hasPersonalData dpv:SpecialCategoryPersonalData ;
    dct:source "GDPR Art 35-3b" .

eu-gdpr:C2 a impacto:eu-gdpr-DPIARequiredProcess ;
    skos:definition "A process which requires a DPIA according to GDPR Article 35-3b and which involves processing of Special Category of personal data for decision making"@en ;
    dpv:hasContext dpv:DecisionMaking ;
    dpv:hasPersonalData dpv:SpecialCategoryPersonalData ;
    dct:source "GDPR Art 35-3b" .

eu-gdpr:C3 a impacto:eu-gdpr-DPIARequiredProcess ;
    skos:definition "A process which requires a DPIA according to Recital 91 and which involves large scale processing for all purposes"@en ;
    dpv:hasProcessingScale dpv:LargeScaleProcessing ;
    dct:source "Recital 91" .

eu-gdpr:C5 a impacto:eu-gdpr-DPIARequiredProcess ;
    skos:definition "A process which requires a DPIA according to GDPR Article 35-3c and which involves large scale ystematic monitoring of a publicly accessible area"@en ;
    dpv:hasProcessingScale dpv:LargeScaleProcessing ;
    dpv:hasContext eu-gdpr:SystematicMonitoring ;
    dpv:hasLocation dpv:PubliclyAccessibleSpace ;
    dct:source "GDPR Art 35-3c" .

eu-gdpr:C6 a impacto:eu-gdpr-DPIARequiredProcess ;
    skos:definition "A process which requires a DPIA according to GDPR Article 35-3a and which involves processing resulting in legal effects"@en ;
    dpv:hasRisk impacto:risk-LegalEffect ;
     dct:source "GDPR Art 35-3a" .

eu-gdpr:C7 a impacto:eu-gdpr-DPIARequiredProcess ;
    skos:definition "A process which requires a DPIA according to GDPR Article 35-3a and which involves large scale profiling"@en ;
    dpv:hasProcessingScale dpv:LargeScaleProcessing ;
	dpv:hasProcessing eu-gdpr:Profiling ;
    dct:source "GDPR Art 35-3a" .

eu-gdpr:C9 a impacto:eu-gdpr-DPIARequiredProcess ;
    skos:definition "A process which requires a DPIA according to GDPR Article 35-1 and which involves the use of new technology or innovative use"@en ;
    dpv:hasContext dpv:InnovativeUseofNewTechnologies ;
    dct:source "GDPR Art 35-1" .



##The following will be examples of multiple processes of DPIA Requirements. 


eu-gdpr:C4a a impacto:eu-gdpr-DPIARequiredProcess ;
    skos:definition "A process which requires a DPIA according to GDPR Article 35-3b and which involves profiling and/or processing of vulnerable persons data"@en ;
    dpv:hasProcessing eu-gdpr:Profiling ;
    dct:source "GDPR Art 35-3b" .
eu-gdpr:C4b a impacto:eu-gdpr-DPIARequiredProcess ;
    skos:definition "A process which requires a DPIA according to GDPR Article 35-3b and which involves profiling and/or processing of vulnerable persons data"@en ;
    dpv:hasHumanSubject dpv:VulnerableHuman ;
    dct:source "GDPR Art 35-3b" .
eu-gdpr:C4c a impacto:eu-gdpr-DPIARequiredProcess ;
    skos:definition "A process which requires a DPIA according to GDPR Article 35-3b and which involves profiling and/or processing of vulnerable persons data"@en ;
    dpv:hasProcessing eu-gdpr:Profiling ;
    dpv:hasHumanSubject dpv:VulnerableHuman ;
    dct:source "GDPR Art 35-3b" .

eu-gdpr:C8a a impacto:eu-gdpr-DPIARequiredProcess ;
    skos:definition "A process which requires a DPIA according to GDPR Article 35-3a and which involves automated decision making and/or automated processing with legal or similar effect"@en ;
    dpv:hasContext dpv:AutomatedDecisionMaking ;
    dpv:hasRisk impacto:risk-LegalEffect ;
    dct:source "GDPR Art 35-3a" .
eu-gdpr:C8b a impacto:eu-gdpr-DPIARequiredProcess ;
    skos:definition "A process which requires a DPIA according to GDPR Article 35-3a and which involves automated decision making and/or automated processing with legal or similar effect"@en ;
    dpv:hasAutomationLevel impacto:dpv-Automated  ;
    dpv:hasRisk impacto:risk-LegalEffect ;
    dct:source "GDPR Art 35-3a" .

eu-gdpr:C10a a impacto:eu-gdpr-DPIARequiredProcess ;
    skos:definition "A process which requires a DPIA according to GDPR Article 35-3b and which involves large scale processing of personal data relating to criminal offences or unlawful or bad conduct"@en ;
    dpv:hasProcessingScale dpv:LargeScaleProcessing ;
    dpv:hasPersonalData pd:Criminal ;
    dct:source "GDPR Art 35-3b" .
eu-gdpr:C10b a impacto:eu-gdpr-DPIARequiredProcess ;
    skos:definition "A process which requires a DPIA according to GDPR Article 35-3b and which involves large scale Processing of personal data relating to criminal offences or unlawful or bad conduct"@en ;
    dpv:hasProcessingScale dpv:LargeScaleProcessing ;
    dpv:hasPersonalData impacto:pd-UnlawfulActivity ;
    dct:source "GDPR Art 35-3b" .
eu-gdpr:C10c a impacto:eu-gdpr-DPIARequiredProcess ;
    skos:definition "A process which requires a DPIA according to GDPR Article 35-3b and which involves large scale processing of personal data relating to criminal offences or unlawful or bad conduct"@en ;
    dpv:hasProcessingScale dpv:LargeScaleProcessing ;
    dpv:hasPersonalData impacto:pd-BadConduct  ;
    dct:source "GDPR Art 35-3b" ;
    dpv:hasJurisdiction loc:AT, loc:BE, loc:BG, loc:HR, loc:CY, loc:CZ, loc:DK, loc:EE, loc:FI, loc:FR, loc:DE, loc:GR, loc:HU, loc:IS, loc:IE, loc:IT, loc:LV, loc:LI, loc:LT, loc:LU, loc:MT, loc:NL, loc:NO, loc:PL, loc:PT, loc:RO, loc:SK, loc:SI, loc:ES, loc:SE .


eu-gdpr:DPIARequiredList
    dpv:hasJurisdiction loc:AT, loc:BE, loc:BG, loc:HR, loc:CY, loc:CZ, loc:DK, loc:EE, loc:FI, loc:FR, loc:DE, loc:GR, loc:HU, loc:IS, loc:IE, loc:IT, loc:LV, loc:LI, loc:LT, loc:LU, loc:MT, loc:NL, loc:NO, loc:PL, loc:PT, loc:RO, loc:SK, loc:SI, loc:ES, loc:SE .



##The rest of the conditions are country specific and will be modelled accordingly. 

# Austria AT

at-gdpr:C11 a impacto:eu-gdpr-DPIARequiredProcess ;
	skos:definition "A process which requires a DPIA according to the Data Protection Authorities of Austria and which involves processing of Biometric data"@en ;
    dpv:hasPersonalData eu-gdpr:BiometricData ;
	dct:source at-gdpr:DPIARequiredList ;
	dpv:hasJurisdiction loc:AT .

at-gdpr:C13a a impacto:eu-gdpr-DPIARequiredProcess ;
	skos:definition "A process which requires a DPIA according to the Data Protection Authorities of Austria and which involves large-scale processing of communication and location data"@en ;
	dpv:hasProcessingScale dpv:LargeScaleProcessing ;
	dpv:hasPersonalData pd:Communication ;
	dct:source at-gdpr:DPIARequiredList ;
	dpv:hasJurisdiction loc:AT .
at-gdpr:C13b a impacto:eu-gdpr-DPIARequiredProcess ;
	skos:definition "A process which requires a DPIA according to the Data Protection Authorities of Austria and which involves large-scale processing of communication and location data"@en ;
	dpv:hasProcessingScale dpv:LargeScaleProcessing ;
	dpv:hasPersonalData pd:Location ;
	dct:source at-gdpr:DPIARequiredList ;
	dpv:hasJurisdiction loc:AT .

at-gdpr:C15a a impacto:eu-gdpr-DPIARequiredProcess ;
	skos:definition "A process which requires a DPIA according to the Data Protection Authorities of Austria and which involves matching or combining separate data sets and registers"@en ;
	dpv:hasProcessing dpv:Match ;		
	dpv:hasDataSource impacto:dpv-DataRegister, impacto:dpv-DataSet ;
	dct:source at-gdpr:DPIARequiredList ;
	dpv:hasJurisdiction loc:AT .
at-gdpr:C15b a impacto:eu-gdpr-DPIARequiredProcess ;
	skos:definition "A process which requires a DPIA according to the Data Protection Authorities of Austria and which involves matching or combining separate data sets and registers"@en ;
	dpv:hasProcessing dpv:Combine ;	
	dpv:hasDataSource impacto:dpv-DataRegister, impacto:dpv-DataSet ;
	dct:source at-gdpr:DPIARequiredList ;
	dpv:hasJurisdiction loc:AT .

at:C21 a impacto:eu-gdpr-DPIARequiredProcess ;
	skos:definition "A process which requires a DPIA according to the Data Protection Authorities of Austria and which involves processing data concerning asylum seekers"@en ;
	dpv:hasHumanSubject dpv:AsylumSeeker ;
	dct:source at:DPIARequiredList ;
	dpv:hasJurisdiction loc:AT .

at:C24a a impacto:eu-gdpr-DPIARequiredProcess ;
	skos:definition "A process which requires a DPIA according to the Data Protection Authorities of Austria and which involves combining and/or matching data sets from two or more processing operations carried out for different purposes and/or by different controllers in the context of data processing that goes beyond the processing normally expected by a data subject, (provided that the use of algorithms can make decisions that significantly affect the data subject.)"@en ;
	dpv:hasProcessing dpv:Match ;
	dct:source at:DPIARequiredList ;
	dpv:hasJurisdiction loc:AT .
at:C24b a impacto:eu-gdpr-DPIARequiredProcess ;
	skos:definition "A process which requires a DPIA according to the Data Protection Authorities of Austria and which involves combining and/or matching data sets from two or more processing operations carried out for different purposes and/or by different controllers in the context of data processing that goes beyond the processing normally expected by a data subject, (provided that the use of algorithms can make decisions that significantly affect the data subject.)"@en ;
	dpv:hasProcessing dpv:Combine ;				  
	dct:source at:DPIARequiredList ;
	dpv:hasJurisdiction loc:AT .				  
at:C24c a impacto:eu-gdpr-DPIARequiredProcess ;
	skos:definition "A process which requires a DPIA according to the Data Protection Authorities of Austria and which involves combining and/or matching data sets from two or more processing operations carried out for different purposes and/or by different controllers in the context of data processing that goes beyond the processing normally expected by a data subject, (provided that the use of algorithms can make decisions that significantly affect the data subject.)"@en ;
	dpv:hasProcessing dpv:Match, dpv:Combine ;
	dct:source at:DPIARequiredList ;
	dpv:hasJurisdiction loc:AT .


at:C25a a impacto:eu-gdpr-DPIARequiredProcess ;
	skos:definition "A process which requires a DPIA according to the Data Protection Authorities of Austria and which involves processing operations aimed at monitoring or controlling data subjects, in particular by means of image or video and associated acoustic data processing"@en ;
	dpv:hasPurpose impacto:dpv-Monitoring ;
	dpv:hasData tech:ImageContent ;
	dct:source at:DPIARequiredList ;
	dpv:hasJurisdiction loc:AT .
at:C25b a impacto:eu-gdpr-DPIARequiredProcess ;
	dpv:hasPurpose impacto:dpv-Monitoring ;
	dpv:hasData tech:VideoContent ;
	dct:source at:DPIARequiredList ;
	dpv:hasJurisdiction loc:AT .
at:C25c a impacto:eu-gdpr-DPIARequiredProcess ;
	dpv:hasPurpose impacto:dpv-Monitoring ;
	dpv:hasData tech:AudioContent ;
	dct:source at:DPIARequiredList ;
	dpv:hasJurisdiction loc:AT .
at:C25d a impacto:eu-gdpr-DPIARequiredProcess ;
	dpv:hasPurpose impacto:dpv-ControlHumanActivity ;
	dpv:hasData tech:ImageContent ;
	dct:source at:DPIARequiredList ;
	dpv:hasJurisdiction loc:AT .
at:C25e a impacto:eu-gdpr-DPIARequiredProcess ;
	dpv:hasPurpose impacto:dpv-ControlHumanActivity ;
	dpv:hasData tech:VideoContent ;
	dct:source at:DPIARequiredList ;
	dpv:hasJurisdiction loc:AT .
at:C25f a impacto:eu-gdpr-DPIARequiredProcess ;
	dpv:hasPurpose impacto:dpv-ControlHumanActivity ;
	dpv:hasData tech:AudioContent ;
	dct:source at:DPIARequiredList ;
	dpv:hasJurisdiction loc:AT .

at:C26 a impacto:eu-gdpr-DPIARequiredProcess ;
	skos:definition "A process which requires a DPIA according to the Data Protection Authorities of Austria and which involves processing of data related to minors "@en ;
	dpv:hasHumanSubject dpv:Child ;
	dct:source at:DPIARequiredList ;
	dpv:hasJurisdiction loc:AT .

at:C27 a impacto:eu-gdpr-DPIARequiredProcess ;
	skos:definition "A process which requires a DPIA according to the Data Protection Authorities of Austria and which involves profiling"@en ;
	dpv:hasProcessing eu-gdpr:Profiling ;
	dct:source at:DPIARequiredList ;
	dpv:hasJurisdiction loc:AT .

at:C32 a impacto:eu-gdpr-DPIARequiredProcess ;
	skos:definition "A process which requires a DPIA according to the Data Protection Authorities of Austria and which involves the use of AI in processing"@en ;
	dpv:hasContext impacto:ai-UseOfAI ;
	dct:source at:DPIARequiredList ;
	dpv:hasJurisdiction loc:AT .

at:C41 a impacto:eu-gdpr-DPIARequiredProcess ;
	skos:definition "A process which requires a DPIA according to the Data Protection Authorities of Austria and which involves processing of data used to assess the behaviour and other personal aspects of natural persons"@en ;
	dpv:hasProcessing dpv:Assess ;
	dpv:hasPersonalData pd:Behavioural, pd:Personality ;
	dct:source at:DPIARequiredList ;
	dpv:hasJurisdiction loc:AT .

at:C43a a impacto:eu-gdpr-DPIARequiredProcess ;
	skos:definition "A process which requires a DPIA according to the Data Protection Authorities of Austria and which involves processing operations aimed at monitoring, monitoring or controlling data subjects, in particular roads with public transport which can be used by everyone"@en ;
	dpv:hasPurpose impacto:dpv-Monitoring ;
	dpv:hasLocation impacto:dpv-PublicRoad ;
	dct:source at:DPIARequiredList ;
	dpv:hasJurisdiction loc:AT .
at:C43b a impacto:eu-gdpr-DPIARequiredProcess ;
	dpv:hasPurpose impacto:dpv-Monitoring ;
	dpv:hasLocation impacto:dpv-PublicTransport ;
	dct:source at:DPIARequiredList ;
	dpv:hasJurisdiction loc:AT .
at:C43c a impacto:eu-gdpr-DPIARequiredProcess ;
	dpv:hasPurpose impacto:dpv-ControlHumanActivity ;
	dpv:hasLocation impacto:dpv-PublicRoad ;
	dct:source at:DPIARequiredList ;
	dpv:hasJurisdiction loc:AT .
at:C43d a impacto:eu-gdpr-DPIARequiredProcess ;
	dpv:hasPurpose impacto:dpv-ControlHumanActivity ;
	dpv:hasLocation impacto:dpv-PublicTransport ;
	dct:source at:DPIARequiredList ;
	dpv:hasJurisdiction loc:AT .


at:C48a a impacto:eu-gdpr-DPIARequiredProcess ;
	skos:definition "A process which requires a DPIA according to the Data Protection Authorities of Austria and which involves processing that involves an assessment or classification of natural persons"@en ;
	dpv:hasContext dpv:EvaluationOfIndividuals ;
	dct:source at:DPIARequiredList ;
	dpv:hasJurisdiction loc:AT .
at:C48b a impacto:eu-gdpr-DPIARequiredProcess ;
	dpv:hasContext impacto:dpv-ClassificationOfIndividuals ;
	dct:source at:DPIARequiredList ;
	dpv:hasJurisdiction loc:AT .


at:C64 a impacto:eu-gdpr-DPIARequiredProcess ;
	skos:definition "A process which requires a DPIA according to the Data Protection Authorities of Austria and which involves processing operations including capturing locations which may be entered by anyone due to a contractual obligation"@en ;
	dpv:hasPersonalData pd:Location ;
	impacto:dpv-hasContractualTerms impacto:dpv-ContractualObligation ;
	dct:source at:DPIARequiredList ;
	dpv:hasJurisdiction loc:AT .

at:C65a a impacto:eu-gdpr-DPIARequiredProcess ;
	skos:definition "A process which requires a DPIA according to the Data Protection Authorities of Austria and which involves processing operations including recording places which may be entered by anyone on the basis of the public interest"@en ;
	dpv:hasData tech:ImageData ;
	dpv:hasLegalBasis dpv:PublicInterest ;
	dct:source at:DPIARequiredList ;
	dpv:hasJurisdiction loc:AT .
at:C65b a impacto:eu-gdpr-DPIARequiredProcess ;
	skos:definition "A process which requires a DPIA according to the Data Protection Authorities of Austria and which involves processing operations including recording places which may be entered by anyone on the basis of the public interest"@en ;
	dpv:hasData tech:VideoData ;
	dpv:hasLegalBasis dpv:PublicInterest ;
	dct:source at:DPIARequiredList ;
	dpv:hasJurisdiction loc:AT .
at:C65c a impacto:eu-gdpr-DPIARequiredProcess ;
	skos:definition "A process which requires a DPIA according to the Data Protection Authorities of Austria and which involves processing operations including recording places which may be entered by anyone on the basis of the public interest"@en ;
	dpv:hasData tech:AudioData ;
	dpv:hasLegalBasis dpv:PublicInterest ;
	dct:source at:DPIARequiredList ;
	dpv:hasJurisdiction loc:AT .

at:C66a a impacto:eu-gdpr-DPIARequiredProcess ;
	skos:definition "A process which requires a DPIA according to the Data Protection Authorities of Austria and which involves processing operations including image processing using mobile cameras for the purpose of preventing or preventing dangerous attacks or criminal connections in public and non-public spaces"@en ;
	dpv:hasPurpose dpv:ProtectionOfPublicSecurity ;
	tech:hasInput tech:MobilePhone ;
	dpv:hasLocation dpv:PublicLocation ;
	dct:source at:DPIARequiredList ;
	dpv:hasJurisdiction loc:AT .
at:C66b a impacto:eu-gdpr-DPIARequiredProcess ;
	skos:definition "A process which requires a DPIA according to the Data Protection Authorities of Austria and which involves processing operations including image processing using mobile cameras for the purpose of preventing or preventing dangerous attacks or criminal connections in public and non-public spaces"@en ;
	dpv:hasPurpose dpv:ProtectionOfPublicSecurity ;
	tech:hasInput tech:MobilePhone ;
	dpv:hasLocation dpv:PrivateLocation ;
	dct:source at:DPIARequiredList ;
	dpv:hasJurisdiction loc:AT .

at:C67a a impacto:eu-gdpr-DPIARequiredProcess ;
	skos:definition "A process which requires a DPIA according to the Data Protection Authorities of Austria and which involves processing operations including image and acoustic processing for the preventive protection of persons or property on private residential properties not exclusively used by the person responsible and by all persons living in the common household"@en ;
	dpv:hasData tech:ImageData ;
	dpv:hasPurpose impacto:dpv-PreventativeProtectionOfPersons ;
	dct:source at:DPIARequiredList ;
	dpv:hasJurisdiction loc:AT .
at:C67b a impacto:eu-gdpr-DPIARequiredProcess ;
	skos:definition "A process which requires a DPIA according to the Data Protection Authorities of Austria and which involves processing operations including image and acoustic processing for the preventive protection of persons or property on private residential properties not exclusively used by the person responsible and by all persons living in the common household"@en ;
	dpv:hasData tech:AudioData ;
	dpv:hasPurpose impacto:dpv-PreventativeProtectionOfPersons ;
	dct:source at:DPIARequiredList ;
	dpv:hasJurisdiction loc:AT .
at:C67c a impacto:eu-gdpr-DPIARequiredProcess ;
	skos:definition "A process which requires a DPIA according to the Data Protection Authorities of Austria and which involves processing operations including image and acoustic processing for the preventive protection of persons or property on private residential properties not exclusively used by the person responsible and by all persons living in the common household"@en ;
	dpv:hasData tech:ImageData ;
	dpv:hasPurpose impacto:dpv-PreventativeProtectionOfProperty ;
	dct:source at:DPIARequiredList ;
	dpv:hasJurisdiction loc:AT .
at:C67d a impacto:eu-gdpr-DPIARequiredProcess ;
	skos:definition "A process which requires a DPIA according to the Data Protection Authorities of Austria and which involves processing operations including image and acoustic processing for the preventive protection of persons or property on private residential properties not exclusively used by the person responsible and by all persons living in the common household"@en ;
	dpv:hasData tech:AudioData ;
	dpv:hasPurpose impacto:dpv-PreventativeProtectionOfProperty ;
	dct:source at:DPIARequiredList ;
	dpv:hasJurisdiction loc:AT .

at:C68 a impacto:eu-gdpr-DPIARequiredProcess ;
	skos:definition "A process which requires a DPIA according to the Data Protection Authorities of Austria and which involves processing operations including monitoring of churches, houses of prayer, as far as they are not already covered by lit. b and lit. e, and other institutions that serve the practice of religion in the community"@en ;
	dpv:hasPurpose impacto:dpv-Monitoring ;
	dpv:hasLocation impacto:loc-WorshipLocation ;
	dct:source at:DPIARequiredList ;
	dpv:hasJurisdiction loc:AT .

at:C90 a impacto:eu-gdpr-DPIARequiredProcess ;
	skos:definition "A process which requires a DPIA according to the Data Protection Authorities of Austria and which involves processing operations in the personal area of persons, even if the processing is based on consent"@en ;
	dpv:hasLegalBasis dpv:Consent ;
	dpv:hasLocation	impacto:loc-PersonalSpace ;
	dct:source at:DPIARequiredList ;
	dpv:hasJurisdiction loc:AT .



