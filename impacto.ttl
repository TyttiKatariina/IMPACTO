    rdfs:label "Public Law Governed Deployer"@en ;
    dcterms:source "AI Act Art. 27(1)"@en ;
    rdfs:seeAlso <https://eur-lex.europa.eu/eli/reg/2024/1689/oj/eng> ;
    rdfs:subClassOf eu-aiact:AIDeployer ;
    skos:broader eu-aiact:AIDeployer ;
    skos:definition "A deployer that is a body governed by public law."@en ;
    skos:prefLabel "Public Law Governed Deployer"@en ;
    skos:scopeNote "Proposed for: DPV EU AI Act extension (eu-aiact)"@en .

impacto-old:eu-aiact-PublicServiceProvidingPrivateEntityDeployer a rdfs:Class,
        skos:Concept ;
    rdfs:label "Public Service Providing Private Entity Deployer"@en ;
    dcterms:source "AI Act Art. 27(1)"@en ;
    rdfs:seeAlso <https://eur-lex.europa.eu/eli/reg/2024/1689/oj/eng> ;
    rdfs:subClassOf eu-aiact:AIDeployer ;
    skos:broader eu-aiact:AIDeployer ;
    skos:definition "A deployer that is a private entity providing public services."@en ;
    skos:prefLabel "Public Service Providing Private Entity Deployer"@en ;
    skos:scopeNote "Proposed for: DPV EU AI Act extension (eu-aiact)"@en .

impacto-old:eu-aiact-RightsQuestionnaire a rdfs:Class,
