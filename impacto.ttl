impacto-old:eu-gdpr-PredeterminedRiskChange a rdfs:Class,
        skos:Concept ;
    rdfs:label "Predetermined Risk Change"@en ;
    dcterms:source "GDPR Art. 35(11)"@en ;
    rdfs:seeAlso <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX%3A32016R0679> ;
    rdfs:subClassOf impacto-old:eu-gdpr-RiskChangeCategory ;
    skos:broader impacto-old:eu-gdpr-RiskChangeCategory ;
