    skos:broader impacto-old:DeployerCategory ;
    skos:definition "A private entity providing public services, which the AI Act treats in the same way as a public law body for the purposes of the FRIA obligation."@en ;
    skos:prefLabel "Private Entity Providing Public Services"@en .

impacto-old:RegulatoryGuidance a rdfs:Class,
        skos:Concept ;
