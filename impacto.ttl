dpv:LocalGovernmentLaw a rdfs:Class,
        skos:Concept ;
    rdfs:label "Local Government Law"@en ;
    dcterms:source "CN58"@en ;
    rdfs:subClassOf dpv:LegalObligation ;
    skos:definition "A legal obligation laid down in local government law which requires or regulates the processing of personal data."@en .

dpv:ManagementConsultants a rdfs:Class,
        skos:Concept ;
    rdfs:label "Management Consultants"@en ;
    dcterms:source "CN22"@en ;
    rdfs:subClassOf dpv:Organisation ;
    skos:definition "A professional providing management advice and related services to clients."@en .

dpv:MedicalPractitioner a rdfs:Class,
        skos:Concept ;
    rdfs:label "Medical Practitioner"@en ;
    dcterms:source "CN52"@en ;
    rdfs:subClassOf dpv:Entity ;
