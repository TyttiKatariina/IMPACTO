loc:PublicRoad skos:editorialNote "Used with the loc: prefix in some conditions although the term is IMPACTO's own."@en ;
    skos:exactMatch impacto-old:dpv-PublicRoad .

ex:Complaints-Recruitment a dpv:OrganisationalMeasure ;
    rdfs:label "Recruitment complaints procedure"@en ;
    skos:definition "Applicants may request the reasons for a shortlisting decision and have it reviewed by a panel that did not use the ranking."@en ;
    skos:prefLabel "Recruitment complaints procedure"@en .

ex:DPIA-3 a dpv:DPIA ;
    rdfs:label "DPIA: warehouse productivity monitoring"@en ;
    dcterms:date "2026-05-05"^^xsd:date ;
    impacto-old:conductedBy ex:Logistics ;
    dpv:hasDataController ex:Logistics ;
    dpv:hasName "DPIA: warehouse productivity monitoring"^^xsd:string ;
    dpv:hasPersonalDataHandling ex:Proc-WorkerMonitoring .

ex:DPO-1 a dpv:DataProtectionOfficer ;
    rdfs:label "Council Data Protection Officer"@en ;
    dpv:hasName "Council Data Protection Officer"^^xsd:string .

ex:Group-UnderrepresentedApplicants a dpv:DataSubject ;
    rdfs:label "Applicants from groups historically underrepresented in the workforce"@en ;
    skos:note "Identified as an affected group for the FRIA under Art.27(1)(c). Not separately identified in the DPIA, which described data subjects as job applicants."@en ;
    skos:prefLabel "Applicants from groups historically underrepresented in the workforce"@en .

ex:Overlap-1 a impacto-old:OverlappingCondition ;
    rdfs:label "Public authority recruitment screening: both assessments due"@en ;
    skos:definition "A high-risk processing activity within the meaning of GDPR Art.35 is carried out through a high-risk AI system deployed by a body governed by public law, so both a DPIA and a FRIA are required."@en ;
    skos:prefLabel "Public authority recruitment screening: both assessments due"@en ;
    impacto-old:concernsAISystem ex:TalentScreen ;
    impacto-old:concernsProcessingActivity ex:Proc-Shortlisting ;
    impacto-old:hasDPIATrigger eu-gdpr:C7,
        <https://w3id.org/dpv/legal/ie#C14a> ;
    impacto-old:hasFRIATrigger impacto-old:F1 ;
    dpv:hasJurisdiction loc:IE .

ex:Overlap-2 a impacto-old:OverlappingCondition ;
    rdfs:label "Credit scoring: both assessments due"@en ;
    skos:prefLabel "Credit scoring: both assessments due"@en ;
    impacto-old:concernsAISystem ex:CreditScorer ;
    impacto-old:concernsProcessingActivity ex:Proc-CreditScoring ;
    impacto-old:hasDPIATrigger eu-gdpr:C8a ;
    impacto-old:hasFRIATrigger impacto-old:F3 ;
    dpv:hasJurisdiction loc:IE .

ex:Oversight-HumanReview a eu-aiact:DeployerHumanOversightMeasure ;
    rdfs:label "Human review of every ranked shortlist"@en ;
    skos:definition "A recruitment officer reviews the full applicant pool alongside the ranking, and records written reasons where the shortlist departs from or follows the ranking."@en ;
    skos:prefLabel "Human review of every ranked shortlist"@en .

ex:Reuse-1a a impacto-old:DPIAInputInFRIA ;
    rdfs:label "Process description reused"@en ;
    skos:prefLabel "Process description reused"@en ;
    impacto-old:hasReuseGap "The DPIA describes the personal data processing. The FRIA adds the surrounding recruitment process, including the interview stage where no personal data is processed by the system."^^xsd:string ;
    impacto-old:hasReuseLevel impacto-old:PartiallyReusable ;
    impacto-old:reusedElement ex:Proc-Shortlisting ;
    impacto-old:satisfiesRequirement impacto-old:FRIA-IR-a .

ex:Reuse-1c a impacto-old:DPIAInputInFRIA ;
    rdfs:label "Affected persons partly reused"@en ;
    skos:prefLabel "Affected persons partly reused"@en ;
    impacto-old:hasReuseGap "The DPIA identified job applicants as data subjects. The FRIA adds underrepresented applicant groups as a distinct affected group."^^xsd:string ;
    impacto-old:hasReuseLevel impacto-old:PartiallyReusable ;
    impacto-old:reusedElement dpv:JobApplicant ;
    impacto-old:satisfiesRequirement impacto-old:FRIA-IR-c .

ex:Reuse-1d a impacto-old:DPIAInputInFRIA ;
    rdfs:label "Risks partly reused"@en ;
    skos:prefLabel "Risks partly reused"@en ;
    impacto-old:hasReuseGap "Both risks carry over. The FRIA adds ex:Risk-GroupDisadvantage, which concerns non-discrimination rather than data protection."^^xsd:string ;
    impacto-old:hasReuseLevel impacto-old:PartiallyReusable ;
    impacto-old:reusedElement ex:Risk-Bias,
        ex:Risk-Opacity ;
    impacto-old:satisfiesRequirement impacto-old:FRIA-IR-d .

ex:Reuse-1f a impacto-old:DPIAInputInFRIA ;
    rdfs:label "Measures partly reused"@en ;
    skos:prefLabel "Measures partly reused"@en ;
    impacto-old:hasReuseGap "Treatment measures carry over. The complaint mechanism ex:Complaints-Recruitment was added for the FRIA."^^xsd:string ;
    impacto-old:hasReuseLevel impacto-old:PartiallyReusable ;
    impacto-old:reusedElement ex:Risk-Bias,
        ex:Risk-Opacity ;
    impacto-old:satisfiesRequirement impacto-old:FRIA-IR-f .

ex:Risk-GroupDisadvantage a dpv:Risk ;
    rdfs:label "Risk  Group Disadvantage"@en ;
    dcterms:description "Cumulative exclusion of an applicant group across successive competitions"^^xsd:string ;
    skos:note "Identified only in the FRIA. The DPIA assessed risk to individual data subjects; this risk is to a group over time and is not reducible to a data protection risk."@en ;
    impacto-old:hasAffectedRight eu-rights:A21-NonDiscrimination ;
    dpv:hasRiskLevel risk:HighRisk ;
    risk:hasRiskTreatment risk:MitigationControl .

<https://tyttikatariina.github.io/IMPACTO/> a owl:Ontology ;
    dcterms:contributor "Harshvardhan J. Pandit" ;
    dcterms:created "2026-09-02"^^xsd:date ;
    dcterms:creator "Tytti Rintamäki" ;
    dcterms:description """IMPACTO models Data Protection Impact Assessments (GDPR Art.35)
    and Fundamental Rights Impact Assessments (AI Act Art.27), the conditions that make
    each of them mandatory, the information each must contain, and the points at which
    the two assessments overlap or feed into one another."""@en ;
    dcterms:source "AI Act Art.6, Art.27, Annex III"@en,
        "EDPB/WP29 WP248rev.01"@en,
        "GDPR Art.35, Art.36, Recitals 84-95"@en ;
    dcterms:title "IMPACTO: Impact Assessment Ontology"@en,
        "IMPACTO: an ontology for GDPR and AI Act impact assessments"@en ;
    vann:preferredNamespacePrefix "impacto" ;
    vann:preferredNamespaceUri "https://tyttikatariina.github.io/IMPACTO/#" ;
    rdfs:seeAlso <https://tyttikatariina.github.io/IMPACTO/>,
        <https://tyttikatariina.github.io/ImpactAssessmentOntology/> ;
    owl:imports <https://w3id.org/dpv>,
        <https://w3id.org/dpv/legal/eu/aiact>,
        <https://w3id.org/dpv/legal/eu/gdpr> ;
    skos:editorialNote "IMPACTO is published under two namespaces. This one carries the ontology specification; the other carries the concept proposals derived from the national DPIA lists. Choosing one and redirecting the other would remove a standing source of broken references."@en .

impacto-old:DPIA-IR-10 a impacto-old:DPIAInformationRequirement ;
    rdfs:label "Necessity assessment"@en ;
    dcterms:source "GDPR Art.35(7)(b)"@en ;
    skos:definition "The reasoning that the processing is necessary to achieve its purposes and that no less intrusive means would suffice."@en ;
    skos:prefLabel "Necessity assessment"@en ;
    impacto-old:hasExpectedProperty impacto-old:hasNecessityAssessment ;
    impacto-old:isMandatory true ;
    impacto-old:partOfRequirement impacto-old:DPIA-IR-A357b .

impacto-old:DPIA-IR-11 a impacto-old:DPIAInformationRequirement ;
    rdfs:label "Proportionality assessment"@en ;
    dcterms:source "GDPR Art.35(7)(b)"@en ;
    skos:definition "The reasoning that the processing is proportionate to its purposes, balancing the interference against the objective pursued."@en ;
    skos:prefLabel "Proportionality assessment"@en ;
    impacto-old:hasExpectedProperty impacto-old:hasProportionalityAssessment ;
    impacto-old:isMandatory true ;
    impacto-old:partOfRequirement impacto-old:DPIA-IR-A357b .

impacto-old:DPIA-IR-13 a impacto-old:DPIAInformationRequirement ;
    rdfs:label "Profiling and inferences"@en ;
    dcterms:source "GDPR Art.4(4), Art.35(3)(a)"@en ;
    skos:definition "Whether the processing involves profiling, and what inferences about behaviour, preferences or characteristics are drawn."@en ;
    skos:prefLabel "Profiling and inferences"@en ;
    impacto-old:hasExpectedProperty dpv:hasProcessing ;
    impacto-old:hasExpectedValueClass eu-gdpr:Profiling ;
    impacto-old:isMandatory false ;
    impacto-old:partOfRequirement impacto-old:DPIA-IR-A357a .

impacto-old:DPIA-IR-14 a impacto-old:DPIAInformationRequirement ;
    rdfs:label "Data sources"@en ;
    dcterms:source "GDPR Art.14; WP248rev.01"@en ;
    skos:definition "The sources from which personal data is obtained, in particular where data is not collected from the data subject."@en ;
    skos:prefLabel "Data sources"@en ;
    impacto-old:hasExpectedProperty dpv:hasDataSource ;
    impacto-old:isMandatory false ;
    impacto-old:partOfRequirement impacto-old:DPIA-IR-A357a .

impacto-old:DPIA-IR-17 a impacto-old:DPIAInformationRequirement ;
    rdfs:label "Data quality measures"@en ;
    dcterms:source "GDPR Art.5(1)(d)"@en ;
    skos:definition "The measures taken to ensure that personal data is accurate and kept up to date."@en ;
    skos:prefLabel "Data quality measures"@en ;
    impacto-old:hasExpectedProperty dpv:hasOrganisationalMeasure ;
    impacto-old:hasExpectedValueClass dpv:DataQualityManagement ;
    impacto-old:isMandatory false ;
    impacto-old:partOfRequirement impacto-old:DPIA-IR-A357d .

impacto-old:DPIA-IR-18 a impacto-old:DPIAInformationRequirement ;
    rdfs:label "Location of processing"@en ;
    dcterms:source "WP248rev.01"@en ;
    skos:definition "The physical or organisational setting in which the processing takes place."@en ;
    skos:prefLabel "Location of processing"@en ;
    impacto-old:hasExpectedProperty dpv:hasLocation ;
    impacto-old:isMandatory false ;
    impacto-old:partOfRequirement impacto-old:DPIA-IR-A357a .

impacto-old:DPIA-IR-20 a impacto-old:DPIAInformationRequirement ;
    rdfs:label "Risk sources and threats"@en ;
    dcterms:source "GDPR Recital 90; WP248rev.01"@en ;
    skos:definition "The sources of each risk and the threats through which it could materialise."@en ;
    skos:prefLabel "Risk sources and threats"@en ;
    impacto-old:hasExpectedProperty impacto-old:hasThreat,
        risk:hasRiskSource ;
    impacto-old:isMandatory true ;
    impacto-old:partOfRequirement impacto-old:DPIA-IR-A357c .

impacto-old:DPIA-IR-22 a impacto-old:DPIAInformationRequirement ;
    rdfs:label "Risk level"@en ;
    dcterms:source "GDPR Art.35(7)(c)"@en ;
    skos:definition "The resulting level of each risk, derived from likelihood and severity."@en ;
    skos:prefLabel "Risk level"@en ;
    impacto-old:hasExpectedProperty dpv:hasRiskLevel ;
    impacto-old:isMandatory true ;
    impacto-old:partOfRequirement impacto-old:DPIA-IR-A357c .

impacto-old:DPIA-IR-25 a impacto-old:DPIAInformationRequirement ;
    rdfs:label "DPO advice"@en ;
    dcterms:source "GDPR Art.35(2)"@en ;
    skos:definition "The advice of the data protection officer, where one has been designated."@en ;
    skos:prefLabel "DPO advice"@en ;
    impacto-old:hasExpectedProperty dpv:hasDataProtectionOfficer ;
    impacto-old:isMandatory true .

impacto-old:DPIA-IR-3 a impacto-old:DPIAInformationRequirement ;
    rdfs:label "Categories of personal data"@en ;
    dcterms:source "GDPR Art.35(7)(a)"@en ;
    skos:definition "The categories of personal data processed, including special categories."@en ;
    skos:prefLabel "Categories of personal data"@en ;
    impacto-old:hasExpectedProperty dpv:hasPersonalData ;
    impacto-old:hasExpectedValueClass dpv:PersonalData ;
    impacto-old:isMandatory true ;
    impacto-old:partOfRequirement impacto-old:DPIA-IR-A357a .

impacto-old:DPIA-IR-5 a impacto-old:DPIAInformationRequirement ;
    rdfs:label "Entities involved"@en ;
    dcterms:source "WP248rev.01"@en ;
    skos:definition "The controller, any joint controllers, processors and recipients involved in the processing."@en ;
    skos:prefLabel "Entities involved"@en ;
    impacto-old:hasExpectedProperty dpv:hasDataProcessor,
        dpv:hasRecipient ;
    impacto-old:isMandatory true ;
    impacto-old:partOfRequirement impacto-old:DPIA-IR-A357a .

impacto-old:DPIA-IR-6 a impacto-old:DPIAInformationRequirement ;
    rdfs:label "Cross-border transfers"@en ;
    dcterms:source "WP248rev.01"@en ;
    skos:definition "Any transfer of personal data to a third country or international organisation, and the safeguards relied upon."@en ;
    skos:prefLabel "Cross-border transfers"@en ;
    impacto-old:hasExpectedProperty dpv:hasThirdCountry ;
    impacto-old:isMandatory false ;
    impacto-old:partOfRequirement impacto-old:DPIA-IR-A357a .

impacto-old:DPIA-IR-9 a impacto-old:DPIAInformationRequirement ;
    rdfs:label "Legal basis"@en ;
    dcterms:source "GDPR Art.6, Art.9; WP248rev.01"@en ;
    skos:definition "The legal basis relied on for the processing, and for any processing of special categories of personal data."@en ;
    skos:prefLabel "Legal basis"@en ;
    impacto-old:hasExpectedProperty dpv:hasLegalBasis ;
    impacto-old:hasExpectedValueClass dpv:LegalBasis ;
    impacto-old:isMandatory true ;
    impacto-old:partOfRequirement impacto-old:DPIA-IR-A357a .

impacto-old:FN3 a impacto-old:FRIANotRequiredCondition ;
    rdfs:label "Private deployer outside the public service and Annex III 5(b),(c) scope"@en ;
    dcterms:source "AI Act Art.27(1)"@en ;
    skos:definition "No FRIA is required where the deployer is neither a body governed by public law nor a private entity providing public services, and the system does not fall under Annex III points 5(b) or 5(c), even though the system is high-risk under Article 6(2)."@en ;
    skos:note "This is the condition that makes the FRIA obligation narrower than the high-risk classification itself."@en ;
    skos:prefLabel "Private deployer outside the public service and Annex III 5(b),(c) scope"@en ;
    impacto-old:excludesAISystemType eu-aiact:HighRiskAISystem-AnnexIII-5-b,
        eu-aiact:HighRiskAISystem-AnnexIII-5-c ;
    impacto-old:hasObligationSource impacto-old:FRIASource-A27 ;
    impacto-old:requiresAISystemType eu-aiact:HighRiskAISystem-A6-2 ;
    impacto-old:requiresDeployerType impacto-old:OtherDeployer .

impacto-old:FRIASource-A6 a impacto-old:LegislativeSource ;
    rdfs:label "AI Act Article 6"@en ;
    dcterms:identifier "Regulation (EU) 2024/1689, Article 6" ;
    skos:definition "The provision establishing the classification rules for high-risk AI systems, referring to Annex I (Art.6(1)) and Annex III (Art.6(2))."@en ;
    skos:prefLabel "AI Act Article 6"@en .

impacto-old:NotReusable a skos:Concept,
        impacto-old:ReuseLevel ;
    rdfs:label "Not Reusable"@en ;
    skos:definition "The FRIA requirement has no counterpart in the DPIA and must be produced afresh."@en ;
    skos:prefLabel "Not Reusable"@en .

impacto-old:dpv-Automated rdfs:label "dpv  Automated"@en ;
    owl:sameAs impacto:Automated ;
    skos:exactMatch impacto:Automated .

impacto-old:dpv-ContractualObligation a skos:Concept ;
    rdfs:label "Contractual Obligation"@en ;
    skos:editorialNote "Used by the DPIA condition set but not yet defined in IMPACTO-concepts.ttl. Proposed for the dpv namespace."@en ;
    skos:prefLabel "Contractual Obligation"@en .

impacto-old:embedsProcessingActivity a rdf:Property,
        skos:Concept ;
    rdfs:label "embeds processing activity"@en ;
    rdfs:domain eu-aiact:AISystem ;
    rdfs:range dpv:Process ;
    skos:definition "Associates an AI system with a personal data processing activity carried out through its use. This is the link that allows a high-risk processing activity to be located inside a high-risk AI system."@en ;
    skos:prefLabel "embeds processing activity"@en .

impacto-old:hasAffectedGroup a rdf:Property,
        skos:Concept ;
    rdfs:label "has affected group"@en ;
    dcterms:source "AI Act Art.27(1)(c)"@en ;
    owl:equivalentProperty impacto-old:ai-NaturalPersonCategorySubjects ;
    skos:definition "A category of natural persons or a group likely to be affected by the use of the AI system. Wider than dpv:hasDataSubject, since affected persons need not be data subjects of the processing."@en ;
    skos:prefLabel "has affected group"@en .

impacto-old:hasAffectedRight a rdf:Property,
        skos:Concept ;
    rdfs:label "has affected right"@en ;
    rdfs:range eu-rights:EUFundamentalRight ;
    owl:equivalentProperty impacto-old:eu-rights-AffectedRight ;
    skos:definition "A fundamental right on which the use of the AI system may have an impact."@en ;
    skos:prefLabel "has affected right"@en .

impacto-old:hasComplaintMechanism a rdf:Property,
        skos:Concept ;
    rdfs:label "has complaint mechanism"@en ;
    dcterms:source "AI Act Art.27(1)(f)"@en ;
    owl:equivalentProperty impacto-old:eu-aiact-ComplaintMeasures ;
    skos:definition "Arrangements for internal governance and complaint mechanisms to be used if the identified risks materialise."@en ;
    skos:prefLabel "has complaint mechanism"@en .

impacto-old:hasDataSubjectCount a rdf:Property,
        skos:Concept ;
    rdfs:label "has data subject count"@en ;
    skos:definition "The number or estimated number of data subjects affected."@en ;
    skos:prefLabel "has data subject count"@en .

impacto-old:hasDeployerProcess a rdf:Property,
        skos:Concept ;
    rdfs:label "has deployer process"@en ;
    dcterms:source "AI Act Art.27(1)(a)"@en ;
    rdfs:range dpv:Process ;
    owl:equivalentProperty impacto-old:eu-aiact-ProcessDescription ;
    skos:definition "A process of the deployer in which the high-risk AI system will be used, in line with its intended purpose. Broader than a personal data processing activity: it includes steps of the process in which no personal data is processed."@en ;
    skos:prefLabel "has deployer process"@en .

impacto-old:hasHumanOversightMeasure a rdf:Property,
        skos:Concept ;
    rdfs:label "has human oversight measure"@en ;
    dcterms:source "AI Act Art.27(1)(e)"@en ;
    rdfs:range eu-aiact:DeployerHumanOversightMeasure ;
    skos:definition "A human oversight measure implemented by the deployer in accordance with the instructions for use."@en ;
    skos:prefLabel "has human oversight measure"@en .

impacto-old:hasNecessityAssessment a rdf:Property,
        skos:Concept ;
    rdfs:label "has necessity assessment"@en ;
    dcterms:source "GDPR Art.35(7)(b)"@en ;
    skos:definition "The assessment of whether the processing is necessary in relation to its purposes."@en ;
    skos:prefLabel "has necessity assessment"@en .

impacto-old:hasProportionalityAssessment a rdf:Property,
        skos:Concept ;
    rdfs:label "has proportionality assessment"@en ;
    dcterms:source "GDPR Art.35(7)(b)"@en ;
    skos:definition "The assessment of whether the processing is proportionate in relation to its purposes."@en ;
    skos:prefLabel "has proportionality assessment"@en .

impacto-old:hasResidualRiskLevel a rdf:Property,
        skos:Concept ;
    rdfs:label "has residual risk level"@en ;
    skos:definition "The level of risk remaining after treatment."@en ;
    skos:prefLabel "has residual risk level"@en .

impacto-old:hasRetentionJustification a rdf:Property,
        skos:Concept ;
    rdfs:label "has retention justification"@en ;
    skos:definition "The justification given for the storage duration."@en ;
    skos:prefLabel "has retention justification"@en .

impacto-old:hasThreat a rdf:Property,
        skos:Concept ;
    rdfs:label "has threat"@en ;
    skos:definition "A threat identified as part of a risk."@en ;
    skos:prefLabel "has threat"@en .

impacto-old:hasUseFrequency a rdf:Property,
        skos:Concept ;
    rdfs:label "has use frequency"@en ;
    dcterms:source "AI Act Art.27(1)(b)"@en ;
    owl:equivalentProperty impacto-old:eu-aiact-FrequencyOfUse ;
    skos:definition "How often a high-risk AI system is intended to be used."@en ;
    skos:prefLabel "has use frequency"@en .

impacto-old:hasUsePeriod a rdf:Property,
        skos:Concept ;
    rdfs:label "has use period"@en ;
    dcterms:source "AI Act Art.27(1)(b)"@en ;
    owl:equivalentProperty impacto-old:eu-aiact-PeriodOfUse ;
    skos:definition "The period of time within which a high-risk AI system is intended to be used."@en ;
    skos:prefLabel "has use period"@en .

impacto-old:loc-PersonalSpace rdfs:label "loc  Personal Space"@en ;
    owl:sameAs impacto:InPersonalSpace ;
    skos:exactMatch impacto:InPersonalSpace .

impacto-old:loc-WorshipLocation rdfs:label "loc  Worship Location"@en ;
    owl:sameAs impacto:WorshipLocation ;
    skos:exactMatch impacto:WorshipLocation .

impacto-old:notifiedAuthority a rdf:Property,
        skos:Concept ;
    rdfs:label "notified authority"@en ;
    dcterms:source "AI Act Art.27(3)"@en,
        "GDPR Art.36(1)"@en ;
    skos:definition "The authority notified of the results of the assessment."@en ;
    skos:prefLabel "notified authority"@en .

impacto-old:pd-BadConduct rdfs:label "pd  Bad Conduct"@en ;
    owl:sameAs impacto:BadConduct ;
    skos:exactMatch impacto:BadConduct .

impacto-old:pd-UnlawfulActivity rdfs:label "pd  Unlawful Activity"@en ;
    owl:sameAs impacto:UnlawfulActivity ;
    skos:exactMatch impacto:UnlawfulActivity .

impacto-old:reusesDPIA a rdf:Property,
        skos:Concept ;
    rdfs:label "reuses DPIA"@en ;
    dcterms:source "AI Act Art.27(4)"@en ;
    rdfs:domain impacto-old:FRIA ;
    rdfs:range impacto-old:DPIA ;
    skos:definition "Indicates that this FRIA relies on and complements an existing DPIA."@en ;
    skos:prefLabel "reuses DPIA"@en .

impacto:InfluenceHumanActivity a owl:Class,
        skos:Concept ;
    rdfs:label "Influence Human Activity"@en ;
    dcterms:source impacto:SourceAT,
        impacto:SourceCZ,
        impacto:SourceDE,
        impacto:SourceES,
        impacto:SourceGR,
        impacto:SourceLT ;
    rdfs:subClassOf risk:IndividualRisk ;
    skos:broader risk:IndividualRisk ;
    skos:definition "An influence on humans as individuals or as groups"@en ;
    skos:notation "C25" ;
    skos:prefLabel "Influence Human Activity"@en ;
    skos:scopeNote "Classified as a risk/consequence concept (ex-post) rather than a processing context, as influencing an individual is a consequence of processing designed to achieve that outcome"@en .

impacto:SourceBG a owl:NamedIndividual ;
    rdfs:label "Bulgaria (BG)"@en ;
    skos:exactMatch <https://w3id.org/dpv/legal/bg#DPIARequiredList> ;
    skos:prefLabel "Bulgaria (BG)"@en .

impacto:SourceEDPB a owl:NamedIndividual ;
    rdfs:label "EDPB"@en ;
    skos:prefLabel "EDPB"@en .

impacto:SourceFI a owl:NamedIndividual ;
    rdfs:label "Finland (FI)"@en ;
    skos:exactMatch <https://w3id.org/dpv/legal/fi#DPIARequiredList> ;
    skos:prefLabel "Finland (FI)"@en .

impacto:SourceGDPR a owl:NamedIndividual ;
    rdfs:label "GDPR"@en ;
    skos:prefLabel "GDPR"@en .

dpv:InnovativeUseofNewTechnologies skos:editorialNote "Lower-case 'of'. Appears once, in eu-gdpr:C9."@en ;
    skos:exactMatch dpv:InnovativeUseOfNewTechnologies .

dpv:hasStorageDuration a rdfs:Resource ;
    skos:editorialNote "Used in DPIAinstance.ttl and in the SHACL shapes. There is no property of this name in DPV 2.3; the nearest current modelling is dpv:hasDuration with a dpv:StorageDuration value. Retained here so existing data continues to validate."@en .

eu-gdpr:C3 a impacto-old:AssessmentTriggerCondition,
        impacto-old:DPIARequiredCondition,
        impacto-old:eu-gdpr-DPIARequiredProcess,
        eu-gdpr:DPIARequiredProcess ;
    rdfs:label "GDPR C3: A process which requires a DPIA according to Recital 91 and which…"@en ;
    dcterms:source "Recital 91" ;
    skos:definition "A process which requires a DPIA according to Recital 91 and which involves large scale processing for all purposes"@en ;
    dpv:hasProcessingScale dpv:LargeScaleProcessing .

<https://w3id.org/dpv/legal/ie#C14c> a impacto-old:AssessmentTriggerCondition,
        impacto-old:DPIARequiredCondition,
        impacto-old:eu-gdpr-DPIARequiredProcess,
        eu-gdpr:DPIARequiredProcess ;
    rdfs:label "IE C14c: A process which requires a DPIA according to the Data Protection…"@en ;
    dcterms:source <https://w3id.org/dpv/legal/ie#DPIARequiredList> ;
    skos:definition "A process which requires a DPIA according to the Data Protection Authorities of Ireland and which involves Evaluation or scoring of individuals (including profiling or predicting)"@en ;
    dpv:hasJurisdiction loc:IE ;
    dpv:hasProcessing eu-gdpr:Profiling .

ex:DPIA-1 a dpv:DPIA ;
    rdfs:label "DPIA: automated shortlisting of job applicants"@en ;
