    dcterms:source "CN22"@en ;
    rdfs:subClassOf dpv:ServiceProvision ;
    skos:definition "Providing legal advice to clients within the framework of professional practice."@en .

dpv:LegalBasisExemption a rdfs:Class,
        skos:Concept ;
