    dcterms:source "CN37"@en ;
    rdfs:subClassOf dpv:Entity ;
    skos:definition "An indication that the entity carrying out the processing does not stand in an employment relationship, for example a self-employed practitioner."@en ;
    skos:scopeNote "Intended as a value for dpv:hasRelationWithDataSubject; the parent recorded in the analysis (dpv:Entity) may require revision."@en .

dpv:Notaries a rdfs:Class,
        skos:Concept ;
    rdfs:label "Notaries"@en ;
    dcterms:source "CN22"@en ;
    rdfs:subClassOf dpv:Organisation ;
    skos:definition "A legal professional authorised to draft, authenticate and certify documents and to carry out notarial activities."@en .

dpv:OfferOfGoods a rdfs:Class,
        skos:Concept ;
