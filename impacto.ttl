impacto:Systematicity a owl:Class,
        skos:Concept ;
    rdfs:label "Systematicity"@en ;
    dcterms:source impacto:SourceBE,
        impacto:SourceBG,
        impacto:SourceCY,
        impacto:SourceFR,
        impacto:SourceGR,
        impacto:SourceHU,
        impacto:SourceIS,
        impacto:SourceNL,
        impacto:SourceNO,
        impacto:SourcePL,
        impacto:SourceSI,
        impacto:SourceSK ;
    rdfs:subClassOf dpv:ProcessingContext ;
    skos:broader dpv:ProcessingContext ;
    skos:definition "An indication of whether data processing is systematic, i.e. if it is organised and constitutes repeated actions performed according to a plan or method, such as for monitoring, analysis or decision-making"@en ;
    skos:notation "C29, C39, C45, C51, C50, C55, C82, C89" ;
    skos:prefLabel "Systematicity"@en .

