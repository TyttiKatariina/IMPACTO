    dcterms:source "CN38"@en ;
    rdfs:subClassOf dpv:Purpose ;
    skos:definition "The combining or linking of personal data held about the same individual across separate controllers, practitioners or data sets."@en .

dpv:LocalAuthority a rdfs:Class,
        skos:Concept ;
    rdfs:label "Local Authority"@en ;
    dcterms:source "CN49"@en ;
    rdfs:subClassOf dpv:Authority ;
