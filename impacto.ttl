ex:Proc-Shortlisting a impacto-old:HighRiskProcessingActivity,
        dpv:PersonalDataHandling ;
    rdfs:label "Automated ranking of job applicants"@en ;
    impacto-old:hasDataSubjectCount "approximately 12,000 applications per year"^^xsd:string ;
    impacto-old:hasNecessityAssessment "Ranking supports human shortlisting for high-volume competitions; no less intrusive method achieves comparable consistency at this volume."^^xsd:string ;
    impacto-old:hasNecessityJustification "Large scale profiling and evaluation of individuals under GDPR Art.35(3)(a) and Art.35(1), and evaluation or scoring of individuals on the Irish supervisory authority's Art.35(4) list."^^xsd:string ;
    impacto-old:hasNecessityStatus eu-gdpr:DPIARequired ;
    impacto-old:hasProportionalityAssessment "Only application-form content is scored. Rankings are advisory and a human decision-maker records reasons for the final shortlist."^^xsd:string ;
    impacto-old:isEmbeddedInAISystem ex:TalentScreen ;
    impacto-old:matchesCondition eu-gdpr:C7,
        eu-gdpr:C9,
        <https://w3id.org/dpv/legal/ie#C14a>,
        <https://w3id.org/dpv/legal/ie#C14c> ;
    dpv:hasAutomationLevel dpv:PartialAutomation ;
    dpv:hasContext impacto-old:ai-UseOfAI,
        dpv:EvaluationOfIndividuals,
        dpv:InnovativeUseOfNewTechnologies,
        dpv:ScoringOfIndividuals ;
    dpv:hasDataSubject dpv:JobApplicant ;
    dpv:hasJurisdiction loc:IE ;
    dpv:hasLegalBasis dpv:LegalObligation ;
    dpv:hasLocation impacto-old:loc-Workplace ;
    dpv:hasName "Automated ranking of job applicants"^^xsd:string ;
    dpv:hasOrganisationalMeasure dpv:StaffTraining ;
    dpv:hasPersonalData impacto-old:pd-Skills,
        pd:Behavioural ;
    dpv:hasProcessing dpv:Analyse,
        dpv:Collect,
        dpv:Store,
        eu-gdpr:Profiling ;
    dpv:hasProcessingScale dpv:LargeScaleProcessing ;
    dpv:hasPurpose dpv:HumanResourceManagement ;
    dpv:hasStorageDuration "12 months after the competition closes"^^xsd:string ;
    dpv:hasTechnicalMeasure dpv:AccessControlMethod,
        dpv:Pseudonymisation .

