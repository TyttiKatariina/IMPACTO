ex:CreditScorer a eu-aiact:HighRiskAISystem ;
    rdfs:label "Consumer credit scoring model"@en ;
    skos:broader eu-aiact:HighRiskAISystem-A6-2,
        eu-aiact:HighRiskAISystem-AnnexIII-5-b ;
    impacto-old:embedsProcessingActivity ex:Proc-CreditScoring ;
    impacto-old:hasDeployer ex:Bank ;
    impacto-old:hasNecessityJustification "Annex III point 5(b) applies. Art.27(1) attaches the FRIA obligation to every deployer of such a system, so the private status of the deployer is immaterial."^^xsd:string ;
    impacto-old:hasNecessityStatus impacto-old:FRIARequired ;
    impacto-old:matchesCondition impacto-old:F3 ;
    dpv:hasName "Consumer credit scoring model"^^xsd:string .

ex:Logistics a dpv:DataController,
        eu-aiact:AIDeployer ;
    rdfs:label "Example Logistics Ltd"@en ;
    impacto-old:hasDeployerCategory impacto-old:OtherDeployer ;
    dpv:hasJurisdiction loc:IE ;
    dpv:hasName "Example Logistics Ltd"^^xsd:string .

ex:Proc-CreditScoring a impacto-old:HighRiskProcessingActivity,
        dpv:PersonalDataHandling ;
    rdfs:label "Automated creditworthiness scoring"@en ;
    impacto-old:hasNecessityStatus eu-gdpr:DPIARequired ;
    impacto-old:isEmbeddedInAISystem ex:CreditScorer ;
    impacto-old:matchesCondition eu-gdpr:C6,
        eu-gdpr:C7,
        eu-gdpr:C8a ;
    dpv:hasContext impacto-old:ai-UseOfAI,
        dpv:AutomatedDecisionMaking,
        dpv:ScoringOfIndividuals ;
    dpv:hasDataSubject dpv:Customer ;
    dpv:hasJurisdiction loc:IE ;
    dpv:hasLegalBasis dpv:LegalObligation ;
    dpv:hasName "Automated creditworthiness scoring"^^xsd:string ;
    dpv:hasPersonalData pd:CreditScore,
        pd:FinancialStatus ;
    dpv:hasProcessing dpv:Analyse,
        eu-gdpr:Profiling ;
    dpv:hasProcessingScale dpv:LargeScaleProcessing ;
    dpv:hasPurpose <https://w3id.org/dpv/sector/finance#CreditChecking> ;
    dpv:hasRisk impacto-old:risk-LegalEffect .

ex:Risk-Bias a dpv:Risk ;
    rdfs:label "Risk  Bias"@en ;
    dcterms:description "Systematic disadvantage to applicants with non-linear career histories"^^xsd:string ;
    impacto-old:hasAffectedRight eu-rights:A21-NonDiscrimination ;
    impacto-old:hasResidualRiskLevel risk:ModerateRisk ;
    impacto-old:hasThreat risk:Discrimination ;
    impacto-old:hasTreatmentDescription "Quarterly outcome testing across protected characteristics; ranking withheld where disparity exceeds threshold."^^xsd:string ;
    dpv:hasImpact risk:Discrimination ;
    dpv:hasLikelihood 3 ;
    dpv:hasRiskLevel risk:HighRisk ;
    dpv:hasSeverity 4 ;
    risk:hasRiskSource risk:Bias ;
    risk:hasRiskTreatment risk:MitigationControl .

ex:Risk-Opacity a dpv:Risk ;
    rdfs:label "Risk  Opacity"@en ;
    dcterms:description "Applicants cannot understand how their ranking was produced"^^xsd:string ;
    impacto-old:hasResidualRiskLevel risk:LowRisk ;
    impacto-old:hasTreatmentDescription "Published explanation of ranking factors and a right to request reasons."^^xsd:string ;
    dpv:hasImpact impacto-old:risk-RightsExercisePrevented ;
    dpv:hasLikelihood 4 ;
    dpv:hasRiskLevel risk:HighRisk ;
    dpv:hasSeverity 3 ;
    risk:hasRiskSource risk:LackOfSystemTransparency ;
    risk:hasRiskTreatment risk:MitigationControl .

ex:TalentScreen a eu-aiact:HighRiskAISystem ;
    rdfs:label "TalentScreen applicant ranking system"@en ;
    skos:broader eu-aiact:HighRiskAISystem-A6-2,
        eu-aiact:HighRiskAISystem-AnnexIII-4-a ;
    impacto-old:embedsProcessingActivity ex:Proc-Shortlisting ;
    impacto-old:hasDeployer ex:CityCouncil ;
    impacto-old:hasNecessityJustification "The deployer is a body governed by public law and the system is high-risk under Art.6(2) via Annex III point 4(a). Annex III point 2 does not apply."^^xsd:string ;
    impacto-old:hasNecessityStatus impacto-old:FRIARequired ;
    impacto-old:matchesCondition impacto-old:F1 ;
    dpv:hasName "TalentScreen applicant ranking system"^^xsd:string ;
    eu-aiact:hasRiskLevel eu-aiact:RiskLevelHigh-A6-2 .

impacto-old:DPIA-IR-A357b a impacto-old:DPIAInformationRequirement ;
    rdfs:label "Necessity and proportionality"@en ;
    dcterms:source "GDPR Art.35(7)(b)"@en ;
    skos:definition "An assessment of the necessity and proportionality of the processing operations in relation to the purposes."@en ;
    skos:prefLabel "Necessity and proportionality"@en ;
    impacto-old:isMandatory true .

impacto-old:FRIA-IR-a a impacto-old:FRIAInformationRequirement ;
    rdfs:label "Description of the deployer's processes"@en ;
    dcterms:source "AI Act Art.27(1)(a)"@en ;
    skos:definition "A description of the deployer's processes in which the high-risk AI system will be used in line with its intended purpose."@en ;
    skos:prefLabel "Description of the deployer's processes"@en ;
    impacto-old:correspondsToDPIARequirement impacto-old:DPIA-IR-1,
        impacto-old:DPIA-IR-2,
        impacto-old:DPIA-IR-A357a ;
    impacto-old:hasExpectedProperty impacto-old:hasDeployerProcess,
        eu-aiact:IntendedPurpose ;
    impacto-old:hasReuseGap "The DPIA describes personal data processing operations and their purposes. The FRIA requires the deployer's processes in which the AI system is used, in line with the intended purpose as defined by the provider. Steps of the process that do not involve personal data, and the provider's stated intended purpose, must be added."@en ;
    impacto-old:hasReuseLevel impacto-old:PartiallyReusable ;
    impacto-old:isMandatory true .

impacto-old:FRIA-IR-c a impacto-old:FRIAInformationRequirement ;
    rdfs:label "Categories of affected persons and groups"@en ;
    dcterms:source "AI Act Art.27(1)(c)"@en ;
    skos:definition "The categories of natural persons and groups likely to be affected by the use of the system in the specific context."@en ;
    skos:prefLabel "Categories of affected persons and groups"@en ;
    impacto-old:correspondsToDPIARequirement impacto-old:DPIA-IR-4,
        impacto-old:DPIA-IR-7 ;
    impacto-old:hasExpectedProperty impacto-old:hasAffectedGroup ;
    impacto-old:hasReuseGap "The DPIA identifies categories of data subject. The FRIA covers all natural persons and groups likely to be affected, including persons who are not data subjects of the processing, and requires attention to groups rather than only individuals."@en ;
    impacto-old:hasReuseLevel impacto-old:PartiallyReusable ;
    impacto-old:isMandatory true .

impacto-old:FRIA-IR-d a impacto-old:FRIAInformationRequirement ;
    rdfs:label "Specific risks of harm"@en ;
    dcterms:source "AI Act Art.27(1)(d), Art.13"@en ;
    skos:definition "The specific risks of harm likely to have an impact on the categories of persons or groups identified, taking into account the information given by the provider under Article 13."@en ;
    skos:prefLabel "Specific risks of harm"@en ;
    impacto-old:correspondsToDPIARequirement impacto-old:DPIA-IR-19,
        impacto-old:DPIA-IR-21,
        impacto-old:DPIA-IR-23,
        impacto-old:DPIA-IR-A357c ;
    impacto-old:hasExpectedProperty impacto-old:hasAffectedRight,
        dpv:hasRisk ;
    impacto-old:hasReuseGap "The DPIA assesses risks to the rights and freedoms of data subjects, in practice concentrated on data protection and privacy. The FRIA must address risks of harm to all fundamental rights engaged, including non-discrimination, human dignity, freedom of expression and assembly, and the rights of the child, and must take account of the information supplied by the provider under Art.13."@en ;
    impacto-old:hasReuseLevel impacto-old:PartiallyReusable ;
    impacto-old:isMandatory true .

impacto-old:FRIA-IR-f a impacto-old:FRIAInformationRequirement ;
    rdfs:label "Measures on materialisation of risks"@en ;
    dcterms:source "AI Act Art.27(1)(f)"@en ;
    skos:definition "The measures to be taken if the identified risks materialise, including the arrangements for internal governance and complaint mechanisms."@en ;
    skos:prefLabel "Measures on materialisation of risks"@en ;
    impacto-old:correspondsToDPIARequirement impacto-old:DPIA-IR-15,
        impacto-old:DPIA-IR-16,
        impacto-old:DPIA-IR-24,
        impacto-old:DPIA-IR-A357d ;
    impacto-old:hasExpectedProperty impacto-old:hasComplaintMechanism,
        risk:hasRiskTreatment ;
    impacto-old:hasReuseGap "Risk treatment measures in a DPIA can be relied on where the same risk is in issue. The FRIA additionally requires internal governance arrangements and complaint mechanisms for affected persons, which the DPIA does not ordinarily record."@en ;
    impacto-old:hasReuseLevel impacto-old:PartiallyReusable ;
    impacto-old:isMandatory true .

