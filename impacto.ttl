    skos:scopeNote "Proposed for: DPV EU AI Act extension (eu-aiact)"@en .

impacto-old:eu-aiact-FRIANotificationStatus a rdfs:Class,
        skos:Concept ;
    rdfs:label "FRIA Notification Status"@en ;
    rdfs:subClassOf impacto-old:eu-aiact-FRIANotification ;
    skos:broader impacto-old:eu-aiact-FRIANotification ;
    skos:definition "A status associated with eu-aiact:FRIANotification (via dpv:hasStatus) that represents the state of the notification obligation and its fulfilment."@en ;
    skos:prefLabel "FRIA Notification Status"@en ;
    skos:scopeNote "Proposed for: DPV EU AI Act extension (eu-aiact)"@en .

impacto-old:eu-aiact-FRIAObligationtoNotify a rdfs:Class,
        skos:Concept ;
    rdfs:label "FRIA Obligation to Notify"@en ;
    dcterms:source "AI Act Art. 27(3)"@en ;
    rdfs:seeAlso <https://eur-lex.europa.eu/eli/reg/2024/1689/oj/eng> ;
    rdfs:subClassOf impacto-old:eu-aiact-FRIANotification ;
    skos:broader impacto-old:eu-aiact-FRIANotification ;
    skos:definition "The obligation of the deployer to notify the market surveillance authority of the results of the FRIA once it has been performed."@en ;
    skos:prefLabel "FRIA Obligation to Notify"@en ;
    skos:scopeNote "Proposed for: DPV EU AI Act extension (eu-aiact)"@en .

impacto-old:eu-aiact-FRIAOutcome a rdfs:Class,
        skos:Concept ;
    rdfs:label "FRIA Outcome"@en ;
    dcterms:source "AI Act Art. 27(1)"@en ;
    rdfs:seeAlso <https://eur-lex.europa.eu/eli/reg/2024/1689/oj/eng> ;
    rdfs:subClassOf eu-aiact:FRIA ;
    skos:broader eu-aiact:FRIA ;
    skos:definition "A process extending eu-aiact:FRIA that represents the step of determining the result of the FRIA procedure, specifically whether the use of the AI system produces an impact on fundamental rights, as stated in AI Act Article 27(1). Associated with a FRIA using dpv:hasAssessment."@en ;
    skos:prefLabel "FRIA Outcome"@en ;
    skos:scopeNote "Proposed for: DPV EU AI Act extension (eu-aiact)"@en .

impacto-old:eu-aiact-FRIAOutcomeStatus a rdfs:Class,
