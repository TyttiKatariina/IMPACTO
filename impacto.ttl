    rdfs:label "FRIA Outcome Status"@en ;
    rdfs:subClassOf dpv:AuditStatus ;
    skos:broader dpv:AuditStatus ;
    skos:definition "A status associated with eu-aiact:FRIAOutcome (via dpv:hasStatus) that represents the specific result determined at the conclusion of the FRIA procedure."@en ;
    skos:prefLabel "FRIA Outcome Status"@en ;
    skos:scopeNote "Proposed for: DPV EU AI Act extension (eu-aiact)"@en .

impacto-old:eu-aiact-FRIAPermitsDeployment a rdfs:Class,
        skos:Concept ;
    rdfs:label "FRIA Permits Deployment"@en ;
    rdfs:subClassOf impacto-old:eu-aiact-FRIAOutcomeStatus ;
    skos:broader impacto-old:eu-aiact-FRIAOutcomeStatus ;
    skos:definition "A FRIA outcome status indicating that the deployment of the AI system may proceed."@en ;
    skos:prefLabel "FRIA Permits Deployment"@en ;
    skos:scopeNote "Proposed for: DPV EU AI Act extension (eu-aiact)"@en .

impacto-old:eu-aiact-FRIAProcedure a rdfs:Class,
        skos:Concept ;
    rdfs:label "FRIA Procedure"@en ;
    dcterms:source "AI Act Art. 27(1)"@en ;
    rdfs:seeAlso <https://eur-lex.europa.eu/eli/reg/2024/1689/oj/eng> ;
    rdfs:subClassOf eu-aiact:FRIA ;
    skos:broader eu-aiact:FRIA ;
    skos:definition "A process extending eu-aiact:FRIA that represents the activity of carrying out the FRIA itself, including collection and documentation of all required inputs as per AI Act Article 27(1). Associated with a FRIA using dpv:hasAssessment."@en ;
    skos:prefLabel "FRIA Procedure"@en ;
    skos:scopeNote "Proposed for: DPV EU AI Act extension (eu-aiact)"@en .

impacto-old:eu-aiact-FRIAProhibitsDeployment a rdfs:Class,
        skos:Concept ;
    rdfs:label "FRIA Prohibits Deployment"@en ;
    rdfs:subClassOf impacto-old:eu-aiact-FRIAOutcomeStatus ;
    skos:broader impacto-old:eu-aiact-FRIAOutcomeStatus ;
    skos:definition "A FRIA outcome status indicating that the AI system should not be deployed because of the identified impacts on fundamental rights."@en ;
    skos:prefLabel "FRIA Prohibits Deployment"@en ;
    skos:scopeNote "Proposed for: DPV EU AI Act extension (eu-aiact)"@en .

impacto-old:eu-aiact-FRIARequired a rdfs:Class,
