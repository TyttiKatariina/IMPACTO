    rdfs:label "DPIA Review Pending"@en ;
    dcterms:source "GDPR Art. 35(11)"@en ;
    rdfs:seeAlso <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX%3A32016R0679> ;
    rdfs:subClassOf impacto-old:eu-gdpr-DPIAReviewStatus ;
    skos:broader impacto-old:eu-gdpr-DPIAReviewStatus ;
    skos:definition "Status reflecting a review is still pending and waiting to been carried out by the controller, where necessary, to assess whether processing is performed in accordance with the DPIA, at least when there is a change in the risk represented by the processing operations."@en ;
    skos:prefLabel "DPIA Review Pending"@en ;
    skos:scopeNote "Proposed for: DPV EU GDPR  (eu-gdpr)"@en .

impacto-old:eu-gdpr-DPIAReviewStatus a rdfs:Class,
        skos:Concept ;
    rdfs:label "DPIA Review Status"@en ;
    dcterms:source "GDPR Art. 35(11)"@en ;
    rdfs:seeAlso <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX%3A32016R0679> ;
    rdfs:subClassOf dpv:AuditStatus ;
    skos:broader dpv:AuditStatus ;
    skos:definition "Status reflecting whether a review has been carried out by the controller, where necessary, to assess whether processing is performed in accordance with the DPIA, at least when there is a change in the risk represented by the processing operations."@en ;
    skos:prefLabel "DPIA Review Status"@en ;
    skos:scopeNote "Proposed for: DPV EU GDPR (dpv)"@en .

impacto-old:eu-gdpr-NonpredeterminedRiskChange a rdfs:Class,
        skos:Concept ;
    rdfs:label "Non-predetermined Risk Change"@en ;
    dcterms:source "GDPR Art. 35(11)"@en ;
    rdfs:seeAlso <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX%3A32016R0679> ;
