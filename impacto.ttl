    impacto-old:providesInputTo ex:FRIA-1 ;
    dpv:hasDataController ex:CityCouncil ;
    dpv:hasName "DPIA: automated shortlisting of job applicants"^^xsd:string ;
    dpv:hasOutcome eu-gdpr:DPIAOutcomeRisksMitigated ;
    dpv:hasPersonalDataHandling ex:Proc-Shortlisting ;
    dpv:hasRisk ex:Risk-Bias,
        ex:Risk-Opacity .

ex:DPIA-2 a dpv:DPIA ;
    rdfs:label "DPIA: consumer credit scoring"@en ;
    dcterms:date "2026-01-20"^^xsd:date ;
    impacto-old:conductedBy ex:Bank ;
    impacto-old:providesInputTo ex:FRIA-2 ;
    dpv:hasDataController ex:Bank ;
    dpv:hasName "DPIA: consumer credit scoring"^^xsd:string ;
    dpv:hasPersonalDataHandling ex:Proc-CreditScoring .

ex:FRIA-1 a eu-aiact:FRIA ;
    rdfs:label "FRIA: automated shortlisting of job applicants"@en ;
    dcterms:date "2026-04-02"^^xsd:date ;
    impacto-old:concernsAISystem ex:TalentScreen ;
    impacto-old:conductedBy ex:CityCouncil ;
    impacto-old:conductedByRole eu-aiact:AIDeployer ;
    impacto-old:hasAffectedGroup ex:Group-UnderrepresentedApplicants,
        dpv:JobApplicant ;
    impacto-old:hasAffectedRight eu-rights:A15-FreedomToChooseOccupationEngageWork,
        eu-rights:A21-NonDiscrimination ;
    impacto-old:hasComplaintMechanism ex:Complaints-Recruitment ;
    impacto-old:hasDPIAInput ex:Reuse-1a,
        ex:Reuse-1c,
        ex:Reuse-1d,
        ex:Reuse-1f ;
    impacto-old:hasHumanOversightMeasure ex:Oversight-HumanReview ;
    impacto-old:hasUseFrequency "each recruitment competition, approximately 40 times per year"^^xsd:string ;
    impacto-old:hasUsePeriod "continuous from May 2026, reviewed annually"^^xsd:string ;
    impacto-old:notifiedAuthority ex:MSA-IE ;
    impacto-old:reusesDPIA ex:DPIA-1 ;
    impacto-old:usesAIOfficeTemplate true ;
    dpv:hasName "FRIA: automated shortlisting of job applicants"^^xsd:string ;
    dpv:hasRisk ex:Risk-Bias,
        ex:Risk-GroupDisadvantage,
        ex:Risk-Opacity .

ex:FRIA-2 a eu-aiact:FRIA ;
    rdfs:label "FRIA: consumer credit scoring"@en ;
    dcterms:date "2026-02-11"^^xsd:date ;
    impacto-old:concernsAISystem ex:CreditScorer ;
    impacto-old:conductedBy ex:Bank ;
    impacto-old:hasAffectedGroup dpv:Customer ;
    impacto-old:hasAffectedRight eu-rights:A21-NonDiscrimination ;
    impacto-old:notifiedAuthority ex:MSA-IE ;
    impacto-old:reusesDPIA ex:DPIA-2 ;
    dpv:hasName "FRIA: consumer credit scoring"^^xsd:string .

ex:MSA-IE a eu-aiact:MarketSurveillanceAuthority ;
    rdfs:label "National market surveillance authority"@en ;
    dpv:hasJurisdiction loc:IE ;
    dpv:hasName "National market surveillance authority"^^xsd:string .

ex:WorkerMonitor a eu-aiact:HighRiskAISystem ;
    rdfs:label "Warehouse productivity monitoring system"@en ;
    skos:broader eu-aiact:HighRiskAISystem-A6-2,
        eu-aiact:HighRiskAISystem-AnnexIII-4-b ;
    impacto-old:embedsProcessingActivity ex:Proc-WorkerMonitoring ;
    impacto-old:hasDeployer ex:Logistics ;
    impacto-old:hasNecessityJustification "The system is high-risk under Art.6(2) via Annex III point 4(b), but no Art.27(1) deployer criterion is met, so no FRIA is owed. The deployer obligations in Art.26 continue to apply."^^xsd:string ;
    impacto-old:hasNecessityStatus impacto-old:FRIANotRequired ;
    impacto-old:matchesCondition impacto-old:FN3 ;
    dpv:hasName "Warehouse productivity monitoring system"^^xsd:string .

impacto-old:DPIA-IR-1 a impacto-old:DPIAInformationRequirement ;
    rdfs:label "Purposes of processing"@en ;
    dcterms:source "GDPR Art.35(7)(a)"@en ;
    skos:definition "The purposes for which personal data is processed."@en ;
    skos:prefLabel "Purposes of processing"@en ;
    impacto-old:hasExpectedProperty dpv:hasPurpose ;
    impacto-old:hasExpectedValueClass dpv:Purpose ;
    impacto-old:isMandatory true ;
    impacto-old:partOfRequirement impacto-old:DPIA-IR-A357a .

impacto-old:DPIA-IR-12 a impacto-old:DPIAInformationRequirement ;
    rdfs:label "Automation and automated decision making"@en ;
    dcterms:source "GDPR Art.22, Art.35(3)(a)"@en ;
    skos:definition "The degree of automation in the processing, and whether decisions producing legal or similarly significant effects are taken solely by automated means."@en ;
    skos:prefLabel "Automation and automated decision making"@en ;
    impacto-old:hasExpectedProperty dpv:hasAutomationLevel ;
    impacto-old:isMandatory true ;
    impacto-old:partOfRequirement impacto-old:DPIA-IR-A357a .

impacto-old:DPIA-IR-15 a impacto-old:DPIAInformationRequirement ;
    rdfs:label "Technical measures"@en ;
    dcterms:source "GDPR Art.32, Art.35(7)(d)"@en ;
    skos:definition "The technical measures implemented to protect personal data, such as encryption, access control and pseudonymisation."@en ;
    skos:prefLabel "Technical measures"@en ;
    impacto-old:hasExpectedProperty dpv:hasTechnicalMeasure ;
    impacto-old:hasExpectedValueClass dpv:TechnicalMeasure ;
    impacto-old:isMandatory true ;
    impacto-old:partOfRequirement impacto-old:DPIA-IR-A357d .

impacto-old:DPIA-IR-19 a impacto-old:DPIAInformationRequirement ;
    rdfs:label "Risk description"@en ;
    dcterms:source "GDPR Art.35(7)(c)"@en ;
    skos:definition "A description of each identified risk to the rights and freedoms of data subjects."@en ;
    skos:prefLabel "Risk description"@en ;
    impacto-old:hasExpectedProperty dpv:hasRisk ;
    impacto-old:hasExpectedValueClass dpv:Risk ;
    impacto-old:isMandatory true ;
    impacto-old:partOfRequirement impacto-old:DPIA-IR-A357c .

impacto-old:DPIA-IR-2 a impacto-old:DPIAInformationRequirement ;
    rdfs:label "Processing operations"@en ;
    dcterms:source "GDPR Art.35(7)(a)"@en ;
    skos:definition "The operations performed on personal data, such as collection, storage, use, disclosure or erasure."@en ;
    skos:prefLabel "Processing operations"@en ;
    impacto-old:hasExpectedProperty dpv:hasProcessing ;
    impacto-old:hasExpectedValueClass dpv:Processing ;
    impacto-old:isMandatory true ;
    impacto-old:partOfRequirement impacto-old:DPIA-IR-A357a .

impacto-old:DPIA-IR-21 a impacto-old:DPIAInformationRequirement ;
    rdfs:label "Likelihood and severity"@en ;
    dcterms:source "GDPR Recital 90"@en ;
    skos:definition "An evaluation of the likelihood and the severity of each risk."@en ;
    skos:prefLabel "Likelihood and severity"@en ;
    impacto-old:hasExpectedProperty dpv:hasLikelihood,
        dpv:hasSeverity ;
    impacto-old:isMandatory true ;
    impacto-old:partOfRequirement impacto-old:DPIA-IR-A357c .

impacto-old:DPIA-IR-23 a impacto-old:DPIAInformationRequirement ;
    rdfs:label "Impacts on data subjects"@en ;
    dcterms:source "GDPR Art.35(7)(c)"@en ;
    skos:definition "The impacts on data subjects that would follow if the risk materialised."@en ;
    skos:prefLabel "Impacts on data subjects"@en ;
    impacto-old:hasExpectedProperty dpv:hasImpact ;
    impacto-old:isMandatory true ;
    impacto-old:partOfRequirement impacto-old:DPIA-IR-A357c .

impacto-old:DPIA-IR-24 a impacto-old:DPIAInformationRequirement ;
    rdfs:label "Risk treatment and residual risk"@en ;
    dcterms:source "GDPR Art.35(7)(d)"@en ;
    skos:definition "The treatment applied to each risk and the level of risk remaining afterwards."@en ;
    skos:prefLabel "Risk treatment and residual risk"@en ;
    impacto-old:hasExpectedProperty impacto-old:hasResidualRiskLevel,
        risk:hasRiskTreatment ;
    impacto-old:isMandatory true ;
    impacto-old:partOfRequirement impacto-old:DPIA-IR-A357d .

impacto-old:DPIA-IR-26 a impacto-old:DPIAInformationRequirement ;
    rdfs:label "Outcome and prior consultation"@en ;
    dcterms:source "GDPR Art.35(7), Art.36(1)"@en ;
    skos:definition "The outcome of the DPIA and, where a high residual risk remains, the prior consultation of the supervisory authority."@en ;
    skos:prefLabel "Outcome and prior consultation"@en ;
    impacto-old:hasExpectedProperty dpv:hasOutcome ;
    impacto-old:isMandatory true .

impacto-old:DPIA-IR-4 a impacto-old:DPIAInformationRequirement ;
    rdfs:label "Categories of data subject"@en ;
    dcterms:source "GDPR Art.35(7)(a); WP248rev.01"@en ;
    skos:definition "The categories of data subject whose personal data is processed, noting any vulnerable groups."@en ;
    skos:prefLabel "Categories of data subject"@en ;
    impacto-old:hasExpectedProperty dpv:hasDataSubject ;
    impacto-old:hasExpectedValueClass dpv:DataSubject ;
    impacto-old:isMandatory true ;
    impacto-old:partOfRequirement impacto-old:DPIA-IR-A357a ;
    impacto-old:providesInputTo impacto-old:FRIA-IR-c .

impacto-old:DPIA-IR-7 a impacto-old:DPIAInformationRequirement ;
    rdfs:label "Scale of processing"@en ;
    dcterms:source "Recital 91; WP248rev.01"@en ;
    skos:definition "The scale of the processing, including the number of data subjects and the volume of data."@en ;
    skos:prefLabel "Scale of processing"@en ;
    impacto-old:hasExpectedProperty impacto-old:hasDataSubjectCount,
        dpv:hasProcessingScale ;
    impacto-old:isMandatory true ;
    impacto-old:partOfRequirement impacto-old:DPIA-IR-A357a .

impacto-old:DPIA-IR-8 a impacto-old:DPIAInformationRequirement ;
    rdfs:label "Storage duration"@en ;
    dcterms:source "WP248rev.01"@en ;
    skos:definition "The period for which personal data is stored, and the justification for that period."@en ;
    skos:prefLabel "Storage duration"@en ;
    impacto-old:hasExpectedProperty impacto-old:hasRetentionJustification,
        dpv:hasStorageDuration ;
    impacto-old:isMandatory true ;
    impacto-old:partOfRequirement impacto-old:DPIA-IR-A357a .

impacto-old:DataBreachNotification a skos:Concept ;
    rdfs:label "Data Breach Notification"@en ;
    skos:editorialNote "Used by the DPIA condition set but not yet defined in IMPACTO-concepts.ttl. Proposed for the dpv namespace."@en ;
    skos:prefLabel "Data Breach Notification"@en .

impacto-old:F1 a impacto-old:FRIARequiredCondition ;
    rdfs:label "Public law body deploying an Annex III system"@en ;
    dcterms:source "AI Act Art.27(1)"@en ;
    skos:definition "A FRIA is required because the deployer is a body governed by public law and the system is high-risk under Article 6(2), other than a system in the area listed in Annex III point 2."@en ;
    skos:prefLabel "Public law body deploying an Annex III system"@en ;
    impacto-old:excludesAISystemType eu-aiact:HighRiskAISystem-AnnexIII-2 ;
    impacto-old:hasObligationSource impacto-old:FRIASource-A27 ;
    impacto-old:requiresAISystemType eu-aiact:HighRiskAISystem-A6-2 ;
    impacto-old:requiresDeployerType impacto-old:BodyGovernedByPublicLaw .

impacto-old:F3 a impacto-old:FRIARequiredCondition ;
    rdfs:label "Any deployer of a creditworthiness system"@en ;
    dcterms:source "AI Act Art.27(1)"@en ;
    skos:definition "A FRIA is required because the system evaluates the creditworthiness of natural persons or establishes their credit score, under Annex III point 5(b). This applies irrespective of the category of deployer."@en ;
    skos:note "No impacto:requiresDeployerType is stated: the obligation attaches to every deployer of such a system, public or private."@en ;
    skos:prefLabel "Any deployer of a creditworthiness system"@en ;
    impacto-old:hasObligationSource impacto-old:FRIASource-A27 ;
    impacto-old:requiresAISystemType eu-aiact:HighRiskAISystem-AnnexIII-5-b .

impacto-old:FRIA-IR-b a impacto-old:FRIAInformationRequirement ;
    rdfs:label "Period and frequency of use"@en ;
    dcterms:source "AI Act Art.27(1)(b)"@en ;
    skos:definition "A description of the period of time within which, and the frequency with which, each high-risk AI system is intended to be used."@en ;
    skos:prefLabel "Period and frequency of use"@en ;
    impacto-old:correspondsToDPIARequirement impacto-old:DPIA-IR-8 ;
    impacto-old:hasExpectedProperty impacto-old:hasUseFrequency,
        impacto-old:hasUsePeriod ;
    impacto-old:hasReuseGap "The DPIA states a storage duration for personal data. The FRIA requires the period and frequency of use of the system itself, which is a different quantity and normally has to be stated afresh."@en ;
    impacto-old:hasReuseLevel impacto-old:PartiallyReusable ;
    impacto-old:isMandatory true .

impacto-old:FRIA-IR-notification a impacto-old:FRIAInformationRequirement ;
    rdfs:label "Notification of the market surveillance authority"@en ;
    dcterms:source "AI Act Art.27(3)"@en ;
    skos:definition "Notification of the results of the assessment to the market surveillance authority, submitting the filled-out template."@en ;
    skos:prefLabel "Notification of the market surveillance authority"@en ;
    impacto-old:hasExpectedProperty impacto-old:notifiedAuthority ;
    impacto-old:hasExpectedValueClass eu-aiact:MarketSurveillanceAuthority ;
    impacto-old:hasReuseGap "Notification of the market surveillance authority has no counterpart in the DPIA. Prior consultation of the supervisory authority under GDPR Art.36 is a different obligation, owed to a different authority and triggered by a different condition."@en ;
    impacto-old:hasReuseLevel impacto-old:NotReusable ;
    impacto-old:isMandatory true .

