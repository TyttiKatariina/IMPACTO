    rdfs:label "Process Description"@en ;
    dcterms:source "AI Act Art. 27(1)(a)"@en ;
    rdfs:seeAlso <https://eur-lex.europa.eu/eli/reg/2024/1689/oj/eng> ;
    rdfs:subClassOf dpv:Context ;
    skos:broader dpv:Context ;
    skos:definition "A description of the deployer's processes in which the high-risk AI system will be used in line with its intended purpose."@en ;
    skos:prefLabel "Process Description"@en ;
    skos:scopeNote "Proposed for: DPV EU AI Act extension (eu-aiact)"@en .

impacto-old:eu-aiact-PublicLawGovernedDeployer a rdfs:Class,
