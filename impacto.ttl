    rdfs:label "Private Sector Event"@en ;
    dcterms:source "CN31"@en ;
    rdfs:subClassOf dpv:EventManagement ;
    skos:definition "An event held in the private sector."@en .

dpv:PrivateSponsors a rdfs:Class,
        skos:Concept ;
    rdfs:label "Private Sponsors"@en ;
    dcterms:source "CN10"@en ;
    rdfs:subClassOf dpv:Entity ;
    skos:definition "A private entity that sponsors or funds the activities of an association, partnership or similar body."@en .

dpv:PrivateUse a rdfs:Class,
        skos:Concept ;
    rdfs:label "Private Use"@en ;
    dcterms:source "CN17"@en ;
    rdfs:subClassOf dpv:ProcessingContext ;
    skos:definition "A processing context in which a property or system is used exclusively by the person responsible and other authorised private users."@en .

dpv:ProfessionalSecrecyObligation a rdfs:Class,
