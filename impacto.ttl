ex:UC-1 a impacto-old:HighRiskUseCase ;
    rdfs:label "Automated shortlisting of job applicants by a local authority"@en ;
    skos:prefLabel "Automated shortlisting of job applicants by a local authority"@en ;
    impacto-old:concernsAISystem ex:TalentScreen ;
    impacto-old:concernsProcessingActivity ex:Proc-Shortlisting ;
    impacto-old:hasAssessmentObligation ex:DPIA-1,
        ex:FRIA-1 ;
    impacto-old:hasDeployer ex:CityCouncil ;
    impacto-old:matchesCondition ex:Overlap-1 ;
    dpv:hasJurisdiction loc:IE .

ex:UC-2 a impacto-old:HighRiskUseCase ;
    rdfs:label "Credit scoring by a private bank"@en ;
    skos:prefLabel "Credit scoring by a private bank"@en ;
    impacto-old:concernsAISystem ex:CreditScorer ;
    impacto-old:concernsProcessingActivity ex:Proc-CreditScoring ;
    impacto-old:hasAssessmentObligation ex:DPIA-2,
        ex:FRIA-2 ;
    impacto-old:hasDeployer ex:Bank ;
    impacto-old:matchesCondition ex:Overlap-2 ;
    dpv:hasJurisdiction loc:IE .

ex:UC-3 a impacto-old:HighRiskUseCase ;
    rdfs:label "Worker performance monitoring by a private logistics company"@en ;
    skos:note "No FRIA. The system is high-risk under Annex III point 4(b), but the deployer is neither a body governed by public law nor a private entity providing public services, and the system is not within Annex III points 5(b) or 5(c)."@en ;
    skos:prefLabel "Worker performance monitoring by a private logistics company"@en ;
    impacto-old:concernsAISystem ex:WorkerMonitor ;
    impacto-old:concernsProcessingActivity ex:Proc-WorkerMonitoring ;
    impacto-old:hasAssessmentObligation ex:DPIA-3 ;
    impacto-old:hasDeployer ex:Logistics ;
    dpv:hasJurisdiction loc:IE .

