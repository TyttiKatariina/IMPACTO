        impacto:SourceNL,
        impacto:SourcePL,
        impacto:SourceRO ;
    rdfs:subClassOf impacto:UtilityProvider ;
    skos:broader impacto:UtilityProvider ;
    skos:definition "A public organisation providing utilities"@en ;
    skos:notation "C23" ;
    skos:prefLabel "Public Utility Provider"@en .

impacto:Sensor a owl:Class,
        skos:Concept ;
    rdfs:label "Sensor"@en ;
    dcterms:source impacto:SourceDE,
        impacto:SourceSI ;
    rdfs:subClassOf tech:Component ;
    skos:broader tech:Component ;
    skos:definition "Innovative device or technology used for detecting, collecting, or transmitting data, often as part of mobile or centralised systems, enabling real-time monitoring or measurement of physical conditions, behaviours, or environments"@en ;
    skos:notation "C62" ;
    skos:prefLabel "Sensor"@en .

impacto:Skill a owl:Class,
        skos:Concept ;
    rdfs:label "Skill"@en ;
    dcterms:source impacto:SourceIS,
        impacto:SourceNO,
        impacto:SourcePL ;
    rdfs:subClassOf pd:External ;
    skos:broader pd:External ;
    skos:definition "Personal data processed for the systematic assessment of an individual's capabilities or expertise, including the evaluation of specific learned abilities, aptitudes, or training outcomes"@en ;
    skos:notation "C45" ;
    skos:prefLabel "Skill"@en .

impacto:SmartMeter a owl:Class,
        skos:Concept ;
    rdfs:label "Smart Meter"@en ;
    dcterms:source impacto:SourceBE,
        impacto:SourceGR,
        impacto:SourceHR,
        impacto:SourceHU,
        impacto:SourceNL,
        impacto:SourcePL,
        impacto:SourceRO ;
    rdfs:subClassOf tech:Device ;
    skos:broader tech:Device ;
    skos:definition "A device installed by utility providers that automatically tracks and transmits consumption data, such as electricity, gas, or water usage"@en ;
    skos:notation "C23" ;
    skos:prefLabel "Smart Meter"@en .

impacto:SourceIE a owl:NamedIndividual ;
    rdfs:label "Ireland (IE)"@en ;
    skos:exactMatch <https://w3id.org/dpv/legal/ie#DPIARequiredList> ;
