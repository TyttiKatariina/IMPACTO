    skos:scopeNote "Proposed as the parent of dpv:ProtectionOfCommercialInterest."@en,
        "Proposed for: DPV core (dpv)"@en .

impacto-old:dpv-DPIAExemption a rdfs:Class,
        skos:Concept ;
    rdfs:label "DPIA Exemption"@en ;
    dcterms:source "GDPR Art. 35(10)"@en ;
    rdfs:seeAlso <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX%3A32016R0679> ;
    rdfs:subClassOf dpv:DPIA ;
    skos:broader dpv:DPIA ;
    skos:definition "The one condition under which specific processing is exempt from the obligation to carry out a DPIA as per GDPR Art. 35(10)."@en ;
    skos:prefLabel "DPIA Exemption"@en ;
    skos:scopeNote "Proposed for: DPV core (dpv)"@en .

impacto-old:dpv-DPIAExemptionA35 a rdfs:Class,
        skos:Concept ;
    rdfs:label "DPIA Exemption A35"@en ;
    rdfs:subClassOf impacto-old:dpv-DPIAExemption ;
    skos:broader impacto-old:dpv-DPIAExemption ;
    skos:definition "The specific DPIA exemption in Article 35 of the GDPR which states that if processing under Article 6(1)(c) or (e) is goverened by Union or MemberState law and a DPIA was already conducted as part o a general impact assesment, a further DPIA is not required unless the Member State considers one necessary before processing."@en ;
    skos:prefLabel "DPIA Exemption A35"@en ;
    skos:scopeNote "Proposed for: DPV core (dpv)"@en .

impacto-old:dpv-DataSubjectBehaviourMonitoring a rdfs:Class,
