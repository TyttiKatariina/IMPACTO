impacto:SourceSK a owl:NamedIndividual ;
    rdfs:label "Slovakia (SK)"@en ;
    skos:exactMatch <https://w3id.org/dpv/legal/sk#DPIARequiredList> ;
    skos:prefLabel "Slovakia (SK)"@en .

impacto:Surveillance a owl:Class,
        skos:Concept ;
    rdfs:label "Surveillance"@en ;
    rdfs:subClassOf dpv:Observe ;
    skos:broader dpv:Observe ;
    skos:definition "Obtaining data through surveillance"@en ;
    skos:prefLabel "Surveillance"@en .

impacto:Systematic a owl:Class,
        skos:Concept ;
    rdfs:label "Systematic"@en ;
    dcterms:source impacto:SourceAll ;
    rdfs:subClassOf impacto:Systematicity ;
    skos:broader impacto:Systematicity ;
    skos:definition "Indication that processing occurs according to a system; is pre-arranged, organised or methodical, and takes place as part of a general plan or is carried out as part of a strategy"@en ;
    skos:notation "C29, C39, C45, C51, C50, C55, C82, C89" ;
    skos:prefLabel "Systematic"@en ;
    skos:scopeNote "Definition follows ICO UK. Proposed as subclass of eu-gdpr:Systematicity"@en .

impacto:Trustworthiness a owl:Class,
        skos:Concept ;
    rdfs:label "Trustworthiness"@en ;
    dcterms:source impacto:SourceEE,
        impacto:SourceNO ;
    rdfs:subClassOf pd:External ;
    skos:broader pd:External ;
    skos:definition "Personal data processed to predict or assess an individual's reliability, integrity, or honesty, often in the context of providing services, financial products, or employment assessments"@en ;
    skos:notation "C61" ;
    skos:prefLabel "Trustworthiness"@en .

impacto:UnknownDataSource a owl:Class,
        skos:Concept ;
    rdfs:label "Unknown Data Source"@en ;
    dcterms:source impacto:SourceIE ;
    rdfs:subClassOf dpv:DataSource ;
    skos:broader dpv:DataSource ;
    skos:definition "The origin of personal data cannot be determined or is not known"@en ;
    skos:notation "C94" ;
    skos:prefLabel "Unknown Data Source"@en .

impacto:UnlawfulActivity a owl:Class,
        skos:Concept ;
    rdfs:label "Unlawful Activity"@en ;
    dcterms:source impacto:SourceAll ;
    rdfs:subClassOf pd:Social ;
    skos:broader pd:Social ;
    skos:definition "Unlawful activity under GDPR refers to any unlawful activity that violates laws and regulations"@en ;
    skos:notation "C9" ;
    skos:prefLabel "Unlawful Activity"@en .

impacto:WhistleblowerManagement a owl:Class,
        skos:Concept ;
    rdfs:label "Whistleblower Management"@en ;
    dcterms:source impacto:SourceFI ;
    rdfs:subClassOf dpv:HumanResourceManagement ;
    skos:broader dpv:HumanResourceManagement ;
    skos:definition "The management of whistleblower processes, systems, and information through which individuals or groups can report on negative activities such as misconduct, harms, and compliance violations"@en ;
    skos:notation "C100" ;
    skos:prefLabel "Whistleblower Management"@en .

impacto:Workplace a owl:Class,
        skos:Concept ;
    rdfs:label "Workplace"@en ;
    dcterms:source impacto:SourceLV,
        impacto:SourceNL ;
    rdfs:subClassOf dpv:LocationLocality ;
    skos:broader dpv:LocationLocality ;
    skos:definition "A professional environment or workplace"@en ;
    skos:notation "C57" ;
    skos:prefLabel "Workplace"@en ;
    skos:scopeNote "Context: continuous or large-scale observation of individuals in sensitive contexts involving protected or vulnerable populations"@en .

impacto:WorshipLocation a owl:Class,
        skos:Concept ;
    rdfs:label "Worship Location"@en ;
    dcterms:source impacto:SourceAT ;
    rdfs:subClassOf dpv:Location ;
    skos:broader dpv:Location ;
    skos:definition "A religious institution such as a church or house of prayer, where monitoring or data processing may occur for security or organisational purposes"@en ;
    skos:notation "C68" ;
    skos:prefLabel "Worship Location"@en .

dpv:ThirdPartyDataSOurce skos:editorialNote "Capitalisation error in 'Source'. Appears twice."@en ;
    skos:exactMatch dpv:ThirdPartyDataSource .

eu-gdpr:C10a a impacto-old:AssessmentTriggerCondition,
        impacto-old:DPIARequiredCondition,
        impacto-old:eu-gdpr-DPIARequiredProcess,
        eu-gdpr:DPIARequiredProcess ;
    rdfs:label "GDPR C10a: A process which requires a DPIA according to GDPR Article 35-3b and…"@en ;
    dcterms:source "GDPR Art 35-3b" ;
    skos:definition "A process which requires a DPIA according to GDPR Article 35-3b and which involves large scale processing of personal data relating to criminal offences or unlawful or bad conduct"@en ;
    dpv:hasPersonalData pd:Criminal ;
    dpv:hasProcessingScale dpv:LargeScaleProcessing .

eu-gdpr:C4c a impacto-old:AssessmentTriggerCondition,
        impacto-old:DPIARequiredCondition,
        impacto-old:eu-gdpr-DPIARequiredProcess,
        eu-gdpr:DPIARequiredProcess ;
    rdfs:label "GDPR C4c: A process which requires a DPIA according to GDPR Article 35-3b and…"@en ;
    dcterms:source "GDPR Art 35-3b" ;
    skos:definition "A process which requires a DPIA according to GDPR Article 35-3b and which involves profiling and/or processing of vulnerable persons data"@en ;
    dpv:hasHumanSubject dpv:VulnerableHuman ;
    dpv:hasProcessing eu-gdpr:Profiling .

eu-gdpr:C5 a impacto-old:AssessmentTriggerCondition,
        impacto-old:DPIARequiredCondition,
        impacto-old:eu-gdpr-DPIARequiredProcess,
        eu-gdpr:DPIARequiredProcess ;
    rdfs:label "GDPR C5: A process which requires a DPIA according to GDPR Article 35-3c and…"@en ;
    dcterms:source "GDPR Art 35-3c" ;
    skos:definition "A process which requires a DPIA according to GDPR Article 35-3c and which involves large scale ystematic monitoring of a publicly accessible area"@en ;
    dpv:hasContext eu-gdpr:SystematicMonitoring ;
    dpv:hasLocation dpv:PubliclyAccessibleSpace ;
    dpv:hasProcessingScale dpv:LargeScaleProcessing .

ex:Proc-WorkerMonitoring a impacto-old:HighRiskProcessingActivity,
        dpv:PersonalDataHandling ;
    rdfs:label "Continuous monitoring of warehouse worker output"@en ;
    impacto-old:hasNecessityJustification "Systematic monitoring and evaluation of employees at scale. A DPIA obligation arises independently of the AI Act."^^xsd:string ;
    impacto-old:hasNecessityStatus eu-gdpr:DPIARequired ;
    impacto-old:isEmbeddedInAISystem ex:WorkerMonitor ;
    impacto-old:matchesCondition eu-gdpr:C3,
        <https://w3id.org/dpv/legal/ie#C14a> ;
    dpv:hasContext impacto-old:ai-UseOfAI,
        dpv:EvaluationOfIndividuals,
        eu-gdpr:SystematicMonitoring ;
    dpv:hasDataSubject dpv:Employee ;
    dpv:hasJurisdiction loc:IE ;
    dpv:hasLocation impacto-old:loc-Workplace ;
    dpv:hasName "Continuous monitoring of warehouse worker output"^^xsd:string ;
    dpv:hasPersonalData pd:Behavioural ;
    dpv:hasProcessing impacto-old:dpv-MonitoringIndividuals,
        dpv:Analyse,
        dpv:Collect ;
    dpv:hasProcessingScale dpv:LargeScaleProcessing ;
    dpv:hasPurpose dpv:HumanResourceManagement ;
    dpv:hasTechnicalMeasure dpv:ActivityMonitoring .

impacto-old:DPIA-IR-16 a impacto-old:DPIAInformationRequirement ;
    rdfs:label "Organisational measures"@en ;
    dcterms:source "GDPR Art.32, Art.35(7)(d)"@en ;
    skos:definition "The organisational measures implemented, such as policies, training, processing agreements and governance arrangements."@en ;
    skos:prefLabel "Organisational measures"@en ;
    impacto-old:hasExpectedProperty dpv:hasOrganisationalMeasure ;
    impacto-old:hasExpectedValueClass dpv:OrganisationalMeasure ;
    impacto-old:isMandatory true ;
    impacto-old:partOfRequirement impacto-old:DPIA-IR-A357d ;
    impacto-old:providesInputTo impacto-old:FRIA-IR-e .

impacto-old:FRIA-IR-e a impacto-old:FRIAInformationRequirement ;
    rdfs:label "Human oversight measures"@en ;
    dcterms:source "AI Act Art.27(1)(e), Art.14, Art.26"@en ;
    skos:definition "A description of the implementation of human oversight measures, according to the instructions for use."@en ;
    skos:prefLabel "Human oversight measures"@en ;
    impacto-old:correspondsToDPIARequirement impacto-old:DPIA-IR-12,
        impacto-old:DPIA-IR-16 ;
    impacto-old:hasExpectedProperty impacto-old:hasHumanOversightMeasure ;
    impacto-old:hasReuseGap "Organisational measures recorded in a DPIA may include human review of automated decisions under GDPR Art.22(3). The FRIA requires the implementation of human oversight in accordance with the provider's instructions for use under Art.14 and Art.26, which is more specific and is documented against those instructions."@en ;
    impacto-old:hasReuseLevel impacto-old:PartiallyReusable ;
    impacto-old:isMandatory true .

