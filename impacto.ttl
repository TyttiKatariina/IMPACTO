    rdfs:label "Member State Territory"@en ;
    dcterms:source "CN33"@en ;
    rdfs:subClassOf dpv:Locality ;
    skos:definition "The territory of a single Member State, where processing is carried out exclusively within it."@en .

dpv:Members a rdfs:Class,
        skos:Concept ;
    rdfs:label "Members"@en ;
    dcterms:source "CN10"@en ;
    rdfs:subClassOf dpv:Entity ;
    skos:definition "An individual holding membership of a body under public or private law, in particular an association or partnership."@en .

dpv:MembershipLists a rdfs:Class,
        skos:Concept ;
    rdfs:label "Membership Lists"@en ;
    dcterms:source "CN10"@en ;
    rdfs:subClassOf dpv:ProcessingContext ;
