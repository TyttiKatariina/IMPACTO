dpv:SoftwareManagement a rdfs:Class,
        skos:Concept ;
    rdfs:label "Software Management"@en ;
    dcterms:source "CN12"@en ;
    rdfs:subClassOf dpv:Purpose ;
    skos:definition "Managing the allocation of software to users of an organisation's computer systems."@en .

dpv:StaffOnContract a rdfs:Class,
        skos:Concept ;
    rdfs:label "Staff On Contract"@en ;
    dcterms:source "CN7"@en ;
    rdfs:subClassOf dpv:Entity ;
