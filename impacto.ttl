dpv:PublicSponsors a rdfs:Class,
        skos:Concept ;
    rdfs:label "Public Sponsors"@en ;
    dcterms:source "CN10"@en ;
    rdfs:subClassOf dpv:Entity ;
    skos:definition "A public entity that sponsors or funds the activities of an association, partnership or similar body."@en .

dpv:PublicSubsidies a rdfs:Class,
        skos:Concept ;
    rdfs:label "Public Subsidies"@en ;
    dcterms:source "CN27"@en ;
    rdfs:subClassOf dpv:ProcessingContext ;
