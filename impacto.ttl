<https://example.org/dpia-conditions#C100> a impacto-old:AssessmentTriggerCondition,
        impacto-old:DPIARequiredCondition,
        impacto-old:eu-gdpr-DPIARequiredProcess,
        eu-gdpr:DPIARequiredProcess ;
    rdfs:label "DPIA-CONDITIONS C100: A process which requires a DPIA according to the Data Protection…"@en ;
    dcterms:source <https://example.org/dpia-conditions#DPIARequiredList> ;
    skos:definition "A process which requires a DPIA according to the Data Protection Authorities of EX and which involves processing of personal data in whistleblower systems"@en ;
    dpv:hasJurisdiction loc:EX ;
    dpv:hasPurpose impacto-old:dpv-WhistleblowerManagement .

<https://example.org/dpia-conditions#C101a> a impacto-old:AssessmentTriggerCondition,
        impacto-old:DPIARequiredCondition,
        impacto-old:eu-gdpr-DPIARequiredProcess,
        eu-gdpr:DPIARequiredProcess ;
    rdfs:label "DPIA-CONDITIONS C101a: A process which requires a DPIA according to the Data Protection…"@en ;
    dcterms:source <https://example.org/dpia-conditions#DPIARequiredList> ;
    skos:definition "A process which requires a DPIA according to the Data Protection Authorities of EX and which involves large Scale Processing that might pose a risk of property loss (particularly in banking and credit card services)"@en ;
    dpv:hasJurisdiction loc:EX ;
    dpv:hasProcessingScale dpv:LargeScaleProcessing ;
    dpv:hasRisk impacto-old:risk-PropertyLoss .

<https://example.org/dpia-conditions#C101b> a impacto-old:AssessmentTriggerCondition,
        impacto-old:DPIARequiredCondition,
        impacto-old:eu-gdpr-DPIARequiredProcess,
        eu-gdpr:DPIARequiredProcess ;
    rdfs:label "DPIA-CONDITIONS C101b: A process which requires a DPIA according to the Data Protection…"@en ;
    dcterms:source <https://example.org/dpia-conditions#DPIARequiredList> ;
    skos:definition "A process which requires a DPIA according to the Data Protection Authorities of EX and which involves large Scale Processing that might pose a risk of property loss (particularly in banking and credit card services)"@en ;
    dpv:hasJurisdiction loc:EX ;
    dpv:hasProcessingScale dpv:LargeScaleProcessing ;
    dpv:hasPurpose <https://w3id.org/dpv/sector/finance#FinancialServiceManagement> ;
    dpv:hasRisk impacto-old:risk-PropertyLoss .

<https://example.org/dpia-conditions#C102> a impacto-old:AssessmentTriggerCondition,
        impacto-old:DPIARequiredCondition,
        impacto-old:eu-gdpr-DPIARequiredProcess,
        eu-gdpr:DPIARequiredProcess ;
    rdfs:label "DPIA-CONDITIONS C102: A process which requires a DPIA according to the Data Protection…"@en ;
    dcterms:source <https://example.org/dpia-conditions#DPIARequiredList> ;
    skos:definition "A process which requires a DPIA according to the Data Protection Authorities of EX and which involves large Scale Processing that might pose a risk of violation of secrecy of correspondence (particularly in communication services)"@en ;
    dpv:hasJurisdiction loc:EX ;
    dpv:hasProcessingScale dpv:LargeScaleProcessing ;
    dpv:hasRisk risk:ViolatingCodeOfConduct .

<https://example.org/dpia-conditions#C103a> a impacto-old:AssessmentTriggerCondition,
        impacto-old:DPIARequiredCondition,
        impacto-old:eu-gdpr-DPIARequiredProcess,
        eu-gdpr:DPIARequiredProcess ;
    rdfs:label "DPIA-CONDITIONS C103a: A process which requires a DPIA according to the Data Protection…"@en ;
    dcterms:source <https://example.org/dpia-conditions#DPIARequiredList> ;
    skos:definition "A process which requires a DPIA according to the Data Protection Authorities of EX and which involves large Scale Processing that might pose a risk of identity theft or fraud (particularly in digital trust services and in comparable identity management services)"@en ;
    dpv:hasJurisdiction loc:EX ;
    dpv:hasProcessingScale dpv:LargeScaleProcessing ;
    dpv:hasRisk risk:IdentityTheft .

<https://example.org/dpia-conditions#C103b> a impacto-old:AssessmentTriggerCondition,
        impacto-old:DPIARequiredCondition,
