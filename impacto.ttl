    dcterms:source "CN3"@en ;
    rdfs:subClassOf dpv:LegalBasis ;
    skos:definition "An exemption from an obligation which arises because the specific processing operation is regulated by EU or Member State law and the obligation was already discharged as part of the establishment of that legal basis."@en .

dpv:LessThan250Employees a rdfs:Class,
        skos:Concept ;
    rdfs:label "Less Than 250 Employees"@en ;
    dcterms:source "CN40"@en ;
    rdfs:subClassOf dpv:Scale ;
    skos:definition "A scale indicating that the organisation carrying out the processing employs fewer than 250 people."@en .

dpv:LimitedPublicArea a rdfs:Class,
        skos:Concept ;
