dpv:Resident a rdfs:Class,
        skos:Concept ;
    rdfs:label "Resident"@en ;
    dcterms:source "CN58"@en ;
    rdfs:subClassOf dpv:DataSubject ;
    skos:definition "A natural person residing within the territory of an authority, irrespective of citizenship."@en .

dpv:ResidentialBuildingManagement a rdfs:Class,
        skos:Concept ;
    rdfs:label "Residential Building Management"@en ;
    dcterms:source "CN55"@en ;
    rdfs:subClassOf dpv:Purpose ;
    skos:definition "The management of multi-apartment residential buildings and related buildings by an association or community of apartment owners."@en .

dpv:ResidentialPurpose a rdfs:Class,
        skos:Concept ;
    rdfs:label "Residential Purpose"@en ;
    dcterms:source "CN17"@en ;
    rdfs:subClassOf dpv:Purpose ;
    skos:definition "A purpose associated with the use of a property for residential living."@en .

dpv:ResidentialUse a rdfs:Class,
        skos:Concept ;
    rdfs:label "Residential Use"@en ;
    dcterms:source "CN17"@en ;
    rdfs:subClassOf dpv:ProcessingContext ;
    skos:definition "A processing context in which a property is used for residential living by the person responsible and the authorised users of the common household."@en .

dpv:RiskLevelNotHigh a rdfs:Class,
        skos:Concept ;
    rdfs:label "Risk Level Not High"@en ;
    dcterms:source "CN1"@en ;
    rdfs:subClassOf dpv:RiskLevel ;
    skos:definition "A risk level indicating that processing is not likely to result in a high risk to the rights and freedoms of natural persons."@en .

dpv:SelfEmployedHealthcarePractitioner a rdfs:Class,
        skos:Concept ;
