@prefix ai: <https://w3id.org/dpv/ai#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dpv: <https://w3id.org/dpv#> .
@prefix eu-aiact: <https://w3id.org/dpv/legal/eu/aiact#> .
@prefix eu-gdpr: <https://w3id.org/dpv/legal/eu/gdpr#> .
@prefix eu-rights: <https://w3id.org/dpv/legal/eu/rights#> .
@prefix ex: <https://example.org/impacto/> .
@prefix impacto: <https://tyttikatariina.github.io/ImpactAssessmentOntology/#> .
@prefix impacto-old: <https://tyttikatariina.github.io/IMPACTO/#> .
@prefix loc: <https://w3id.org/dpv/loc#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pd: <https://w3id.org/dpv/pd#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix risk: <https://w3id.org/dpv/risk#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tech: <https://w3id.org/dpv/tech#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

impacto-old:AISystemProcessingPattern a rdfs:Class,
        skos:Concept ;
    rdfs:label "AI System Processing Pattern"@en ;
    rdfs:subClassOf impacto-old:eu-aiact-FRIANecessityAssessment,
        dpv:Process ;
    skos:broader dpv:Process ;
    skos:definition "The personal data processing characteristics typically entailed by a class of high-risk AI system. Expressed with the same DPV predicates as DPIA trigger conditions, so that an Annex III classification can be checked directly against the DPIA condition set."@en ;
    skos:prefLabel "AI System Processing Pattern"@en ;
    skos:scopeNote "A pattern is an expectation, not a determination: whether a DPIA is actually required still depends on the characteristics of the concrete processing activity."@en,
        "Describes the personal data processing typically entailed by a class of high-risk AI system under Annex III, expressed with the same predicates as the DPIA conditions so that the two regimes can be matched against one another."@en .

impacto-old:AssessmentObligationSource a rdfs:Class,
        skos:Concept ;
    rdfs:label "Assessment Obligation Source"@en ;
    skos:definition "A legal or regulatory source from which an obligation to conduct an impact assessment derives."@en ;
    skos:prefLabel "Assessment Obligation Source"@en .

impacto-old:AssessmentStage a rdfs:Class,
        skos:Concept ;
    rdfs:label "Assessment Stage"@en ;
    rdfs:subClassOf dpv:Process ;
    skos:broader dpv:Process ;
    skos:definition "A distinct step within an impact assessment process."@en ;
    skos:prefLabel "Assessment Stage"@en .

impacto-old:AssessmentTriggerCondition a rdfs:Class,
        skos:Concept ;
    rdfs:label "Assessment Trigger Condition"@en ;
    rdfs:subClassOf dpv:Process ;
    skos:broader dpv:Process ;
    skos:definition "A pattern of characteristics which, when matched by a real processing activity or AI system, determines whether an impact assessment is required. Each condition lists the characteristics that must ALL be present for it to be triggered."@en ;
    skos:prefLabel "Assessment Trigger Condition"@en ;
    skos:scopeNote "Conditions are expressed with the same DPV predicates that describe real processing activities (dpv:hasPersonalData, dpv:hasProcessingScale, dpv:hasContext, ...), so that matching is a subset test between a condition and an activity."@en .

impacto-old:BodyGovernedByPublicLaw a rdfs:Class,
        skos:Concept,
        impacto-old:DeployerCategory ;
    rdfs:label "Body Governed by Public Law"@en ;
    dcterms:source "AI Act Art.27(1)"@en ;
    rdfs:subClassOf impacto-old:DeployerCategory ;
    owl:equivalentClass impacto-old:eu-aiact-PublicLawGovernedDeployer ;
    skos:broader impacto-old:DeployerCategory ;
    skos:definition "A deployer that is a body governed by public law. Such deployers must conduct a FRIA for high-risk AI systems under Art.6(2)."@en ;
    skos:prefLabel "Body Governed by Public Law"@en .

impacto-old:ConsultationStage a rdfs:Class,
        skos:Concept ;
    rdfs:label "Consultation Stage"@en ;
    dcterms:source "AI Act Art.27(3)"@en,
        "GDPR Art.35(2),(9), Art.36"@en ;
    rdfs:subClassOf impacto-old:AssessmentStage ;
    skos:broader impacto-old:AssessmentStage ;
    skos:definition "The stage in which the DPO, data subjects or their representatives, affected persons, the provider, or a supervisory authority are consulted."@en ;
    skos:prefLabel "Consultation Stage"@en .

impacto-old:DPAGuidance a rdfs:Class,
        skos:Concept ;
    rdfs:label "DPA Guidance"@en ;
    rdfs:subClassOf impacto-old:RegulatoryGuidance ;
    skos:broader impacto-old:RegulatoryGuidance ;
    skos:definition "Guidance issued by a national data protection authority."@en ;
    skos:prefLabel "DPA Guidance"@en .

impacto-old:DPIA a rdfs:Class,
        skos:Concept ;
    rdfs:label "Data Protection Impact Assessment"@en ;
    dcterms:source "GDPR Art.35"@en ;
    rdfs:subClassOf impacto-old:ImpactAssessment ;
    owl:equivalentClass dpv:DPIA ;
    skos:broader impacto-old:ImpactAssessment ;
    skos:definition "An assessment of the impact of envisaged processing operations on the protection of personal data, required by GDPR Art.35."@en ;
    skos:prefLabel "Data Protection Impact Assessment"@en .

impacto-old:DPIAExemptList a rdfs:Class,
        skos:Concept ;
    rdfs:label "DPIA Exempt List"@en ;
    dcterms:source "GDPR Art.35(5)"@en ;
    rdfs:subClassOf impacto-old:DPAGuidance ;
    skos:broader impacto-old:DPAGuidance ;
    skos:definition "A national list of processing operations for which no DPIA is required, published by a supervisory authority under GDPR Art.35(5). Commonly called a whitelist."@en ;
    skos:prefLabel "DPIA Exempt List"@en .

impacto-old:DPIAInformationRequirement a rdfs:Class,
        skos:Concept ;
    rdfs:label "DPIA Information Requirement"@en ;
    dcterms:source "GDPR Art.35(7)"@en ;
    rdfs:subClassOf impacto-old:InformationRequirement ;
    skos:broader impacto-old:InformationRequirement ;
    skos:definition "An item of information a DPIA must contain, derived from GDPR Art.35(7) and elaborated by EDPB/WP29 guidance."@en ;
    skos:prefLabel "DPIA Information Requirement"@en .

impacto-old:DPIAInputInFRIA a rdfs:Class,
        skos:Concept ;
    rdfs:label "DPIA Input in FRIA"@en ;
    dcterms:source "AI Act Art.27(4)"@en ;
    owl:equivalentClass impacto-old:eu-aiact-ExistingDPIAInput ;
    skos:definition "A record that content produced for a DPIA is being relied upon within a FRIA. Under AI Act Art.27(4), where an obligation of Art.27 is already met through the DPIA conducted under GDPR Art.35, the FRIA complements that DPIA."@en ;
    skos:prefLabel "DPIA Input in FRIA"@en .

impacto-old:DPIANotRequiredCondition a rdfs:Class,
        skos:Concept ;
    rdfs:label "DPIA Not Required Condition"@en ;
    dcterms:source "GDPR Art.35(5)"@en ;
    rdfs:subClassOf impacto-old:DPIATriggerCondition ;
    owl:equivalentClass impacto-old:eu-gdpr-DPIANotRequiredProcess ;
    skos:broader impacto-old:DPIATriggerCondition ;
    skos:definition "A pattern of processing which a supervisory authority has listed under GDPR Art.35(5) as not requiring a DPIA."@en ;
    skos:prefLabel "DPIA Not Required Condition"@en .

impacto-old:DPIAProcess a rdfs:Class,
        skos:Concept ;
    rdfs:label "DPIA Process"@en ;
    dcterms:source "GDPR Art.35(1), Art.35(2)"@en ;
    rdfs:subClassOf impacto-old:ImpactAssessmentProcess ;
    owl:equivalentClass impacto-old:eu-gdpr-DPIAProcess ;
    skos:broader impacto-old:ImpactAssessmentProcess ;
    skos:closeMatch eu-gdpr:DPIAProcedure ;
    skos:definition "The process of carrying out a DPIA, conducted by or on behalf of the controller."@en ;
    skos:prefLabel "DPIA Process"@en ;
    impacto-old:conductedByRole dpv:DataController ;
    impacto-old:hasInformationRequirement impacto-old:DPIA-IR-1,
        impacto-old:DPIA-IR-10,
        impacto-old:DPIA-IR-11,
        impacto-old:DPIA-IR-12,
        impacto-old:DPIA-IR-13,
        impacto-old:DPIA-IR-14,
        impacto-old:DPIA-IR-15,
        impacto-old:DPIA-IR-16,
        impacto-old:DPIA-IR-17,
        impacto-old:DPIA-IR-18,
        impacto-old:DPIA-IR-19,
        impacto-old:DPIA-IR-2,
        impacto-old:DPIA-IR-20,
        impacto-old:DPIA-IR-21,
        impacto-old:DPIA-IR-22,
        impacto-old:DPIA-IR-23,
        impacto-old:DPIA-IR-24,
        impacto-old:DPIA-IR-25,
        impacto-old:DPIA-IR-26,
        impacto-old:DPIA-IR-3,
        impacto-old:DPIA-IR-4,
        impacto-old:DPIA-IR-5,
        impacto-old:DPIA-IR-6,
        impacto-old:DPIA-IR-7,
        impacto-old:DPIA-IR-8,
        impacto-old:DPIA-IR-9,
        impacto-old:DPIA-IR-A357a,
        impacto-old:DPIA-IR-A357b,
        impacto-old:DPIA-IR-A357c,
        impacto-old:DPIA-IR-A357d .

impacto-old:DPIARequiredCondition a rdfs:Class,
        skos:Concept ;
    rdfs:label "DPIA Required Condition"@en ;
    dcterms:source "GDPR Art.35(1),(3),(4)"@en ;
    rdfs:subClassOf impacto-old:DPIATriggerCondition ;
    owl:equivalentClass impacto-old:eu-gdpr-DPIARequiredProcess ;
    skos:broader impacto-old:DPIATriggerCondition ;
    skos:definition "A pattern of processing which makes a DPIA mandatory, whether under GDPR Art.35(3), Recital 91, the EDPB criteria, or a national supervisory authority's Art.35(4) list."@en ;
    skos:prefLabel "DPIA Required Condition"@en .

impacto-old:DPIARequiredList a rdfs:Class,
        skos:Concept ;
    rdfs:label "DPIA Required List"@en ;
    dcterms:source "GDPR Art.35(4)"@en ;
    rdfs:subClassOf impacto-old:DPAGuidance ;
    skos:broader impacto-old:DPAGuidance ;
    skos:definition "A national list of processing operations for which a DPIA is mandatory, published by a supervisory authority under GDPR Art.35(4). Commonly called a blacklist."@en ;
    skos:prefLabel "DPIA Required List"@en .

impacto-old:DPIATriggerCondition a rdfs:Class,
        skos:Concept ;
    rdfs:label "DPIA Trigger Condition"@en ;
    rdfs:subClassOf impacto-old:AssessmentTriggerCondition ;
    skos:broader impacto-old:AssessmentTriggerCondition ;
    skos:definition "A condition relevant to determining whether a DPIA is required."@en ;
    skos:prefLabel "DPIA Trigger Condition"@en .

impacto-old:DeployerCategory a rdfs:Class,
        skos:Concept ;
    rdfs:label "Deployer Category"@en ;
    dcterms:source "AI Act Art.27(1)"@en ;
    rdfs:subClassOf eu-aiact:AIDeployer ;
    skos:broader eu-aiact:AIDeployer ;
    skos:definition "A category of deployer used by AI Act Art.27(1) to determine who must conduct a FRIA."@en ;
    skos:prefLabel "Deployer Category"@en .

impacto-old:DescriptionStage a rdfs:Class,
        skos:Concept ;
    rdfs:label "Description Stage"@en ;
    dcterms:source "AI Act Art.27(1)(a),(b)"@en,
        "GDPR Art.35(7)(a)"@en ;
    rdfs:subClassOf impacto-old:AssessmentStage ;
    skos:broader impacto-old:AssessmentStage ;
    skos:definition "The stage that produces a systematic description of the processing operations or of the deployer's processes in which the AI system will be used."@en ;
    skos:prefLabel "Description Stage"@en ;
    impacto-old:hasStage_Requirement impacto-old:DPIA-IR-A357a,
        impacto-old:FRIA-IR-a,
        impacto-old:FRIA-IR-b .

impacto-old:FRIA a rdfs:Class,
        skos:Concept ;
    rdfs:label "Fundamental Rights Impact Assessment"@en ;
    dcterms:source "AI Act Art.27"@en ;
    rdfs:subClassOf impacto-old:ImpactAssessment ;
    owl:equivalentClass eu-aiact:FRIA ;
    skos:broader impacto-old:ImpactAssessment ;
    skos:definition "An assessment of the impact on fundamental rights that the use of a high-risk AI system may produce, required by AI Act Art.27."@en ;
    skos:prefLabel "Fundamental Rights Impact Assessment"@en .

impacto-old:FRIAInformationRequirement a rdfs:Class,
        skos:Concept ;
    rdfs:label "FRIA Information Requirement"@en ;
    dcterms:source "AI Act Art.27(1)"@en ;
    rdfs:subClassOf impacto-old:InformationRequirement ;
    skos:broader impacto-old:InformationRequirement ;
    skos:definition "An item of information a FRIA must contain, listed in AI Act Art.27(1)(a) to (f)."@en ;
    skos:prefLabel "FRIA Information Requirement"@en .

impacto-old:FRIANecessityStatus a rdfs:Class,
        skos:Concept ;
    rdfs:label "FRIA Necessity Status"@en ;
    rdfs:subClassOf dpv:AuditStatus ;
    owl:equivalentClass impacto-old:eu-aiact-FRIANecessityStatus ;
    skos:broader dpv:AuditStatus ;
    skos:closeMatch eu-gdpr:DPIANecessityStatus ;
    skos:definition "Status reflecting whether a FRIA is necessary."@en ;
    skos:prefLabel "FRIA Necessity Status"@en .

impacto-old:FRIANecessityUndetermined a rdfs:Class,
        skos:Concept,
        impacto-old:FRIANecessityStatus ;
    rdfs:label "FRIA Necessity Undetermined"@en ;
    rdfs:subClassOf impacto-old:FRIANecessityStatus ;
    skos:broader impacto-old:FRIANecessityStatus ;
    skos:definition "The necessity of a FRIA has not yet been determined, typically because the high-risk classification of the system or the category of the deployer is not yet known."@en ;
    skos:prefLabel "FRIA Necessity Undetermined"@en .

impacto-old:FRIANotRequired a rdfs:Class,
        skos:Concept,
        impacto-old:FRIANecessityStatus ;
    rdfs:label "FRIA Not Required"@en ;
    rdfs:subClassOf impacto-old:FRIANecessityStatus ;
    owl:equivalentClass impacto-old:eu-aiact-FRIANotRequired ;
    skos:broader impacto-old:FRIANecessityStatus ;
    skos:definition "Condition where a FRIA is not required, because the AI system is not within Art.6(2), falls under the Annex III point 2 carve-out, or the deployer does not meet the Art.27(1) criteria."@en ;
    skos:prefLabel "FRIA Not Required"@en .

impacto-old:FRIANotRequiredCondition a rdfs:Class,
        skos:Concept ;
    rdfs:label "FRIA Not Required Condition"@en ;
    rdfs:subClassOf impacto-old:FRIATriggerCondition,
        impacto-old:eu-aiact-FRIANecessity ;
    skos:broader impacto-old:FRIATriggerCondition ;
    skos:definition "A combination of AI system classification and deployer category which falls outside the scope of AI Act Art.27(1), so that no FRIA is required."@en ;
    skos:prefLabel "FRIA Not Required Condition"@en ;
    skos:related impacto-old:eu-aiact-FRIANotRequired .

impacto-old:FRIAProcess a rdfs:Class,
        skos:Concept ;
    rdfs:label "FRIA Process"@en ;
    dcterms:source "AI Act Art.27(1)"@en ;
    rdfs:subClassOf impacto-old:ImpactAssessmentProcess ;
    owl:equivalentClass impacto-old:eu-aiact-FRIAProcedure ;
    skos:broader impacto-old:ImpactAssessmentProcess ;
    skos:definition "The process of carrying out a FRIA, conducted by the deployer of a high-risk AI system."@en ;
    skos:prefLabel "FRIA Process"@en ;
    impacto-old:conductedByRole eu-aiact:AIDeployer ;
    impacto-old:hasInformationRequirement impacto-old:FRIA-IR-a,
        impacto-old:FRIA-IR-b,
        impacto-old:FRIA-IR-c,
        impacto-old:FRIA-IR-d,
        impacto-old:FRIA-IR-e,
        impacto-old:FRIA-IR-f,
        impacto-old:FRIA-IR-notification .

impacto-old:FRIARequired a rdfs:Class,
        skos:Concept,
        impacto-old:FRIANecessityStatus ;
    rdfs:label "FRIA Required"@en ;
    rdfs:subClassOf impacto-old:FRIANecessityStatus ;
    owl:equivalentClass impacto-old:eu-aiact-FRIARequired ;
    skos:broader impacto-old:FRIANecessityStatus ;
    skos:definition "Condition where a FRIA is required."@en ;
    skos:prefLabel "FRIA Required"@en .

impacto-old:FRIARequiredCondition a rdfs:Class,
        skos:Concept ;
    rdfs:label "FRIA Required Condition"@en ;
    dcterms:source "AI Act Art.27(1)"@en ;
    rdfs:subClassOf impacto-old:FRIATriggerCondition,
        impacto-old:eu-aiact-FRIANecessity ;
    skos:broader impacto-old:FRIATriggerCondition ;
    skos:definition "A combination of AI system classification and deployer category which makes a FRIA mandatory under AI Act Art.27(1)."@en ;
    skos:editorialNote "A condition that, when matched, yields the status impacto:eu-aiact-FRIARequired. The condition and the status are deliberately distinct: one is the rule, the other is the determination it produces."@en ;
    skos:prefLabel "FRIA Required Condition"@en ;
    skos:related impacto-old:eu-aiact-FRIARequired .

impacto-old:FRIATriggerCondition a rdfs:Class,
        skos:Concept ;
    rdfs:label "FRIA Trigger Condition"@en ;
    rdfs:subClassOf impacto-old:AssessmentTriggerCondition,
        impacto-old:eu-aiact-FRIANecessity ;
    skos:broader impacto-old:AssessmentTriggerCondition,
        impacto-old:eu-aiact-FRIANecessity ;
    skos:definition "A condition relevant to determining whether a FRIA is required. Unlike DPIA conditions, a FRIA condition constrains BOTH the classification of the AI system and the category of the deployer."@en ;
    skos:prefLabel "FRIA Trigger Condition"@en .

impacto-old:HighRiskProcessingActivity a rdfs:Class,
        skos:Concept ;
    rdfs:label "High-Risk Processing Activity"@en ;
    dcterms:source "GDPR Art.35(1)"@en ;
    rdfs:subClassOf dpv:Process ;
    skos:broader dpv:Process ;
    skos:definition "A real processing activity that is likely to result in a high risk to the rights and freedoms of natural persons and therefore requires a DPIA. Determined by matching the activity against at least one DPIA Required Condition."@en ;
    skos:prefLabel "High-Risk Processing Activity"@en .

impacto-old:HighRiskUseCase a rdfs:Class,
        skos:Concept ;
    rdfs:label "High Risk Use Case"@en ;
    skos:definition "A concrete deployment situation described in enough detail to be evaluated against both DPIA and FRIA trigger conditions: an AI system, the processing activities it carries out, the deployer, and the jurisdiction."@en ;
    skos:prefLabel "High Risk Use Case"@en .

impacto-old:ImpactAssessment a rdfs:Class,
        skos:Concept ;
    rdfs:label "Impact Assessment"@en ;
    owl:equivalentClass dpv:ImpactAssessment ;
    skos:definition "An assessment of the impact that a process, system or technology may have on persons, their rights and their freedoms. Superclass of DPIA and FRIA."@en ;
    skos:prefLabel "Impact Assessment"@en ;
    skos:scopeNote "Provided as a stable IMPACTO entry point; semantically identical to dpv:ImpactAssessment."@en .

impacto-old:ImpactAssessmentProcess a rdfs:Class,
        skos:Concept ;
    rdfs:label "Impact Assessment Process"@en ;
    rdfs:subClassOf dpv:Process ;
    skos:broader dpv:Process ;
    skos:definition "The procedure by which an impact assessment is carried out, from determining whether it is required through to documenting its outcome."@en ;
    skos:prefLabel "Impact Assessment Process"@en .

impacto-old:InformationRequirement a rdfs:Class,
        skos:Concept ;
    rdfs:label "Information Requirement"@en ;
    skos:definition "An item of information that an impact assessment must contain in order to be legally complete."@en ;
    skos:prefLabel "Information Requirement"@en .

impacto-old:LegislativeSource a rdfs:Class,
        skos:Concept ;
    rdfs:label "Legislative Source"@en ;
    rdfs:subClassOf impacto-old:AssessmentObligationSource ;
    skos:broader impacto-old:AssessmentObligationSource ;
    skos:definition "A provision of legislation, such as GDPR Art.35 or AI Act Art.27."@en ;
    skos:prefLabel "Legislative Source"@en .

impacto-old:MeasuresStage a rdfs:Class,
        skos:Concept ;
    rdfs:label "Measures Stage"@en ;
    dcterms:source "AI Act Art.27(1)(e),(f)"@en,
        "GDPR Art.35(7)(d)"@en ;
    rdfs:subClassOf impacto-old:AssessmentStage ;
    skos:broader impacto-old:AssessmentStage ;
    skos:definition "The stage specifying the measures envisaged to address the identified risks, including safeguards, security measures, human oversight and governance arrangements."@en ;
    skos:prefLabel "Measures Stage"@en ;
    impacto-old:hasStage_Requirement impacto-old:DPIA-IR-A357d,
        impacto-old:FRIA-IR-e,
        impacto-old:FRIA-IR-f .

impacto-old:NecessityAndProportionalityStage a rdfs:Class,
        skos:Concept ;
    rdfs:label "Necessity and Proportionality Stage"@en ;
    dcterms:source "GDPR Art.35(7)(b)"@en ;
    rdfs:subClassOf impacto-old:AssessmentStage ;
    skos:broader impacto-old:AssessmentStage ;
    skos:definition "The stage assessing the necessity and proportionality of the processing in relation to its purposes. Specific to the DPIA; the AI Act has no equivalent explicit step."@en ;
    skos:prefLabel "Necessity and Proportionality Stage"@en ;
    impacto-old:hasStage_Requirement impacto-old:DPIA-IR-A357b .

impacto-old:NecessityDeterminationStage a rdfs:Class,
        skos:Concept ;
    rdfs:label "Necessity Determination Stage"@en ;
    dcterms:source "AI Act Art.6, Art.27(1)"@en,
        "GDPR Art.35(1),(3),(4),(5)"@en ;
    rdfs:subClassOf impacto-old:AssessmentStage ;
    skos:broader impacto-old:AssessmentStage ;
    skos:definition "The stage that determines whether the assessment is legally required at all, by checking the processing activity or AI system against the applicable trigger conditions."@en ;
    skos:prefLabel "Necessity Determination Stage"@en .

impacto-old:NotificationStage a rdfs:Class,
        skos:Concept ;
    rdfs:label "Notification Stage"@en ;
    dcterms:source "AI Act Art.27(3)"@en,
        "GDPR Art.36(1)"@en ;
    rdfs:subClassOf impacto-old:AssessmentStage ;
    skos:broader impacto-old:AssessmentStage ;
    skos:definition "The stage in which the results of the assessment are notified: prior consultation of the supervisory authority for a DPIA with high residual risk, or notification of the market surveillance authority for a FRIA."@en ;
    skos:prefLabel "Notification Stage"@en ;
    impacto-old:hasStage_Requirement impacto-old:DPIA-IR-26,
        impacto-old:FRIA-IR-notification .

impacto-old:OtherDeployer a rdfs:Class,
        skos:Concept,
        impacto-old:DeployerCategory ;
    rdfs:label "Other Deployer"@en ;
    rdfs:subClassOf impacto-old:DeployerCategory ;
    skos:broader impacto-old:DeployerCategory ;
    skos:definition "A deployer that is neither a public law body nor a private entity providing public services. Such a deployer only owes a FRIA where the system falls under Annex III points 5(b) or 5(c)."@en ;
    skos:prefLabel "Other Deployer"@en .

impacto-old:OutcomeStage a rdfs:Class,
        skos:Concept ;
    rdfs:label "Outcome Stage"@en ;
    rdfs:subClassOf impacto-old:AssessmentStage ;
    skos:broader impacto-old:AssessmentStage ;
    skos:definition "The stage recording the conclusion of the assessment and whether the processing or the deployment may proceed."@en ;
    skos:prefLabel "Outcome Stage"@en .

impacto-old:OverlappingCondition a rdfs:Class,
        skos:Concept ;
    rdfs:label "Overlapping Condition"@en ;
    rdfs:subClassOf impacto-old:AssessmentTriggerCondition ;
    skos:broader impacto-old:AssessmentTriggerCondition ;
    skos:definition "A situation in which the same use case triggers both a DPIA and a FRIA: a high-risk processing activity that is carried out through a high-risk AI system deployed by a deployer within the scope of AI Act Art.27(1)."@en ;
    skos:prefLabel "Overlapping Condition"@en .

impacto-old:PrivateEntityProvidingPublicService a rdfs:Class,
        skos:Concept,
        impacto-old:DeployerCategory ;
    rdfs:label "Private Entity Providing Public Services"@en ;
    dcterms:source "AI Act Art.27(1)"@en ;
    rdfs:subClassOf impacto-old:DeployerCategory ;
