    dpv:hasTechnicalMeasure dpv:ActivityMonitoring .

<https://w3id.org/dpv/legal/sk#C29> a impacto-old:AssessmentTriggerCondition,
        impacto-old:DPIARequiredCondition,
        impacto-old:eu-gdpr-DPIARequiredProcess,
        eu-gdpr:DPIARequiredProcess ;
    rdfs:label "SK C29: A process which requires a DPIA according to the Data Protection…"@en ;
    dcterms:source <https://w3id.org/dpv/legal/sk#DPIARequiredList> ;
