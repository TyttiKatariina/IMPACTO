    dcterms:source impacto:SourceEE ;
    rdfs:subClassOf risk:FinancialLoss ;
    skos:broader risk:FinancialLoss ;
    skos:definition "Loss of property"@en ;
    skos:notation "C101" ;
    skos:prefLabel "Property Loss"@en .

impacto:PublicUtilityProvider a owl:Class,
        skos:Concept ;
    rdfs:label "Public Utility Provider"@en ;
    dcterms:source impacto:SourceBE,
        impacto:SourceGR,
        impacto:SourceHR,
