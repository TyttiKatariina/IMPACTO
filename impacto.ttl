impacto:Automated a owl:Class,
        skos:Concept ;
    rdfs:label "Automated"@en ;
    rdfs:subClassOf dpv:ProcessingContext ;
    skos:broader dpv:ProcessingContext ;
    skos:definition "Processing context indicating that automation is involved; parent concept for all automation-related processing contexts"@en ;
    skos:prefLabel "Automated"@en .

impacto:BadConduct a owl:Class,
        skos:Concept ;
    rdfs:label "Bad Conduct"@en ;
    dcterms:source impacto:SourceAll ;
    rdfs:subClassOf impacto:Conduct ;
    skos:broader impacto:Conduct ;
    skos:definition "Broader term than criminal offences or unlawful conduct. It can include behaviour that may not be illegal but is still considered ethically or professionally inappropriate, controversial, or reputationally damaging"@en ;
    skos:notation "C9" ;
    skos:prefLabel "Bad Conduct"@en .

impacto:CentralisedLocation a owl:Class,
        skos:Concept ;
    rdfs:label "Centralised Location"@en ;
    dcterms:source impacto:SourceDE,
        impacto:SourceSI ;
    rdfs:subClassOf dpv:LocationFixture ;
    skos:broader dpv:LocationFixture ;
    skos:definition "A physical or digital point where data is collected and aggregated from multiple sources, typically involving centralised sensors or mobile-based systems for large-scale monitoring or control"@en ;
    skos:notation "C62" ;
    skos:prefLabel "Centralised Location"@en .

impacto:ClassificationOfIndividuals a owl:Class,
        skos:Concept ;
    rdfs:label "Classification Of Individuals"@en ;
    dcterms:source impacto:SourceAT,
        impacto:SourceHU,
        impacto:SourcePL ;
    rdfs:subClassOf dpv:ProcessingContext ;
    skos:broader dpv:ProcessingContext ;
    skos:definition "Processing that evaluates, ranks, or categorises natural persons, often based on behavioural, demographic, or personal data"@en ;
    skos:notation "C48" ;
    skos:prefLabel "Classification Of Individuals"@en ;
    skos:scopeNote "Phrasing follows Article 29 Data Protection Working Party and EDPB guidelines"@en .

impacto:Competency a owl:Class,
        skos:Concept ;
    rdfs:label "Competency"@en ;
    dcterms:source impacto:SourceIS,
        impacto:SourceNO,
        impacto:SourcePL ;
    rdfs:subClassOf pd:External ;
    skos:broader pd:External ;
    skos:definition "Personal data used in the systematic evaluation of an individual's overall effectiveness in applying knowledge and skills, including professional qualifications, behavioural performance, and domain-specific expertise"@en ;
    skos:notation "C45" ;
    skos:prefLabel "Competency"@en .

impacto:ContractExclusion a owl:Class,
        skos:Concept ;
    rdfs:label "Contract Exclusion"@en ;
    dcterms:source impacto:SourceBE,
        impacto:SourceCY,
        impacto:SourceES,
        impacto:SourceFR,
        impacto:SourceGR,
        impacto:SourceHR,
        impacto:SourceIS,
        impacto:SourceIT,
        impacto:SourceLI,
        impacto:SourceSE,
        impacto:SourceSI ;
    rdfs:subClassOf impacto:ImpactOnContract ;
    skos:broader impacto:ImpactOnContract ;
    skos:definition "Where an individual or an organisation is denied the opportunity to enter into a contract"@en ;
    skos:notation "C20" ;
    skos:prefLabel "Contract Exclusion"@en .

impacto:ContractSuspension a owl:Class,
        skos:Concept ;
    rdfs:label "Contract Suspension"@en ;
    dcterms:source impacto:SourceBE,
        impacto:SourceCY,
        impacto:SourceES,
        impacto:SourceFR,
        impacto:SourceGR,
        impacto:SourceHR,
        impacto:SourceIS,
        impacto:SourceIT,
        impacto:SourceLI,
        impacto:SourceSE,
        impacto:SourceSI ;
    rdfs:subClassOf impacto:ImpactOnContract ;
    skos:broader impacto:ImpactOnContract ;
    skos:definition "Where an existing contract is temporarily halted or rendered inactive, such as due to suspicion of fraud, violation of terms, or negative behavioural indicators"@en ;
    skos:notation "C20" ;
    skos:prefLabel "Contract Suspension"@en .

impacto:ContractTerminated a owl:Class,
        skos:Concept ;
    rdfs:label "Contract Terminated"@en ;
    dcterms:source impacto:SourceBE,
        impacto:SourceCY,
        impacto:SourceES,
        impacto:SourceFR,
        impacto:SourceGR,
        impacto:SourceHR,
        impacto:SourceIS,
        impacto:SourceIT,
        impacto:SourceLI,
        impacto:SourceSE,
        impacto:SourceSI ;
    rdfs:subClassOf impacto:ImpactOnContract ;
    skos:broader impacto:ImpactOnContract ;
    skos:definition "Where an existing contract is cancelled or terminated, such as by revoking a loan, ending a subscription, or dismissing an employee"@en ;
    skos:notation "C20, C52" ;
    skos:prefLabel "Contract Terminated"@en .

impacto:DigitalTwin a owl:Class,
        skos:Concept ;
    rdfs:label "Digital Twin"@en ;
    dcterms:source impacto:SourceDK ;
    rdfs:subClassOf pd:External ;
    skos:broader pd:External ;
    skos:definition "A digital representation of a real-world person or system, where personal data is processed to simulate, predict, or monitor behaviour, performance, or health"@en ;
    skos:notation "C84" ;
    skos:prefLabel "Digital Twin"@en .

impacto:ElectronicHealthCard a owl:Class,
        skos:Concept ;
    rdfs:label "Electronic Health Card"@en ;
    dcterms:source impacto:SourceFR,
        impacto:SourceGR,
        impacto:SourceHU,
        impacto:SourceNL ;
    rdfs:subClassOf pd:HealthRecord ;
    skos:broader pd:HealthRecord ;
    skos:definition "A digital or physical card used to store or provide access to personal health data, as part of large-scale systematic processing for public health purposes, including integration with electronic prescription and health record systems"@en ;
    skos:notation "C39" ;
    skos:prefLabel "Electronic Health Card"@en .

impacto:ElectronicHealthRecord a owl:Class,
        skos:Concept ;
    rdfs:label "Electronic Health Record"@en ;
    dcterms:source impacto:SourceFR,
        impacto:SourceGR,
        impacto:SourceHU,
        impacto:SourceNL ;
    rdfs:subClassOf pd:HealthRecord ;
    skos:broader pd:HealthRecord ;
    skos:definition "A digital record of a patient's medical history, diagnoses, medications, treatment plans, and other health-related information"@en ;
    skos:notation "C39" ;
    skos:prefLabel "Electronic Health Record"@en .

impacto:ElectronicPrescriptionSystem a owl:Class,
        skos:Concept ;
    rdfs:label "Electronic Prescription System"@en ;
    dcterms:source impacto:SourceFR,
        impacto:SourceGR,
        impacto:SourceHU,
        impacto:SourceNL ;
    rdfs:subClassOf tech:System ;
    skos:broader tech:System ;
    skos:definition "A system used by healthcare providers to create, transmit, and manage electronic prescriptions as part of large-scale systematic health data processing"@en ;
    skos:notation "C39" ;
    skos:prefLabel "Electronic Prescription System"@en .

impacto:FacialRecognitionTechnology a owl:Class,
        skos:Concept ;
    rdfs:label "Facial Recognition Technology"@en ;
    dcterms:source impacto:SourceCY,
        impacto:SourceDK,
        impacto:SourceIT,
        impacto:SourcePL,
        impacto:SourceRO ;
    rdfs:subClassOf tech:Capability ;
    skos:broader tech:Capability ;
    skos:definition "A biometric identification system that detects, captures, and compares facial features to identify or verify individuals in real-time or retrospectively, as defined in the EU AI Act"@en ;
    skos:notation "C36" ;
    skos:prefLabel "Facial Recognition Technology"@en ;
    skos:scopeNote "Proposed as rename/replacement of current tech:FaceRecognition to align with EU AI Act terminology"@en .

impacto:FileSystem a owl:Class,
        skos:Concept ;
    rdfs:label "File System"@en ;
    dcterms:source impacto:SourceLU ;
    rdfs:subClassOf tech:System ;
    skos:broader tech:System ;
    skos:definition "A structured set of personal data that is accessible according to specific criteria, whether centralised, decentralised, or dispersed functionally or geographically, as defined in the GDPR"@en ;
    skos:notation "C79" ;
    skos:prefLabel "File System"@en .

impacto:HealthcareLocation a owl:Class,
        skos:Concept ;
    rdfs:label "Healthcare Location"@en ;
    dcterms:source impacto:SourceLV,
        impacto:SourceNL ;
    rdfs:subClassOf dpv:LocationLocality ;
    skos:broader dpv:LocationLocality ;
    skos:definition "A place where healthcare is provided to individuals"@en ;
    skos:notation "C57" ;
    skos:prefLabel "Healthcare Location"@en ;
    skos:scopeNote "Context: continuous or large-scale observation of individuals in sensitive contexts involving protected or vulnerable populations"@en .

impacto:HistoricalResearch a owl:Class,
        skos:Concept ;
    rdfs:label "Historical Research"@en ;
    dcterms:source impacto:SourceLT,
        impacto:SourceLU,
        impacto:SourceLV,
        impacto:SourceNO,
        impacto:SourcePT,
        impacto:SourceSK ;
    rdfs:subClassOf dpv:ResearchAndDevelopment ;
    skos:broader dpv:ResearchAndDevelopment ;
    skos:definition "The processing of personal data for scientific or historical research purposes, conducted without the data subject's consent, and in conjunction with at least one of the legal criteria under the GDPR, such as being necessary for a task carried out in the public interest"@en ;
    skos:notation "C30" ;
    skos:prefLabel "Historical Research"@en .

impacto:InPersonalSpace a owl:Class,
        skos:Concept ;
    rdfs:label "In Personal Space"@en ;
    dcterms:source impacto:SourceAT ;
    rdfs:subClassOf dpv:LocationLocality ;
    skos:broader dpv:LocationLocality ;
    skos:definition "Refers to private areas such as homes or personal environments, where data processing even with consent may infringe on privacy due to the sensitive nature of the setting"@en ;
    skos:notation "C90" ;
    skos:prefLabel "In Personal Space"@en .

impacto:InPublicTransport a owl:Class,
        skos:Concept ;
    rdfs:label "In Public Transport"@en ;
    dcterms:source impacto:SourceAT,
        impacto:SourceCY,
        impacto:SourceFR,
        impacto:SourcePL ;
    rdfs:subClassOf dpv:PubliclyAccessibleSpace ;
    skos:broader dpv:PubliclyAccessibleSpace ;
    skos:definition "Vehicles and infrastructures used for public travel, such as buses, trains, metro, and stations, where individuals are subject to monitoring or data processing"@en ;
    skos:notation "C43" ;
    skos:prefLabel "In Public Transport"@en .

impacto:LabourBrokeringService a owl:Class,
        skos:Concept ;
    rdfs:label "Labour Brokering Service"@en ;
    dcterms:source impacto:SourceEE ;
    rdfs:subClassOf dpv:HumanResourceManagement ;
    skos:broader dpv:HumanResourceManagement ;
    skos:definition "Service that facilitates labour provision through a brokering process, including matching workers with jobs or facilitating labour based on demand"@en ;
    skos:notation "C105" ;
    skos:prefLabel "Labour Brokering Service"@en .

impacto:LocationDisplacement a owl:Class,
        skos:Concept ;
    rdfs:label "Location Displacement"@en ;
    dcterms:source impacto:SourceBE ;
    rdfs:subClassOf pd:External ;
    skos:broader pd:External ;
    skos:definition "Personal data processed to analyse or predict a person's change in location, movement patterns, or relocation behaviours, often linked to economic or social factors"@en ;
    skos:notation "C87" ;
    skos:prefLabel "Location Displacement"@en .

impacto:LocationRoute a owl:Class,
        skos:Concept ;
    rdfs:label "Location Route"@en ;
    dcterms:source impacto:SourceEE,
        impacto:SourceNO ;
    rdfs:subClassOf pd:Location ;
    skos:broader pd:Location ;
    skos:definition "Personal data representing an individual's travel path or movement behaviour, processed to predict interests, routines, or mobility patterns"@en ;
    skos:notation "C61" ;
    skos:prefLabel "Location Route"@en .

impacto:ManageSocialHousing a owl:Class,
        skos:Concept ;
    rdfs:label "Manage Social Housing"@en ;
    dcterms:source impacto:SourceFR ;
    rdfs:subClassOf <https://w3id.org/dpv/sector/publicservices#SocialWelfareProvision> ;
    skos:broader <https://w3id.org/dpv/sector/publicservices#SocialWelfareProvision> ;
    skos:definition "Processing data for the assessment, approval, and management of social housing applications, typically by public authorities or welfare organisations"@en ;
    skos:notation "C77" ;
    skos:prefLabel "Manage Social Housing"@en .

impacto:MedicalSupportService a owl:Class,
        skos:Concept ;
    rdfs:label "Medical Support Service"@en ;
    dcterms:source impacto:SourceFR ;
    rdfs:subClassOf <https://w3id.org/dpv/sector/health#ServiceProvision> ;
    skos:broader <https://w3id.org/dpv/sector/health#ServiceProvision> ;
    skos:definition "Service that facilitates providing healthcare and related support, interventions, or assessments"@en ;
    skos:notation "C76" ;
    skos:prefLabel "Medical Support Service"@en .

impacto:Neurotechnology a owl:Class,
        skos:Concept ;
    rdfs:label "Neurotechnology"@en ;
    dcterms:source impacto:SourceDK ;
    rdfs:subClassOf dpv:Technology ;
    skos:broader dpv:Technology ;
    skos:definition "A technology that processes neural or brain-derived data, enabling applications in healthcare, human enhancement, or cognitive monitoring"@en ;
    skos:notation "C85" ;
    skos:prefLabel "Neurotechnology"@en .

impacto:NonDataSubjectDataSource a owl:Class,
        skos:Concept ;
    rdfs:label "Non Data Subject Data Source"@en ;
    dcterms:source impacto:SourceAT,
        impacto:SourceCZ,
        impacto:SourceDE,
        impacto:SourceES,
        impacto:SourceGR,
        impacto:SourceLT ;
    rdfs:subClassOf dpv:DataSource ;
    skos:broader dpv:DataSource ;
    skos:definition "Personal data obtained from a third party or another source rather than directly from the individual concerned, especially in cases where informing the data subject would be difficult or impossible, such as in law enforcement, research, or archival processing"@en ;
    skos:notation "C25" ;
    skos:prefLabel "Non Data Subject Data Source"@en ;
    skos:scopeNote "Existing non-data subject sources in DPV should be moved below this concept"@en .

impacto:OnPublicRoad a owl:Class,
        skos:Concept ;
    rdfs:label "On Public Road"@en ;
    dcterms:source impacto:SourceAT,
        impacto:SourceCY,
        impacto:SourceFR,
        impacto:SourcePL ;
    rdfs:subClassOf dpv:PubliclyAccessibleSpace ;
    skos:broader dpv:PubliclyAccessibleSpace ;
    skos:definition "Any location accessible to the general public, particularly roads and streets used by public or private transportation, where monitoring or control of individuals is conducted via processing operations such as video surveillance or traffic sensors"@en ;
    skos:notation "C43" ;
    skos:prefLabel "On Public Road"@en ;
    skos:scopeNote "Proposed as subclass of dpv:PubliclyAccessibleSpace pending group discussion on modelling specific locations"@en .

impacto:Predict a owl:Class,
        skos:Concept ;
    rdfs:label "Predict"@en ;
    dcterms:source impacto:SourceEDPB ;
    rdfs:subClassOf dpv:Infer ;
    skos:broader dpv:Infer ;
    skos:definition "To anticipate or forecast aspects of an individual's behaviour, characteristics, or future actions"@en ;
    skos:notation "C14, C37, C73" ;
    skos:prefLabel "Predict"@en .

impacto:PreventativeProtectionOfPersons a owl:Class,
        skos:Concept ;
    rdfs:label "Preventative Protection Of Persons"@en ;
    rdfs:subClassOf dpv:EnforceSecurity ;
    skos:broader dpv:EnforceSecurity ;
    skos:definition "Processing carried out for the purpose of preventing harm or protecting individuals before an incident occurs"@en ;
    skos:prefLabel "Preventative Protection Of Persons"@en .

impacto:PreventativeProtectionOfProperty a owl:Class,
        skos:Concept ;
    rdfs:label "Preventative Protection Of Property"@en ;
    rdfs:subClassOf dpv:EnforceSecurity ;
    skos:broader dpv:EnforceSecurity ;
    skos:definition "Processing carried out for the purpose of preventing loss or damage to property before an incident occurs"@en ;
    skos:prefLabel "Preventative Protection Of Property"@en .

impacto:Prison a owl:Class,
        skos:Concept ;
    rdfs:label "Prison"@en ;
    dcterms:source impacto:SourceLV,
        impacto:SourceNL ;
    rdfs:subClassOf dpv:LocationLocality ;
    skos:broader dpv:LocationLocality ;
