    rdfs:subClassOf impacto-old:AssessmentObligationSource ;
    skos:broader impacto-old:AssessmentObligationSource ;
    skos:definition "Guidance issued by a supervisory or market surveillance authority, or by the EDPB or AI Office."@en ;
    skos:prefLabel "Regulatory Guidance"@en .

impacto-old:ReuseLevel a rdfs:Class,
        skos:Concept ;
    rdfs:label "Reuse Level"@en ;
    skos:definition "The extent to which DPIA content can satisfy a FRIA information requirement."@en ;
    skos:prefLabel "Reuse Level"@en .

impacto-old:ReviewStage a rdfs:Class,
        skos:Concept ;
    rdfs:label "Review Stage"@en ;
    dcterms:source "AI Act Art.27(2)"@en,
        "GDPR Art.35(11)"@en ;
    rdfs:subClassOf impacto-old:AssessmentStage ;
    skos:broader impacto-old:AssessmentStage ;
    skos:definition "The stage in which an existing assessment is reviewed and updated because the risk or the use has changed. In the AI Act this also covers relying on a previously conducted FRIA and updating outdated elements."@en ;
    skos:prefLabel "Review Stage"@en .

impacto-old:RiskAssessmentStage a rdfs:Class,
        skos:Concept ;
    rdfs:label "Risk Assessment Stage"@en ;
