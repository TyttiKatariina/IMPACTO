    rdfs:label "AI System Not Exempt"@en ;
    rdfs:subClassOf impacto-old:eu-aiact-FRIAExemptions ;
    skos:broader impacto-old:eu-aiact-FRIAExemptions ;
    skos:definition "A determination that no exemption from the FRIA obligation applies to the deployment of the AI system."@en ;
    skos:prefLabel "AI System Not Exempt"@en ;
    skos:scopeNote "Proposed for: DPV EU AI Act extension (eu-aiact)"@en .

impacto-old:eu-aiact-NotHighRiskAISystem a rdfs:Class,
        skos:Concept ;
    rdfs:label "Not High Risk AI System"@en ;
    rdfs:subClassOf impacto-old:eu-aiact-FRIANecessityDetermination ;
    skos:broader impacto-old:eu-aiact-FRIANecessityDetermination ;
    skos:closeMatch eu-aiact:RiskLevelNotHigh ;
    skos:definition "A determination that the AI system is not a high-risk AI system, so that the FRIA obligation under Article 27 does not apply."@en ;
    skos:prefLabel "Not High Risk AI System"@en ;
    skos:scopeNote "Proposed for: DPV EU AI Act extension (eu-aiact)"@en .

impacto-old:eu-aiact-PeriodOfUse a rdfs:Class,
        skos:Concept ;
    rdfs:label "Period Of Use"@en ;
    dcterms:source "AI Act Art. 27(1)(b)"@en ;
    rdfs:seeAlso <https://eur-lex.europa.eu/eli/reg/2024/1689/oj/eng> ;
    rdfs:subClassOf dpv:Technology ;
    skos:broader dpv:Technology ;
    skos:definition "The period of time within which the high-risk AI system is intended to be used."@en ;
    skos:prefLabel "Period Of Use"@en ;
    skos:scopeNote "Proposed for: DPV EU AI Act extension (eu-aiact)"@en .

impacto-old:eu-aiact-PotentiallyHighRiskAISystem a rdfs:Class,
        skos:Concept ;
    rdfs:label "Potentially High Risk AI System"@en ;
    dcterms:source "AI Act Art. 6(3)"@en ;
    rdfs:seeAlso <https://eur-lex.europa.eu/eli/reg/2024/1689/oj/eng> ;
    rdfs:subClassOf impacto-old:eu-aiact-FRIANecessityDetermination ;
    skos:broader impacto-old:eu-aiact-FRIANecessityDetermination ;
    skos:definition "A determination that the AI system may be a high-risk AI system, pending further assessment, for example of whether the derogation in Article 6(3) applies."@en ;
    skos:prefLabel "Potentially High Risk AI System"@en ;
    skos:scopeNote "Proposed for: DPV EU AI Act extension (eu-aiact)"@en .

impacto-old:eu-aiact-ProcessDescription a rdfs:Class,
