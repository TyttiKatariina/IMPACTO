    dcterms:source "CN31"@en ;
    rdfs:subClassOf dpv:Purpose ;
    skos:definition "The settlement of monetary benefits such as fees and reimbursements owed to participants."@en .

dpv:MoreThan250Employees a rdfs:Class,
        skos:Concept ;
    rdfs:label "More Than 250 Employees"@en ;
    dcterms:source "CN40"@en ;
    rdfs:subClassOf dpv:Scale ;
    skos:definition "A scale indicating that the organisation carrying out the processing employs 250 or more people."@en .

dpv:Municipalities a rdfs:Class,
        skos:Concept ;
    rdfs:label "Municipalities"@en ;
    dcterms:source "CN26"@en ;
