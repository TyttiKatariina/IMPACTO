    skos:broader impacto-old:eu-aiact-FRIATemplate ;
    skos:definition "A questionnaire through which a deployer documents its assessment of impacts on fundamental rights, based on the template provided by the AI Office."@en ;
    skos:prefLabel "Rights Questionnaire"@en ;
    skos:scopeNote "Proposed for: DPV EU AI Act extension (eu-aiact)"@en .

impacto-old:eu-gdpr-DPIANotRequired a rdfs:Class,
        skos:Concept ;
    rdfs:label "DPIA Not Required"@en ;
    dcterms:source "GDPR Art. 35(5)"@en ;
    rdfs:seeAlso <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX%3A32016R0679> ;
    rdfs:subClassOf eu-gdpr:DPIANecessityStatus ;
    skos:broader eu-gdpr:DPIANecessityStatus ;
    skos:definition "Status indicating that a DPIA is not required for the processing, for example because it is not likely to result in a high risk or because it appears on a supervisory authority list under GDPR Article 35(5)."@en ;
    skos:prefLabel "DPIA Not Required"@en ;
    skos:scopeNote "Proposed for: DPV GDPR extension (eu-gdpr)"@en .

impacto-old:eu-gdpr-DPIANotRequiredProcess a rdfs:Class,
        skos:Concept ;
    rdfs:label "DPIA Not Required Process"@en ;
    dcterms:source "GDPR Art. 35(5); Member State DPA Not-Required Lists (AT, CZ, FR, HR, IT, LV, NL, ES)"@en ;
    rdfs:seeAlso <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX%3A32016R0679> ;
    rdfs:subClassOf impacto-old:eu-gdpr-DPIAProcess ;
    skos:broader impacto-old:eu-gdpr-DPIAProcess ;
    skos:definition "A personal data processing activity that does not require a DPIA according to the whitelists of processing activities published by Member State Data Protection Authorities."@en ;
    skos:prefLabel "DPIA Not Required Process"@en ;
    skos:scopeNote "Proposed for: DPV GDPR extension (eu-gdpr)"@en .

impacto-old:eu-gdpr-DPIAProcess a rdfs:Class,
        skos:Concept ;
    rdfs:label "DPIA Process"@en ;
    dcterms:source "GDPR Art. 35"@en ;
    rdfs:seeAlso <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX%3A32016R0679> ;
    rdfs:subClassOf dpv:Process ;
    skos:broader dpv:Process ;
    skos:definition "The process of conducting a DPIA that has two outcomes, either a DPIA is required and is conducted, or a DPIA is not required and is therefore not conducted."@en ;
    skos:prefLabel "DPIA Process"@en ;
    skos:scopeNote "Proposed for: DPV GDPR extension (eu-gdpr)"@en .

impacto-old:eu-gdpr-DPIARequiredProcess a rdfs:Class,
        skos:Concept ;
    rdfs:label "DPIA Required Process"@en ;
    dcterms:source "GDPR Art. 35"@en ;
    rdfs:seeAlso <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX%3A32016R0679> ;
    rdfs:subClassOf impacto-old:eu-gdpr-DPIAProcess ;
    skos:broader impacto-old:eu-gdpr-DPIAProcess ;
    skos:definition "A personal data processing activity that requires a DPIA according to GDPR Article 35."@en ;
    skos:prefLabel "DPIA Required Process"@en ;
    skos:scopeNote "Proposed for: DPV GDPR extension (eu-gdpr)"@en,
        "The requirements for whether a DPIA is required for a specific process can be found in GDPR Art 35 and also in specific lists published by Member State Data Protection Authorities."@en .

impacto-old:eu-gdpr-DPIAReviewComplete a rdfs:Class,
        skos:Concept ;
    rdfs:label "DPIA Review Complete"@en ;
    dcterms:source "GDPR Art. 35(11)"@en ;
    rdfs:seeAlso <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX%3A32016R0679> ;
    rdfs:subClassOf impacto-old:eu-gdpr-DPIAReviewStatus ;
    skos:broader impacto-old:eu-gdpr-DPIAReviewStatus ;
    skos:definition "Status reflecting a review has been carried out by the controller, where necessary, to assess whether processing is performed in accordance with the DPIA, at least when there is a change in the risk represented by the processing operations."@en ;
    skos:prefLabel "DPIA Review Complete"@en ;
    skos:scopeNote "Proposed for: DPV EU GDPR (eu-gdpr)"@en .

impacto-old:eu-gdpr-DPIAReviewPending a rdfs:Class,
