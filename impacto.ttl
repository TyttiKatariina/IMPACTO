<https://w3id.org/dpv/legal/ie#C14a> a impacto-old:AssessmentTriggerCondition,
        impacto-old:DPIARequiredCondition,
        impacto-old:eu-gdpr-DPIARequiredProcess,
        eu-gdpr:DPIARequiredProcess ;
    rdfs:label "IE C14a: A process which requires a DPIA according to the Data Protection…"@en ;
