    dcterms:source "CN17"@en ;
    rdfs:subClassOf dpv:PhysicalMeasure ;
    skos:definition "A measure serving the preventive protection of persons on private property used for residential purposes."@en .

dpv:PetitionOrganisers a rdfs:Class,
        skos:Concept ;
    rdfs:label "Petition Organisers"@en ;
    dcterms:source "CN24"@en ;
