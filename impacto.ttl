    dcterms:source "CN16"@en ;
    rdfs:subClassOf loc:Locality ;
    skos:definition "A public area included within a monitored space only to the limited extent that its inclusion is unavoidable."@en .

dpv:LinkingPersonalData a rdfs:Class,
