    dcterms:source "GDPR Art. 35(11)"@en ;
    rdfs:seeAlso <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX%3A32016R0679> ;
    rdfs:subClassOf dpv:Context ;
    skos:broader dpv:Context ;
    skos:definition "A categorisation of the change of risk associated with processing operations, requiring a DPIA review."@en ;
    skos:prefLabel "Risk Change Category"@en ;
    skos:scopeNote "Proposed for: DPV GDPR extension (eu-gdpr)"@en .

impacto-old:eu-gdpr-hasChangeDescription a rdfs:Class,
        skos:Concept ;
