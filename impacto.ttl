    rdfs:subClassOf impacto-old:eu-aiact-FRIAOutcomeStatus ;
    skos:broader impacto-old:eu-aiact-FRIAOutcomeStatus ;
    skos:definition "A FRIA outcome status indicating that consultation is required before a decision on deployment can be taken."@en ;
    skos:prefLabel "FRIA Requires Consultation"@en ;
    skos:scopeNote "Proposed for: DPV EU AI Act extension (eu-aiact)"@en .

impacto-old:eu-aiact-FRIARiskStatus a rdfs:Class,
        skos:Concept ;
    rdfs:label "FRIA Risk Status"@en ;
    rdfs:subClassOf dpv:AuditStatus ;
    skos:broader dpv:AuditStatus ;
    skos:definition "A status representing the level of risk to fundamental rights indicated by a FRIA."@en ;
    skos:prefLabel "FRIA Risk Status"@en ;
    skos:scopeNote "Proposed for: DPV EU AI Act extension (eu-aiact)"@en .

impacto-old:eu-aiact-FRIATemplate a rdfs:Class,
        skos:Concept ;
    rdfs:label "FRIA Template"@en ;
    dcterms:source "AI Act Art. 27(5)"@en ;
    rdfs:seeAlso <https://eur-lex.europa.eu/eli/reg/2024/1689/oj/eng> ;
    rdfs:subClassOf eu-aiact:FRIA ;
    skos:broader eu-aiact:FRIA ;
    skos:definition "The template for a questionnaire developed by the AI Office to facilitate deployers in complying with their FRIA obligations."@en ;
    skos:prefLabel "FRIA Template"@en ;
    skos:scopeNote "Proposed for: DPV EU AI Act extension (eu-aiact)"@en .

impacto-old:eu-aiact-FRIAUpdateComplete a rdfs:Class,
        skos:Concept ;
    rdfs:label "FRIA Update Complete"@en ;
    dcterms:source "AI Act Art. 27(2)"@en ;
    rdfs:seeAlso <https://eur-lex.europa.eu/eli/reg/2024/1689/oj/eng> ;
    rdfs:subClassOf impacto-old:eu-aiact-FRIAUpdateStatus ;
    skos:broader impacto-old:eu-aiact-FRIAUpdateStatus ;
    skos:definition "Status reflecting a review has been carried out by the deployer if any elements listed in Art. 27(1) have changed or are no longer up to date."@en ;
    skos:prefLabel "FRIA Update Complete"@en ;
    skos:scopeNote "Proposed for: DPV EU AI Act (eu-aiact)"@en .

impacto-old:eu-aiact-FRIAUpdatePending a rdfs:Class,
        skos:Concept ;
    rdfs:label "FRIA Update Pending"@en ;
    dcterms:source "AI Act Art. 27(2)"@en ;
    rdfs:seeAlso <https://eur-lex.europa.eu/eli/reg/2024/1689/oj/eng> ;
    rdfs:subClassOf impacto-old:eu-aiact-FRIAUpdateStatus ;
    skos:broader impacto-old:eu-aiact-FRIAUpdateStatus ;
    skos:definition "Status reflecting a review is still pending and waiting to been carried out by the deployer if any elements listed in Art. 27(1) have changed or are no longer up to date."@en ;
    skos:prefLabel "FRIA Update Pending"@en ;
    skos:scopeNote "Proposed for: DPV EU AI Act (eu-aiact)"@en .

impacto-old:eu-aiact-FRIAUpdateStatus a rdfs:Class,
        skos:Concept ;
    rdfs:label "FRIA Update Status"@en ;
    dcterms:source "AI Act Art. 27(2)"@en ;
    rdfs:seeAlso <https://eur-lex.europa.eu/eli/reg/2024/1689/oj/eng> ;
    rdfs:subClassOf eu-aiact:FRIA ;
    skos:broader eu-aiact:FRIA ;
    skos:definition "Status reflecting the deployers need to update the information in the FRIA if any elements listed in Art. 27(1) have changed or are no longer up to date."@en ;
    skos:prefLabel "FRIA Update Status"@en ;
    skos:scopeNote "Proposed for: DPV EU AI Act (eu-aiact)"@en .

impacto-old:eu-aiact-FrequencyOfUse a rdfs:Class,
        skos:Concept ;
    rdfs:label "Frequency Of Use"@en ;
    dcterms:source "AI Act Art. 27(1)(b)"@en ;
    rdfs:seeAlso <https://eur-lex.europa.eu/eli/reg/2024/1689/oj/eng> ;
    rdfs:subClassOf dpv:Technology ;
    skos:broader dpv:Technology ;
    skos:definition "The frequency with which the high-risk AI system is intended to be used."@en ;
    skos:prefLabel "Frequency Of Use"@en ;
    skos:scopeNote "Proposed for: DPV EU AI Act extension (eu-aiact)"@en .

impacto-old:eu-aiact-HighRiskAISystem a rdfs:Class,
        skos:Concept ;
    rdfs:label "High Risk AI System"@en ;
    dcterms:source "AI Act Art. 6(2), Art. 27(1)"@en ;
    rdfs:seeAlso <https://eur-lex.europa.eu/eli/reg/2024/1689/oj/eng> ;
    rdfs:subClassOf impacto-old:eu-aiact-FRIANecessityDetermination ;
    skos:broader impacto-old:eu-aiact-FRIANecessityDetermination ;
    skos:definition "A determination that the AI system is a high-risk AI system referred to in AI Act Article 6(2), bringing its deployment within the scope of Article 27."@en ;
    skos:editorialNote "The published IMPACTO term and the DPV AI Act term denote the same class. DPV additionally subdivides it by Article 6(1), Article 6(2) and each Annex III point, which IMPACTO's conditions rely on."@en ;
    skos:exactMatch eu-aiact:HighRiskAISystem ;
    skos:prefLabel "High Risk AI System"@en ;
    skos:scopeNote "Proposed for: DPV EU AI Act extension (eu-aiact)"@en .

impacto-old:eu-aiact-ImpactAssessmentReuse a rdfs:Class,
        skos:Concept ;
    rdfs:label "Impact Assessment Reuse"@en ;
    dcterms:source "AI Act Art. 27(2)"@en ;
    rdfs:seeAlso <https://eur-lex.europa.eu/eli/reg/2024/1689/oj/eng> ;
    rdfs:subClassOf eu-aiact:FRIA ;
    skos:broader eu-aiact:FRIA ;
    skos:definition "The reuse of an existing and previously conducted impact assessment as input in a FRIA."@en ;
    skos:prefLabel "Impact Assessment Reuse"@en ;
    skos:scopeNote "Proposed for: DPV EU AI Act extension (eu-aiact)"@en .

impacto-old:eu-aiact-IntendedUse a rdfs:Class,
        skos:Concept ;
    rdfs:label "Intended Use"@en ;
    dcterms:source "AI Act Art. 27(1)(b)"@en ;
    rdfs:seeAlso <https://eur-lex.europa.eu/eli/reg/2024/1689/oj/eng> ;
    rdfs:subClassOf dpv:Technology ;
    skos:broader dpv:Technology ;
    skos:definition "The contextual application of an AI system's intended purpose in a specific deployment scenario. Distinct from eu-aiact:IntendedPurpose in that the same AI system with one intended purpose may have multiple intended uses, varying by input/output data, human subjects involved, or hardware and software used."@en ;
    skos:prefLabel "Intended Use"@en ;
    skos:scopeNote "Distinct from eu-aiact:IntendedPurpose: while an AI system has a single intended purpose, it may have multiple intended uses depending on deployment context."@en,
        "Proposed for: DPV EU AI Act extension (eu-aiact)"@en .

impacto-old:eu-aiact-InternalGovernanceMeasures a rdfs:Class,
        skos:Concept ;
    rdfs:label "Internal Governance Measures"@en ;
    dcterms:source "AI Act Art. 27(1)(f)"@en ;
    rdfs:seeAlso <https://eur-lex.europa.eu/eli/reg/2024/1689/oj/eng> ;
    rdfs:subClassOf dpv:AIGovernance ;
    skos:broader dpv:AIGovernance ;
    skos:definition "Arrangements for internal governance to be taken by the deployer in the case of the materialisation of risks to fundamental rights."@en ;
    skos:prefLabel "Internal Governance Measures"@en ;
    skos:scopeNote "Proposed for: DPV EU AI Act extension (eu-aiact)"@en .

impacto-old:eu-aiact-NotExempt a rdfs:Class,
