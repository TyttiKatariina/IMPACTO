    dcterms:source "CN37"@en ;
    rdfs:subClassOf dpv:LegalEntity ;
    skos:definition "An individual healthcare practitioner working on a self-employed basis in the exercise of their professional duties."@en .

dpv:SelfEmployedHealthcareProfessional a rdfs:Class,
        skos:Concept ;
