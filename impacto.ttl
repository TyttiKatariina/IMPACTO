    skos:broader impacto-old:AssessmentStage ;
    skos:definition "The stage identifying and evaluating risks: risks to the rights and freedoms of data subjects in a DPIA, risks of harm to affected persons and groups in a FRIA."@en ;
    skos:prefLabel "Risk Assessment Stage"@en ;
    impacto-old:hasStage_Requirement impacto-old:DPIA-IR-A357c,
        impacto-old:FRIA-IR-c,
        impacto-old:FRIA-IR-d .

impacto-old:ai-AISubject a rdfs:Class,
        skos:Concept ;
    rdfs:label "AI Subject"@en ;
    dcterms:source "AI Act Art. 27(1)(c)"@en ;
    rdfs:seeAlso <https://eur-lex.europa.eu/eli/reg/2024/1689/oj/eng> ;
    rdfs:subClassOf ai:AI ;
    skos:broader ai:AI ;
    skos:definition "A natural person or group of persons that is subject to, or affected by, the use of an AI system."@en ;
    skos:prefLabel "AI Subject"@en ;
    skos:scopeNote "Proposed for: DPV AI extension (ai)"@en .

impacto-old:ai-NaturalPersonCategorySubjects a rdfs:Class,
        skos:Concept ;
