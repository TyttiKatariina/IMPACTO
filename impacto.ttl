    skos:prefLabel "Predetermined Risk Change"@en ;
    skos:scopeNote "Proposed for: DPV GDPR extension (eu-gdpr)"@en .

impacto-old:eu-gdpr-RiskChangeCategory a rdfs:Class,
        skos:Concept ;
