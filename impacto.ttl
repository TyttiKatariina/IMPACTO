dpv:OfferOfProducts a rdfs:Class,
        skos:Concept ;
    rdfs:label "Offer Of Products"@en ;
    dcterms:source "CN36"@en ;
    rdfs:subClassOf dpv:ServiceProvision ;
    skos:definition "The display or offering of products to a customer, for example through items placed on a controller's website."@en .

dpv:OrganisationalTransactions a rdfs:Class,
        skos:Concept ;
    rdfs:label "Organisational Transactions"@en ;
    dcterms:source "CN5"@en ;
    rdfs:subClassOf dpv:Data ;
    skos:definition "Data recording the business transactions of an organisation, as distinct from transaction data relating to an individual."@en ;
    skos:scopeNote "Proposed as part of a possible group of data categories relating to an organisation or business rather than to an individual."@en .

dpv:OwnerAssociation a rdfs:Class,
        skos:Concept ;
