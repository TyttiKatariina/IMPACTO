    dcterms:source "CN22"@en ;
    rdfs:subClassOf dpv:Organisation ;
    skos:definition "A professional providing tax advice and related services to clients."@en .

dpv:TemporaryStaff a rdfs:Class,
        skos:Concept ;
    rdfs:label "Temporary Staff"@en ;
    dcterms:source "CN7"@en ;
    rdfs:subClassOf dpv:Entity ;
    skos:definition "A person engaged by an organisation on a temporary basis."@en .

dpv:TravelOrganisation a rdfs:Class,
        skos:Concept ;
    rdfs:label "Travel Organisation"@en ;
    dcterms:source "CN31"@en ;
    rdfs:subClassOf dpv:EventManagement ;
