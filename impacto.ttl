impacto-old:DPIASource-A35 a impacto-old:LegislativeSource ;
    rdfs:label "GDPR Article 35"@en ;
    dcterms:identifier "Regulation (EU) 2016/679, Article 35" ;
    skos:definition "The provision establishing the obligation to conduct a data protection impact assessment."@en ;
    skos:prefLabel "GDPR Article 35"@en .

impacto-old:F2 a impacto-old:FRIARequiredCondition ;
    rdfs:label "Private entity providing public services deploying an Annex III system"@en ;
    dcterms:source "AI Act Art.27(1)"@en ;
    skos:definition "A FRIA is required because the deployer is a private entity providing public services and the system is high-risk under Article 6(2), other than a system in the area listed in Annex III point 2."@en ;
    skos:prefLabel "Private entity providing public services deploying an Annex III system"@en ;
    impacto-old:excludesAISystemType eu-aiact:HighRiskAISystem-AnnexIII-2 ;
    impacto-old:hasObligationSource impacto-old:FRIASource-A27 ;
    impacto-old:requiresAISystemType eu-aiact:HighRiskAISystem-A6-2 ;
    impacto-old:requiresDeployerType impacto-old:PrivateEntityProvidingPublicService .

impacto-old:F4 a impacto-old:FRIARequiredCondition ;
    rdfs:label "Any deployer of a life or health insurance risk and pricing system"@en ;
    dcterms:source "AI Act Art.27(1)"@en ;
    skos:definition "A FRIA is required because the system is used for risk assessment and pricing in relation to natural persons in the case of life and health insurance, under Annex III point 5(c). This applies irrespective of the category of deployer."@en ;
    skos:prefLabel "Any deployer of a life or health insurance risk and pricing system"@en ;
    impacto-old:hasObligationSource impacto-old:FRIASource-A27 ;
    impacto-old:requiresAISystemType eu-aiact:HighRiskAISystem-AnnexIII-5-c .

impacto-old:FN1 a impacto-old:FRIANotRequiredCondition ;
    rdfs:label "High-risk under Article 6(1) only"@en ;
    dcterms:source "AI Act Art.27(1)"@en ;
    skos:definition "No FRIA is required where the system is high-risk solely as a safety component of a product covered by the Union harmonisation legislation in Annex I. Article 27(1) applies only to systems referred to in Article 6(2)."@en ;
    skos:prefLabel "High-risk under Article 6(1) only"@en ;
    impacto-old:excludesAISystemType eu-aiact:HighRiskAISystem-A6-2 ;
    impacto-old:hasObligationSource impacto-old:FRIASource-A27 ;
    impacto-old:requiresAISystemType eu-aiact:HighRiskAISystem-A6-1 .

impacto-old:FN2 a impacto-old:FRIANotRequiredCondition ;
    rdfs:label "Annex III point 2 carve-out"@en ;
    dcterms:source "AI Act Art.27(1)"@en ;
    skos:definition "No FRIA is required for high-risk AI systems intended to be used in the area listed in Annex III point 2, namely safety components in the management and operation of critical digital infrastructure, road traffic, and the supply of water, gas, heating and electricity."@en ;
    skos:prefLabel "Annex III point 2 carve-out"@en ;
    impacto-old:hasObligationSource impacto-old:FRIASource-A27 ;
    impacto-old:requiresAISystemType eu-aiact:HighRiskAISystem-AnnexIII-2 .

impacto-old:FN4 a impacto-old:FRIANotRequiredCondition ;
    rdfs:label "Not high-risk following the Article 6(3) derogation"@en ;
    dcterms:source "AI Act Art.6(3)"@en ;
    skos:definition "No FRIA is required where an Annex III system does not pose a significant risk of harm to health, safety or fundamental rights, including because it does not materially influence the outcome of decision making, and the provider has documented that assessment under Article 6(3)."@en ;
    skos:note "The derogation does not apply where the system performs profiling of natural persons; such systems are always high-risk."@en ;
    skos:prefLabel "Not high-risk following the Article 6(3) derogation"@en ;
    impacto-old:hasObligationSource impacto-old:FRIASource-A6 ;
    impacto-old:requiresAISystemType eu-aiact:RiskLevelNotHigh .

impacto-old:FullyReusable a skos:Concept,
        impacto-old:ReuseLevel ;
    rdfs:label "Fully Reusable"@en ;
    skos:definition "The DPIA content satisfies the FRIA requirement without addition."@en ;
    skos:prefLabel "Fully Reusable"@en .

impacto-old:appliesInJurisdiction a rdf:Property,
        skos:Concept ;
    rdfs:label "applies in jurisdiction"@en ;
    rdfs:subPropertyOf dpv:hasJurisdiction ;
    skos:definition "The jurisdiction in which a condition or guidance source has effect. Conditions derived from the GDPR itself apply across the EEA; conditions derived from a national list apply only in that Member State."@en ;
    skos:prefLabel "applies in jurisdiction"@en .

impacto-old:concernsAISystem a rdf:Property,
        skos:Concept ;
    rdfs:label "concerns AI system"@en ;
    rdfs:range eu-aiact:AISystem ;
    skos:definition "The AI system to which this condition or assessment relates."@en ;
    skos:prefLabel "concerns AI system"@en .

impacto-old:concernsProcessingActivity a rdf:Property,
        skos:Concept ;
    rdfs:label "concerns processing activity"@en ;
    rdfs:range dpv:Process ;
    skos:definition "The processing activity to which this condition or assessment relates."@en ;
    skos:prefLabel "concerns processing activity"@en .

impacto-old:conductedBy a rdf:Property,
        skos:Concept ;
    rdfs:label "conducted by"@en ;
    rdfs:domain impacto-old:ImpactAssessment ;
    rdfs:range dpv:LegalEntity ;
    skos:definition "The specific entity that carried out this assessment."@en ;
    skos:prefLabel "conducted by"@en .

impacto-old:conductedByRole a rdf:Property,
        skos:Concept ;
    rdfs:label "conducted by role"@en ;
    skos:definition "The category of entity legally responsible for conducting the assessment: the controller for a DPIA, the deployer for a FRIA."@en ;
    skos:prefLabel "conducted by role"@en .

impacto-old:correspondsToDPIARequirement a rdf:Property,
        skos:Concept ;
    rdfs:label "corresponds to DPIA requirement"@en ;
    rdfs:domain impacto-old:FRIAInformationRequirement ;
    rdfs:range impacto-old:DPIAInformationRequirement ;
    skos:definition "Maps a FRIA information requirement onto the DPIA information requirement that covers the same ground, so that reusable content can be identified before a FRIA is started."@en ;
    skos:prefLabel "corresponds to DPIA requirement"@en .

impacto-old:dpv-hasContractualTerms a skos:Concept ;
    rdfs:label "has Contractual Terms"@en ;
    skos:editorialNote "Used by the DPIA condition set but not yet defined in IMPACTO-concepts.ttl. Proposed for the dpv namespace."@en ;
    skos:prefLabel "has Contractual Terms"@en .

impacto-old:eu-gdpr-hasRiskChangeCategory a rdf:Property,
        skos:Concept ;
    rdfs:label "has risk change category"@en ;
    dcterms:source "GDPR Art. 35(11)"@en ;
    rdfs:range impacto-old:eu-gdpr-RiskChangeCategory ;
    rdfs:seeAlso <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX%3A32016R0679> ;
    rdfs:subClassOf dpv:hasContext ;
    skos:broader dpv:hasContext ;
    skos:definition "Indicates the category of change in risk associated with processing or with a DPIA."@en ;
    skos:prefLabel "has risk change category"@en ;
    skos:scopeNote "Proposed for: DPV GDPR extension (eu-gdpr)"@en .

impacto-old:excludesAISystemType a rdf:Property,
        skos:Concept ;
    rdfs:label "excludes AI system type"@en ;
    rdfs:domain impacto-old:FRIATriggerCondition ;
    rdfs:range eu-aiact:AISystem ;
    skos:definition "An AI system classification which, if it applies, prevents this condition from being triggered. Used for the Annex III point 2 carve-out in Art.27(1)."@en ;
    skos:prefLabel "excludes AI system type"@en .

impacto-old:hasAssessmentObligation a rdf:Property,
        skos:Concept ;
    rdfs:label "has assessment obligation"@en ;
    rdfs:domain impacto-old:HighRiskUseCase ;
    skos:definition "The impact assessments determined to be required for this use case."@en ;
    skos:prefLabel "has assessment obligation"@en .

impacto-old:hasAssessmentProcess a rdf:Property,
        skos:Concept ;
    rdfs:label "has assessment process"@en ;
    rdfs:domain impacto-old:ImpactAssessment ;
    rdfs:range impacto-old:ImpactAssessmentProcess ;
    skos:definition "Associates an impact assessment with the process that produced it."@en ;
    skos:prefLabel "has assessment process"@en .

impacto-old:hasDPIAInput a rdf:Property,
        skos:Concept ;
    rdfs:label "has DPIA input"@en ;
    rdfs:domain impacto-old:FRIA ;
    rdfs:range impacto-old:DPIAInputInFRIA ;
    skos:definition "Associates a FRIA with a record of the DPIA content it reuses."@en ;
    skos:prefLabel "has DPIA input"@en .

impacto-old:hasDPIATrigger a rdf:Property,
        skos:Concept ;
    rdfs:label "has DPIA trigger"@en ;
    rdfs:domain impacto-old:OverlappingCondition ;
    rdfs:range impacto-old:DPIARequiredCondition ;
    skos:definition "The DPIA condition matched in this overlapping situation."@en ;
    skos:prefLabel "has DPIA trigger"@en .

impacto-old:hasDeployer a rdf:Property,
        skos:Concept ;
    rdfs:label "has deployer"@en ;
    rdfs:range eu-aiact:AIDeployer ;
    skos:definition "The entity deploying an AI system under its own authority."@en ;
    skos:prefLabel "has deployer"@en .

impacto-old:hasDeployerCategory a rdf:Property,
        skos:Concept ;
    rdfs:label "has deployer category"@en ;
    rdfs:range impacto-old:DeployerCategory ;
    skos:definition "Classifies a deployer for the purposes of the Art.27(1) FRIA obligation."@en ;
    skos:prefLabel "has deployer category"@en .

impacto-old:hasExpectedProperty a rdf:Property,
        skos:Concept ;
    rdfs:label "has expected property"@en ;
    rdfs:domain impacto-old:InformationRequirement ;
    skos:definition "The RDF property through which this information requirement is expected to be expressed, for example dpv:hasPurpose for the requirement to state purposes. Enables SHACL shapes to be generated from the requirement list."@en ;
    skos:prefLabel "has expected property"@en .

impacto-old:hasExpectedValueClass a rdf:Property,
        skos:Concept ;
    rdfs:label "has expected value class"@en ;
    rdfs:domain impacto-old:InformationRequirement ;
    skos:definition "The class of value expected for the expected property."@en ;
    skos:prefLabel "has expected value class"@en .

impacto-old:hasFRIATrigger a rdf:Property,
        skos:Concept ;
    rdfs:label "has FRIA trigger"@en ;
    rdfs:domain impacto-old:OverlappingCondition ;
    rdfs:range impacto-old:FRIARequiredCondition ;
    skos:definition "The FRIA condition matched in this overlapping situation."@en ;
    skos:prefLabel "has FRIA trigger"@en .

impacto-old:hasImpactAssessment a rdf:Property,
        skos:Concept ;
    rdfs:label "has impact assessment"@en ;
    rdfs:domain dpv:Process ;
    rdfs:range impacto-old:ImpactAssessment ;
    rdfs:subPropertyOf dpv:hasImpactAssessment ;
    skos:definition "Associates a processing activity or AI use with the impact assessment carried out for it."@en ;
    skos:prefLabel "has impact assessment"@en .

impacto-old:hasInformationRequirement a rdf:Property,
        skos:Concept ;
    rdfs:label "has information requirement"@en ;
    rdfs:range impacto-old:InformationRequirement ;
    skos:definition "Associates an assessment, process or stage with an information requirement it must satisfy."@en ;
    skos:prefLabel "has information requirement"@en .

impacto-old:hasNecessityJustification a rdf:Property,
        skos:Concept ;
    rdfs:label "has necessity justification"@en ;
    rdfs:range xsd:string ;
    skos:definition "Free-text reasoning recorded for a necessity determination, in particular where an assessment is judged not to be required."@en ;
    skos:prefLabel "has necessity justification"@en .

impacto-old:hasNecessityStatus a rdf:Property,
        skos:Concept ;
    rdfs:label "has necessity status"@en ;
    rdfs:subPropertyOf dpv:hasStatus ;
    skos:definition "States whether an assessment has been determined to be required, not required, or undetermined for a given processing activity or AI system."@en ;
    skos:prefLabel "has necessity status"@en .

impacto-old:hasNextStage a rdf:Property,
        skos:Concept ;
    rdfs:label "has next stage"@en ;
    rdfs:domain impacto-old:AssessmentStage ;
    rdfs:range impacto-old:AssessmentStage ;
    skos:definition "Orders the stages of an assessment process."@en ;
    skos:prefLabel "has next stage"@en .

impacto-old:hasObligationSource a rdf:Property,
        skos:Concept ;
    rdfs:label "has obligation source"@en ;
    rdfs:range impacto-old:AssessmentObligationSource ;
    rdfs:subPropertyOf dcterms:source ;
    skos:definition "The legal or regulatory source that establishes this condition."@en ;
    skos:prefLabel "has obligation source"@en .

impacto-old:hasReuseGap a rdf:Property,
        skos:Concept ;
    rdfs:label "has reuse gap"@en ;
    rdfs:range xsd:string ;
    skos:definition "A description of what the DPIA content does not cover and must therefore be added to the FRIA."@en ;
    skos:prefLabel "has reuse gap"@en .

impacto-old:hasReuseLevel a rdf:Property,
        skos:Concept ;
    rdfs:label "has reuse level"@en ;
    rdfs:range impacto-old:ReuseLevel ;
    skos:definition "The extent to which the corresponding DPIA content can be relied upon."@en ;
    skos:prefLabel "has reuse level"@en .

impacto-old:hasStage a rdf:Property,
        skos:Concept ;
    rdfs:label "has stage"@en ;
    rdfs:domain impacto-old:ImpactAssessmentProcess ;
    rdfs:range impacto-old:AssessmentStage ;
    skos:definition "Associates an assessment process with one of its stages."@en ;
    skos:prefLabel "has stage"@en .

impacto-old:hasStage_Requirement a rdf:Property,
        skos:Concept ;
    rdfs:label "stage addresses requirement"@en ;
    rdfs:domain impacto-old:AssessmentStage ;
    rdfs:range impacto-old:InformationRequirement ;
    skos:definition "The information requirements addressed at a given stage of the assessment process."@en ;
    skos:prefLabel "stage addresses requirement"@en .

impacto-old:hasTreatmentDescription a rdf:Property,
        skos:Concept ;
    rdfs:label "has treatment description"@en ;
    skos:definition "A description of how a risk is treated."@en ;
    skos:prefLabel "has treatment description"@en .

impacto-old:indicatesDPIACondition a rdf:Property,
        skos:Concept ;
    rdfs:label "indicates DPIA condition"@en ;
    rdfs:range impacto-old:DPIARequiredCondition ;
    skos:definition "Records that the processing typically entailed by a class of high-risk AI system corresponds to a condition under which a DPIA is required."@en ;
    skos:prefLabel "indicates DPIA condition"@en .

impacto-old:isEmbeddedInAISystem a rdf:Property,
        skos:Concept ;
    rdfs:label "is embedded in AI system"@en ;
    rdfs:domain dpv:Process ;
    rdfs:range eu-aiact:AISystem ;
    owl:inverseOf impacto-old:embedsProcessingActivity ;
    skos:definition "Indicates that a processing activity is carried out through the use of a given AI system."@en ;
    skos:prefLabel "is embedded in AI system"@en .

impacto-old:isMandatory a rdf:Property,
        skos:Concept ;
    rdfs:label "is mandatory"@en ;
    rdfs:domain impacto-old:InformationRequirement ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether the information requirement is mandatory under the legislation, as opposed to recommended by guidance."@en ;
    skos:prefLabel "is mandatory"@en .

impacto-old:legacyTermNote a rdfs:Resource ;
    rdfs:label "legacy Term Note"@en ;
    dcterms:description "The IMPACTO-specific terms with an impacto:dpv-, impacto:pd-, impacto:risk-, impacto:loc-, impacto:tech-, impacto:ai- or impacto:sector- prefix in the condition set are proposed extensions to the corresponding DPV modules. They are used as-is here; where DPV later adopts them, an exactMatch should be added to this file."@en .

impacto-old:matchesCondition a rdf:Property,
        skos:Concept ;
    rdfs:label "matches condition"@en ;
    rdfs:range impacto-old:AssessmentTriggerCondition ;
    skos:definition "Records that a real processing activity or AI system exhibits all the characteristics of a given trigger condition."@en ;
    skos:prefLabel "matches condition"@en .

impacto-old:partOfRequirement a rdfs:Resource ;
    rdfs:label "part of requirement"@en ;
    skos:definition "Relates a detailed information requirement to the statutory heading it elaborates."@en ;
    skos:prefLabel "part of requirement"@en .

impacto-old:patternFor a rdf:Property,
        skos:Concept ;
    rdfs:label "pattern for"@en ;
    rdfs:domain impacto-old:AISystemProcessingPattern ;
    rdfs:range eu-aiact:AISystem ;
    skos:definition "The class of AI system whose typical processing characteristics this pattern describes."@en ;
    skos:prefLabel "pattern for"@en .

impacto-old:providesInputTo a rdf:Property,
        skos:Concept ;
    rdfs:label "provides input to"@en ;
    owl:inverseOf impacto-old:reusesDPIA ;
    skos:definition "Indicates that this DPIA supplies content used in a FRIA."@en ;
    skos:prefLabel "provides input to"@en .

impacto-old:reliesOnPreviousFRIA a rdf:Property,
        skos:Concept ;
    rdfs:label "relies on previous FRIA"@en ;
    dcterms:source "AI Act Art.27(2)"@en ;
    rdfs:domain impacto-old:FRIA ;
    rdfs:range impacto-old:FRIA ;
    skos:definition "Indicates that the deployer relies on a fundamental rights impact assessment previously conducted, or on information provided by the provider, because the relevant obligations are already met."@en ;
    skos:prefLabel "relies on previous FRIA"@en .

impacto-old:requiresAISystemType a rdf:Property,
        skos:Concept ;
    rdfs:label "requires AI system type"@en ;
    rdfs:domain impacto-old:FRIATriggerCondition ;
    rdfs:range eu-aiact:AISystem ;
    skos:definition "The AI system classification (e.g. eu-aiact:HighRiskAISystem-A6-2, or a specific Annex III point) that must apply for this condition to be triggered."@en ;
    skos:prefLabel "requires AI system type"@en .

impacto-old:requiresDeployerType a rdf:Property,
        skos:Concept ;
    rdfs:label "requires deployer type"@en ;
    rdfs:domain impacto-old:FRIATriggerCondition ;
    rdfs:range impacto-old:DeployerCategory ;
    skos:definition "The category of deployer that must apply for this condition to be triggered. Absent this property, the condition applies to any deployer."@en ;
    skos:prefLabel "requires deployer type"@en .

impacto-old:requiresFRIAUpdate a rdf:Property,
        skos:Concept ;
    rdfs:label "requires FRIA update"@en ;
    dcterms:source "AI Act Art.27(2)"@en ;
    rdfs:domain impacto-old:FRIA ;
    rdfs:range xsd:boolean ;
    skos:definition "True where elements of a previously conducted FRIA are no longer up to date, so the deployer must take the necessary steps to update the information."@en ;
    skos:prefLabel "requires FRIA update"@en .

impacto-old:reusedElement a rdf:Property,
        skos:Concept ;
    rdfs:label "reused element"@en ;
    rdfs:domain impacto-old:DPIAInputInFRIA ;
    skos:definition "The specific element of the DPIA being relied on, such as a processing description, a risk, or a set of measures."@en ;
    skos:prefLabel "reused element"@en .

impacto-old:satisfiedBy a rdf:Property,
        skos:Concept ;
    rdfs:label "satisfied by"@en ;
    skos:definition "Links an information requirement, in the context of a concrete assessment, to the resource that provides the required information."@en ;
    skos:prefLabel "satisfied by"@en .

impacto-old:satisfiesRequirement a rdf:Property,
        skos:Concept ;
    rdfs:label "satisfies requirement"@en ;
    rdfs:domain impacto-old:DPIAInputInFRIA ;
    rdfs:range impacto-old:FRIAInformationRequirement ;
    skos:definition "The FRIA information requirement that the reused DPIA element satisfies, wholly or in part."@en ;
    skos:prefLabel "satisfies requirement"@en .

impacto-old:usesAIOfficeTemplate a rdf:Property,
        skos:Concept ;
    rdfs:label "uses AI Office template"@en ;
    dcterms:source "AI Act Art.27(5)"@en ;
    rdfs:domain impacto-old:FRIA ;
    skos:definition "Indicates the FRIA was produced using the questionnaire or automated tool developed by the AI Office to facilitate compliance."@en ;
    skos:prefLabel "uses AI Office template"@en .

impacto:AssessmentOutcome a owl:Class,
        skos:Concept ;
    rdfs:label "Assessment Outcome"@en ;
    dcterms:source impacto:SourceIS,
        impacto:SourceNO,
        impacto:SourcePL ;
    rdfs:subClassOf pd:External ;
    skos:broader pd:External ;
    skos:definition "Personal data that captures results or conclusions from standardised assessments, such as exams, evaluations, or diagnostic tests, aimed at determining skills, knowledge, mental health, or developmental status"@en ;
    skos:notation "C45" ;
    skos:prefLabel "Assessment Outcome"@en .

impacto:AtHome a owl:Class,
        skos:Concept ;
    rdfs:label "At Home"@en ;
    dcterms:source impacto:SourceLV,
        impacto:SourceNL ;
    rdfs:subClassOf dpv:LocationLocality ;
    skos:broader dpv:LocationLocality ;
    skos:definition "Home or place of residence"@en ;
    skos:notation "C57" ;
    skos:prefLabel "At Home"@en .

impacto:AtWork a owl:Class,
        skos:Concept ;
    rdfs:label "At Work"@en ;
    dcterms:source impacto:SourceLV,
        impacto:SourceNL ;
    rdfs:subClassOf dpv:LocationLocality ;
    skos:broader dpv:LocationLocality ;
    skos:definition "A professional environment or workplace where personal data may be processed for purposes such as employee monitoring, supervision, or performance evaluation"@en ;
    skos:notation "C57" ;
    skos:prefLabel "At Work"@en .

impacto:Career a owl:Class,
        skos:Concept ;
    rdfs:label "Career"@en ;
    dcterms:source impacto:SourceEE ;
    rdfs:subClassOf pd:Professional ;
    skos:broader pd:Professional ;
    skos:definition "Personal data related to an individual's professional progression, roles held, promotions, or career evaluations that may impact employment opportunities"@en ;
    skos:notation "C105" ;
    skos:prefLabel "Career"@en .

impacto:ContractRefused a owl:Class,
        skos:Concept ;
    rdfs:label "Contract Refused"@en ;
    dcterms:source impacto:SourceBE,
        impacto:SourceHR ;
    rdfs:subClassOf impacto:ImpactOnContract ;
    skos:broader impacto:ImpactOnContract ;
    skos:definition "An impact where personal data, often from third parties, is used to inform a decision to deny entry into a service contract with a natural person"@en ;
    skos:notation "C52" ;
    skos:prefLabel "Contract Refused"@en .

impacto:EffectOnSalary a owl:Class,
        skos:Concept ;
    rdfs:label "Effect On Salary"@en ;
    dcterms:source impacto:SourceEE ;
    rdfs:subClassOf risk:IndividualRisk ;
    skos:broader risk:IndividualRisk ;
    skos:definition "Where the salary of an individual is affected"@en ;
    skos:notation "C105" ;
    skos:prefLabel "Effect On Salary"@en .

impacto:GoodConduct a owl:Class,
        skos:Concept ;
    rdfs:label "Good Conduct"@en ;
    dcterms:source impacto:SourceAll ;
    rdfs:subClassOf impacto:Conduct ;
    skos:broader impacto:Conduct ;
    skos:definition "Behaviour that is lawful, ethical, professional, reputation-enhancing or neutral and unlikely to cause social or professional harm"@en ;
    skos:notation "C9" ;
    skos:prefLabel "Good Conduct"@en .

impacto:IOTDevice a owl:Class,
        skos:Concept ;
    rdfs:label "IOT Device"@en ;
    dcterms:source impacto:SourceCY,
        impacto:SourceGR,
        impacto:SourceHR,
        impacto:SourceHU,
        impacto:SourceIS,
        impacto:SourceIT,
        impacto:SourceNL,
        impacto:SourceNO,
        impacto:SourcePL,
        impacto:SourcePT,
        impacto:SourceRO,
        impacto:SourceSI ;
    rdfs:subClassOf tech:Device ;
    skos:broader tech:Device ;
    skos:definition "Devices that are generating signals or data and transmitting this over the internet"@en ;
    skos:notation "C18" ;
    skos:prefLabel "IOT Device"@en .

impacto:IdentityManagementService a owl:Class,
        skos:Concept ;
    rdfs:label "Identity Management Service"@en ;
    dcterms:source impacto:SourceEE ;
    rdfs:subClassOf tech:Service ;
    skos:broader tech:Service ;
    skos:definition "A technical and administrative system that authenticates and manages digital identities, with risks of identity theft or fraud due to large-scale personal data processing"@en ;
    skos:notation "C103" ;
    skos:prefLabel "Identity Management Service"@en .

impacto:ImpactOnCareer a owl:Class,
        skos:Concept ;
    rdfs:label "Impact On Career"@en ;
    dcterms:source impacto:SourceEE ;
    rdfs:subClassOf dpv:Impact ;
    skos:broader dpv:Impact ;
    skos:definition "Where the career of an individual is impacted"@en ;
    skos:notation "C105" ;
    skos:prefLabel "Impact On Career"@en .

impacto:Inspection a owl:Class,
        skos:Concept ;
    rdfs:label "Inspection"@en ;
    rdfs:subClassOf dpv:ProcessingContext ;
    skos:broader dpv:ProcessingContext ;
    skos:definition "A processing context where personal data is used as part of an evaluative or investigative activity or purpose"@en ;
    skos:prefLabel "Inspection"@en .

impacto:JudicialEnforcement a owl:Class,
        skos:Concept ;
    rdfs:label "Judicial Enforcement"@en ;
    dcterms:source impacto:SourceDK ;
    rdfs:subClassOf <https://w3id.org/dpv/sector/law#JusticeManagement> ;
    skos:broader <https://w3id.org/dpv/sector/law#JusticeManagement> ;
    skos:definition "Processing of data for the execution of court decisions or enforcement of legal judgments"@en ;
    skos:notation "C83" ;
    skos:prefLabel "Judicial Enforcement"@en .

impacto:NonSystematic a owl:Class,
        skos:Concept ;
    rdfs:label "Non-Systematic"@en ;
    dcterms:source impacto:SourceAll ;
    rdfs:subClassOf impacto:Systematicity ;
    skos:broader impacto:Systematicity ;
    skos:definition "Indication that processing does not meet the definition of systematic"@en ;
    skos:notation "C29, C39, C45, C51, C50, C55, C82, C89" ;
    skos:prefLabel "Non-Systematic"@en .

impacto:PersonnelSupervision a owl:Class,
        skos:Concept ;
    rdfs:label "Personnel Supervision"@en ;
    rdfs:subClassOf dpv:PersonnelManagement ;
    skos:broader dpv:PersonnelManagement ;
    skos:definition "Activities that constitute supervision as part of oversight or management of humans as personnel"@en ;
    skos:prefLabel "Personnel Supervision"@en .

impacto:PrivateUtilityProvider a owl:Class,
        skos:Concept ;
    rdfs:label "Private Utility Provider"@en ;
    dcterms:source impacto:SourceBE,
        impacto:SourceGR,
        impacto:SourceHR,
        impacto:SourceHU,
        impacto:SourceNL,
        impacto:SourcePL,
        impacto:SourceRO ;
    rdfs:subClassOf impacto:UtilityProvider ;
    skos:broader impacto:UtilityProvider ;
    skos:definition "A private organisation providing utilities"@en ;
    skos:notation "C23" ;
    skos:prefLabel "Private Utility Provider"@en .

impacto:PublicSafetyAlertManagement a owl:Class,
        skos:Concept ;
    rdfs:label "Public Safety Alert Management"@en ;
    dcterms:source impacto:SourceFR ;
    rdfs:subClassOf dpv:PublicBenefit ;
    skos:broader dpv:PublicBenefit ;
    skos:definition "Management of health alerts, such as for a patient at risk or for pandemics, through which health professionals and authorities can alert individuals or the public regarding their health"@en ;
    skos:notation "C91" ;
    skos:prefLabel "Public Safety Alert Management"@en .

impacto:ServiceAccessAllowed a owl:Class,
        skos:Concept ;
    rdfs:label "Service Access Allowed"@en ;
    dcterms:source impacto:SourceBE,
        impacto:SourceES,
        impacto:SourceGR,
        impacto:SourceHR,
        impacto:SourceIS,
        impacto:SourceIT,
        impacto:SourceLI,
        impacto:SourceLV,
        impacto:SourceNO,
        impacto:SourcePL,
        impacto:SourceSE,
        impacto:SourceSI ;
    rdfs:subClassOf impacto:ServiceRelatedConsequence ;
    skos:broader impacto:ServiceRelatedConsequence ;
    skos:definition "Where an individual or an organisation is permitted to use or access a service"@en ;
    skos:notation "C17" ;
    skos:prefLabel "Service Access Allowed"@en .

impacto:SignificantEffectDataSubject a owl:Class,
        skos:Concept ;
    rdfs:label "Significant Effect On Data Subject"@en ;
    dcterms:source impacto:SourceGDPR ;
    rdfs:subClassOf impacto:SignificantEffect ;
    skos:broader impacto:SignificantEffect ;
    skos:definition "An impact that is distinguished as being legally significant, such as when it affects the rights and freedoms of entities, or when it affects financial status, health, reputation, access to services or other economic or social opportunities"@en ;
    skos:notation "C24" ;
    skos:prefLabel "Significant Effect On Data Subject"@en .

impacto:SignificantlyEffect a owl:Class,
        skos:Concept ;
    rdfs:label "Significantly Effect"@en ;
    dcterms:source impacto:SourceAT,
        impacto:SourceCZ,
        impacto:SourceGR,
        impacto:SourceIE,
        impacto:SourceIT,
        impacto:SourceLU,
        impacto:SourceNL,
        impacto:SourcePL ;
    rdfs:subClassOf impacto:SignificantEffect ;
    skos:broader impacto:SignificantEffect ;
    skos:definition "Where an individual or organisation is majorly impacted"@en ;
    skos:notation "C24" ;
    skos:prefLabel "Significantly Effect"@en .

impacto:SourceMT a owl:NamedIndividual ;
    rdfs:label "Malta (MT)"@en ;
    skos:exactMatch <https://w3id.org/dpv/legal/mt#DPIARequiredList> ;
    skos:prefLabel "Malta (MT)"@en .

impacto:Tracking a owl:Class,
        skos:Concept ;
    rdfs:label "Tracking"@en ;
    dcterms:source impacto:SourceLI,
        impacto:SourceLV ;
    rdfs:subClassOf dpv:Use ;
    skos:broader dpv:Use ;
    skos:definition "The use of data to follow or track something across contexts"@en ;
    skos:notation "C58" ;
    skos:prefLabel "Tracking"@en ;
    skos:scopeNote "While generalised to enable tracking of activities and events, this also encompasses tracking of individuals across websites, apps, devices, and other forms which can constitute systematic monitoring and surveillance"@en .

impacto:TrustService a owl:Class,
        skos:Concept ;
    rdfs:label "Trust Service"@en ;
    dcterms:source impacto:SourceEE ;
    rdfs:subClassOf tech:Service ;
    skos:broader tech:Service ;
    skos:definition "Services that involve the processing of personal data to authenticate identity, verify electronic transactions, or provide secure communication and document exchange, where the nature of processing may pose a risk of identity theft or fraud"@en ;
    skos:notation "C103" ;
    skos:prefLabel "Trust Service"@en .

<https://tyttikatariina.github.io/ImpactAssessmentOntology/complete> a owl:Ontology ;
    dcterms:contributor "Harshvardhan J. Pandit" ;
    dcterms:creator "Tytti Rintamäki" ;
    dcterms:description "Impact assessments under the GDPR and the AI Act: the DPIA and FRIA processes, the conditions that make each mandatory including national supervisory authority guidance, the information each must contain, the reuse of DPIA content in a FRIA, and the cases where both are owed."@en ;
    dcterms:title "IMPACTO — complete ontology and knowledge graph"@en .

<https://tyttikatariina.github.io/ImpactAssessmentOntology/concepts> a owl:Ontology ;
    rdfs:label "concepts"@en ;
    dcterms:contributor "Harshvardhan J. Pandit" ;
    dcterms:creator "Tytti Rintamäki" ;
    dcterms:description "New concepts proposed by IMPACTO as additions to DPV and its extensions, derived from analysis of GDPR DPIA required process lists across all EU and EEA member states."@en ;
    dcterms:title "IMPACTO Concept Proposals"@en ;
    owl:imports <https://tyttikatariina.github.io/ImpactAssessmentOntology/> .

dpv:AccessControl skos:editorialNote "Current DPV uses dpv:AccessControlMethod."@en ;
    skos:exactMatch dpv:AccessControlMethod .

dpv:Controller owl:equivalentClass dpv:DataController ;
    skos:editorialNote "Legacy name used in the existing IMPACTO files. Current DPV uses dpv:DataController."@en ;
    skos:exactMatch dpv:DataController .

dpv:HighRisk skos:editorialNote "Risk levels now live in the RISK extension."@en ;
    skos:exactMatch risk:HighRisk .

dpv:LowRisk skos:editorialNote "Risk levels now live in the RISK extension."@en ;
    skos:exactMatch risk:LowRisk .

dpv:MediumRisk skos:editorialNote "Current DPV uses risk:ModerateRisk."@en ;
    skos:exactMatch risk:ModerateRisk .

dpv:PartiallyAutomated skos:editorialNote "Current DPV uses dpv:PartialAutomation."@en ;
    skos:exactMatch dpv:PartialAutomation .

dpv:Processor owl:equivalentClass dpv:DataProcessor ;
    skos:editorialNote "Legacy name. Current DPV uses dpv:DataProcessor."@en ;
    skos:exactMatch dpv:DataProcessor .

dpv:TrainingManagement skos:editorialNote "Current DPV uses dpv:StaffTraining."@en ;
    skos:exactMatch dpv:StaffTraining .

dpv:hasController owl:equivalentProperty dpv:hasDataController ;
    skos:editorialNote "Legacy name. Current DPV uses dpv:hasDataController."@en .

dpv:hasDPIAOutcome owl:equivalentProperty dpv:hasOutcome ;
    skos:editorialNote "Legacy name. Current DPV expresses the outcome with dpv:hasOutcome and an eu-gdpr:DPIAOutcome value."@en .

dpv:hasProcessor owl:equivalentProperty dpv:hasDataProcessor ;
    skos:editorialNote "Legacy name. Current DPV uses dpv:hasDataProcessor."@en .

dpv:hasRiskSource owl:equivalentProperty risk:hasRiskSource ;
    skos:editorialNote "The property now lives in the RISK extension as risk:hasRiskSource."@en .

dpv:hasTreatment owl:equivalentProperty risk:hasRiskTreatment ;
    skos:editorialNote "Current DPV uses risk:hasRiskTreatment."@en .

<https://w3id.org/dpv/legal/at#C21> a impacto-old:AssessmentTriggerCondition,
        impacto-old:DPIARequiredCondition,
        impacto-old:eu-gdpr-DPIARequiredProcess,
        eu-gdpr:DPIARequiredProcess ;
    rdfs:label "AT C21: A process which requires a DPIA according to the Data Protection…"@en ;
    dcterms:source <https://w3id.org/dpv/legal/at#DPIARequiredList> ;
    skos:definition "A process which requires a DPIA according to the Data Protection Authorities of Austria and which involves processing data concerning asylum seekers"@en ;
    dpv:hasHumanSubject dpv:AsylumSeeker ;
    dpv:hasJurisdiction loc:AT .

<https://w3id.org/dpv/legal/at#C24a> a impacto-old:AssessmentTriggerCondition,
        impacto-old:DPIARequiredCondition,
        impacto-old:eu-gdpr-DPIARequiredProcess,
        eu-gdpr:DPIARequiredProcess ;
    rdfs:label "AT C24a: A process which requires a DPIA according to the Data Protection…"@en ;
    dcterms:source <https://w3id.org/dpv/legal/at#DPIARequiredList> ;
    skos:definition "A process which requires a DPIA according to the Data Protection Authorities of Austria and which involves combining and/or matching data sets from two or more processing operations carried out for different purposes and/or by different controllers in the context of data processing that goes beyond the processing normally expected by a data subject, (provided that the use of algorithms can make decisions that significantly affect the data subject.)"@en ;
    dpv:hasJurisdiction loc:AT ;
    dpv:hasProcessing dpv:Match .

<https://w3id.org/dpv/legal/at#C24b> a impacto-old:AssessmentTriggerCondition,
        impacto-old:DPIARequiredCondition,
        impacto-old:eu-gdpr-DPIARequiredProcess,
        eu-gdpr:DPIARequiredProcess ;
    rdfs:label "AT C24b: A process which requires a DPIA according to the Data Protection…"@en ;
    dcterms:source <https://w3id.org/dpv/legal/at#DPIARequiredList> ;
    skos:definition "A process which requires a DPIA according to the Data Protection Authorities of Austria and which involves combining and/or matching data sets from two or more processing operations carried out for different purposes and/or by different controllers in the context of data processing that goes beyond the processing normally expected by a data subject, (provided that the use of algorithms can make decisions that significantly affect the data subject.)"@en ;
    dpv:hasJurisdiction loc:AT ;
    dpv:hasProcessing dpv:Combine .

<https://w3id.org/dpv/legal/at#C24c> a impacto-old:AssessmentTriggerCondition,
        impacto-old:DPIARequiredCondition,
        impacto-old:eu-gdpr-DPIARequiredProcess,
        eu-gdpr:DPIARequiredProcess ;
    rdfs:label "AT C24c: A process which requires a DPIA according to the Data Protection…"@en ;
    dcterms:source <https://w3id.org/dpv/legal/at#DPIARequiredList> ;
    skos:definition "A process which requires a DPIA according to the Data Protection Authorities of Austria and which involves combining and/or matching data sets from two or more processing operations carried out for different purposes and/or by different controllers in the context of data processing that goes beyond the processing normally expected by a data subject, (provided that the use of algorithms can make decisions that significantly affect the data subject.)"@en ;
    dpv:hasJurisdiction loc:AT ;
    dpv:hasProcessing dpv:Combine,
        dpv:Match .

<https://w3id.org/dpv/legal/at#C25a> a impacto-old:AssessmentTriggerCondition,
        impacto-old:DPIARequiredCondition,
        impacto-old:eu-gdpr-DPIARequiredProcess,
        eu-gdpr:DPIARequiredProcess ;
    rdfs:label "AT C25a: A process which requires a DPIA according to the Data Protection…"@en ;
    dcterms:source <https://w3id.org/dpv/legal/at#DPIARequiredList> ;
    skos:definition "A process which requires a DPIA according to the Data Protection Authorities of Austria and which involves processing operations aimed at monitoring or controlling data subjects, in particular by means of image or video and associated acoustic data processing"@en ;
    dpv:hasData tech:ImageContent ;
    dpv:hasJurisdiction loc:AT ;
    dpv:hasPurpose impacto-old:dpv-Monitoring .

<https://w3id.org/dpv/legal/at#C25b> a impacto-old:AssessmentTriggerCondition,
        impacto-old:DPIARequiredCondition,
        impacto-old:eu-gdpr-DPIARequiredProcess,
        eu-gdpr:DPIARequiredProcess ;
    rdfs:label "AT C25b"@en ;
    dcterms:source <https://w3id.org/dpv/legal/at#DPIARequiredList> ;
    dpv:hasData tech:VideoContent ;
    dpv:hasJurisdiction loc:AT ;
    dpv:hasPurpose impacto-old:dpv-Monitoring .

<https://w3id.org/dpv/legal/at#C25c> a impacto-old:AssessmentTriggerCondition,
        impacto-old:DPIARequiredCondition,
        impacto-old:eu-gdpr-DPIARequiredProcess,
        eu-gdpr:DPIARequiredProcess ;
    rdfs:label "AT C25c"@en ;
    dcterms:source <https://w3id.org/dpv/legal/at#DPIARequiredList> ;
    dpv:hasData tech:AudioContent ;
    dpv:hasJurisdiction loc:AT ;
    dpv:hasPurpose impacto-old:dpv-Monitoring .

<https://w3id.org/dpv/legal/at#C25d> a impacto-old:AssessmentTriggerCondition,
        impacto-old:DPIARequiredCondition,
        impacto-old:eu-gdpr-DPIARequiredProcess,
        eu-gdpr:DPIARequiredProcess ;
    rdfs:label "AT C25d"@en ;
    dcterms:source <https://w3id.org/dpv/legal/at#DPIARequiredList> ;
    dpv:hasData tech:ImageContent ;
    dpv:hasJurisdiction loc:AT ;
    dpv:hasPurpose impacto-old:dpv-ControlHumanActivity .

<https://w3id.org/dpv/legal/at#C25e> a impacto-old:AssessmentTriggerCondition,
        impacto-old:DPIARequiredCondition,
        impacto-old:eu-gdpr-DPIARequiredProcess,
        eu-gdpr:DPIARequiredProcess ;
    rdfs:label "AT C25e"@en ;
    dcterms:source <https://w3id.org/dpv/legal/at#DPIARequiredList> ;
    dpv:hasData tech:VideoContent ;
    dpv:hasJurisdiction loc:AT ;
    dpv:hasPurpose impacto-old:dpv-ControlHumanActivity .

<https://w3id.org/dpv/legal/at#C25f> a impacto-old:AssessmentTriggerCondition,
        impacto-old:DPIARequiredCondition,
        impacto-old:eu-gdpr-DPIARequiredProcess,
        eu-gdpr:DPIARequiredProcess ;
    rdfs:label "AT C25f"@en ;
    dcterms:source <https://w3id.org/dpv/legal/at#DPIARequiredList> ;
    dpv:hasData tech:AudioContent ;
    dpv:hasJurisdiction loc:AT ;
    dpv:hasPurpose impacto-old:dpv-ControlHumanActivity .

<https://w3id.org/dpv/legal/at#C26> a impacto-old:AssessmentTriggerCondition,
        impacto-old:DPIARequiredCondition,
        impacto-old:eu-gdpr-DPIARequiredProcess,
        eu-gdpr:DPIARequiredProcess ;
    rdfs:label "AT C26: A process which requires a DPIA according to the Data Protection…"@en ;
    dcterms:source <https://w3id.org/dpv/legal/at#DPIARequiredList> ;
    skos:definition "A process which requires a DPIA according to the Data Protection Authorities of Austria and which involves processing of data related to minors "@en ;
    dpv:hasHumanSubject dpv:Child ;
    dpv:hasJurisdiction loc:AT .

<https://w3id.org/dpv/legal/at#C27> a impacto-old:AssessmentTriggerCondition,
        impacto-old:DPIARequiredCondition,
        impacto-old:eu-gdpr-DPIARequiredProcess,
        eu-gdpr:DPIARequiredProcess ;
    rdfs:label "AT C27: A process which requires a DPIA according to the Data Protection…"@en ;
    dcterms:source <https://w3id.org/dpv/legal/at#DPIARequiredList> ;
    skos:definition "A process which requires a DPIA according to the Data Protection Authorities of Austria and which involves profiling"@en ;
    dpv:hasJurisdiction loc:AT ;
    dpv:hasProcessing eu-gdpr:Profiling .

<https://w3id.org/dpv/legal/at#C32> a impacto-old:AssessmentTriggerCondition,
        impacto-old:DPIARequiredCondition,
        impacto-old:eu-gdpr-DPIARequiredProcess,
        eu-gdpr:DPIARequiredProcess ;
