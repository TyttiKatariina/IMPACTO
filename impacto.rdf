     -->



    <!-- https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-hasRiskChangeCategory -->

    <rdf:Property rdf:about="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-hasRiskChangeCategory">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/IMPACTO/"/>
        <skos:prefLabel xml:lang="en">has risk change category</skos:prefLabel>
        <skos:notation>eu-gdpr-hasRiskChangeCategory</skos:notation>
        <skos:definition xml:lang="en">Indicates the category of change in risk associated with processing or with a DPIA.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#hasContext"/>
        <skos:note xml:lang="en">Range: https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-RiskChangeCategory</skos:note>
        <skos:note xml:lang="en">Proposed for: DPV GDPR extension (eu-gdpr)</skos:note>
        <skos:note xml:lang="en">Source: GDPR Art. 35(11)</skos:note>
    </rdf:Property>



    <!-- https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-hasChangeDescription -->

    <rdf:Property rdf:about="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-hasChangeDescription">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:inScheme rdf:resource="https://tyttikatariina.github.io/IMPACTO/"/>
        <skos:prefLabel xml:lang="en">has change description</skos:prefLabel>
        <skos:notation>eu-gdpr-hasChangeDescription</skos:notation>
        <skos:definition xml:lang="en">Provides a description of a change in the processing or its risk that is relevant to a DPIA review.</skos:definition>
        <skos:broader rdf:resource="https://w3id.org/dpv#hasContext"/>
        <skos:note xml:lang="en">Proposed for: DPV GDPR extension (eu-gdpr)</skos:note>
        <skos:note xml:lang="en">Source: GDPR Art. 35(11)</skos:note>
    </rdf:Property>
