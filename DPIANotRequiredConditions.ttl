at:CN12 a impacto:eu-gdpr-DPIANotRequiredProcess ;
    skos:definition "A process which does not require a DPIA according to the Data Protection Authorities of Austria and which involves: Inventory management (management of inventory records), 
support for the exchange of goods and the company's accounting, ancillary and auxiliary records of suppliers related to inventory management, acquisition costs and management of the allocation of 
hardware and software to computer system users."@en ;
    dpv:hasPurpose hapt:dpv-InventoryManagement, hapt:dpv-ExchangeOfGoods, hapt:dpv-Accounting, hapt:dpv-HardwareUserAllocation, hapt:dpv-SoftwareUserAllocation  ;
	dpv:hasData hapt:dpv-AcquisitionCosts, hapt:dpv-AncillaryRecords, hapt:dpv-AuxiliaryRecords ;
    dct:source at:DPIANotRequiredList ;
    dct:identifier "CN12" ;
    dpv:hasJurisdiction loc:AT .


at:CN13 a impacto:eu-gdpr-DPIANotRequiredProcess ;
    skos:definition "A process which does not require a DPIA according to the Data Protection Authorities of Austria and which involves: Processing of personal data within the framework of registers, 
evidence or books established by Union, federal or state law, provided that no personal data within the meaning of Art. 9 and 10 GDPR are processed."@en ;
   	dpv:hasPurpose hapt:dpv-StatutoryRecordKeeping ;
	dpv:hasContext hapt:dpv-DataRegister ;
	dpv:hasData hapt:dpv-NationalLevelRegisters, hapt:dpv-PersonalDataRegisters, hapt:dpv-UnionLevelRegisters ;
	dpv:hasApplicableLaw hapt:dpv-UnionLaw, hapt:dpv-FederalLaw, hapt:dpv-StateLaw;
    dct:source at:DPIANotRequiredList ;
    dct:identifier "CN13" ;
    dpv:hasJurisdiction loc:AT .


at:CN14a a impacto:eu-gdpr-DPIANotRequiredProcess ;
    skos:definition "A process which does not require a DPIA according to the Data Protection Authorities of Austria and which involves: Management of usernames and passwords as well as system access logging."@en ;
    dpv:hasTechnicalMeasure hapt:dpv-AccessLogins ;
    dct:source at:DPIANotRequiredList ;
    dct:identifier "CN14" ;
    dpv:hasJurisdiction loc:AT .

at:CN14b a impacto:eu-gdpr-DPIANotRequiredProcess ;
