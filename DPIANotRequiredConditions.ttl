    dpv:hasPersonalData dpv:SpecialCategoryPersonalData ;
    dpv:hasLegalBasis  dpv:Ex. ("any of the legal basis") ;
    dct:source at:DPIANotRequiredList ;
    dct:identifier "CN9" ;
    dpv:hasJurisdiction loc:AT .

