eu-gdpr:DPIANotRequiredList a hapt:DPIANotRequiredList ;
    skos:prefLabel "DPIA Not Required List"@en ;
    rdfs:label "DPIA Not Required List"@en ;
    skos:definition "Exemptions from the obligation to carry out a data protection impact assessment arising from the GDPR itself and from EDPB guidance."@en ;
    dct:source "GDPR Art. 35(1), 35(5), 35(10); EDPB WP248rev.01"@en .
    dpv:hasJurisdiction loc:AT, loc:BE, loc:BG, loc:HR, loc:CY, loc:CZ, loc:DK, loc:EE, loc:FI, loc:FR, loc:DE, loc:GR, loc:HU, loc:IS, loc:IE, loc:IT, loc:LV, loc:LI, loc:LT, loc:LU, loc:MT, loc:NL, loc:NO, loc:PL, loc:PT, loc:RO, loc:SK, loc:SI, loc:ES, loc:SE .


###############################################################################
# DPIA Not Required Conditions
###############################################################################

eu-gdpr:CN1 a impacto:eu-gdpr-DPIANotRequiredProcess ;
    skos:definition "A process which does not require a DPIA according to Article 35(1) of the GDPR: Where the processing is not likely to result in a high risk to the rights and freedoms of natural persons."@en ;
    dpv:hasRiskLevel hapt:dpv-RiskLevelNotHigh ;
    dct:source eu-gdpr:DPIANotRequiredList ;
    dct:identifier "CN1" ;
    dpv:hasJurisdiction loc:AT, loc:BE, loc:BG, loc:HR, loc:CY, loc:CZ, loc:DK, loc:EE, loc:FI, loc:FR, loc:DE, loc:GR, loc:HU, loc:IS, loc:IE, loc:IT, loc:LV, loc:LI, loc:LT, loc:LU, loc:MT, loc:NL, loc:NO, loc:PL, loc:PT, loc:RO, loc:SK, loc:SI, loc:ES, loc:SE .

eu-gdpr:CN2 a impacto:eu-gdpr-DPIANotRequiredProcess ;
    skos:definition "A process which does not require a DPIA according to Article 35 of the GDPR: When the nature, scope, context and purposes of the processing are very similar to the processing for which a DPIA has already been carried out"@en ;
    hapt:hasExemptionBasis hapt:dpv-ExistingDPIAReuse ;
    dct:source eu-gdpr:DPIANotRequiredList ;
    dct:identifier "CN2" ;
    dpv:hasJurisdiction loc:AT, loc:BE, loc:BG, loc:HR, loc:CY, loc:CZ, loc:DK, loc:EE, loc:FI, loc:FR, loc:DE, loc:GR, loc:HU, loc:IS, loc:IE, loc:IT, loc:LV, loc:LI, loc:LT, loc:LU, loc:MT, loc:NL, loc:NO, loc:PL, loc:PT, loc:RO, loc:SK, loc:SI, loc:ES, loc:SE .

eu-gdpr:CN3 a impacto:eu-gdpr-DPIANotRequiredProcess ;
    skos:definition "A process which does not require a DPIA according to Article 35 of the GDPR: Where a processing operation, pursuant to point (c) or (e) of article 6(1), has a legal basis in EU or Member State law, where the law regulates the specific processing operation and where a DPIA has already been carried out as part of the establishment of that legal basis (Article 35(10))21, except if a Member state has stated it to be necessary to carry out a DPIA prior processing activities"@en ;
    dpv:hasLegalBasis hapt:dpv-LegalBasisExemption ;
    dct:source eu-gdpr:DPIANotRequiredList ;
    dct:identifier "CN3" ;
    dpv:hasJurisdiction loc:AT, loc:BE, loc:BG, loc:HR, loc:CY, loc:CZ, loc:DK, loc:EE, loc:FI, loc:FR, loc:DE, loc:GR, loc:HU, loc:IS, loc:IE, loc:IT, loc:LV, loc:LI, loc:LT, loc:LU, loc:MT, loc:NL, loc:NO, loc:PL, loc:PT, loc:RO, loc:SK, loc:SI, loc:ES, loc:SE .

eu-gdpr:CN4 a impacto:eu-gdpr-DPIANotRequiredProcess ;
    skos:definition "A process which does not require a DPIA according to Article 35 of the GDPR: Where the processing is included on the optional list (established by the supervisory authority) of processing operations for which no DPIA is required (Article 35(5))"@en ;
    dpv:hasEntity hapt:dpv-DataProtectionAuthorityGuidance ;
    dpv:hasSource hapt:dpv-WhiteListActivity ;
    dct:source eu-gdpr:DPIANotRequiredList ;
    dct:identifier "CN4" ;
    dpv:hasJurisdiction loc:AT, loc:BE, loc:BG, loc:HR, loc:CY, loc:CZ, loc:DK, loc:EE, loc:FI, loc:FR, loc:DE, loc:GR, loc:HU, loc:IS, loc:IE, loc:IT, loc:LV, loc:LI, loc:LT, loc:LU, loc:MT, loc:NL, loc:NO, loc:PL, loc:PT, loc:RO, loc:SK, loc:SI, loc:ES, loc:SE .


at:CN5a a impacto:eu-gdpr-DPIANotRequiredProcess ;
    skos:definition "A process which does not require a DPIA according to the Data Protection Authorities of Austria: Processing of personal data in the context of any business relationship with customers and suppliers, including 
systematic recording of all business transactions relating to income and expenses."@en ;
    dpv:hasData hapt:dpv-IncomeData ;
    dpv:hasData hapt:dpv-BusinessTransactions ;
    dpv:hasEntity hapt:dpv-ServiceCustomer ;
    dpv:hasPurpose hapt:dpv-BusinessRelationshipManagement ;
    dct:source at:DPIANotRequiredList ;
    dct:identifier "CN5" ;
    dpv:hasJurisdiction loc:AT .

at:CN5b a impacto:eu-gdpr-DPIANotRequiredProcess ;
    skos:definition "A process which does not require a DPIA according to the Data Protection Authorities of Austria: Processing of personal data in the context of any business relationship with customers and suppliers, including 
