	skos:scopeNote "Processing activities of companies that process data about third parties (not clients of the controller) with whom the companies have no business relationship (such as detective agencies, debt collection agencies 
or credit agencies) are not covered by this exception."@en . 
dpv:isNotApplicableFor hapt:dpv-DetectiveAgency ;
dpv:isNotApplicableFor hapt:dpv-DebtCollectionAgency ;
dpv:isNotApplicableFor hapt:dpv-CreditAgency ;


at:CN6a  a impacto:eu-gdpr-DPIANotRequiredProcess ;
    skos:definition "A process which does not require a DPIA according to the Data Protection Authorities of Austria: Processing and keeping evidence of personal data for payroll, payroll and compliance with recording, information 
and reporting obligations, insofar as this is necessary on the basis of laws or norms of collective legal design or employment contract obligations."@en ;
    dpv:hasJustification hapt:justifications-CollectiveLegalNorm ;
	dpv:hasData hapt:pd-Payroll ;
    dpv:hasPurpose hapt:dpv-RecordKeeping ;
    dct:source at:DPIANotRequiredList ;
    dct:identifier "CN6" ;
    dpv:hasJurisdiction loc:AT .

at:CN6b  a impacto:eu-gdpr-DPIANotRequiredProcess ;
    skos:definition "A process which does not require a DPIA according to the Data Protection Authorities of Austria: Processing and keeping evidence of personal data for payroll, payroll and compliance with recording, information 
and reporting obligations, insofar as this is necessary on the basis of laws or norms of collective legal design or employment contract obligations."@en ;
    dpv:hasLegalBasis dpv:EmploymentContract ;
	dpv:hasData hapt:pd-Payroll ;
