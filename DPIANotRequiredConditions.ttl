# Art. 35(5) DPIA Not Required lists (White lists of processing activities)
###############################################################################

at:DPIANotRequiredList a impacto:DPIANotRequiredList ;
    skos:prefLabel "DPIA Not Required list (AT)"@en ;
    rdfs:label "DPIA Not Required list (AT)"@en ;
    skos:definition "List of processing operations for which no data protection impact assessment is required, published by the supervisory authority of AT under GDPR Art. 35(5)."@en ;
    dpv:hasJurisdiction loc:AT ;
    dct:source "GDPR Art. 35(5)"@en .
