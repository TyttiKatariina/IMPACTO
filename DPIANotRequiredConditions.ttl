    dpv:hasEntity hapt:dpv-PublicOfficials ;
    dpv:hasPurpose hapt:dpv-PublicInquiryInvestigation ;
    dct:source at:DPIANotRequiredList ;
    dct:identifier "CN28" ;
    dpv:hasJurisdiction loc:AT .

at:CN29 a impacto:eu-gdpr-DPIANotRequiredProcess ;
    skos:definition "A process which does not require a DPIA according to the Data Protection Authorities of Austria and which involves: Formal handling of business cases (File management and procedure management) to be provided by the 
controller (including the storage of documents arising from this activity, settlement of fees, organization of large-scale proceedings)."@en ;
    dpv:hasData hapt:dpv-BusinessCases ;
    dpv:hasPurpose hapt:dpv-CaseManagement, hapt:dpv-FileManagement, hapt:dpv-FeeSettlement, hapt:ProceedingOrganisation ;
	dpv:hasContext dpv:StorageLocation ;
    dct:source at:DPIANotRequiredList ;
    dct:identifier "CN29" ;
    dpv:hasJurisdiction loc:AT .

at:CN30 a impacto:eu-gdpr-DPIANotRequiredProcess ;
    skos:definition "A process which does not require a DPIA according to the Data Protection Authorities of Austria and which involves: Data processing for holding events in the public and private sector, such as invitation and 
registration of participants, organization of trips and stays, supply of participants and communication before and after the event, settlement of monetary benefits (fees, reimbursement of travel expenses), processing of cultural programs,
transmission of documents and production of image and acoustic recordings in connection with the event."@en ;
	dpv:hasEntity dpv:PrivateSectorBody, dpv:PublicSectorBody ;
    dpv:hasPurpose hapt:dpv-AccommodationOrganisation ;
    dpv:hasPurpose hapt:dpv-CulturalEvent ;
    dpv:hasPurpose hapt:dpv-EventManagement ;
    dpv:hasPurpose hapt:dpv-EventOrganisation ;
    dpv:hasPurpose hapt:dpv-Invitations ;
    dpv:hasPurpose hapt:dpv-MonetaryBenefitsManagement (parent for travel expense reimbursement and fee) ;
    dpv:hasPurpose hapt:dpv-PrivateEventOrganisation ;
    dpv:hasPurpose hapt:dpv-PrivateSectorEvent ;
    dpv:hasPurpose hapt:dpv-PublicEventOrganisation ;
    dpv:hasPurpose hapt:dpv-PublicSectorEvent ;
    dpv:hasPurpose hapt:dpv-Registration ;
    dpv:hasPurpose hapt:dpv-TravelExpenseReimbursement ;
    dpv:hasPurpose hapt:dpv-TravelOrganisation ;
	dpv:hasPurpose hapt:dpv-FeeCollection ;
	dpv:hasPurpose hapt:dpv-CulturalPrograms, hapt:dpv-DocumentTransmission
	dpv:hasData hapt:tech-ImageRecording, hapt:tech-AcousticRecording ;
    dct:source at:DPIANotRequiredList ;
    dct:identifier "CN30" ;
    dpv:hasJurisdiction loc:AT .

at:CN31 a impacto:eu-gdpr-DPIANotRequiredProcess ;
    skos:definition "A process which does not require a DPIA according to the Data Protection Authorities of Austria and which involves: Data processing for the awarding of prizes and decorations or similar awards, including the 
related preliminary examinations."@en ;
    dpv:hasPurpose hapt:dpv-AwardingDecorations, hapt:dpv-AwardingPrizes, hapt:dpv-PreliminaryExaminationForAwards ;
    dct:source at:DPIANotRequiredList ;
    dct:identifier "CN31" ;
    dpv:hasJurisdiction loc:AT .

cz:CN32 a impacto:eu-gdpr-DPIANotRequiredProcess ;
    skos:definition "A process which does not require a DPIA according to the Data Protection Authorities of the Czech Republic and which involves: Processing (processing operations) of personal data of employees with a permanent 
workplace in the territory of the Member State carried out only in the territory of the Member State, within the fulfillment of legal obligations in accounting, payroll, social and health insurance."@en ;
    dpv:hasHumanSubject dpv:Employee ;
	dpv:hasLocation hapt:dpv-MemberStateTerritory ;
	dpv:hasPurpose hapt:dpv-LegalObligationFulfillment, hapt:dpv-Accounting, hapt:dpv-Payroll, hapt:dpv-SocialInsurance, hapt:dpv-HealthInsurance ;
    dct:source cz:DPIANotRequiredList ;
    dct:identifier "CN32" ;
    dpv:hasJurisdiction loc:CZ .

lv:CN32 a impacto:eu-gdpr-DPIANotRequiredProcess ;
    skos:definition "A process which does not require a DPIA according to the Data Protection Authorities of Latvia and which involves: Processing (processing operations) of personal data of employees with a permanent workplace in the 
territory of the Member State carried out only in the territory of the Member State, within the fulfillment of legal obligations in accounting, payroll, social and health insurance."@en ;
    dpv:hasHumanSubject dpv:Employee ;
	dpv:hasLocation hapt:dpv-MemberStateTerritory ;
	dpv:hasPurpose hapt:dpv-LegalObligationFulfillment, hapt:dpv-Accounting, hapt:dpv-Payroll, hapt:dpv-SocialInsurance, hapt:dpv-HealthInsurance ;
    dct:source lv:DPIANotRequiredList ;
    dct:identifier "CN32" ;
    dpv:hasJurisdiction loc:LV .

cz:CN33 a impacto:eu-gdpr-DPIANotRequiredProcess ;
    skos:definition "A process which does not require a DPIA according to the Data Protection Authorities of the Czech Republic and which involves: Processing of personnel records of employees with a permanent workplace in the territory 
of the Member State carried out only in the territory of the Member State."@en ;
	dpv:hasData hapt:dpv-PersonnelRecords
	dpv:hasHumanSubject dpv:Employee ;
	dpv:hasLocation hapt:dpv-MemberStateTerritory ;
    dct:source cz:DPIANotRequiredList ;
    dct:identifier "CN33" ;
    dpv:hasJurisdiction loc:CZ .

cz:CN34 a impacto:eu-gdpr-DPIANotRequiredProcess ;
    skos:definition "A process which does not require a DPIA according to the Data Protection Authorities of the Czech Republic and which involves: Processing (processing operations) of personal data of customers carried out entirely in 
the territory of the Member State, relating to business activities (sales and provision of services, including organizing competitions and sending newsletters), carried out only in the National Language, unless it includes the processing 
of special categories of personal data, evaluation, scoring or systematic monitoring of data subjects."@en ;
	dpv:hasHumanSubject dpv:Customer ;
	dpv:hasLocation hapt:dpv-MemberStateTerritory ;
    dpv:hasPurpose dpv:ServiceProvision, hapt:dpv-Sales, hapt:dpv-CompetitionOrganisation, hapt:dpv-NewsletterDistribution ;
	hapt:dpv-isExpressedInLanguage hapt:dpv-NationalLanguage ;
	dpv:isNotApplicableFor dpv:SpecialCategoryPersonalData, dpv:EvaluationOfIndividuals, dpv:ScoringOfIndividuals, hapt:dpv-SystematicMonitoring ;
    dct:source cz:DPIANotRequiredList ;
    dct:identifier "CN34" ;
    dpv:hasJurisdiction loc:CZ .

lv:CN34 a impacto:eu-gdpr-DPIANotRequiredProcess ;
    skos:definition "A process which does not require a DPIA according to the Data Protection Authorities of Latvia and which involves: Processing (processing operations) of personal data of customers carried out entirely in the territory of 
the Member State, relating to business activities (sales and provision of services, including organizing competitions and sending newsletters), carried out only in the National Language, unless it includes the processing of special categories 
of personal data, evaluation, scoring or systematic monitoring of data subjects."@en ;
   	dpv:hasHumanSubject dpv:Customer ;
	dpv:hasLocation hapt:dpv-MemberStateTerritory ;
    dpv:hasPurpose dpv:ServiceProvision, hapt:dpv-Sales, hapt:dpv-CompetitionOrganisation, hapt:dpv-NewsletterDistribution ;
	hapt:dpv-isExpressedInLanguage hapt:dpv-NationalLanguage ;
	dpv:isNotApplicableFor dpv:SpecialCategoryPersonalData, dpv:EvaluationOfIndividuals, dpv:ScoringOfIndividuals, hapt:dpv-SystematicMonitoring ;
    dct:source lv:DPIANotRequiredList ;
    dct:identifier "CN34" ;
    dpv:hasJurisdiction loc:LV .

cz:CN35 a impacto:eu-gdpr-DPIANotRequiredProcess ;
    skos:definition "A process which does not require a DPIA according to the Data Protection Authorities of the Czech Republic and which involves: Processing (processing operations) associated with an individual customer visit to 
the controller's website, including customer profiling based on their selection of items or displaying items from the offer of goods, products and services placed on the website on the controller's side. This processing does not involve 
the processing of special categories of personal data, data of a highly personal nature (see point 4 on page 11 of the WP248 Guideline) and does not target the processing of personal data on vulnerable data subjects as a separate target group."@en ;
    dpv:hasHumanSubject dpv:Customer ;
	dpv:hasPurpose dpv:Profiling, hapt:dpv-OfferOfGoods, hapt:dpv-OfferOfProducts ;
	dpv:isNotApplicableFor dpv:SpecialCategoryPersonalData, dpv:VulnerableHuman ;
    dct:source cz:DPIANotRequiredList ;
    dct:identifier "CN35" ;
    dpv:hasJurisdiction loc:CZ .

cz:CN36 a impacto:eu-gdpr-DPIANotRequiredProcess ;
    skos:definition "A process which does not require a DPIA according to the Data Protection Authorities of the Czech Republic and which involves: Processing (processing operations) carried out by a person authorised to provide 
healthcare services who is not in an employment relationship. This person uses the necessary personal data only to provide healthcare services to the data subject (see recital 91 of the Regulation), and there is no systematic transfer 
to third countries, no processor is used for some processing operations on personal data of patients, or there is no sharing/linking of personal data of patients of two or more individual doctors."@en ;
	dpv:hasEntity sector-health:HealthCareProvider ;
	dpv:hasPurpose hapt:sector-health-HealthCareProvision ;
	dpv:isNotApplicableFor hapt:dpv-ThirdCountryDataTransfer, dpv:Share, hapt:dpv-Link ;
    dct:source cz:DPIANotRequiredList ;
    dct:identifier "CN36" ;
    dpv:hasJurisdiction loc:CZ .

cz:CN37 a impacto:eu-gdpr-DPIANotRequiredProcess ;
    skos:definition "A process which does not require a DPIA according to the Data Protection Authorities of the Czech Republic and which involves: Processing (processing operations) carried out by individual lawyers and notaries 
(lawyers and notaries who are not in an employment relationship), using the necessary personal data only to provide legal services to the data subject (see recital 91 of the Regulation), and not systematically transferring them to 
third countries, for some of the processing operations on personal data of clients, a processor is not used, or there is no sharing/linking of personal data of clients of two or more individual lawyers."@en ;
	dpv:hasOrganisation hapt:dpv-IndividualLegalPractitioner, hapt:dpv-IndividualNotary ;
	dpv:hasEntity sector-health:HealthCareProvider ;
	dpv:hasPurpose sector-law:LegalAidProvision ;
	dpv:isNotApplicableFor hapt:dpv-ThirdCountryDataTransfer, dpv:Share, hapt:dpv-Link ;
    dct:source cz:DPIANotRequiredList ;
    dct:identifier "CN37" ;
    dpv:hasJurisdiction loc:CZ .

cz:CN38 a impacto:eu-gdpr-DPIANotRequiredProcess ;
    skos:definition "A process which does not require a DPIA according to the Data Protection Authorities of the Czech Republic and which involves: Processing (processing operations) carried out by individual natural persons providing 
social services (persons who are not in an employment relationship), using the necessary personal data only to provide social services to the data subject, and not systematically transferring them to third countries, for some of the 
processing operations on personal data of clients, a processor is not used, or there is no sharing/linking of personal data of clients of two or more individual social service providers."@en ;
	dpv:hasOrganisation hapt:dpv-SocialServiceProvider ;
	dpv:hasPurpose sector-health:SocialServicesProvision ;
	dpv:isNotApplicableFor hapt:dpv-ThirdCountryDataTransfer, dpv:Share, hapt:dpv-Link ;
    dct:source cz:DPIANotRequiredList ;
    dct:identifier "CN38" ;
    dpv:hasJurisdiction loc:CZ .

fr:CN39 a impacto:eu-gdpr-DPIANotRequiredProcess ;
    skos:definition "A process which does not require a DPIA according to the Data Protection Authorities of France and which involves: Processing, implemented solely for human resources purposes and under the conditions provided 
for by applicable regulations, for the sole purpose of managing the personnel of organizations employing fewer than 250 people, with the exception of the use of profiling."@en ;
    dpv:hasPurpose dpv:HumanResourceManagement ;
	dpv:hasProcessingScale hapt:dpv-LessThan250Employees ;
	dpv:isNotApplicableFor dpv:Profiling ;
    dct:source fr:DPIANotRequiredList ;
    dct:identifier "CN39" ;
    dpv:hasJurisdiction loc:FR .

fr:CN40 a impacto:eu-gdpr-DPIANotRequiredProcess ;
    skos:definition "A process which does not require a DPIA according to the Data Protection Authorities of France and which involves: Supplier relationship management processes."@en ;
	dpv:hasPurpose hapt:dpv-SupplierRelationshipManagement ;
    dct:source fr:DPIANotRequiredList ;
    dct:identifier "CN4" ;
    dpv:hasJurisdiction loc:FR .

fr:CN41 a impacto:eu-gdpr-DPIANotRequiredProcess ;
    skos:definition "A process which does not require a DPIA according to the Data Protection Authorities of France and which involves: Processing carried out under the conditions stipulated by the texts relating to the management 
of the electoral register of municipalities"@en ;
    dpv:hasPurpose hapt:dpv-MunicipalityElectoralRegisterManagement ;
    dct:source fr:DPIANotRequiredList ;
    dct:identifier "CN41" ;
    dpv:hasJurisdiction loc:FR .

fr:CN42 a impacto:eu-gdpr-DPIANotRequiredProcess ;
    skos:definition "A process which does not require a DPIA according to the Data Protection Authorities of France and which involves: Data processing intended for the management of the activities of works councils and establishment 
committees."@en ;
    dpv:hasPurpose hapt:dpv-EstablishmentCommitteeActivityManagement ;
    dpv:hasPurpose hapt:dpv-WorkCouncilActivityManagement ;
    dct:source fr:DPIANotRequiredList ;
    dct:identifier "CN42" ;
    dpv:hasJurisdiction loc:FR .

fr:CN43 a impacto:eu-gdpr-DPIANotRequiredProcess ;
    skos:definition "A process which does not require a DPIA according to the Data Protection Authorities of France and which involves: Processing carried out by an association, foundation or any other non-profit institution for the 
management of its members and donors within the framework of its usual activities, provided that the data is not sensitive."@en ;
	dpv:hasEntity hapt:dpv-Association, hapt:dpv-Foundation, dpv:NonProfitOrganisation ;
    dpv:hasPurpose hapt:dpv-DonorManagement ;
    dpv:hasPurpose hapt:dpv-MemberManagement ;
	dpv:isNotApplicableFor dpv:SensitiveData ;
    dct:source fr:DPIANotRequiredList ;
    dct:identifier "CN43" ;
    dpv:hasJurisdiction loc:FR .

fr:CN44 a impacto:eu-gdpr-DPIANotRequiredProcess ;
    skos:definition "A process which does not require a DPIA according to the Data Protection Authorities of France and which involves: Processing of health data necessary for the care of a patient by a healthcare professional practicing 
individually within a medical practice, a pharmacy or a medical biology laboratory."@en ;
	dpv:hasPersonalData pd:Health ;
	dpv:hasPurpose hapt:sector-health-PatientCare ;
	dpv:hasEntity hapt:dpv-IndividualHealthcarePractitioner ;
    dpv:hasOrganisation hapt:sector-health-MedicalLaboratory, hapt:sector-health-MedicalPractice, hapt:sector-health-Pharmacy, hapt:sector-health-MedicalBiologyLaboratory ;
    dct:source fr:DPIANotRequiredList ;
    dct:identifier "CN44" ;
    dpv:hasJurisdiction loc:FR .

fr:CN45 a impacto:eu-gdpr-DPIANotRequiredProcess ;
    skos:definition "A process which does not require a DPIA according to the Data Protection Authorities of France and which involves: Data processing carried out by lawyers in the course of their individual professional practice."@en ;
    dpv:hasEntity hapt:sector-law-IndividualLegalPractice ;
    dct:source fr:DPIANotRequiredList ;
    dct:identifier "CN45" ;
    dpv:hasJurisdiction loc:FR .

fr:CN46 a impacto:eu-gdpr-DPIANotRequiredProcess ;
    skos:definition "A process which does not require a DPIA according to the Data Protection Authorities of France and which involves: Data processing carried out by the clerks of the commercial courts for the purposes of performing 
their duties."@en ;
    dpv:hasEntity hapt:dpv-CommercialCourtClerk ;
    dpv:hasPurpose hapt:sector-law-LegalDuties ;
    dct:source fr:DPIANotRequiredList ;
    dct:identifier "CN46" ;
    dpv:hasJurisdiction loc:FR .

fr:CN47 a impacto:eu-gdpr-DPIANotRequiredProcess ;
    skos:definition "A process which does not require a DPIA according to the Data Protection Authorities of France and which involves: Data processing carried out by notaries for the purposes of carrying out their notarial activities 
and drafting documents for notarial offices."@en ;
    dpv:hasEntity hapt:dpv-Notary ;
    dpv:hasPurpose hapt:dpv-DraftingDocumentation, hapt:sector-law-NotarialActivities ;
    dct:source fr:DPIANotRequiredList ;
    dct:identifier "CN47" ;
    dpv:hasJurisdiction loc:FR .

fr:CN48 a impacto:eu-gdpr-DPIANotRequiredProcess ;
    skos:definition "A process which does not require a DPIA according to the Data Protection Authorities of France and which involves: Data processing carried out by local authorities and public and private legal entities for the 
purpose of managing school, extracurricular and early childhood services."@en ;
    dpv:hasEntity hapt:dpv-LocalAuthority dpv:PublicSectorBody, dpv:PrivateSectorBody ;
    dpv:hasPurpose sector-education:EducationManagement, hapt:sector-education-EarlyChildhoodServiceManagement, hapt:sector-education-ExtraCurricularServiceManagement ;
    dct:source fr:DPIANotRequiredList ;
    dct:identifier "CN48" ;
    dpv:hasJurisdiction loc:FR .

fr:CN49 a impacto:eu-gdpr-DPIANotRequiredProcess ;
    skos:definition "A process which does not require a DPIA according to the Data Protection Authorities of France and which involves: Processing implemented solely for the purpose of managing physical access controls and working 
time calculations, excluding any biometric devices. This excludes the processing of data that reveals sensitive or highly personal information."@en ;
	dpv:hasTechnicalMeasure dpv:PhysicalAccessControlMethod ;
	dpv:hasPurpose hapt:dpv-WorkingTimeCalculations ;
	dpv:isNotApplicableFor hapt:tech-BiometricDevice, dpv:SensitiveData ;
    dct:source fr:DPIANotRequiredList ;
    dct:identifier "CN49" ;
    dpv:hasJurisdiction loc:FR .

fr:CN50 a impacto:eu-gdpr-DPIANotRequiredProcess ;
    skos:definition "A process which does not require a DPIA according to the Data Protection Authorities of France and which involves: Processing related to breathalyzer tests, strictly regulated by legislation and implemented 
within the context of transport activities for the sole purpose of preventing drivers from operating a vehicle under the influence ofmalcohol or narcotics."@en ;
    dpv:hasPurpose hapt:sector-law-RoadVehicleAlcoholTesting, hapt:sector-law-RoadVehicleDrugTesting, hapt:sector-law-RoadVehicleSubstanceImpairmentPrevention ;
	dpv:hasData hapt:dpv-BreathalyzerTestResult ;
    dct:source fr:DPIANotRequiredList ;
    dct:identifier "CN50" ;
    dpv:hasJurisdiction loc:FR .

lv:CN51 a impacto:eu-gdpr-DPIANotRequiredProcess ;
    skos:definition "A process which does not require a DPIA according to the Data Protection Authorities of Latvia and which involves: The processing of health data necessary for the care of the patient by self-employed staff 
working individually in the exercise of their professional duties, such as medical practitioners and healthcare professionals, provided that the processing operations do not involve systematic transfer to third countries."@en ;
    dpv:hasData pd:Health ;
	dpv:hasEntity hapt:dpv-IndividualHealthcarePractitioner ;
	dpv:isNotApplicableFor hapt:dpv-ThirdCountryDataTransfer ;
    dct:source lv:DPIANotRequiredList ;
    dct:identifier "CN51" ;
    dpv:hasJurisdiction loc:LV .

lv:CN52 a impacto:eu-gdpr-DPIANotRequiredProcess ;
    skos:definition "A process which does not require a DPIA according to the Data Protection Authorities of Latvia and which involves: Data processing by lawyers, notaries, sworn bailiffs working individually and engaged in their 
professional activities related to the obligation of professional secrecy, provided that the processing operations do not involve systematic transmission to third countries."@en ;
    dpv:hasEntity hapt:dpv-Lawyer, hapt:dpv-Notary, hapt:dpv-SwornBailiffs ;
    dpv:hasLegalBasis hapt:dpv-ProfessionalSecrecyObligation ;
	dpv:isNotApplicableFor hapt:dpv-ThirdCountryDataTransfer ;
    dct:source lv:DPIANotRequiredList ;
    dct:identifier "CN52" ;
    dpv:hasJurisdiction loc:LV .

lv:CN53 a impacto:eu-gdpr-DPIANotRequiredProcess ;
    skos:definition "A process which does not require a DPIA according to the Data Protection Authorities of Latvia and which involves: Data processing carried out by an association, foundation, for the management of its members and 
donors in the framework of its regular activities, except processing of personal data of a sensitive nature;"@en ;
	dpv:hasEntity hapt:dpv-Association, hapt:dpv-Foundation, dpv:NonProfitOrganisation ;
    dpv:hasPurpose hapt:dpv-DonorManagement ;
    dpv:hasPurpose hapt:dpv-MemberManagement ;
	dpv:isNotApplicableFor dpv:SensitiveData ;
    dct:source lv:DPIANotRequiredList ;
    dct:identifier "CN53" ;
    dpv:hasJurisdiction loc:LV .

lv:CN54 a impacto:eu-gdpr-DPIANotRequiredProcess ;
    skos:definition "A process which does not require a DPIA according to the Data Protection Authorities of Latvia and which involves: Data processing by the association of apartment owners, the co-operative society of apartments or 
the community of apartment owners, in relation to the management of multi-apartment residential buildings and related buildings, and land, except processing on a large scale."@en ;
    dpv:hasEntity hapt:dpv-ApartmentOwner ;
    dpv:hasPurpose hapt:dpv-ResidentialBuildingManagement ;
	dpv:isNotApplicableFor dpv:LargeScaleProcessing ;
    dct:source lv:DPIANotRequiredList ;
    dct:identifier "CN54" ;
    dpv:hasJurisdiction loc:LV .

lv:CN55 a impacto:eu-gdpr-DPIANotRequiredProcess ;
    skos:definition "A process which does not require a DPIA according to the Data Protection Authorities of Latvia and which involves: Processing of data for the management of physical access controls and schedules for the calculation 
of working time, excluding special categories of personal data and/or other personal data of highly sensitive nature."@en ;
	dpv:hasTechnicalMeasure dpv:PhysicalAccessControlMethod ;
	dpv:hasPurpose hapt:dpv-WorkingTimeCalculations ;
	dpv:isNotApplicableFor dpv:SensitiveData ;
    dct:source lv:DPIANotRequiredList ;
    dct:identifier "CN55" ;
    dpv:hasJurisdiction loc:LV .

lv:CN56 a impacto:eu-gdpr-DPIANotRequiredProcess ;
    skos:definition "A process which does not require a DPIA according to the Data Protection Authorities of Latvia and which involves: Processing of data in connection with checks of alcohol or narcotic substances within the framework 
of transport activities arising from legal requirements in the law in order to verify that the driver is not under the influence of alcohol or narcotics."@en ;
    dpv:hasPurpose hapt:sector-law-RoadVehicleAlcoholTesting, hapt:sector-law-RoadVehicleDrugTesting, hapt:sector-law-RoadVehicleSubstanceImpairmentPrevention ;
	dpv:hasData hapt:dpv-BreathalyzerTestResult ;
	dpv:hasPurpose hapt:sector-law-RoadVehicleDriverAlcoholLevelVerification, hapt:sector-law-RoadVehicleDriverDrugInfluenceVerification, hapt:sector-law-RoadVehicleDriverSobrietyVerification ;
    dct:source lv:DPIANotRequiredList ;
    dct:identifier "CN56" ;
    dpv:hasJurisdiction loc:LV .

lv:CN57 a impacto:eu-gdpr-DPIANotRequiredProcess ;
    skos:definition "A process which does not require a DPIA according to the Data Protection Authorities of Latvia and which involves: Processing of data in relation to collective submissions laid down in the Local Government Law."@en ;
    dpv:hasPurpose hapt:dpv-CollectiveSubmissionsManagement ; "A collective submission allows a specific number of local residents to collectively submit an official application or initiative regarding municipal functions directly to the local council"@en (add this to definition of this concept) ;
    dct:source lv:DPIANotRequiredList ;
    dct:identifier "CN57" ;
    dpv:hasJurisdiction loc:LV .

es:CN58 a impacto:eu-gdpr-DPIANotRequiredProcess ;
    skos:definition "A process which does not require a DPIA according to the Data Protection Authorities of Spain and which involves: Processing carried out strictly under the guidelines established or authorized previously, 
by way of circulars or decisions issued by supervisory bodies, whenever the processing has not changed since it was authorized."@en ;
    hapt:hasExemptionBasis hapt:dpv-AuthorisedProcessing ;
    dct:source es:DPIANotRequiredList ;
    dct:identifier "CN58" ;
    dpv:hasJurisdiction loc:ES .

es:CN59 a impacto:eu-gdpr-DPIANotRequiredProcess ;
    skos:definition "A process which does not require a DPIA according to the Data Protection Authorities of Spain and which involves: Processing carried out strictly under the guidelines of codes of conduct approved by the 
Commission or by supervisory bodies, whenever a full DPIA has already been carried out within a context of a validated code of conduct, and is implemented with the measures and safeguards defined in the DPIA."@en ;
    dpv:hasTechnicalOrganisationalMeasure dpv:CodeOfConduct ;
	dpv:hasStatus eu-gdpr:DPIAOutcomeRisksMitigated ;
    dct:source es:DPIANotRequiredList ;
    dct:identifier "CN59" ;
    dpv:hasJurisdiction loc:ES .

es:CN60 a impacto:eu-gdpr-DPIANotRequiredProcess ;
    skos:definition "A process which does not require a DPIA according to the Data Protection Authorities of Spain and which involves: Processing that is necessary in order to comply with a legal requirement or to complete a 
mission being carried out in the public interest or in the exercise of official authority vested in the controller, provided that there is no duty to carry out a DPIA within the legal mandate itself, whenever a full DPIA has already 
been performed."@en ;
	dpv:hasStatus hapt:dpv-DPIAComplete ;
	dpv:hasLegalBasis dpv:OfficalAuthorityOfController, dpv:PublicInterest, hapt:dpv-LegalRequirement ;
    dct:source es:DPIANotRequiredList ;
    dct:identifier "CN60" ;
    dpv:hasJurisdiction loc:ES .

es:CN61 a impacto:eu-gdpr-DPIANotRequiredProcess ;
    skos:definition "A process which does not require a DPIA according to the Data Protection Authorities of Spain and which involves: Processing carried out by self-employed personnel who work on an individual basis in the 
exercise of their professional duties, especially physicians, healthcare professionals, or lawyers, unless two or more criteria established in the list of types of data processing that require impact assessment are met."@en ;
    dpv:hasEntity hapt:dpv-SelfEmployedPersonnel ;
	dpv:hasEntity hapt:dpv-Physician, hapt:dpv-HealthcareProfessional, hapt:dpv-Lawyer ;
	dct:source es:DPIANotRequiredList ;
    dct:identifier "CN61" ;
    dpv:hasJurisdiction loc:ES ;
	dct:scopeNote "unless two or more criteria established in the list of types of data processing that require impact assessment are met" @en . 

es:CN62 a impacto:eu-gdpr-DPIANotRequiredProcess ;
    skos:definition "A process which does not require a DPIA according to the Data Protection Authorities of Spain and which involves: Processing carried out in relation to the internal administration of personnel working at SMEs, 
in order to face processing operations mandatory by law for the purposes of accounting, human resources management, payroll management, social security, and safety in the workplace, but never in relation to customer data."@en ;
    dpv:hasPurpose hapt:dpv-InternalAdministration, hapt:dpv-Accounting, dpv:HumanResourceManagement, hapt:dpv-PayrollManagement, sector-publicservices:SocialSecurityManagement, hapt:dpv-WorkplaceSafety ;
