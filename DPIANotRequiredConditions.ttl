at:CN11 a impacto:eu-gdpr-DPIANotRequiredProcess ;
	skos:definition "A process which does not require a DPIA according to the Data Protection Authorities of Austria and which involves: Processing of own or purchased customer and interested party data for the business initiation regarding the own delivery or service offer as well as for the implementation of advertising measures and newsletter dispatch."@en ;
    dpv:hasEntity impacto:dpv-InterestedParty ;
    dpv:hasPurpose impacto:dpv-BusinessInitiation, impacto:dpv-DeliveryOffering, impacto:dpv-NewsletterDistribution, impacto:dpv-ServiceOffering, dpv:Advertising ;
	dpv:hasHumanSubject dpv:Customer ;
	dpv:hasSubject impacto:dpv-InterestedParty ;
    dct:source at:DPIANotRequiredList ;
    dct:identifier "CN11" ;
    dpv:hasJurisdiction loc:AT .


at:CN12 a impacto:eu-gdpr-DPIANotRequiredProcess ;
    skos:definition "A process which does not require a DPIA according to the Data Protection Authorities of Austria and which involves: Inventory management (management of inventory records), support for the exchange of goods and the company's accounting, ancillary and auxiliary records of suppliers related to inventory management, acquisition costs and management of the allocation of hardware and software to computer system users."@en ;
    dpv:hasPurpose impacto:dpv-InventoryManagement, impacto:dpv-ExchangeOfGoods, impacto:dpv-Accounting, impacto:dpv-HardwareUserAllocation, impacto:dpv-SoftwareUserAllocation  ;
	dpv:hasData impacto:dpv-AcquisitionCosts, impacto:dpv-AncillaryRecords, impacto:dpv-AuxiliaryRecords ;
    dct:source at:DPIANotRequiredList ;
    dct:identifier "CN12" ;
    dpv:hasJurisdiction loc:AT .


at:CN13 a impacto:eu-gdpr-DPIANotRequiredProcess ;
    skos:definition "A process which does not require a DPIA according to the Data Protection Authorities of Austria and which involves: Processing of personal data within the framework of registers, evidence or books established by Union, federal or state law, provided that no personal data within the meaning of Art. 9 and 10 GDPR are processed."@en ;
    dpv:hasData impacto:dpv-NationalLevelRegisters ;
    dpv:hasData impacto:dpv-PersonalDataRegisters ;
    dpv:hasData impacto:dpv-UnionLevelRegisters ;
    dpv:hasEntity impacto:dpv-FederalAuthority ;
    dct:source at:DPIANotRequiredList ;
    dct:identifier "CN13" ;
    dpv:hasJurisdiction loc:AT .
dpv:hasLegalBasis dpv:LegalObligation ;
	dpv:hasPurpose impacto:dpv-StatutoryRecordKeeping ;
	dpv:hasContext impacto:dpv-DataRegister ;

at:CN14 a impacto:eu-gdpr-DPIANotRequiredProcess ;
    skos:definition "A process which does not require a DPIA according to the Data Protection Authorities of Austria and which involves: Management of usernames and passwords as well as system access logging."@en ;
    dpv:hasTechnicalMeasure impacto:dpv-AccessLogins ;
    dct:source at:DPIANotRequiredList ;
    dct:identifier "CN14" ;
    dpv:hasJurisdiction loc:AT .
	dpv:hasPurpose dpv:IdentityManagement ;
	dpv:hasPurpose dpv:SecurityManagement ;
	dpv:hasPersonalData pd:UserID ;

at:CN15 a impacto:eu-gdpr-DPIANotRequiredProcess ;
    skos:definition "A process which does not require a DPIA according to the Data Protection Authorities of Austria and which involves: Control of the authorization of access to buildings and delimited areas by the owner or authorized user with the help of systems that process personal data with automated assistance, whereby no biometric data of data subjects are processed. The mere real-time reproduction of facial images is covered by this exception."@en ;
    dpv:hasDataSource impacto:dpv-ImageData ;
    dpv:hasDataSource impacto:dpv-VideoData ;
    dpv:hasDataSource impacto:pd-FacialImages ;
    dpv:isImplementedUsingTechnology impacto:tech-AutomatedAccess ;
    dct:source at:DPIANotRequiredList ;
    dct:identifier "CN15" ;
    dpv:hasJurisdiction loc:AT .
	dpv:hasPurpose dpv:AccessControl ;
	dpv:hasPurpose dpv:PhysicalAccessControl ;
	dpv:hasLocation dpv:PrivateLocation ;

at:CN16 a impacto:eu-gdpr-DPIANotRequiredProcess ;
    skos:definition "A process which does not require a DPIA according to the Data Protection Authorities of Austria and which involves: Stationary image processing and associated acoustic processing for monitoring purposes (video surveillance). Subject to conditions. Spatial recording area: Localities over which the person responsible is authorized to dispose. The video surveillance may not extend beyond the property, with the exception of an inevitable inclusion of public traffic areas to the extent of up to half a meter measured from the property boundary of the monitored object. In addition, video surveillance may not be operated in places that represent the most personal area of life of people. Storage period: Recorded personal data must be deleted by the controller after 72 hours at the latest, unless a longer storage period has been expressly stipulated in a law, by an official legal act, in a works agreement or with the consent of the personnel representation. Identification: The prerequisite for the exception is the appropriate identification of the image processing by the person responsible. In any case, the person responsible must be clearly stated from the marking."@en ;
    dpv:hasContext impacto:dpv-PropertyBoundaryLimitation ;
    dpv:hasDataSource impacto:dpv-AudioData ;
    dpv:hasLocation impacto:dpv-LimitedPublicArea ;
    dpv:hasPersonalData impacto:pd-Gait ;
    dct:source at:DPIANotRequiredList ;
    dct:identifier "CN16" ;
    dpv:hasJurisdiction loc:AT .
dpv:hasPurpose impacto:dpv-Monitoring ;
	dpv:hasData tech:VideoContent ;
	dpv:hasData tech:AudioContent ;
	dpv:hasLocation dpv:PrivateLocation ;

at:CN17  a impacto:eu-gdpr-DPIANotRequiredProcess ;
    skos:definition "A process which does not require a DPIA according to the Data Protection Authorities of Austria and which involves: Image and acoustic processing, which serve the preventive protection of persons or things on private properties used for residential purposes, which are used exclusively by the person responsible and by all authorized users living in the common household. The prerequisite is the consent of all authorized users."@en ;
    dpv:hasContext impacto:dpv-PrivateUse ;
    dpv:hasContext impacto:dpv-ResidentialUse ;
    dpv:hasEntity impacto:dpv-PropertyOwner ;
    dpv:hasPurpose impacto:dpv-ResidentialPurpose ;
    dpv:hasTechnicalMeasure impacto:dpv-PersonsPreventativeProtection ;
    dpv:hasTechnicalMeasure impacto:dpv-PropertyPreventativeProtection ;
    dct:source at:DPIANotRequiredList ;
    dct:identifier "CN17" ;
    dpv:hasJurisdiction loc:AT .
dpv:hasPurpose impacto:dpv-PreventativeProtectionOfPersons ;
