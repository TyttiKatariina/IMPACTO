#TR seperate all these at:CN7 a impacto:eu-gdpr-DPIANotRequiredProcess ;
    skos:definition "A process which does not require a DPIA according to the Data Protection Authorities of Austria: Processing and evident of service law, salary-related, training-related and other personal data directly related to the employment relationship of public servants and other persons paid by those responsible for the public sector (such as civil servants, contract staff, persons in training, temporary staff, but also deputies and civil servants) as well as volunteers and civil servants (each without remuneration) by the service authorities and personnel departments for the purpose of individual personnel measures and statistical evaluations."@en ;
    dpv:hasEntity impacto:dpv-CivilServant ;
    dpv:hasEntity impacto:dpv-Deputies ;
    dpv:hasEntity impacto:dpv-HumanResourceDepartment ;
    dpv:hasEntity impacto:dpv-PersonnelInTraining ;
    dpv:hasEntity impacto:dpv-PublicServant ;
    dpv:hasEntity impacto:dpv-StaffOnContract ;
    dpv:hasEntity impacto:dpv-TemporaryStaff ;
    dpv:hasPurpose impacto:tech-StatisticalEvaluations ;
	dpv:hasPurpose impacto:dpv-PersonnelMeasures ; 
	dpv:hasPurpose dpv:PersonnelPayment ;
	dpv:hasPurpose impacto:dpv-PersonnelTraining ;
	dpv:hasResponsibleEntity dpv:PublicSectorBody ;
    dct:source at:DPIANotRequiredList ;
    dct:identifier "CN7" ;
    dpv:hasJurisdiction loc:AT .

at:CN8 a impacto:eu-gdpr-DPIANotRequiredProcess ;
    skos:definition "A process which does not require a DPIA according to the Data Protection Authorities of Austria: Processing and preservation of personal data of applicants, if this data has been provided by the data subject."@en ;
