annex3:C8a a eu-aiact:HighRiskAISystem-AnnexIII-8-a ;
    dct:identifier "8a" ;
    skos:definition "8. Administration of justice and democratic processes: (a) AI systems intended to be used by a judicial authority or on their behalf to assist a judicial authority in researching and interpreting facts and the law and in applying the law to a concrete set of facts or used in a similar way in alternative dispute resolution;"@en ;
    dpv:hasSector eu-aiact:JusticeSector ;
    dpv:hasPurpose hapt:sector-law-JudicialFactResearch, sector-law:JudicialLegalInterpretation, hapt:sector-law-LawApplicationToFacts, hapt:dpv-AlternativeDisputeResolution ;
    dpv:hasRisk hapt:risk-LegalEffects ;
    dpv:isImplementedUsingTechnology ai:AISystem ;
    tech:hasDeployer dpv:JudicialOrganisation, vair:JudicialAuthorityAgent ;
    dpv:hasStatus eu-gdpr:DPIARequired ;
    hapt:eu-gdpr-hasDPIARequiredCondition eu-gdpr:C9, eu-gdpr:C6, at:C32, cz:C32, dk:C32, de:C32, gr:C32 ;
    skos:note "DPIA required by member states: AT CZ DK DE GR (Use of AI in processing)"@en ;
    skos:note "member state processing activity: AT CZ DK DE GR"@en ;
    dct:source "AI Act Annex III 8(a)" ;
    dpv:hasJurisdiction loc:EU .

annex3:C8a-1 a eu-aiact:HighRiskAISystem-AnnexIII-8-a ;
    dct:identifier "8a.1" ;
    skos:definition "A use case developed from AI Act Annex III point 8(a) in which the AI system involves purpose: researching and interpreting facts and the law, applying the law to facts, applying facts for dispute resolution; processing context: (automated) decision making, profiling, evaluation or scoring, legal effects / processing resulting in legal effects; technology: AI; AI or data subjects: natural persons; deployer: judicial authority, judicial authority agent."@en ;
    skos:broader annex3:C8a ;
    dpv:hasSector eu-aiact:JusticeSector ;
    dpv:hasPurpose hapt:sector-law-JudicialFactResearch, sector-law:JudicialLegalInterpretation, hapt:sector-law-LawApplicationToFacts, hapt:dpv-AlternativeDisputeResolution ;
    dpv:hasRisk hapt:risk-LegalEffects ;
    dpv:hasContext dpv:AutomatedDecisionMaking, dpv:EvaluationOfIndividuals, dpv:ScoringOfIndividuals ;
    dpv:hasProcessing eu-gdpr:Profiling ;
    dpv:isImplementedUsingTechnology ai:AISystem ;
    dpv:hasHumanSubject dpv:NaturalPerson ;
    tech:hasDeployer dpv:JudicialOrganisation, vair:JudicialAuthorityAgent ;
    hapt:eu-gdpr-hasDPIARequiredCondition at:C32, cz:C32, dk:C32, de:C32, gr:C32, cy:C14a, cy:C14b, cy:C14c, cy:C14d, dk:C14a, dk:C14b, dk:C14c, dk:C14d, fi:C14a, fi:C14b, fi:C14c, fi:C14d, fr:C14a, fr:C14b, fr:C14c, fr:C14d, de:C14a, de:C14b, de:C14c, de:C14d, gr:C14a, gr:C14b, gr:C14c, gr:C14d, hu:C14a, hu:C14b, hu:C14c, hu:C14d, is_:C14a, is_:C14b, is_:C14c, is_:C14d, ie:C14a, ie:C14b, ie:C14c, ie:C14d, it:C14a, it:C14b, it:C14c, it:C14d, lv:C14a, lv:C14b, lv:C14c, lv:C14d, li:C14a, li:C14b, li:C14c, li:C14d, lu:C14a, lu:C14b, lu:C14c, lu:C14d, no:C14a, no:C14b, no:C14c, no:C14d, pl:C14a, pl:C14b, pl:C14c, pl:C14d, pt:C14a, pt:C14b, pt:C14c, pt:C14d, ro:C14a, ro:C14b, ro:C14c, ro:C14d, sk:C14a, sk:C14b, sk:C14c, sk:C14d, es:C14a, es:C14b, es:C14c, es:C14d, se:C14a, se:C14b, se:C14c, se:C14d ;
    skos:note "DPIA required by member states: AT CZ DK DE GR (Use of AI in processing) CY DK FI FR DE GR HU IS IE IT LV LI LU NO PL PT RO SK ES SE(evaluation or scoring)"@en ;
    dct:source "AI Act Annex III 8(a)" ;
    dpv:hasJurisdiction loc:EU .

annex3:C8a-2 a eu-aiact:HighRiskAISystem-AnnexIII-8-a ;
    dct:identifier "8a.2" ;
    skos:definition "A use case developed from AI Act Annex III point 8(a) in which the AI system involves purpose: researching and interpreting facts and the law, applying the law to facts, applying facts for dispute resolution; processing context: criminal offences; technology: AI; special categories of personal data: criminal offences; AI or data subjects: natural persons; deployer: judicial authority, judicial authority agent."@en ;
    skos:broader annex3:C8a ;
    dpv:hasSector eu-aiact:JusticeSector ;
    dpv:hasPurpose hapt:sector-law-JudicialFactResearch, sector-law:JudicialLegalInterpretation, hapt:sector-law-LawApplicationToFacts, hapt:dpv-AlternativeDisputeResolution ;
