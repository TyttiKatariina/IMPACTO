    skos:note "DPIA required by member states: AT CZ DK DE GR (Use of AI in processing) ALL (criminal offences)"@en ;
    dct:source "AI Act Annex III 8(a)" ;
    dpv:hasJurisdiction loc:EU .

annex3:C8b a eu-aiact:HighRiskAISystem-AnnexIII-8-b ;
    dct:identifier "8b" ;
    skos:definition "8. Administration of justice and democratic processes:(b) AI systems intended to be used for influencing the outcome of an election or referendum or the voting behaviour of natural persons in the exercise of their vote in elections or referenda. This does not include AI systems whose output natural persons are not directly exposed to, such as tools used to organise, optimise and structure political campaigns from an administrative and logistic point of view."@en ;
    dpv:hasSector eu-aiact:JusticeSector ;
    dpv:hasPurpose hapt:dpv-ElectionOutcomeInfluencing, hapt:dpv-ReferendumOutcomeInfluencing, hapt:dpv-VotingBehaviourInfluencing ;
    dpv:hasRisk hapt:risk-LegalEffects ;
    dpv:isImplementedUsingTechnology ai:AISystem ;
    dpv:hasPersonalData pd:Behavioural ;
    dpv:hasHumanSubject dpv:NaturalPerson ;
    tech:hasDeployer dpv:JudicialOrganisation, vair:JudicialAuthorityAgent ;
    dpv:isNotApplicableFor hapt:eu-aiact-NoDirectExposureToOutput ;
    hapt:eu-gdpr-hasDPIARequiredCondition pl:C22, at:C32, cz:C32, dk:C32, de:C32, gr:C32 ;
    skos:note "DPIA required by member states: PL (Processing by public authorities or private parties of personal data relating to party affiliation and/or electoral preferences)"@en ;
    skos:note "member state processing activity: AT CZ DK DE GR"@en ;
    dct:source "AI Act Annex III 8(b)" ;
    dpv:hasJurisdiction loc:EU .

annex3:C8b-1 a eu-aiact:HighRiskAISystem-AnnexIII-8-b ;
