    skos:note "DPIA required by member states: SE, AT, CY, IE, IT LV, MT SI (Asylum seekers) AT CZ DK DE GR (Use of AI in processing)"@en ;
    skos:note "member state processing activity: AT CZ DK DE GR"@en ;
    skos:note "Asylum seekers (unlabelled column): Asylum seekers: SE, AT, CY, IE, IT LV, MT SI"@en ;
    dct:source "AI Act Annex III 7(d)" ;
    dpv:hasJurisdiction loc:EU .

