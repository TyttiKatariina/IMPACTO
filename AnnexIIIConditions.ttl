    dpv:hasHumanSubject dpv:NaturalPerson ;
    tech:hasDeployer hapt:dpv-PublicAuthority, vair:PublicAuthorityAgent, vair:EUAgency, vair:EUOffice, vair:EUBody ;
    dpv:isNotApplicableFor sector-law:ImmigrationBorderDocumentVerification ;
    dpv:hasStatus eu-gdpr:DPIARequired ;
