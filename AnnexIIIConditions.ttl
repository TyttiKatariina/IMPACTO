annex3:C1a a eu-aiact:HighRiskAISystem-AnnexIII-1-a ;
    dct:identifier "1a" ;
    skos:definition "1. Biometrics, insofar as their use is permitted under relevant Union or national law: (a) Remote biometric identification systems. This shall not include AI systems intended to be used for biometric verification whose sole purpose is to confirm that a specific natural person is the person he or she claims to be;"@en ;
    dpv:hasPurpose hapt:dpv-Identification ;
    dpv:hasRisk hapt:risk-LegalEffects ;
    dpv:isImplementedUsingTechnology ai:AISystem ;
    ai:hasCapability ai:RemoteBiometricIdentification ;
    dpv:hasPersonalData eu-gdpr:BiometricData ;
    dpv:hasHumanSubject dpv:NaturalPerson ;
    dpv:isNotApplicableFor eu-aiact:BiometricVerification ;
    dpv:hasStatus eu-gdpr:DPIARequired ;
    hapt:eu-gdpr-hasDPIARequiredCondition eu-gdpr:C9, at-gdpr:C11, be:C11, bg:C11, hr:C11, cz:C11, dk:C11, ee:C11, fi:C11, fr:C11, de:C11, gr:C11, hu:C11, is_:C11, ie:C11, lv:C11, li:C11, lt:C11, lu:C11, mt:C11, nl:C11, no:C11, pl:C11, pt:C11, sk:C11, si:C11, es:C11 ;
    skos:note "DPIA required by member states: AT BE BG HR CZ DK EE FI FR DE GR HU IS IE LV LI LT LU MT NL NO PL PT SK SI ES (Biometrics)"@en ;
    dct:source "AI Act Annex III 1(a)" ;
    dpv:hasJurisdiction loc:EU .

annex3:C1b a eu-aiact:HighRiskAISystem-AnnexIII-1-b ;
    dct:identifier "1b" ;
    skos:definition "1. Biometrics, insofar as their use is permitted under relevant Union or national law: (b) AI systems intended to be used for biometric categorisation, according to sensitive or protected attributes or characteristics based on the inference of those attributes or characteristics;"@en ;
    dpv:hasRisk hapt:risk-LegalEffects ;
    dpv:hasProcessing dpv:Infer, eu-gdpr:Profiling ;
    dpv:isImplementedUsingTechnology ai:AISystem ;
    ai:hasCapability ai:BiometricCategorisation ;
    dpv:hasPersonalData eu-gdpr:BiometricData, dpv:SensitivePersonalData ;
    dpv:hasHumanSubject dpv:NaturalPerson ;
    dpv:hasStatus eu-gdpr:DPIARequired ;
    hapt:eu-gdpr-hasDPIARequiredCondition eu-gdpr:C9, eu-gdpr:C4a, at-gdpr:C11, be:C11, bg:C11, hr:C11, cz:C11, dk:C11, ee:C11, fi:C11, fr:C11, de:C11, gr:C11, hu:C11, is_:C11, ie:C11, lv:C11, li:C11, lt:C11, lu:C11, mt:C11, nl:C11, no:C11, pl:C11, pt:C11, sk:C11, si:C11, es:C11 ;
    skos:note "DPIA required by member states: AT BE BG HR CZ DK EE FI FR DE GR HU IS IE LV LI LT LU MT NL NO PL PT SK SI ES (Biometrics)"@en ;
    dct:source "AI Act Annex III 1(b)" ;
    dpv:hasJurisdiction loc:EU .

annex3:C1c a eu-aiact:HighRiskAISystem-AnnexIII-1-c ;
    dct:identifier "1c" ;
    skos:definition "1. Biometrics, insofar as their use is permitted under relevant Union or national law: (c) AI systems intended to be used for emotion recognition."@en ;
    dpv:hasRisk hapt:risk-LegalEffects ;
    dpv:isImplementedUsingTechnology ai:AISystem ;
    ai:hasCapability ai:EmotionRecognition ;
    dpv:hasPersonalData eu-gdpr:BiometricData, pd:Emotion ;
    dpv:hasHumanSubject dpv:NaturalPerson ;
    dpv:hasStatus eu-gdpr:DPIARequired ;
    hapt:eu-gdpr-hasDPIARequiredCondition eu-gdpr:C9, at-gdpr:C11, be:C11, bg:C11, hr:C11, cz:C11, dk:C11, ee:C11, fi:C11, fr:C11, de:C11, gr:C11, hu:C11, is_:C11, ie:C11, lv:C11, li:C11, lt:C11, lu:C11, mt:C11, nl:C11, no:C11, pl:C11, pt:C11, sk:C11, si:C11, es:C11 ;
    skos:note "DPIA required by member states: AT BE BG HR CZ DK EE FI FR DE GR HU IS IE LV LI LT LU MT NL NO PL PT SK SI ES (Biometrics)"@en ;
    dct:source "AI Act Annex III 1(c)" ;
    dpv:hasJurisdiction loc:EU .

annex3:C2 a eu-aiact:HighRiskAISystem-AnnexIII-2 ;
    dct:identifier "2a" ;
    skos:definition "2. Critical infrastructure: (a) AI systems intended to be used as safety components in the management and operation of critical digital infrastructure, road traffic and the supply of water, gas, heating and electricity."@en ;
    dpv:hasSector eu-aiact:CriticalInfrastructureSector ;
    dpv:hasPurpose hapt:dpv-CriticalDigitalInfrastructureManagement, hapt:dpv-CriticalDigitalInfrastructureOperation, hapt:dpv-RoadTrafficManagement, hapt:dpv-RoadTrafficOperation, hapt:dpv-WaterSupplyManagement, hapt:dpv-WaterSupplyOperation, hapt:dpv-GasSupplyManagement, hapt:dpv-GasSupplyOperation, hapt:dpv-HeatingSupplyManagement, hapt:dpv-HeatingSupplyOperation, hapt:dpv-ElectricitySupplyManagement, hapt:dpv-ElectricitySupplyOperation ;
    dpv:hasRisk hapt:risk-LegalEffects ;
    dpv:isImplementedUsingTechnology ai:AISystem, eu-aiact:SafetyComponent ;
    tech:hasDeployer hapt:dpv-CriticalInfrastructureOperator ;
    hapt:eu-gdpr-hasDPIARequiredCondition at:C32, cz:C32, dk:C32, de:C32, gr:C32 ;
    skos:note "DPIA required by member states: AT CZ DK DE GR (Use of AI in processing)"@en ;
    dct:source "AI Act Annex III 2" ;
    dpv:hasJurisdiction loc:EU .

annex3:C2-1 a eu-aiact:HighRiskAISystem-AnnexIII-2 ;
    dct:identifier "2a.1." ;
    skos:definition "A use case developed from AI Act Annex III point 2(a) in which the AI system involves purpose: controlling safety of critical digital infrastructure / road traffic / supply of water, gas, heating, electricity; technology: AI, smart meters; deployer: critical infrastructure operations / management."@en ;
    skos:broader annex3:C2a ;
    dpv:hasSector eu-aiact:CriticalInfrastructureSector ;
    dpv:hasPurpose hapt:dpv-CriticalDigitalInfrastructureManagement, hapt:dpv-CriticalDigitalInfrastructureOperation, hapt:dpv-RoadTrafficManagement, hapt:dpv-RoadTrafficOperation, hapt:dpv-WaterSupplyManagement, hapt:dpv-WaterSupplyOperation, hapt:dpv-GasSupplyManagement, hapt:dpv-GasSupplyOperation, hapt:dpv-HeatingSupplyManagement, hapt:dpv-HeatingSupplyOperation, hapt:dpv-ElectricitySupplyManagement, hapt:dpv-ElectricitySupplyOperation ;
    dpv:hasRisk hapt:risk-LegalEffects ;
    dpv:isImplementedUsingTechnology ai:AISystem, hapt:tech-SmartMeter, eu-aiact:SafetyComponent ;
    tech:hasDeployer hapt:dpv-CriticalInfrastructureOperator ;
    hapt:eu-gdpr-hasDPIARequiredCondition hu:C23, pl:C23, ro:C23, at:C32, cz:C32, dk:C32, de:C32, gr:C32 ;
    skos:note "DPIA required by member states: HU, PL, RO (smart meters), AT CZ DK DE GR (Use of AI in processing)"@en ;
    dct:source "AI Act Annex III 2" ;
    dpv:hasJurisdiction loc:EU .

annex3:C2-2 a eu-aiact:HighRiskAISystem-AnnexIII-2 ;
    dct:identifier "2a.2." ;
    skos:definition "A use case developed from AI Act Annex III point 2(a) in which the AI system involves purpose: controlling safety of critical digital infrastructure / road traffic / supply of water, gas, heating, electricity; technology: AI, road traffic smart video analysis system; deployer: critical infrastructure operations / management."@en ;
    skos:broader annex3:C2a ;
    dpv:hasSector eu-aiact:CriticalInfrastructureSector ;
    dpv:hasPurpose hapt:dpv-CriticalDigitalInfrastructureManagement, hapt:dpv-CriticalDigitalInfrastructureOperation, hapt:dpv-RoadTrafficManagement, hapt:dpv-RoadTrafficOperation, hapt:dpv-WaterSupplyManagement, hapt:dpv-WaterSupplyOperation, hapt:dpv-GasSupplyManagement, hapt:dpv-GasSupplyOperation, hapt:dpv-HeatingSupplyManagement, hapt:dpv-HeatingSupplyOperation, hapt:dpv-ElectricitySupplyManagement, hapt:dpv-ElectricitySupplyOperation ;
    dpv:hasRisk hapt:risk-LegalEffects ;
    dpv:isImplementedUsingTechnology ai:AISystem, hapt:tech-SmartVideoAnalysisSystem, eu-aiact:SafetyComponent ;
    tech:hasDeployer hapt:dpv-CriticalInfrastructureOperator ;
    hapt:eu-gdpr-hasDPIARequiredCondition cy:C49, at:C43a, at:C43c, cy:C43a, cy:C43c, at:C32, cz:C32, dk:C32, de:C32, gr:C32 ;
    skos:note "DPIA required by member states: AT CY (road traffic analysis) AT CZ DK DE GR (Use of AI in processing)"@en ;
    dct:source "AI Act Annex III 2" ;
    dpv:hasJurisdiction loc:EU .

annex3:C2-3 a eu-aiact:HighRiskAISystem-AnnexIII-2 ;
    dct:identifier "2a.3." ;
    skos:definition "A use case developed from AI Act Annex III point 2(a) in which the AI system involves purpose: controlling safety of critical digital infrastructure / road traffic / supply of water, gas, heating, electricity; technology: AI, public transport monitoring system; deployer: critical infrastructure operations / management."@en ;
    skos:broader annex3:C2a ;
    dpv:hasSector eu-aiact:CriticalInfrastructureSector ;
    dpv:hasPurpose hapt:dpv-CriticalDigitalInfrastructureManagement, hapt:dpv-CriticalDigitalInfrastructureOperation, hapt:dpv-RoadTrafficManagement, hapt:dpv-RoadTrafficOperation, hapt:dpv-WaterSupplyManagement, hapt:dpv-WaterSupplyOperation, hapt:dpv-GasSupplyManagement, hapt:dpv-GasSupplyOperation, hapt:dpv-HeatingSupplyManagement, hapt:dpv-HeatingSupplyOperation, hapt:dpv-ElectricitySupplyManagement, hapt:dpv-ElectricitySupplyOperation ;
    dpv:hasRisk hapt:risk-LegalEffects ;
    dpv:isImplementedUsingTechnology ai:AISystem, hapt:tech-PublicTransportMonitoringSystem, eu-aiact:SafetyComponent ;
    tech:hasDeployer hapt:dpv-CriticalInfrastructureOperator ;
    hapt:eu-gdpr-hasDPIARequiredCondition at:C32, cz:C32, dk:C32, de:C32, gr:C32 ;
    skos:note "DPIA required by member states: AT CZ DK DE GR (Use of AI in processing) RO SK (public transport)"@en ;
    skos:editorialNote "No condition found in DPIARequiredConditions.ttl for: Public transport (RO, SK)"@en ;
    dct:source "AI Act Annex III 2" ;
    dpv:hasJurisdiction loc:EU .

annex3:C3a a eu-aiact:HighRiskAISystem-AnnexIII-3-a ;
    dct:identifier "3a" ;
    skos:definition "3. Education and vocational training: (a) AI systems intended to be used to determine access or admission or to assign natural persons to educational and vocational training institutions at all level"@en ;
    dpv:hasSector eu-aiact:EducationSector ;
    dpv:hasPurpose sector-education:StudentAdmissionScreening, sector-education:StudentInstituteAllocation ;
    dpv:hasRisk hapt:risk-LegalEffects ;
    dpv:hasContext dpv:AutomatedDecisionMaking ;
    dpv:hasProcessing eu-gdpr:Profiling ;
    dpv:isImplementedUsingTechnology ai:AISystem ;
    dpv:hasHumanSubject dpv:NaturalPerson ;
    tech:hasDeployer dpv:EducationalOrganisation, hapt:dpv-VocationalTrainingInstitution ;
    dpv:hasStatus eu-gdpr:DPIARequired ;
    hapt:eu-gdpr-hasDPIARequiredCondition eu-gdpr:C9, eu-gdpr:C6, eu-gdpr:C8a, eu-gdpr:C4a, at:C32, cz:C32, dk:C32, de:C32, gr:C32, at:C48a, at:C48b ;
    skos:note "DPIA required by member states: AT CZ DK DE GR (Use of AI in processing) AT DE LV ES (Assessing or classfying of people)"@en ;
    skos:editorialNote "No condition found in DPIARequiredConditions.ttl for: Assessing or classifying people (DE, LV, ES)"@en ;
    dct:source "AI Act Annex III 3(a)" ;
    dpv:hasJurisdiction loc:EU .

annex3:C3a-1 a eu-aiact:HighRiskAISystem-AnnexIII-3-a ;
    dct:identifier "3a.1." ;
    skos:definition "A use case developed from AI Act Annex III point 3(a) in which the AI system involves purpose: determine access/admission, assign persons (to institutions); processing context: assessing or classifying natural persons, systematic assessment of skills / competences / outcomes of tests, mental health, development; technology: AI; AI or data subjects: natural persons; deployer: educational and vocational training institutions."@en ;
    skos:broader annex3:C3a ;
    dpv:hasSector eu-aiact:EducationSector ;
    dpv:hasPurpose sector-education:StudentAdmissionScreening, sector-education:StudentInstituteAllocation ;
    dpv:hasRisk hapt:risk-LegalEffects ;
    dpv:hasContext dpv:EvaluationOfIndividuals, hapt:dpv-ClassificationOfIndividuals, hapt:eu-gdpr-Systematic ;
    dpv:hasProcessing dpv:Assess ;
    dpv:isImplementedUsingTechnology ai:AISystem ;
    dpv:hasPersonalData hapt:pd-Skills, hapt:pd-Competency, hapt:pd-AssessmentOutcome, pd:MentalHealth, hapt:pd-PersonalDevelopment ;
    dpv:hasHumanSubject dpv:NaturalPerson ;
    tech:hasDeployer dpv:EducationalOrganisation, hapt:dpv-VocationalTrainingInstitution ;
    dpv:hasStatus eu-gdpr:DPIARequired ;
    hapt:eu-gdpr-hasDPIARequiredCondition eu-gdpr:C9, eu-gdpr:C6, at:C48a, at:C48b, at:C32, cz:C32, dk:C32, de:C32, gr:C32 ;
    skos:note "DPIA required by member states: AT DE LV ES (Assessing or classfying of people) AT CZ DK DE GR (Use of AI in processing)"@en ;
    skos:editorialNote "No condition found in DPIARequiredConditions.ttl for: Assessing or classifying people (DE, LV, ES)"@en ;
    dct:source "AI Act Annex III 3(a)" ;
    dpv:hasJurisdiction loc:EU .

annex3:C3a-2 a eu-aiact:HighRiskAISystem-AnnexIII-3-a ;
    dct:identifier "3a.2." ;
    skos:definition "A use case developed from AI Act Annex III point 3(a) in which the AI system involves purpose: determine access/admission, assign persons (to institutions); processing context: (automated) decision making, profiling, assessing or classifying natural persons, systematic assessment of skills / competences / outcomes of tests, mental health, development; technology: AI; AI or data subjects: students, minors, vulnerable persons; deployer: educational and vocational training institutions."@en ;
    skos:broader annex3:C3a ;
    dpv:hasSector eu-aiact:EducationSector ;
    dpv:hasPurpose sector-education:StudentAdmissionScreening, sector-education:StudentInstituteAllocation ;
    dpv:hasRisk hapt:risk-LegalEffects ;
    dpv:hasContext dpv:AutomatedDecisionMaking, dpv:EvaluationOfIndividuals, hapt:dpv-ClassificationOfIndividuals, hapt:eu-gdpr-Systematic ;
    dpv:hasProcessing eu-gdpr:Profiling, dpv:Assess ;
    dpv:isImplementedUsingTechnology ai:AISystem ;
    dpv:hasPersonalData hapt:pd-Skills, hapt:pd-Competency, hapt:pd-AssessmentOutcome, pd:MentalHealth, hapt:pd-PersonalDevelopment ;
    dpv:hasHumanSubject dpv:Student, dpv:Child, dpv:VulnerableHuman ;
    tech:hasDeployer dpv:EducationalOrganisation, hapt:dpv-VocationalTrainingInstitution ;
    dpv:hasStatus eu-gdpr:DPIARequired ;
    hapt:eu-gdpr-hasDPIARequiredCondition eu-gdpr:C9, eu-gdpr:C6, eu-gdpr:C8a, eu-gdpr:C4c, hu:C74, at:C26, ie:C26, it:C26, lt:C26, mt:C26, lv:C57h, fi:C96 ;
    skos:note "DPIA required by member states: student assessment for HU and NL. Minors/ vulnerable= IE, IT, LT, MT, AT"@en ;
    skos:note "member state processing activity: AT CY CZ DE ES FI FR HU IE IT LV LI LT MT NO PT RO SK SI SE (Vulnerable)"@en ;
    skos:editorialNote "No condition found in DPIARequiredConditions.ttl for: Student assessment (NL); Vulnerable persons (AT, CY, CZ, DE, ES, FR, HU, IE, IT, LI, LT, MT, NO, PT, RO, SK, SI, SE)"@en ;
    dct:source "AI Act Annex III 3(a)" ;
    dpv:hasJurisdiction loc:EU .

annex3:C3b a eu-aiact:HighRiskAISystem-AnnexIII-3-b ;
    dct:identifier "3b" ;
    skos:definition "3. Education and vocational training: (b) AI systems intended to be used to evaluate learning outcomes, including when those outcomes are used to steer the learning process of natural persons in educational and vocational training institutions at all levels;"@en ;
    dpv:hasSector eu-aiact:EducationSector ;
    dpv:hasPurpose sector-education:StudentLearningOutcomeAssessment ;
    dpv:hasRisk hapt:risk-LegalEffects ;
    dpv:hasContext hapt:eu-gdpr-Systematic, dpv:EvaluationOfIndividuals, dpv:ScoringOfIndividuals ;
    dpv:hasProcessing dpv:Assess ;
    dpv:isImplementedUsingTechnology ai:AISystem ;
    dpv:hasPersonalData hapt:pd-Skills, hapt:pd-Competency, hapt:pd-AssessmentOutcome, pd:MentalHealth, hapt:pd-PersonalDevelopment ;
    dpv:hasHumanSubject dpv:NaturalPerson ;
    tech:hasDeployer dpv:EducationalOrganisation, hapt:dpv-VocationalTrainingInstitution ;
    dpv:hasStatus eu-gdpr:DPIARequired ;
    hapt:eu-gdpr-hasDPIARequiredCondition eu-gdpr:C9, is_:C45a, is_:C45b, is_:C45c, is_:C45d, no:C45a, no:C45b, no:C45c, no:C45d, pl:C45a, pl:C45b, pl:C45c, pl:C45d, cy:C14a, cy:C14b, cy:C14c, cy:C14d, dk:C14a, dk:C14b, dk:C14c, dk:C14d, fi:C14a, fi:C14b, fi:C14c, fi:C14d, fr:C14a, fr:C14b, fr:C14c, fr:C14d, de:C14a, de:C14b, de:C14c, de:C14d, gr:C14a, gr:C14b, gr:C14c, gr:C14d, hu:C14a, hu:C14b, hu:C14c, hu:C14d, is_:C14a, is_:C14b, is_:C14c, is_:C14d, ie:C14a, ie:C14b, ie:C14c, ie:C14d, it:C14a, it:C14b, it:C14c, it:C14d, lv:C14a, lv:C14b, lv:C14c, lv:C14d, li:C14a, li:C14b, li:C14c, li:C14d, lu:C14a, lu:C14b, lu:C14c, lu:C14d, no:C14a, no:C14b, no:C14c, no:C14d, pl:C14a, pl:C14b, pl:C14c, pl:C14d, pt:C14a, pt:C14b, pt:C14c, pt:C14d, ro:C14a, ro:C14b, ro:C14c, ro:C14d, sk:C14a, sk:C14b, sk:C14c, sk:C14d, es:C14a, es:C14b, es:C14c, es:C14d, se:C14a, se:C14b, se:C14c, se:C14d, hu:C74, at:C32, cz:C32, dk:C32, de:C32, gr:C32 ;
    skos:note "DPIA required by member states: IS NO PL (assessment) CY DK FI FR DE GR HU IS IE IT LV LI LU NO PL PT RO SK ES SE(evaluation or scoring) HU NL (assessing students) AT CZ DK DE GR (Use of AI in Processing)"@en ;
    skos:editorialNote "No condition found in DPIARequiredConditions.ttl for: Student assessment (NL)"@en ;
    dct:source "AI Act Annex III 3(b)" ;
    dpv:hasJurisdiction loc:EU .

annex3:C3b-1 a eu-aiact:HighRiskAISystem-AnnexIII-3-b ;
    dct:identifier "3b.1." ;
    skos:definition "A use case developed from AI Act Annex III point 3(b) in which the AI system involves purpose: evaluating learning outcomes; processing context: systematic assessment of skills / competences / outcomes of tests, mental health, development, evaluation or scoring; technology: AI; AI or data subjects: students, minors, vulnerable persons; deployer: educational and vocational training institutions."@en ;
    skos:broader annex3:C3b ;
