    dpv:hasProcessing dpv:Assess ;
    dpv:isImplementedUsingTechnology ai:AISystem ;
    dpv:hasPersonalData hapt:pd-Skills, hapt:pd-Competency, hapt:pd-AssessmentOutcome, pd:MentalHealth, hapt:pd-PersonalDevelopment ;
    dpv:hasHumanSubject dpv:Student, dpv:Child, dpv:VulnerableHuman ;
    tech:hasDeployer dpv:EducationalOrganisation, hapt:dpv-VocationalTrainingInstitution ;
    dpv:hasStatus eu-gdpr:DPIARequired ;
    hapt:eu-gdpr-hasDPIARequiredCondition eu-gdpr:C9, eu-gdpr:C4b, hu:C74, at:C26, ie:C26, it:C26, lt:C26, mt:C26, lv:C57h, fi:C96 ;
    skos:note "DPIA required by member states: student assessment for HU and NL. Minors/ vulnerable= IE, IT, LT, MT, AT"@en ;
    skos:note "member state processing activity: AT CY CZ DE ES FI FR HU IE IT LV LI LT MT NO PT RO SK SI SE (Vulnerable)"@en ;
    skos:editorialNote "No condition found in DPIARequiredConditions.ttl for: Student assessment (NL); Vulnerable persons (AT, CY, CZ, DE, ES, FR, HU, IE, IT, LI, LT, MT, NO, PT, RO, SK, SI, SE)"@en ;
    dct:source "AI Act Annex III 3(b)" ;
    dpv:hasJurisdiction loc:EU .

annex3:C3c a eu-aiact:HighRiskAISystem-AnnexIII-3-c ;
    dct:identifier "3c" ;
    skos:definition "3. Education and vocational training:(c) AI systems intended to be used for the purpose of assessing the appropriate level of education that individual will receive or will be able to access, in the context of/within education and vocational training institution;"@en ;
    dpv:hasSector eu-aiact:EducationSector ;
    dpv:hasPurpose hapt:sector-education-EducationLevelAssessment, sector-education:StudentAdmissionScreening ;
    dpv:hasRisk hapt:risk-LegalEffects ;
    dpv:hasContext dpv:AutomatedDecisionMaking, dpv:EvaluationOfIndividuals, hapt:dpv-ClassificationOfIndividuals, hapt:eu-gdpr-Systematic ;
    dpv:hasProcessing eu-gdpr:Profiling, dpv:Assess ;
    dpv:isImplementedUsingTechnology ai:AISystem ;
    dpv:hasPersonalData hapt:pd-Skills, hapt:pd-Competency, hapt:pd-AssessmentOutcome, pd:MentalHealth, hapt:pd-PersonalDevelopment ;
    dpv:hasHumanSubject dpv:NaturalPerson ;
    tech:hasDeployer dpv:EducationalOrganisation, hapt:dpv-VocationalTrainingInstitution ;
    dpv:hasStatus eu-gdpr:DPIARequired ;
    hapt:eu-gdpr-hasDPIARequiredCondition eu-gdpr:C9, eu-gdpr:C4a, at:C32, cz:C32, dk:C32, de:C32, gr:C32, at:C48a, at:C48b ;
    skos:note "DPIA required by member states: AT CZ DK DE GR (Use of AI in processing) AT DE LV ES (Assessing or classfying of people)"@en ;
    skos:editorialNote "No condition found in DPIARequiredConditions.ttl for: Assessing or classifying people (DE, LV, ES)"@en ;
    dct:source "AI Act Annex III 3(c)" ;
    dpv:hasJurisdiction loc:EU .

annex3:C3c-1 a eu-aiact:HighRiskAISystem-AnnexIII-3-c ;
    dct:identifier "3c.1." ;
    skos:definition "A use case developed from AI Act Annex III point 3(c) in which the AI system involves purpose: assessing appropriate level of education, determining access (to education); processing context: (automated) decision making, profiling, assessing or classifying natural persons, systematic assessment of skills / competences / outcomes of tests, mental health, development; technology: AI; AI or data subjects: students, minors, vulnerable persons; deployer: educational and vocational training institutions."@en ;
    skos:broader annex3:C3c ;
    dpv:hasSector eu-aiact:EducationSector ;
    dpv:hasPurpose hapt:sector-education-EducationLevelAssessment, sector-education:StudentAdmissionScreening ;
    dpv:hasRisk hapt:risk-LegalEffects ;
    dpv:hasContext dpv:AutomatedDecisionMaking, dpv:EvaluationOfIndividuals, hapt:dpv-ClassificationOfIndividuals, hapt:eu-gdpr-Systematic ;
    dpv:hasProcessing eu-gdpr:Profiling, dpv:Assess ;
    dpv:isImplementedUsingTechnology ai:AISystem ;
    dpv:hasPersonalData hapt:pd-Skills, hapt:pd-Competency, hapt:pd-AssessmentOutcome, pd:MentalHealth, hapt:pd-PersonalDevelopment ;
    dpv:hasHumanSubject dpv:Student, dpv:Child, dpv:VulnerableHuman ;
    tech:hasDeployer dpv:EducationalOrganisation, hapt:dpv-VocationalTrainingInstitution ;
    dpv:hasStatus eu-gdpr:DPIARequired ;
    hapt:eu-gdpr-hasDPIARequiredCondition eu-gdpr:C9, eu-gdpr:C4c, hu:C74, at:C26, ie:C26, it:C26, lt:C26, mt:C26, lv:C57h, fi:C96 ;
    skos:note "DPIA required by member states: student assessment for HU and NL. Minors/ vulnerable= IE, IT, LT, MT, AT"@en ;
    skos:note "member state processing activity: AT CY CZ DE ES FI FR HU IE IT LV LI LT MT NO PT RO SK SI SE (Vulnerable)"@en ;
    skos:editorialNote "No condition found in DPIARequiredConditions.ttl for: Student assessment (NL); Vulnerable persons (AT, CY, CZ, DE, ES, FR, HU, IE, IT, LI, LT, MT, NO, PT, RO, SK, SI, SE)"@en ;
    dct:source "AI Act Annex III 3(c)" ;
    dpv:hasJurisdiction loc:EU .

annex3:C3d a eu-aiact:HighRiskAISystem-AnnexIII-3-d ;
    dct:identifier "3d" ;
    skos:definition "3. Education and vocational training:(d) AI systems intended to be used for monitoring and detecting prohibited behaviour of students during tests in the context of/within education and vocational training institutions."@en ;
    dpv:hasSector eu-aiact:EducationSector ;
    dpv:hasPurpose sector-education:StudentProctoring, sector-education:StudentCheatingAssessment, hapt:dpv-Monitoring, hapt:dpv-ControlHumanActivity ;
    dpv:hasRisk hapt:risk-LegalEffects ;
    dpv:hasContext hapt:dpv-MonitoringIndividuals ;
    dpv:isImplementedUsingTechnology ai:AISystem ;
    dpv:hasPersonalData pd:Behavioural, pd:Personality ;
    dpv:hasLocation hapt:loc-School ;
    dpv:hasHumanSubject dpv:NaturalPerson ;
    tech:hasDeployer dpv:EducationalOrganisation, hapt:dpv-VocationalTrainingInstitution ;
    hapt:eu-gdpr-hasDPIARequiredCondition at:C41, be:C41, de:C41, be:C56, at:C32, cz:C32, dk:C32, de:C32, gr:C32 ;
    skos:note "DPIA required by member states: BE AT CZ DE GR LT ES IS NO LV NL (Behavioural data) AT CZ DK DE GR (Use of AI in processing)"@en ;
    skos:editorialNote "No condition found in DPIARequiredConditions.ttl for: Behavioural data (CZ, GR, LT, ES, IS, NO, LV, NL)"@en ;
    dct:source "AI Act Annex III 3(d)" ;
    dpv:hasJurisdiction loc:EU .

annex3:C3d-1 a eu-aiact:HighRiskAISystem-AnnexIII-3-d ;
    dct:identifier "3d.1." ;
    skos:definition "A use case developed from AI Act Annex III point 3(d) in which the AI system involves purpose: monitoring students during tests, detecting prohibited behaviour of students during tests; processing context: monitoring, surveillance, behavioural data, monitoring or controlling data subjects, electronic monitoring of a school, supervision of the data subject; technology: AI; special categories of personal data: behavioural data, behaviour or other personal aspects of natural persons; AI or data subjects: students, minors, vulnerable persons; deployer: educational and vocational training institutions."@en ;
    skos:broader annex3:C3d ;
    dpv:hasSector eu-aiact:EducationSector ;
    dpv:hasPurpose sector-education:StudentProctoring, sector-education:StudentCheatingAssessment, hapt:dpv-Monitoring, hapt:dpv-ControlHumanActivity ;
    dpv:hasRisk hapt:risk-LegalEffects ;
    dpv:hasContext hapt:dpv-MonitoringIndividuals ;
    dpv:isImplementedUsingTechnology ai:AISystem ;
    dpv:hasPersonalData pd:Behavioural, pd:Personality ;
    dpv:hasLocation hapt:loc-School ;
    dpv:hasHumanSubject dpv:Student, dpv:Child, dpv:VulnerableHuman ;
    tech:hasDeployer dpv:EducationalOrganisation, hapt:dpv-VocationalTrainingInstitution ;
    dpv:hasStatus eu-gdpr:DPIARequired ;
    hapt:eu-gdpr-hasDPIARequiredCondition eu-gdpr:C9, eu-gdpr:C4b, hu:C74, at:C26, ie:C26, it:C26, lt:C26, mt:C26, lv:C57h, fi:C96 ;
    skos:note "DPIA required by member states: student assessment for HU and NL. Minors/ vulnerable= IE, IT, LT, MT, AT"@en ;
    skos:note "member state processing activity: AT CY CZ DE ES FI FR HU IE IT LV LI LT MT NO PT RO SK SI SE (Vulnerable)"@en ;
    skos:editorialNote "No condition found in DPIARequiredConditions.ttl for: Student assessment (NL); Vulnerable persons (AT, CY, CZ, DE, ES, FR, HU, IE, IT, LI, LT, MT, NO, PT, RO, SK, SI, SE)"@en ;
    dct:source "AI Act Annex III 3(d)" ;
    dpv:hasJurisdiction loc:EU .

annex3:C4a a eu-aiact:HighRiskAISystem-AnnexIII-4-a ;
    dct:identifier "4a" ;
    skos:definition "4. Employment, workers management and access to self-employment: (a) AI systems intended to be used for recruitment or selection of natural persons, notably to place targeted job advertisements, to analyse and filter job applications, and to evaluate candidates;"@en ;
    dpv:hasSector eu-aiact:EmploymentSector ;
    dpv:hasPurpose dpv:RecruitmentManagement, dpv:RecruitmentTargetedAdvertising ;
    dpv:hasRisk hapt:risk-LegalEffects ;
    dpv:hasContext dpv:AutomatedDecisionMaking, dpv:EvaluationOfIndividuals, hapt:dpv-ClassificationOfIndividuals, hapt:eu-gdpr-Systematic, dpv:ScoringOfIndividuals ;
    dpv:hasProcessing eu-gdpr:Profiling, dpv:Assess ;
    dpv:isImplementedUsingTechnology ai:AISystem ;
    dpv:hasPersonalData hapt:pd-Skills, hapt:pd-Competency, hapt:pd-AssessmentOutcome ;
    dpv:hasHumanSubject dpv:NaturalPerson, dpv:JobApplicant, vair:PotentialJobApplicant ;
    tech:hasDeployer hapt:dpv-Employer, hapt:dpv-Recruiter ;
    dpv:hasStatus eu-gdpr:DPIARequired ;
    hapt:eu-gdpr-hasDPIARequiredCondition eu-gdpr:C9, eu-gdpr:C4a, fr:C75, at:C32, cz:C32, dk:C32, de:C32, gr:C32, ee:C105a, ee:C105b ;
    skos:note "DPIA required by member states: FR (recruitment) AT CZ DK DE GR (Use of AI in processing) EE (Large Scale Processing that might pose a risk of discrimination with legal consequences or with similar impact (particularly in labor broking services and in assessment/evaluation services having impact on salaries and career)"@en ;
    dct:source "AI Act Annex III 4(a)" ;
    dpv:hasJurisdiction loc:EU .

annex3:C4b a eu-aiact:HighRiskAISystem-AnnexIII-4-b ;
    dct:identifier "4b" ;
    skos:definition "4. Employment, workers management and access to self-employment: (b) AI intended to be used to make decisions affecting terms of the work related relationships, promotion and termination of work-related contractual relationships, to allocate tasks based on individual behaviour or personal traits or characteristics and to monitor and evaluate performance and behaviour of persons in such relationships."@en ;
    dpv:hasSector eu-aiact:EmploymentSector ;
    dpv:hasPurpose vair:MakingPromotionDecision, vair:MakingContractTerminationDecision, hapt:dpv-TaskAllocation, dpv:PersonnelMonitoring, dpv:PersonnelPerformanceEvaluation, hapt:dpv-PersonnelBehaviourEvaluation, hapt:dpv-Monitoring, hapt:dpv-ControlHumanActivity, hapt:dpv-CommercialUse, dpv:ServiceProvision, hapt:dpv-ProductDevelopment ;
    dpv:hasRisk hapt:risk-LegalEffects, hapt:dpv-ContractExclusion, hapt:dpv-ContractSuspension, dpv:ContractTerminated ;
    dpv:hasContext dpv:AutomatedDecisionMaking, dpv:EvaluationOfIndividuals, dpv:ScoringOfIndividuals ;
    dpv:hasProcessing eu-gdpr:Profiling, hapt:dpv-Predict ;
    dpv:hasTechnicalMeasure dpv:ActivityMonitoring ;
    dpv:isImplementedUsingTechnology ai:AISystem ;
    dpv:hasPersonalData pd:Behavioural, hapt:pd-WorkingCapacity, pd:Financial, pd:MedicalHealth, pd:Preference, pd:Interest, hapt:pd-Trustworthiness, pd:Location, hapt:pd-LocationRoute ;
    dpv:hasHumanSubject dpv:NaturalPerson, dpv:Employee ;
    tech:hasDeployer hapt:dpv-Employer ;
    dpv:hasStatus eu-gdpr:DPIARequired ;
    hapt:eu-gdpr-hasDPIARequiredCondition eu-gdpr:C9, eu-gdpr:C6, eu-gdpr:C8a, eu-gdpr:C4a, at:C32, cz:C32, dk:C32, de:C32, gr:C32, ee:C105a, ee:C105b ;
    skos:note "DPIA required by member states: AT CZ DK DE GR (Use of AI in processing) EE (Large Scale Processing that might pose a risk of discrimination with legal consequences or with similar impact (particularly in labor broking services and in assessment/evaluation services having impact on salaries and career)"@en ;
    dct:source "AI Act Annex III 4(b)" ;
    dpv:hasJurisdiction loc:EU .

annex3:C4b-1 a eu-aiact:HighRiskAISystem-AnnexIII-4-b ;
    dct:identifier "4b.1." ;
    skos:definition "A use case developed from AI Act Annex III point 4(b) in which the AI system involves purpose: promotion, termination, task allocation, monitoring and evaluating (performance and behaviour); processing context: monitoring of employee activities; technology: AI; special categories of personal data: behavioural data; AI or data subjects: natural persons, employee; deployer: employer."@en ;
    skos:broader annex3:C4b ;
    dpv:hasSector eu-aiact:EmploymentSector ;
    dpv:hasPurpose vair:MakingPromotionDecision, vair:MakingContractTerminationDecision, hapt:dpv-TaskAllocation, dpv:PersonnelMonitoring, dpv:PersonnelPerformanceEvaluation, hapt:dpv-PersonnelBehaviourEvaluation ;
    dpv:hasRisk hapt:risk-LegalEffects ;
    dpv:hasTechnicalMeasure dpv:ActivityMonitoring ;
    dpv:isImplementedUsingTechnology ai:AISystem ;
    dpv:hasPersonalData pd:Behavioural ;
    dpv:hasHumanSubject dpv:NaturalPerson, dpv:Employee ;
    tech:hasDeployer hapt:dpv-Employer ;
    hapt:eu-gdpr-hasDPIARequiredCondition hr:C16, cy:C16, cz:C16, ee:C16, de:C16, gr:C16, hu:C16, is_:C16, lv:C16, li:C16, lt:C16, lu:C16, mt:C16, nl:C16, no:C16, sk:C16, si:C16, at:C32, cz:C32, dk:C32, de:C32, gr:C32 ;
    skos:note "DPIA required by member states: BE HR CZ EE DE GR HU IS LV LI LT LU MT NL NO SK CY IT SI ES SE AT (monitoring of employee activities) AT CZ DK DE GR (Use of AI in processing)"@en ;
    skos:editorialNote "No condition found in DPIARequiredConditions.ttl for: Monitoring of employee activities (BE, IT, ES, SE, AT)"@en ;
    dct:source "AI Act Annex III 4(b)" ;
    dpv:hasJurisdiction loc:EU .

annex3:C5a a eu-aiact:HighRiskAISystem-AnnexIII-5-a ;
    dct:identifier "5a" ;
    skos:definition "5. Access to and enjoyment of essential private services and essential public services and benefits: (a) AI systems intended to be used by public authorities or on behalf of public authorities to evaluate the eligibility of natural persons for essential public assistance benefits and services, including healthcare services, as well as to grant, reduce, revoke, or reclaim such benefits and services;"@en ;
    dpv:hasSector hapt:dpv-PublicServicesAndBenefits ;
    dpv:hasPurpose hapt:sector-publicservices-PublicAssistanceEligibilityEvaluation, hapt:sector-publicservices-PublicAssistanceGranting, hapt:sector-publicservices-PublicAssistanceReduction, hapt:sector-publicservices-PublicAssistanceRevocation, hapt:sector-publicservices-PublicAssistanceReclaiming ;
    dpv:hasRisk hapt:risk-LegalEffects, hapt:risk-ServiceAccessDenied, hapt:risk-ServiceExclusion ;
    dpv:hasContext dpv:AutomatedDecisionMaking, dpv:EvaluationOfIndividuals, dpv:ScoringOfIndividuals ;
    dpv:isImplementedUsingTechnology ai:AISystem ;
    dpv:hasPersonalData eu-gdpr:HealthData ;
    dpv:hasHumanSubject dpv:NaturalPerson, vair:PublicServicesApplicant, vair:PublicServicesRecipient ;
    tech:hasDeployer hapt:dpv-PublicAuthority ;
    dpv:hasStatus eu-gdpr:DPIARequired ;
    hapt:eu-gdpr-hasDPIARequiredCondition eu-gdpr:C9, eu-gdpr:C6, eu-gdpr:C8a, eu-gdpr:C2, at:C32, cz:C32, dk:C32, de:C32, gr:C32, nl:C59, pl:C59, cy:C14a, cy:C14b, cy:C14c, cy:C14d, dk:C14a, dk:C14b, dk:C14c, dk:C14d, fi:C14a, fi:C14b, fi:C14c, fi:C14d, fr:C14a, fr:C14b, fr:C14c, fr:C14d, de:C14a, de:C14b, de:C14c, de:C14d, gr:C14a, gr:C14b, gr:C14c, gr:C14d, hu:C14a, hu:C14b, hu:C14c, hu:C14d, is_:C14a, is_:C14b, is_:C14c, is_:C14d, ie:C14a, ie:C14b, ie:C14c, ie:C14d, it:C14a, it:C14b, it:C14c, it:C14d, lv:C14a, lv:C14b, lv:C14c, lv:C14d, li:C14a, li:C14b, li:C14c, li:C14d, lu:C14a, lu:C14b, lu:C14c, lu:C14d, no:C14a, no:C14b, no:C14c, no:C14d, pl:C14a, pl:C14b, pl:C14c, pl:C14d, pt:C14a, pt:C14b, pt:C14c, pt:C14d, ro:C14a, ro:C14b, ro:C14c, ro:C14d, sk:C14a, sk:C14b, sk:C14c, sk:C14d, es:C14a, es:C14b, es:C14c, es:C14d, se:C14a, se:C14b, se:C14c, se:C14d ;
    skos:note "DPIA required by member states: AT CZ DK DE GR (Use of AI in processing) NL, PL (health data) CY DK FI FR DE GR HU IS IE IT LV LI LU NO PL PT RO SK ES SE(evaluation or scoring)"@en ;
    dct:source "AI Act Annex III 5(a)" ;
    dpv:hasJurisdiction loc:EU .

annex3:C5b a eu-aiact:HighRiskAISystem-AnnexIII-5-b ;
    dct:identifier "5b" ;
    skos:definition "5. Access to and enjoyment of essential private services and essential public services and benefits:(b) AI systems intended to be used to evaluate the creditworthiness of natural persons or establish their credit score , with the exception of AI systems used for the purpose of detecting financial fraud;"@en ;
    dpv:hasSector hapt:dpv-PublicServicesAndBenefits, vair:PrivateService ;
    dpv:hasPurpose vair:AssessingCreditworthiness ;
    dpv:hasRisk hapt:risk-LegalEffects ;
    dpv:hasProcessing eu-gdpr:Profiling ;
    dpv:isImplementedUsingTechnology ai:AISystem ;
    dpv:hasHumanSubject dpv:NaturalPerson ;
    dpv:isNotApplicableFor sector-finance:FraudManagement ;
    dpv:hasStatus eu-gdpr:DPIARequired ;
    hapt:eu-gdpr-hasDPIARequiredCondition eu-gdpr:C9, eu-gdpr:C6, eu-gdpr:C4a, at:C32, cz:C32, dk:C32, de:C32, gr:C32 ;
    skos:note "DPIA required by member states: AT CZ DK DE GR (Use of AI in processing)"@en ;
    dct:source "AI Act Annex III 5(b)" ;
    dpv:hasJurisdiction loc:EU .

