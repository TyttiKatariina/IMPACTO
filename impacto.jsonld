      },
      "skos:definition": {
        "@language": "en",
        "@value": "Status reflecting whether a review has been carried out by the controller, where necessary, to assess whether processing is performed in accordance with the DPIA, at least when there is a change in the risk represented by the processing operations."
      },
      "skos:inScheme": {
        "@id": "https://tyttikatariina.github.io/IMPACTO/"
