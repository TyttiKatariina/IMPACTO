        "@language": "en",
        "@value": "Proposed for: DPV EU AI Act extension (eu-aiact)"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "FRIA Not Required"
      }
    },
    {
      "@id": "impacto:eu-aiact-FRIANotRequiredProcess",
      "@type": "skos:Concept",
      "skos:broader": {
        "@id": "dpv:Process"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A deployment of an AI system that does not require a FRIA under AI Act Article 27(1), for example because the AI system is not a high-risk AI system referred to in Article 6(2), is intended to be used in the area listed in Annex III point 2, or the deployer is not one of the categories listed in Article 27(1)."
      },
      "skos:inScheme": {
        "@id": "https://tyttikatariina.github.io/IMPACTO/"
      },
      "skos:notation": "eu-aiact-FRIANotRequiredProcess",
      "skos:note": [
        {
          "@language": "en",
          "@value": "Proposed for: DPV EU AI Act extension (eu-aiact)"
        },
        {
          "@language": "en",
          "@value": "Source: AI Act Art. 27(1)"
        }
      ],
      "skos:prefLabel": {
        "@language": "en",
        "@value": "FRIA Not Required Process"
      },
      "skos:related": [
        {
          "@id": "impacto:eu-aiact-FRIANotRequired"
        },
        {
          "@id": "impacto:eu-aiact-FRIAExempt"
        }
      ],
      "skos:scopeNote": {
        "@language": "en",
        "@value": "The counterpart of impacto:eu-gdpr-DPIANotRequiredProcess for the FRIA. The outcome of the FRIA necessity assessment is recorded with dpv:hasStatus impacto:eu-aiact-FRIANotRequired or impacto:eu-aiact-FRIAExempt."
      }
    },
