      "skos:broader": {
        "@id": "impacto:eu-aiact-FRIAOutcomeStatus"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A FRIA outcome status indicating that the deployment of the AI system may proceed."
      },
      "skos:inScheme": {
        "@id": "https://tyttikatariina.github.io/IMPACTO/"
      },
      "skos:notation": "eu-aiact-FRIAPermitsDeployment",
