      "skos:broader": {
        "@id": "impacto:eu-gdpr-RiskChangeCategory"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A change in risk that was anticipated and accounted for in the original DPIA and for which a review was in place/ scheduled for."
