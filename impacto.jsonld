      }
    },
    {
      "@id": "impacto:eu-aiact-IntendedUse",
      "@type": "skos:Concept",
      "skos:broader": {
        "@id": "dpv:Technology"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The contextual application of an AI system's intended purpose in a specific deployment scenario. Distinct from eu-aiact:IntendedPurpose in that the same AI system with one intended purpose may have multiple intended uses, varying by input/output data, human subjects involved, or hardware and software used."
      },
      "skos:editorialNote": {
        "@language": "en",
        "@value": "Parent changed from tech:IntendedUse (previous index) to dpv:Technology."
      },
      "skos:inScheme": {
        "@id": "https://tyttikatariina.github.io/IMPACTO/"
      },
      "skos:notation": "eu-aiact-IntendedUse",
      "skos:note": [
        {
          "@language": "en",
          "@value": "Proposed for: DPV EU AI Act extension (eu-aiact)"
        },
        {
          "@language": "en",
          "@value": "Source: AI Act Art. 27(1)(b)"
        }
      ],
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Intended Use"
      },
      "skos:scopeNote": {
        "@language": "en",
        "@value": "Distinct from eu-aiact:IntendedPurpose: while an AI system has a single intended purpose, it may have multiple intended uses depending on deployment context."
      }
    },
    {
