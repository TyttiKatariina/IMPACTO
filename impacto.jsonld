    {
      "@id": "impacto:eu-aiact-HighRiskAISystem",
      "@type": "skos:Concept",
      "skos:broader": {
        "@id": "impacto:eu-aiact-FRIANecessityDetermination"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A determination that the AI system is a high-risk AI system referred to in AI Act Article 6(2), bringing its deployment within the scope of Article 27."
      },
      "skos:editorialNote": {
        "@language": "en",
        "@value": "Name collides with the existing eu-aiact:HighRiskAISystem, which is listed under reused concepts. A distinct name (for example HighRiskAISystemDetermination) would avoid the clash when proposed to eu-aiact."
      },
      "skos:inScheme": {
        "@id": "https://tyttikatariina.github.io/IMPACTO/"
      },
      "skos:notation": "eu-aiact-HighRiskAISystem",
      "skos:note": [
        {
          "@language": "en",
          "@value": "Proposed for: DPV EU AI Act extension (eu-aiact)"
        },
        {
          "@language": "en",
          "@value": "Source: AI Act Art. 6(2), Art. 27(1)"
        }
      ],
      "skos:prefLabel": {
        "@language": "en",
        "@value": "High Risk AI System"
      }
    },
    {
      "@id": "impacto:eu-aiact-ImpactAssessmentReuse",
      "@type": "skos:Concept",
      "skos:broader": {
        "@id": "eu-aiact:FRIA"
      },
      "skos:definition": {
        "@language": "en",
