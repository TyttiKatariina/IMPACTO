        {
          "@language": "en",
          "@value": "Proposed for: DPV EU AI Act extension (eu-aiact)"
        },
        {
          "@language": "en",
          "@value": "Source: AI Act Art. 27(1)"
        }
      ],
      "skos:prefLabel": {
        "@language": "en",
        "@value": "FRIA Necessity"
      }
    },
    {
      "@id": "impacto:eu-aiact-FRIANecessityAssessment",
      "@type": "skos:Concept",
      "skos:broader": {
        "@id": "eu-aiact:FRIA"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A process extending eu-aiact:FRIA that represents the step in which an organisation assesses whether it is necessary to conduct a FRIA, as required under AI Act Article 27(1). Associated with a FRIA using dpv:hasAssessment."
      },
      "skos:inScheme": {
        "@id": "https://tyttikatariina.github.io/IMPACTO/"
      },
      "skos:notation": "eu-aiact-FRIANecessityAssessment",
