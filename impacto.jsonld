      "@type": "skos:Concept",
      "skos:broader": {
        "@id": "eu-aiact:FRIA"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A process extending eu-aiact:FRIA that represents the activity of carrying out the FRIA itself, including collection and documentation of all required inputs as per AI Act Article 27(1). Associated with a FRIA using dpv:hasAssessment."
      },
      "skos:inScheme": {
        "@id": "https://tyttikatariina.github.io/IMPACTO/"
      },
      "skos:notation": "eu-aiact-FRIAProcedure",
