        },
        {
          "@language": "en",
          "@value": "Source: GDPR Art. 35(11)"
        }
      ],
      "skos:prefLabel": {
        "@language": "en",
        "@value": "DPIA Review Status"
      }
    },
    {
      "@id": "impacto:eu-gdpr-NonpredeterminedRiskChange",
      "@type": "skos:Concept",
      "skos:broader": {
        "@id": "impacto:eu-gdpr-RiskChangeCategory"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A change in risk that was not anticipated or accounted for and requires an immediate review of the original DPIA."
      },
      "skos:inScheme": {
        "@id": "https://tyttikatariina.github.io/IMPACTO/"
      },
      "skos:notation": "eu-gdpr-NonpredeterminedRiskChange",
