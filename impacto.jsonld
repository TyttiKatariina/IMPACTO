      },
      "skos:definition": {
        "@language": "en",
        "@value": "A process extending eu-aiact:FRIA that represents the step of determining the result of the FRIA procedure, specifically whether the use of the AI system produces an impact on fundamental rights, as stated in AI Act Article 27(1). Associated with a FRIA using dpv:hasAssessment."
      },
      "skos:inScheme": {
