        "@id": "eu-aiact:FRIA"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Whether a FRIA is required for a given deployment of an AI system, as determined under AI Act Article 27(1)."
      },
      "skos:editorialNote": {
        "@language": "en",
        "@value": "Overlaps with eu-aiact:FRIANecessityAssessment, which has the same parent; confirm whether both are needed."
      },
