          "@language": "en",
          "@value": "Source: GDPR Art. 35(11)"
        }
      ],
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Non-predetermined Risk Change"
      }
    },
    {
      "@id": "impacto:eu-gdpr-PredeterminedRiskChange",
