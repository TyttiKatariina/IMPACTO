        {
          "@language": "en",
          "@value": "Proposed for: DPV EU AI Act extension (eu-aiact)"
        },
        {
          "@language": "en",
          "@value": "Source: AI Act Art. 27(1)"
        }
      ],
      "skos:prefLabel": {
        "@language": "en",
        "@value": "FRIA Necessity Assessment"
      }
    },
    {
      "@id": "impacto:eu-aiact-FRIANecessityDetermination",
      "@type": "skos:Concept",
      "skos:broader": {
        "@id": "impacto:eu-aiact-FRIANecessityStatus"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The basis on which the necessity of a FRIA is determined, such as the risk classification of the AI system or the applicability of an exemption."
