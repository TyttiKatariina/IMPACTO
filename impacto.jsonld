    {
      "@id": "impacto:eu-gdpr-DPIANotRequired",
      "@type": "skos:Concept",
      "skos:broader": {
        "@id": "eu-gdpr:DPIANecessityStatus"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Status indicating that a DPIA is not required for the processing, for example because it is not likely to result in a high risk or because it appears on a supervisory authority list under GDPR Article 35(5)."
      },
      "skos:editorialNote": {
        "@language": "en",
        "@value": "eu-gdpr:DPIANotRequired already exists in the DPV GDPR extension and is also listed under reused concepts. Confirm whether this entry is a refinement or should be removed."
      },
      "skos:inScheme": {
        "@id": "https://tyttikatariina.github.io/IMPACTO/"
      },
      "skos:notation": "eu-gdpr-DPIANotRequired",
      "skos:note": [
        {
          "@language": "en",
          "@value": "Proposed for: DPV GDPR extension (eu-gdpr)"
        },
        {
          "@language": "en",
          "@value": "Source: GDPR Art. 35(5)"
        }
      ],
      "skos:prefLabel": {
        "@language": "en",
        "@value": "DPIA Not Required"
      }
    },
    {
      "@id": "impacto:eu-gdpr-DPIANotRequiredProcess",
      "@type": "skos:Concept",
      "skos:broader": {
        "@id": "impacto:eu-gdpr-DPIAProcess"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A personal data processing activity that does not require a DPIA according to the whitelists of processing activities published by Member State Data Protection Authorities."
      },
      "skos:inScheme": {
        "@id": "https://tyttikatariina.github.io/IMPACTO/"
      },
      "skos:notation": "eu-gdpr-DPIANotRequiredProcess",
      "skos:note": [
        {
          "@language": "en",
          "@value": "Proposed for: DPV GDPR extension (eu-gdpr)"
        },
        {
          "@language": "en",
          "@value": "Source: GDPR Art. 35(5); Member State DPA Not-Required Lists (AT, CZ, FR, HR, IT, LV, NL, ES)"
        }
      ],
      "skos:prefLabel": {
        "@language": "en",
        "@value": "DPIA Not Required Process"
      }
    },
    {
      "@id": "impacto:eu-gdpr-DPIAProcess",
      "@type": "skos:Concept",
      "skos:broader": {
        "@id": "dpv:Process"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The process of conducting a DPIA that has two outcomes, either a DPIA is required and is conducted, or a DPIA is not required and is therefore not conducted."
      },
      "skos:inScheme": {
        "@id": "https://tyttikatariina.github.io/IMPACTO/"
      },
      "skos:notation": "eu-gdpr-DPIAProcess",
      "skos:note": [
        {
          "@language": "en",
          "@value": "Proposed for: DPV GDPR extension (eu-gdpr)"
        },
        {
          "@language": "en",
          "@value": "Source: GDPR Art. 35"
        }
      ],
      "skos:prefLabel": {
        "@language": "en",
        "@value": "DPIA Process"
      }
    },
    {
      "@id": "impacto:eu-gdpr-DPIARequiredProcess",
      "@type": "skos:Concept",
      "skos:broader": {
        "@id": "impacto:eu-gdpr-DPIAProcess"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A personal data processing activity that requires a DPIA according to GDPR Article 35."
      },
      "skos:inScheme": {
        "@id": "https://tyttikatariina.github.io/IMPACTO/"
      },
      "skos:notation": "eu-gdpr-DPIARequiredProcess",
      "skos:note": [
        {
          "@language": "en",
          "@value": "Proposed for: DPV GDPR extension (eu-gdpr)"
        },
        {
          "@language": "en",
          "@value": "Source: GDPR Art. 35"
        }
      ],
      "skos:prefLabel": {
        "@language": "en",
        "@value": "DPIA Required Process"
      },
      "skos:scopeNote": {
        "@language": "en",
        "@value": "The requirements for whether a DPIA is required for a specific process can be found in GDPR Art 35 and also in specific lists published by Member State Data Protection Authorities."
      }
    },
    {
      "@id": "impacto:eu-gdpr-DPIAReviewComplete",
      "@type": "skos:Concept",
      "skos:broader": {
        "@id": "impacto:eu-gdpr-DPIAReviewStatus"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Status reflecting a review has been carried out by the controller, where necessary, to assess whether processing is performed in accordance with the DPIA, at least when there is a change in the risk represented by the processing operations."
      },
      "skos:inScheme": {
        "@id": "https://tyttikatariina.github.io/IMPACTO/"
      },
      "skos:notation": "eu-gdpr-DPIAReviewComplete",
      "skos:note": [
        {
          "@language": "en",
          "@value": "Proposed for: DPV EU GDPR (eu-gdpr)"
        },
        {
          "@language": "en",
          "@value": "Source: GDPR Art. 35(11)"
        }
      ],
      "skos:prefLabel": {
        "@language": "en",
        "@value": "DPIA Review Complete"
      }
    },
    {
      "@id": "impacto:eu-gdpr-DPIAReviewPending",
      "@type": "skos:Concept",
      "skos:broader": {
        "@id": "impacto:eu-gdpr-DPIAReviewStatus"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Status reflecting a review is still pending and waiting to been carried out by the controller, where necessary, to assess whether processing is performed in accordance with the DPIA, at least when there is a change in the risk represented by the processing operations."
      },
      "skos:inScheme": {
        "@id": "https://tyttikatariina.github.io/IMPACTO/"
      },
      "skos:notation": "eu-gdpr-DPIAReviewPending",
      "skos:note": [
        {
          "@language": "en",
          "@value": "Proposed for: DPV EU GDPR (eu-gdpr)"
        },
        {
          "@language": "en",
          "@value": "Source: GDPR Art. 35(11)"
        }
      ],
      "skos:prefLabel": {
        "@language": "en",
        "@value": "DPIA Review Pending"
      }
    },
    {
      "@id": "impacto:eu-gdpr-DPIAReviewStatus",
