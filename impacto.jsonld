        "@value": "FRIA Required"
      }
    },
    {
      "@id": "impacto:eu-aiact-FRIARequiredProcess",
      "@type": "skos:Concept",
      "skos:broader": {
        "@id": "dpv:Process"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A deployment of a high-risk AI system referred to in AI Act Article 6(2) that requires a FRIA according to Article 27(1), because the deployer is a body governed by public law or a private entity providing public services, or because the AI system is referred to in Annex III point 5(b) or (c)."
      },
      "skos:inScheme": {
        "@id": "https://tyttikatariina.github.io/IMPACTO/"
      },
      "skos:notation": "eu-aiact-FRIARequiredProcess",
      "skos:note": [
        {
          "@language": "en",
          "@value": "Proposed for: DPV EU AI Act extension (eu-aiact)"
        },
        {
          "@language": "en",
          "@value": "Source: AI Act Art. 27(1)"
        }
      ],
      "skos:prefLabel": {
        "@language": "en",
        "@value": "FRIA Required Process"
      },
      "skos:related": {
        "@id": "impacto:eu-aiact-FRIARequired"
      },
      "skos:scopeNote": {
        "@language": "en",
        "@value": "The counterpart of impacto:eu-gdpr-DPIARequiredProcess for the FRIA. The outcome of the FRIA necessity assessment is recorded with dpv:hasStatus impacto:eu-aiact-FRIARequired."
      }
    },
