        "@value": "A status associated with eu-aiact:FRIANotification (via dpv:hasStatus) that represents the state of the notification obligation and its fulfilment."
      },
      "skos:editorialNote": {
        "@language": "en",
        "@value": "The other status concepts in this index descend from dpv:AuditStatus; the source table gives eu-aiact:FRIANotification (a process) as the parent here."
      },
      "skos:inScheme": {
