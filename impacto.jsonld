{
  "@context": {
    "ai": "https://w3id.org/dpv/ai#",
    "dcterms": "http://purl.org/dc/terms/",
    "dpv": "https://w3id.org/dpv#",
    "eu-aiact": "https://w3id.org/dpv/legal/eu/aiact#",
    "eu-gdpr": "https://w3id.org/dpv/legal/eu/gdpr#",
    "impacto": "https://tyttikatariina.github.io/IMPACTO/#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "tech": "https://w3id.org/dpv/tech#",
    "vann": "http://purl.org/vocab/vann/"
  },
  "@graph": [
    {
      "@id": "https://tyttikatariina.github.io/IMPACTO/",
      "@type": [
        "skos:ConceptScheme",
        "owl:Ontology"
      ],
      "dcterms:contributor": "Harshvardhan J. Pandit",
      "dcterms:created": {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "YYYY-MM-DD"
      },
      "dcterms:creator": "Tytti Rintamäki",
      "dcterms:description": {
        "@language": "en",
        "@value": "IMPACTO represents impact assessment requirements and processes based on the GDPR and the EU AI Act, specifically the Data Protection Impact Assessment (DPIA) and the Fundamental Rights Impact Assessment (FRIA)."
      },
      "dcterms:license": {
        "@id": "http://creativecommons.org/licenses/by/4.0/"
      },
      "dcterms:modified": {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-10-15"
      },
      "dcterms:publisher": "ADAPT Centre, Dublin City University",
      "dcterms:source": [
        {
          "@language": "en",
          "@value": "GDPR (Regulation EU 2016/679)"
        },
        {
          "@language": "en",
          "@value": "EU AI Act (Regulation EU 2024/1689)"
        }
      ],
      "dcterms:title": "IMPACTO",
      "owl:versionIRI": {
        "@id": "https://tyttikatariina.github.io/IMPACTO/1.0"
      },
      "owl:versionInfo": {
        "@language": "en",
        "@value": "1.0"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Impact Assessment Ontology"
      },
      "skos:altLabel": {
        "@language": "en",
        "@value": "IMPACTO"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "IMPACTO represents impact assessment requirements and processes based on the GDPR and the EU AI Act, specifically the Data Protection Impact Assessment (DPIA) and the Fundamental Rights Impact Assessment (FRIA)."
      },
      "skos:notation": "impacto",
      "skos:note": [
        {
          "@language": "en",
          "@value": "Licensed under a Creative Commons Attribution 4.0 International License (CC BY 4.0)."
        },
        {
          "@language": "en",
          "@value": "Version 1.0"
        },
        {
          "@language": "en",
          "@value": "Authors: Tytti Rintamäki (ADAPT Centre, Dublin City University); Harshvardhan J. Pandit (AI Accountability Lab, Trinity College Dublin)"
        },
        {
          "@language": "en",
          "@value": "Sources: GDPR (Regulation EU 2016/679); EU AI Act (Regulation EU 2024/1689)"
        }
      ],
      "skos:prefLabel": {
        "@language": "en",
        "@value": "IMPACTO (Impact Assessment Ontology)"
      },
      "vann:preferredNamespacePrefix": "impacto",
      "vann:preferredNamespaceUri": "https://tyttikatariina.github.io/IMPACTO/#"
    },
    {
      "@id": "impacto:ai-AISubject",
      "@type": "skos:Concept",
      "skos:broader": {
        "@id": "ai:AI"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A natural person or group of persons that is subject to, or affected by, the use of an AI system."
      },
      "skos:inScheme": {
        "@id": "https://tyttikatariina.github.io/IMPACTO/"
      },
      "skos:notation": "ai-AISubject",
      "skos:note": [
        {
          "@language": "en",
          "@value": "Proposed for: DPV AI extension (ai)"
        },
        {
          "@language": "en",
          "@value": "Source: AI Act Art. 27(1)(c)"
        }
      ],
      "skos:prefLabel": {
        "@language": "en",
        "@value": "AI Subject"
      }
    },
    {
      "@id": "impacto:ai-NaturalPersonCategorySubjects",
      "@type": "skos:Concept",
      "skos:broader": {
        "@id": "ai:AI"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The categories of natural persons and groups likely to be affected by the use of an AI system in a specific context."
      },
      "skos:inScheme": {
        "@id": "https://tyttikatariina.github.io/IMPACTO/"
      },
      "skos:notation": "ai-NaturalPersonCategorySubjects",
      "skos:note": [
        {
          "@language": "en",
          "@value": "Proposed for: DPV AI extension (ai)"
        },
        {
          "@language": "en",
          "@value": "Source: AI Act Art. 27(1)(c)"
        }
      ],
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Natural Person Category Subjects"
      }
    },
    {
      "@id": "impacto:dpv-AffectedEntity",
      "@type": "skos:Concept",
      "skos:broader": {
        "@id": "dpv:Entity"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "An entity, such as a natural person, group or organisation, that is affected by the impacts of processing or of the use of a technology."
      },
      "skos:inScheme": {
        "@id": "https://tyttikatariina.github.io/IMPACTO/"
      },
      "skos:notation": "dpv-AffectedEntity",
      "skos:note": {
        "@language": "en",
        "@value": "Proposed for: DPV core (dpv)"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Affected Entity"
      }
    },
    {
      "@id": "impacto:dpv-CommercialBenefit",
      "@type": "skos:Concept",
      "skos:broader": {
        "@id": "dpv:Purpose"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Purposes associated with obtaining or preserving a commercial benefit for an organisation."
      },
      "skos:inScheme": {
        "@id": "https://tyttikatariina.github.io/IMPACTO/"
      },
      "skos:notation": "dpv-CommercialBenefit",
      "skos:note": {
        "@language": "en",
        "@value": "Proposed for: DPV core (dpv)"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Commercial Benefit"
      },
      "skos:scopeNote": {
        "@language": "en",
        "@value": "Proposed as the parent of dpv:ProtectionOfCommercialInterest."
      }
    },
    {
      "@id": "impacto:dpv-DPIAExemption",
      "@type": "skos:Concept",
      "skos:broader": {
        "@id": "dpv:DPIA"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The one condition under which specific processing is exempt from the obligation to carry out a DPIA as per GDPR Art. 35(10)."
      },
      "skos:inScheme": {
        "@id": "https://tyttikatariina.github.io/IMPACTO/"
      },
      "skos:notation": "dpv-DPIAExemption",
      "skos:note": [
        {
          "@language": "en",
          "@value": "Proposed for: DPV core (dpv)"
        },
        {
          "@language": "en",
          "@value": "Source: GDPR Art. 35(10)"
        }
      ],
      "skos:prefLabel": {
        "@language": "en",
        "@value": "DPIA Exemption"
      }
    },
    {
      "@id": "impacto:dpv-DPIAExemptionA35",
      "@type": "skos:Concept",
      "skos:broader": {
        "@id": "impacto:dpv-DPIAExemption"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The specific DPIA exemption in Article 35 of the GDPR which states that if processing under Article 6(1)(c) or (e) is goverened by Union or MemberState law and a DPIA was already conducted as part o a general impact assesment, a further DPIA is not required unless the Member State considers one necessary before processing."
      },
      "skos:inScheme": {
        "@id": "https://tyttikatariina.github.io/IMPACTO/"
      },
      "skos:notation": "dpv-DPIAExemptionA35",
      "skos:note": {
        "@language": "en",
        "@value": "Proposed for: DPV core (dpv)"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "DPIA Exemption A35"
      }
    },
    {
      "@id": "impacto:dpv-DataSubjectBehaviourMonitoring",
      "@type": "skos:Concept",
      "skos:broader": {
        "@id": "dpv:Purpose"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Processing related to the monitoring of the behaviour of data subjects, as far as that behaviour takes place within the Union."
      },
      "skos:inScheme": {
        "@id": "https://tyttikatariina.github.io/IMPACTO/"
      },
      "skos:notation": "dpv-DataSubjectBehaviourMonitoring",
      "skos:note": [
        {
          "@language": "en",
          "@value": "Proposed for: DPV core (dpv)"
        },
        {
          "@language": "en",
          "@value": "Source: GDPR Art. 3(2)(b)"
        }
      ],
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Data Subject Behaviour Monitoring"
      }
    },
    {
      "@id": "impacto:dpv-DataSubjectGoodsOffer",
      "@type": "skos:Concept",
      "skos:broader": {
        "@id": "dpv:Purpose"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Processing related to the offering of goods to data subjects, irrespective of whether a payment is required."
      },
      "skos:inScheme": {
        "@id": "https://tyttikatariina.github.io/IMPACTO/"
      },
      "skos:notation": "dpv-DataSubjectGoodsOffer",
      "skos:note": [
        {
          "@language": "en",
          "@value": "Proposed for: DPV core (dpv)"
        },
        {
          "@language": "en",
          "@value": "Source: GDPR Art. 3(2)(a)"
        }
      ],
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Data Subject Goods Offer"
      }
    },
    {
      "@id": "impacto:dpv-DataSubjectServicesOffer",
      "@type": "skos:Concept",
      "skos:broader": {
        "@id": "dpv:Purpose"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Processing related to the offering of services to data subjects, irrespective of whether a payment is required."
      },
      "skos:inScheme": {
        "@id": "https://tyttikatariina.github.io/IMPACTO/"
      },
      "skos:notation": "dpv-DataSubjectServicesOffer",
      "skos:note": [
        {
          "@language": "en",
          "@value": "Proposed for: DPV core (dpv)"
        },
        {
          "@language": "en",
          "@value": "Source: GDPR Art. 3(2)(a)"
        }
      ],
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Data Subject Services Offer"
      }
    },
    {
      "@id": "impacto:dpv-ProcessingContextEvaluation",
      "@type": "skos:Concept",
      "skos:broader": {
        "@id": "dpv:ProcessingContext"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A processing context in which personal data is used to evaluate personal aspects relating to natural persons, such as in systematic and extensive evaluation."
      },
      "skos:inScheme": {
        "@id": "https://tyttikatariina.github.io/IMPACTO/"
      },
      "skos:notation": "dpv-ProcessingContextEvaluation",
      "skos:note": [
        {
          "@language": "en",
          "@value": "Proposed for: DPV core (dpv)"
        },
        {
          "@language": "en",
          "@value": "Source: GDPR Art. 35(3)(a)"
        }
      ],
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Processing Context Evaluation"
      }
    },
    {
      "@id": "impacto:dpv-ProcessingDescription",
      "@type": "skos:Concept",
      "skos:broader": {
        "@id": "dpv:Context"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A systematic description of the envisaged processing operations and the purposes of the processing, including, where applicable, the legitimate interest pursued by the controller, as part of a DPIA."
      },
      "skos:inScheme": {
        "@id": "https://tyttikatariina.github.io/IMPACTO/"
      },
      "skos:notation": "dpv-ProcessingDescription",
      "skos:note": [
        {
          "@language": "en",
          "@value": "Proposed for: DPV (dpv)"
        },
        {
          "@language": "en",
          "@value": "Source: GDPR Art. 35(7)(a)"
        }
      ],
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Processing Description"
      }
    },
    {
      "@id": "impacto:dpv-ProtectionOfCommercialInterest",
      "@type": "skos:Concept",
      "skos:broader": {
        "@id": "impacto:dpv-CommercialBenefit"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Processing carried out to protect the commercial interests of an organisation, such as trade secrets or business confidentiality."
      },
      "skos:inScheme": {
        "@id": "https://tyttikatariina.github.io/IMPACTO/"
      },
      "skos:notation": "dpv-ProtectionOfCommercialInterest",
      "skos:note": {
        "@language": "en",
        "@value": "Proposed for: DPV core (dpv)"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Protection Of Commercial Interest"
      }
    },
    {
      "@id": "impacto:dpv-ProtectionOfOperationalSecurity",
      "@type": "skos:Concept",
      "skos:broader": {
        "@id": "dpv:Purpose"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Processing carried out to protect the security of an organisation's operations, systems or premises."
      },
      "skos:inScheme": {
        "@id": "https://tyttikatariina.github.io/IMPACTO/"
      },
      "skos:notation": "dpv-ProtectionOfOperationalSecurity",
      "skos:note": {
        "@language": "en",
        "@value": "Proposed for: DPV core (dpv)"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Protection Of Operational Security"
      }
    },
    {
      "@id": "impacto:dpv-ProtectionOfPublicInterest",
      "@type": "skos:Concept",
      "skos:broader": {
        "@id": "dpv:PublicBenefit"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Processing carried out to protect an interest of the public at large."
      },
      "skos:inScheme": {
        "@id": "https://tyttikatariina.github.io/IMPACTO/"
      },
      "skos:notation": "dpv-ProtectionOfPublicInterest",
      "skos:note": {
        "@language": "en",
        "@value": "Proposed for: DPV core (dpv)"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Protection Of Public Interest"
      }
    },
    {
      "@id": "impacto:eu-aiact-A46-Notification-Exemptions",
      "@type": "skos:Concept",
      "skos:broader": {
        "@id": "impacto:eu-aiact-FRIANotification"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The exemption from the obligation to notify the market surveillance authority that applies in the cases referred to in AI Act Article 46(1)."
      },
      "skos:inScheme": {
        "@id": "https://tyttikatariina.github.io/IMPACTO/"
      },
      "skos:notation": "eu-aiact-A46-Notification-Exemptions",
      "skos:note": [
        {
          "@language": "en",
          "@value": "Proposed for: DPV EU AI Act extension (eu-aiact)"
        },
        {
          "@language": "en",
          "@value": "Source: AI Act Art. 27(3), Art. 46(1)"
        }
      ],
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Art 46 Notification Exemptions"
      }
    },
    {
      "@id": "impacto:eu-aiact-AutomatedTool",
      "@type": "skos:Concept",
      "skos:broader": {
        "@id": "impacto:eu-aiact-FRIATemplate"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "An automated tool through which the FRIA questionnaire template may be provided and completed."
      },
      "skos:inScheme": {
        "@id": "https://tyttikatariina.github.io/IMPACTO/"
      },
      "skos:notation": "eu-aiact-AutomatedTool",
      "skos:note": [
        {
          "@language": "en",
          "@value": "Proposed for: DPV EU AI Act extension (eu-aiact)"
        },
        {
          "@language": "en",
          "@value": "Source: AI Act Art. 27(5)"
        }
      ],
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Automated Tool"
      }
    },
    {
      "@id": "impacto:eu-aiact-ComplaintMeasures",
      "@type": "skos:Concept",
      "skos:broader": {
        "@id": "dpv:AIGovernance"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Complaint mechanisms to be used by the deployer in the case of the materialisation of risks to fundamental rights."
      },
      "skos:inScheme": {
        "@id": "https://tyttikatariina.github.io/IMPACTO/"
      },
      "skos:notation": "eu-aiact-ComplaintMeasures",
      "skos:note": [
        {
          "@language": "en",
          "@value": "Proposed for: DPV EU AI Act extension (eu-aiact)"
        },
        {
          "@language": "en",
          "@value": "Source: AI Act Art. 27(1)(f)"
        }
      ],
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Complaint Measures"
      }
    },
    {
      "@id": "impacto:eu-aiact-ConsultationWithAffectedEntities",
      "@type": "skos:Concept",
      "skos:broader": {
        "@id": "dpv:Consultation"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Consultation with the natural persons, groups or other entities likely to be affected by the use of the AI system, or with their representatives."
      },
      "skos:inScheme": {
        "@id": "https://tyttikatariina.github.io/IMPACTO/"
      },
      "skos:notation": "eu-aiact-ConsultationWithAffectedEntities",
      "skos:note": {
        "@language": "en",
        "@value": "Proposed for: DPV EU AI Act extension (eu-aiact)"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Consultation with Affected Entities"
      }
    },
    {
      "@id": "impacto:eu-aiact-ConsultationWithMarketSurveillanceAuthority",
      "@type": "skos:Concept",
      "skos:broader": {
        "@id": "dpv:Consultation"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Consultation with the market surveillance authority competent for the AI system."
      },
      "skos:inScheme": {
        "@id": "https://tyttikatariina.github.io/IMPACTO/"
      },
      "skos:notation": "eu-aiact-ConsultationWithMarketSurveillanceAuthority",
      "skos:note": {
        "@language": "en",
        "@value": "Proposed for: DPV EU AI Act extension (eu-aiact)"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Consultation with Market Surveillance Authority"
      }
    },
    {
      "@id": "impacto:eu-aiact-ConsultationWithProvider",
      "@type": "skos:Concept",
      "skos:broader": {
        "@id": "dpv:Consultation"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Consultation with the provider of the AI system, for example regarding the information provided under Article 13 or existing impact assessments."
      },
      "skos:inScheme": {
        "@id": "https://tyttikatariina.github.io/IMPACTO/"
      },
      "skos:notation": "eu-aiact-ConsultationWithProvider",
      "skos:note": {
        "@language": "en",
        "@value": "Proposed for: DPV EU AI Act extension (eu-aiact)"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Consultation with Provider"
      }
    },
    {
      "@id": "impacto:eu-aiact-Exempt",
      "@type": "skos:Concept",
      "skos:broader": {
        "@id": "impacto:eu-aiact-FRIAExemptions"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A determination that the deployment of the AI system is exempt from the FRIA obligation."
      },
      "skos:inScheme": {
        "@id": "https://tyttikatariina.github.io/IMPACTO/"
      },
      "skos:notation": "eu-aiact-Exempt",
      "skos:note": {
        "@language": "en",
        "@value": "Proposed for: DPV EU AI Act extension (eu-aiact)"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "AI System Exempt"
      }
    },
    {
      "@id": "impacto:eu-aiact-ExistingDPIAInput",
      "@type": "skos:Concept",
      "skos:broader": {
        "@id": "impacto:eu-aiact-ImpactAssessmentReuse"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A DPIA conducted under GDPR Article 35 through which some FRIA obligations are already met, and which can be used as input in a FRIA."
      },
      "skos:inScheme": {
        "@id": "https://tyttikatariina.github.io/IMPACTO/"
      },
      "skos:notation": "eu-aiact-ExistingDPIAInput",
      "skos:note": [
        {
          "@language": "en",
          "@value": "Proposed for: DPV EU AI Act extension (eu-aiact)"
        },
        {
          "@language": "en",
          "@value": "Source: AI Act Art. 27(4)"
        }
      ],
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Existing DPIA Input"
      },
      "skos:related": {
        "@id": "dpv:hasReuseCompatibility"
      }
    },
    {
      "@id": "impacto:eu-aiact-FRIAExempt",
      "@type": "skos:Concept",
      "skos:broader": {
        "@id": "impacto:eu-aiact-FRIANecessityStatus"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A FRIA necessity status indicating that a FRIA is not required because an exemption applies, such as for high-risk AI systems intended to be used in the area listed in point 2 of Annex III."
      },
      "skos:inScheme": {
