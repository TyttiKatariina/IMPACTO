      "skos:broader": {
        "@id": "impacto:eu-aiact-FRIANecessityStatus"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A FRIA necessity status indicating that the organisation is not required to conduct a FRIA."
      },
      "skos:inScheme": {
        "@id": "https://tyttikatariina.github.io/IMPACTO/"
      },
      "skos:notation": "eu-aiact-FRIANotRequired",
