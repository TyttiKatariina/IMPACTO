        "@id": "dpv:AuditStatus"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A status associated with eu-aiact:FRIANecessityAssessment (via dpv:hasStatus) that represents the specific outcome of the necessity assessment process."
      },
      "skos:inScheme": {
        "@id": "https://tyttikatariina.github.io/IMPACTO/"
      },
      "skos:notation": "eu-aiact-FRIANecessityStatus",
