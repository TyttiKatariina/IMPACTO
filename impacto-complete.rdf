    <skos:exactMatch rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-PublicRoad"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess">
    <rdfs:subClassOf rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdfs:subClassOf rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
