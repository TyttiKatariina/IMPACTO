    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/bg#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Bulgaria and which involves the migration of data from existing to new technologies where this is related to large-scale data processing</skos:definition>
    <dpv:hasContext rdf:resource="https://w3id.org/dpv#InnovativeUseOfTechnology"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#BG"/>
    <dpv:hasProcessing rdf:resource="https://w3id.org/dpv#Transfer"/>
    <dpv:hasProcessingScale rdf:resource="https://w3id.org/dpv#LargeScaleProcessing"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/ImpactAssessmentOntology/#InfluenceHumanActivity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Influence Human Activity</rdfs:label>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceAT"/>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceCZ"/>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceDE"/>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceES"/>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceGR"/>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceLT"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv/risk#IndividualRisk"/>
    <skos:broader rdf:resource="https://w3id.org/dpv/risk#IndividualRisk"/>
    <skos:definition xml:lang="en">An influence on humans as individuals or as groups</skos:definition>
    <skos:notation>C25</skos:notation>
    <skos:prefLabel xml:lang="en">Influence Human Activity</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Classified as a risk/consequence concept (ex-post) rather than a processing context, as influencing an individual is a consequence of processing designed to achieve that outcome</skos:scopeNote>
  </rdf:Description>
