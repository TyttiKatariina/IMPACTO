    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#DemocraticParticipationManagement"/>
    <skos:definition xml:lang="en">The organisation and management of citizens' initiatives by their organisers.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/impacto/FRIA-2">
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/aiact#FRIA"/>
    <rdfs:label xml:lang="en">FRIA: consumer credit scoring</rdfs:label>
