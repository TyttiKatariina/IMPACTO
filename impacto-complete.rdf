    <rdfs:label xml:lang="en">has reuse level</rdfs:label>
    <rdfs:range rdf:resource="https://tyttikatariina.github.io/IMPACTO/#ReuseLevel"/>
    <skos:definition xml:lang="en">The extent to which the corresponding DPIA content can be relied upon.</skos:definition>
    <skos:prefLabel xml:lang="en">has reuse level</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SmartMeter">
