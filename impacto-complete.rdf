    <rdfs:seeAlso rdf:resource="https://eur-lex.europa.eu/eli/reg/2024/1689/oj/eng"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv/legal/eu/aiact#FRIA"/>
    <skos:broader rdf:resource="https://w3id.org/dpv/legal/eu/aiact#FRIA"/>
    <skos:definition xml:lang="en">Whether a FRIA is required for a given deployment of an AI system, as determined under AI Act Article 27(1).</skos:definition>
    <skos:prefLabel xml:lang="en">FRIA Necessity</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Proposed for: DPV EU AI Act extension (eu-aiact)</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#dpv-ProcessingContextEvaluation">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
