    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">IS C16: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/is#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Iceland and which involves (Large scale) processing of employee activities</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#IS"/>
    <dpv:hasProcessingScale rdf:resource="https://w3id.org/dpv#LargeScaleProcessing"/>
    <dpv:hasTechnicalMeasure rdf:resource="https://w3id.org/dpv#ActivityMonitoring"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#FRIA-IR-c">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#FRIAInformationRequirement"/>
    <rdfs:label xml:lang="en">Categories of affected persons and groups</rdfs:label>
    <dcterms:source xml:lang="en">AI Act Art.27(1)(c)</dcterms:source>
    <skos:definition xml:lang="en">The categories of natural persons and groups likely to be affected by the use of the system in the specific context.</skos:definition>
    <skos:prefLabel xml:lang="en">Categories of affected persons and groups</skos:prefLabel>
    <impacto-old:correspondsToDPIARequirement rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIA-IR-4"/>
    <impacto-old:correspondsToDPIARequirement rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIA-IR-7"/>
    <impacto-old:hasExpectedProperty rdf:resource="https://tyttikatariina.github.io/IMPACTO/#hasAffectedGroup"/>
    <impacto-old:hasReuseGap xml:lang="en">The DPIA identifies categories of data subject. The FRIA covers all natural persons and groups likely to be affected, including persons who are not data subjects of the processing, and requires attention to groups rather than only individuals.</impacto-old:hasReuseGap>
    <impacto-old:hasReuseLevel rdf:resource="https://tyttikatariina.github.io/IMPACTO/#PartiallyReusable"/>
    <impacto-old:isMandatory rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</impacto-old:isMandatory>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/pl#C11">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">PL C11: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/pl#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Poland and which involves processing of Biometric data</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#PL"/>
    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#BiometricData"/>
  </rdf:Description>
