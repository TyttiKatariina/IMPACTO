    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#GR"/>
    <dpv:hasProcessing rdf:resource="https://w3id.org/dpv#Match"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv#Identification">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Identification</rdfs:label>
    <dcterms:source xml:lang="en">CN20</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#Purpose"/>
    <skos:definition xml:lang="en">Processing carried out to identify an individual or to make the identity of the responsible controller apparent.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#PartiallyReusable">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#ReuseLevel"/>
    <rdfs:label xml:lang="en">Partially Reusable</rdfs:label>
    <skos:definition xml:lang="en">The DPIA content covers part of the FRIA requirement but must be extended, typically because the FRIA reaches beyond data protection to other fundamental rights, or beyond data subjects to other affected persons and groups.</skos:definition>
    <skos:prefLabel xml:lang="en">Partially Reusable</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/ro#C14a">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">RO C14a: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/ro#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Romania and which involves Evaluation or scoring of individuals (including profiling or predicting)</skos:definition>
    <dpv:hasContext rdf:resource="https://w3id.org/dpv#EvaluationOfIndividuals"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#RO"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv#ImageData">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
