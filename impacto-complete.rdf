  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#hasInformationRequirement">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">has information requirement</rdfs:label>
    <rdfs:range rdf:resource="https://tyttikatariina.github.io/IMPACTO/#InformationRequirement"/>
