  <rdf:Description rdf:about="https://example.org/impacto/Reuse-1a">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIAInputInFRIA"/>
    <rdfs:label xml:lang="en">Process description reused</rdfs:label>
    <skos:prefLabel xml:lang="en">Process description reused</skos:prefLabel>
    <impacto-old:hasReuseGap rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The DPIA describes the personal data processing. The FRIA adds the surrounding recruitment process, including the interview stage where no personal data is processed by the system.</impacto-old:hasReuseGap>
    <impacto-old:hasReuseLevel rdf:resource="https://tyttikatariina.github.io/IMPACTO/#PartiallyReusable"/>
    <impacto-old:reusedElement rdf:resource="https://example.org/impacto/Proc-Shortlisting"/>
    <impacto-old:satisfiesRequirement rdf:resource="https://tyttikatariina.github.io/IMPACTO/#FRIA-IR-a"/>
  </rdf:Description>
