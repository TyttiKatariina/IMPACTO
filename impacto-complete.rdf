  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#hasDataSubjectCount">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">has data subject count</rdfs:label>
    <skos:definition xml:lang="en">The number or estimated number of data subjects affected.</skos:definition>
    <skos:prefLabel xml:lang="en">has data subject count</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/is#C16">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
