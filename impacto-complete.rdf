    <impacto-old:indicatesDPIACondition rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#C8a"/>
    <impacto-old:indicatesDPIACondition rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#C9"/>
    <impacto-old:patternFor rdf:resource="https://w3id.org/dpv/legal/eu/aiact#HighRiskAISystem-AnnexIII-4-b"/>
    <dpv:hasContext rdf:resource="https://tyttikatariina.github.io/IMPACTO/#ai-UseOfAI"/>
