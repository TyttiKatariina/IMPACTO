    <rdfs:label xml:lang="en">LU C16: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/lu#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Luxembourg and which involves (Large scale) processing of employee activities</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#LU"/>
    <dpv:hasProcessingScale rdf:resource="https://w3id.org/dpv#LargeScaleProcessing"/>
    <dpv:hasTechnicalMeasure rdf:resource="https://w3id.org/dpv#ActivityMonitoring"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/dpia-conditions#C100">
