  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#eu-aiact-FRIAExempt">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">FRIA Exempt</rdfs:label>
    <dcterms:source xml:lang="en">AI Act Art. 27(1)</dcterms:source>
    <rdfs:seeAlso rdf:resource="https://eur-lex.europa.eu/eli/reg/2024/1689/oj/eng"/>
    <rdfs:subClassOf rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-aiact-FRIANecessityStatus"/>
    <skos:broader rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-aiact-FRIANecessityStatus"/>
    <skos:definition xml:lang="en">A FRIA necessity status indicating that a FRIA is not required because an exemption applies, such as for high-risk AI systems intended to be used in the area listed in point 2 of Annex III.</skos:definition>
    <skos:prefLabel xml:lang="en">FRIA Exempt</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Proposed for: DPV EU AI Act extension (eu-aiact)</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/hu#C11">
