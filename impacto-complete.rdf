    <skos:editorialNote xml:lang="en">Used by the DPIA condition set but not yet defined in IMPACTO-concepts.ttl. Proposed for the dpv namespace.</skos:editorialNote>
    <skos:prefLabel xml:lang="en">Personal Data Deletion</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#reusedElement">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">reused element</rdfs:label>
    <rdfs:domain rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIAInputInFRIA"/>
    <skos:definition xml:lang="en">The specific element of the DPIA being relied on, such as a processing description, a risk, or a set of measures.</skos:definition>
    <skos:prefLabel xml:lang="en">reused element</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/is#C17b">
