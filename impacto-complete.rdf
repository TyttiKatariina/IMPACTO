  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#F3">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#FRIARequiredCondition"/>
    <rdfs:label xml:lang="en">Any deployer of a creditworthiness system</rdfs:label>
    <dcterms:source xml:lang="en">AI Act Art.27(1)</dcterms:source>
    <skos:definition xml:lang="en">A FRIA is required because the system evaluates the creditworthiness of natural persons or establishes their credit score, under Annex III point 5(b). This applies irrespective of the category of deployer.</skos:definition>
    <skos:note xml:lang="en">No impacto:requiresDeployerType is stated: the obligation attaches to every deployer of such a system, public or private.</skos:note>
    <skos:prefLabel xml:lang="en">Any deployer of a creditworthiness system</skos:prefLabel>
    <impacto-old:hasObligationSource rdf:resource="https://tyttikatariina.github.io/IMPACTO/#FRIASource-A27"/>
    <impacto-old:requiresAISystemType rdf:resource="https://w3id.org/dpv/legal/eu/aiact#HighRiskAISystem-AnnexIII-5-b"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/no#C40">
