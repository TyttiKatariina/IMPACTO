    <dpv:hasLikelihood rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dpv:hasLikelihood>
    <dpv:hasRiskLevel rdf:resource="https://w3id.org/dpv/risk#HighRisk"/>
