    <rdfs:label xml:lang="en">has treatment description</rdfs:label>
    <skos:definition xml:lang="en">A description of how a risk is treated.</skos:definition>
    <skos:prefLabel xml:lang="en">has treatment description</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#AnnexIII-4-b-Pattern">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AISystemProcessingPattern"/>
    <rdfs:label xml:lang="en">Decisions on work relationships and monitoring of workers</rdfs:label>
