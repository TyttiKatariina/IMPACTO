    <rdfs:label xml:lang="en">HR C52a: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/hr#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Croatia and which involves where personal data are collected from third parties in order to be subsequently taken into account in the decision to refuse or terminate a specific service contract with a natural person</skos:definition>
    <dpv:hasContext rdf:resource="https://w3id.org/dpv#RefuseContract"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#HR"/>
    <dpv:hasSource rdf:resource="https://w3id.org/dpv#ThirdPartyDataSource"/>
  </rdf:Description>
