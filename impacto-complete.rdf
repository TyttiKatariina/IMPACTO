    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of EX and which involves extensive processing of sensitive personal data for the purpose of developing algorithms</skos:definition>
    <dpv:hasContext rdf:resource="https://w3id.org/dpv#AlgorithmicLogic"/>
