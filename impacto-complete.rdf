    <skos:prefLabel xml:lang="en">Implantable Medical Device</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/pl#C31b">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">PL C31b: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/pl#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Poland and which involves processing concerned with evaluating individuals for various insurance purposes</skos:definition>
    <dpv:hasContext rdf:resource="https://w3id.org/dpv#EvaluationOfIndividuals"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#PL"/>
    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv/pd#Insurance"/>
    <dpv:hasPurpose rdf:resource="https://w3id.org/dpv/sector/health#InsuranceManagement"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/fi#C37g">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">FI C37g: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/fi#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Finland and which involves The use of new technologies or technological solutions for the processing of personal data or with the possibility of processing personal data to analyse or predict the economic situation, health, personal preferences or interests, reliability or behaviour, location or movements of natural persons</skos:definition>
    <dpv:hasContext rdf:resource="https://w3id.org/dpv#InnovativeUseOfNewTechnologies"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#FI"/>
    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv/pd#Behavioural"/>
    <dpv:hasProcessing rdf:resource="https://w3id.org/dpv#Analyse"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/dpia-conditions#DPIARequiredList">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredList"/>
    <rdfs:label xml:lang="en">DPIA required list (EX)</rdfs:label>
    <skos:definition xml:lang="en">List of processing operations for which a data protection impact assessment is mandatory, published by the national supervisory authority under GDPR Art.35(4).</skos:definition>
    <skos:prefLabel xml:lang="en">DPIA required list (EX)</skos:prefLabel>
    <impacto-old:appliesInJurisdiction rdf:resource="https://w3id.org/dpv/loc#EX"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#EX"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#eu-aiact-FRIAMarketSurveillanceAuthorityNotified">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">FRIA Market Surveillance Authority Notified</rdfs:label>
    <dcterms:source xml:lang="en">AI Act Art. 27(3)</dcterms:source>
    <rdfs:seeAlso rdf:resource="https://eur-lex.europa.eu/eli/reg/2024/1689/oj/eng"/>
    <rdfs:subClassOf rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-aiact-FRIANotification"/>
    <skos:broader rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-aiact-FRIANotification"/>
    <skos:definition xml:lang="en">Indication that the market surveillance authority has been notified of the results of the FRIA.</skos:definition>
    <skos:prefLabel xml:lang="en">FRIA Market Surveillance Authority Notified</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Proposed for: DPV EU AI Act extension (eu-aiact)</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv#PrivateSponsors">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Private Sponsors</rdfs:label>
    <dcterms:source xml:lang="en">CN10</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#Entity"/>
    <skos:definition xml:lang="en">A private entity that sponsors or funds the activities of an association, partnership or similar body.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#isEmbeddedInAISystem">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">is embedded in AI system</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/dpv#Process"/>
    <rdfs:range rdf:resource="https://w3id.org/dpv/legal/eu/aiact#AISystem"/>
    <owl:inverseOf rdf:resource="https://tyttikatariina.github.io/IMPACTO/#embedsProcessingActivity"/>
    <skos:definition xml:lang="en">Indicates that a processing activity is carried out through the use of a given AI system.</skos:definition>
    <skos:prefLabel xml:lang="en">is embedded in AI system</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/dpia-conditions#C61f">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">DPIA-CONDITIONS C61f: Processing personal data with the purpose of providing services or…</rdfs:label>
    <dcterms:source rdf:resource="https://example.org/dpia-conditions#DPIARequiredList"/>
    <skos:definition xml:lang="en">Processing personal data with the purpose of providing services or developing products for commercial use that involve predicting working capacity, economic status, health, personal preferences or interests, trustworthiness, behavior, location or route (Sensitive data or data of highly personal nature and evaluation/scoring).</skos:definition>
    <dpv:hasIntendedPurpose rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-CommercialUse"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#EX"/>
    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv/pd#Preference"/>
    <dpv:hasPurpose rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-ProductDevelopment"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/ImpactAssessmentOntology/#GoodConduct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Good Conduct</rdfs:label>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceAll"/>
    <rdfs:subClassOf rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#Conduct"/>
    <skos:broader rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#Conduct"/>
    <skos:definition xml:lang="en">Behaviour that is lawful, ethical, professional, reputation-enhancing or neutral and unlikely to cause social or professional harm</skos:definition>
    <skos:notation>C9</skos:notation>
    <skos:prefLabel xml:lang="en">Good Conduct</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/lt#C16">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">LT C16: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/lt#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Lithuania and which involves (Large scale) processing of employee activities</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#LT"/>
    <dpv:hasProcessingScale rdf:resource="https://w3id.org/dpv#LargeScaleProcessing"/>
    <dpv:hasTechnicalMeasure rdf:resource="https://w3id.org/dpv#ActivityMonitoring"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/hr#C38">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">HR C38: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/hr#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Croatia and which involves the processing of personal data by linking, comparing or verifying matches from multiple sources</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#HR"/>
    <dpv:hasProcessing rdf:resource="https://w3id.org/dpv#Match"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/gr#C31a">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">GR C31a: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/gr#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Greece and which involves processing concerned with evaluating individuals for various insurance purposes</skos:definition>
    <dpv:hasContext rdf:resource="https://w3id.org/dpv#EvaluationOfIndividuals"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#GR"/>
    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv/pd#Insurance"/>
    <dpv:hasPurpose rdf:resource="https://w3id.org/dpv/sector/finance#InsuranceManagement"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/pl#C43c">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
