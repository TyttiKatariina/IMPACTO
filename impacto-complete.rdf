  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#reliesOnPreviousFRIA">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">relies on previous FRIA</rdfs:label>
    <dcterms:source xml:lang="en">AI Act Art.27(2)</dcterms:source>
    <rdfs:domain rdf:resource="https://tyttikatariina.github.io/IMPACTO/#FRIA"/>
    <rdfs:range rdf:resource="https://tyttikatariina.github.io/IMPACTO/#FRIA"/>
    <skos:definition xml:lang="en">Indicates that the deployer relies on a fundamental rights impact assessment previously conducted, or on information provided by the provider, because the relevant obligations are already met.</skos:definition>
    <skos:prefLabel xml:lang="en">relies on previous FRIA</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/es#C25d">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
