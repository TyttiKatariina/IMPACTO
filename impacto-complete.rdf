    <dpv:hasPurpose rdf:resource="https://tyttikatariina.github.io/IMPACTO/#sector-publicservices-OrganisingEGovernmentServices"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#eu-aiact-FRIARiskStatus">
