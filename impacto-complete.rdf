    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv/pd#VoiceCommunicationRecording"/>
    <dpv:hasProcessing rdf:resource="https://w3id.org/dpv#Record"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/cy#C27">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
