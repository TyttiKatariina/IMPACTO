    <dpv:hasPurpose rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-ProductDevelopment"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/be#C55">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">BE C55: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/be#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Austria and which involves the systematic transfer of special data categories between controllers</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#BE"/>
    <dpv:hasProcessing rdf:resource="https://w3id.org/dpv#Transfer"/>
    <dpv:hasSensitivePersonalData rdf:resource="https://w3id.org/dpv#SpecialCategoryPersonalData"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/dpia-conditions#C57g">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">DPIA-CONDITIONS C57g: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://example.org/dpia-conditions#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of EX and which involves the supervision of the data subject, which is carried out in the following cases: a. if it is carried out on a large scale; b. if it is carried out at the workplace; c. if it applies to specially protected data subjects (e.g. health care, social care, prison, prison, educational institution, workplace)</skos:definition>
    <dpv:hasContext rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-MonitoringIndividuals"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#EX"/>
    <dpv:hasLocation rdf:resource="https://tyttikatariina.github.io/IMPACTO/#loc-EducationalInstitution"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv#LandManagement">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Land Management</rdfs:label>
    <dcterms:source xml:lang="en">CN55</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#Purpose"/>
    <skos:definition xml:lang="en">The management of land associated with residential buildings held by an association or community of apartment owners.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#FRIA-IR-b">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#FRIAInformationRequirement"/>
    <rdfs:label xml:lang="en">Period and frequency of use</rdfs:label>
    <dcterms:source xml:lang="en">AI Act Art.27(1)(b)</dcterms:source>
    <skos:definition xml:lang="en">A description of the period of time within which, and the frequency with which, each high-risk AI system is intended to be used.</skos:definition>
    <skos:prefLabel xml:lang="en">Period and frequency of use</skos:prefLabel>
    <impacto-old:correspondsToDPIARequirement rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIA-IR-8"/>
    <impacto-old:hasExpectedProperty rdf:resource="https://tyttikatariina.github.io/IMPACTO/#hasUseFrequency"/>
    <impacto-old:hasExpectedProperty rdf:resource="https://tyttikatariina.github.io/IMPACTO/#hasUsePeriod"/>
    <impacto-old:hasReuseGap xml:lang="en">The DPIA states a storage duration for personal data. The FRIA requires the period and frequency of use of the system itself, which is a different quantity and normally has to be stated afresh.</impacto-old:hasReuseGap>
    <impacto-old:hasReuseLevel rdf:resource="https://tyttikatariina.github.io/IMPACTO/#PartiallyReusable"/>
    <impacto-old:isMandatory rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</impacto-old:isMandatory>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/ie#C12">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">IE C12: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/ie#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Ireland and which involves processing of genetic data</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#IE"/>
    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#Genetic"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/hu#DPIARequiredList">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredList"/>
    <rdfs:label xml:lang="en">DPIA required list (HU)</rdfs:label>
    <skos:definition xml:lang="en">List of processing operations for which a data protection impact assessment is mandatory, published by the national supervisory authority under GDPR Art.35(4).</skos:definition>
    <skos:prefLabel xml:lang="en">DPIA required list (HU)</skos:prefLabel>
    <impacto-old:appliesInJurisdiction rdf:resource="https://w3id.org/dpv/loc#HU"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#HU"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv#FundingAgency">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Funding Agency</rdfs:label>
    <dcterms:source xml:lang="en">CN27</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#LegalEntity"/>
    <skos:definition xml:lang="en">An entity that administers or pays public subsidies and processes personal data in doing so.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#dpv-Automated">
    <rdfs:label xml:lang="en">dpv  Automated</rdfs:label>
    <owl:sameAs rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#Automated"/>
    <skos:exactMatch rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#Automated"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/ImpactAssessmentOntology/#Systematicity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Systematicity</rdfs:label>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceBE"/>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceBG"/>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceCY"/>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceFR"/>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceGR"/>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceHU"/>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceIS"/>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceNL"/>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceNO"/>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourcePL"/>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceSI"/>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceSK"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#ProcessingContext"/>
    <skos:broader rdf:resource="https://w3id.org/dpv#ProcessingContext"/>
    <skos:definition xml:lang="en">An indication of whether data processing is systematic, i.e. if it is organised and constitutes repeated actions performed according to a plan or method, such as for monitoring, analysis or decision-making</skos:definition>
    <skos:notation>C29, C39, C45, C51, C50, C55, C82, C89</skos:notation>
    <skos:prefLabel xml:lang="en">Systematicity</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SignificantlyEffect">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Significantly Effect</rdfs:label>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceAT"/>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceCZ"/>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceGR"/>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceIE"/>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceIT"/>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceLU"/>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceNL"/>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourcePL"/>
    <rdfs:subClassOf rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SignificantEffect"/>
    <skos:broader rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SignificantEffect"/>
    <skos:definition xml:lang="en">Where an individual or organisation is majorly impacted</skos:definition>
    <skos:notation>C24</skos:notation>
    <skos:prefLabel xml:lang="en">Significantly Effect</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIAReviewComplete">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">DPIA Review Complete</rdfs:label>
    <dcterms:source xml:lang="en">GDPR Art. 35(11)</dcterms:source>
    <rdfs:seeAlso rdf:resource="https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX%3A32016R0679"/>
    <rdfs:subClassOf rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIAReviewStatus"/>
    <skos:broader rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIAReviewStatus"/>
    <skos:definition xml:lang="en">Status reflecting a review has been carried out by the controller, where necessary, to assess whether processing is performed in accordance with the DPIA, at least when there is a change in the risk represented by the processing operations.</skos:definition>
    <skos:prefLabel xml:lang="en">DPIA Review Complete</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Proposed for: DPV EU GDPR (eu-gdpr)</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/hr#C37f">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">HR C37f: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/hr#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Croatia and which involves The use of new technologies or technological solutions for the processing of personal data or with the possibility of processing personal data to analyse or predict the economic situation, health, personal preferences or interests, reliability or behaviour, location or movements of natural persons</skos:definition>
    <dpv:hasContext rdf:resource="https://w3id.org/dpv#InnovativeUseOfNewTechnologies"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#HR"/>
    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv/pd#Reliability"/>
    <dpv:hasProcessing rdf:resource="https://w3id.org/dpv#Analyse"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/pl#C17a">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">PL C17a: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/pl#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Poland and which involves processing resulting in access to or exclusion of services</skos:definition>
    <dpv:hasConsequence rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-LegalEffect"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#PL"/>
    <dpv:hasRisk rdf:resource="https://tyttikatariina.github.io/IMPACTO/#risk-ServiceAccessDenied"/>
