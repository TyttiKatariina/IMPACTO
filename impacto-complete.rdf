  <rdf:Description rdf:about="https://example.org/dpia-conditions#C61a">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
