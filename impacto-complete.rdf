    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/mt#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Malta and which involves (Large scale) processing of employee activities</skos:definition>
