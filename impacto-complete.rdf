    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Liechtenstein and which involves extensive processing of data subject to social, professional or special official secrecy, even if it is not data pursuant to Article 9(1) and (10 GDPR)</skos:definition>
    <dpv:hasData rdf:resource="https://w3id.org/dpv#ConfidentialData"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#LI"/>
    <dpv:hasProcessingScale rdf:resource="https://w3id.org/dpv#LargeScaleProcessing"/>
