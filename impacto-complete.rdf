    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv/pd#MedicalHealth"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/impacto/FRIA-1">
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/aiact#FRIA"/>
    <rdfs:label xml:lang="en">FRIA: automated shortlisting of job applicants</rdfs:label>
