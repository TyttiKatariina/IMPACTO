  <rdf:Description rdf:about="https://example.org/impacto/Overlap-1">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#OverlappingCondition"/>
    <rdfs:label xml:lang="en">Public authority recruitment screening: both assessments due</rdfs:label>
    <skos:definition xml:lang="en">A high-risk processing activity within the meaning of GDPR Art.35 is carried out through a high-risk AI system deployed by a body governed by public law, so both a DPIA and a FRIA are required.</skos:definition>
    <skos:prefLabel xml:lang="en">Public authority recruitment screening: both assessments due</skos:prefLabel>
    <impacto-old:concernsAISystem rdf:resource="https://example.org/impacto/TalentScreen"/>
    <impacto-old:concernsProcessingActivity rdf:resource="https://example.org/impacto/Proc-Shortlisting"/>
    <impacto-old:hasDPIATrigger rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#C7"/>
    <impacto-old:hasDPIATrigger rdf:resource="https://w3id.org/dpv/legal/ie#C14a"/>
    <impacto-old:hasFRIATrigger rdf:resource="https://tyttikatariina.github.io/IMPACTO/#F1"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#IE"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/ie#C46">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">IE C46: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/ie#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Ireland and which involves extensive processing of sensitive personal data for the purpose of developing algorithms</skos:definition>
    <dpv:hasContext rdf:resource="https://w3id.org/dpv#AlgorithmicLogic"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#IE"/>
    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv#SensitivePersonalData"/>
    <dpv:hasProcessingScale rdf:resource="https://w3id.org/dpv#LargeScaleProcessing"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/se#C15a">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">SE C15a: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/se#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Sweden and which involves matching or combining separate data sets and registers</skos:definition>
    <dpv:hasDataSource rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-DataRegister"/>
    <dpv:hasDataSource rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-DataSet"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#SE"/>
    <dpv:hasProcessing rdf:resource="https://w3id.org/dpv#Match"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/hu#C39a">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">HU C39a: Large scale systematic processing of personal data concerning health…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/hu#DPIARequiredList"/>
    <skos:definition xml:lang="en">Large scale systematic processing of personal data concerning health and public health for public interest purposes as is the introduction and use of electronic prescription systems and the introduction and use of electronic health records or electronic health cards.</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#HU"/>
    <dpv:hasLegalBasis rdf:resource="https://w3id.org/dpv#PublicInterest"/>
    <dpv:hasPersonalData rdf:resource="https://tyttikatariina.github.io/IMPACTO/#pd-ElectronicHealthRecord"/>
    <dpv:hasPersonalData rdf:resource="https://tyttikatariina.github.io/IMPACTO/#pd-PublicHealthData"/>
    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv/pd#HealthData"/>
    <dpv:hasProcessingScale rdf:resource="https://w3id.org/dpv#LargeScaleProcessing"/>
    <tech:hasSystem rdf:resource="https://tyttikatariina.github.io/IMPACTO/#sector-health-ElectronicPresecriptionSystem"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv#Billing">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
