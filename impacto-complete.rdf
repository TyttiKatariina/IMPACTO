    <rdfs:label xml:lang="en">PL C48a: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/pl#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Poland and which involves processing that involves an assessment or classification of natural persons</skos:definition>
    <dpv:hasContext rdf:resource="https://w3id.org/dpv#EvaluationOfIndividuals"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#PL"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/ro#DPIARequiredList">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredList"/>
    <rdfs:label xml:lang="en">DPIA required list (RO)</rdfs:label>
    <skos:definition xml:lang="en">List of processing operations for which a data protection impact assessment is mandatory, published by the national supervisory authority under GDPR Art.35(4).</skos:definition>
    <skos:prefLabel xml:lang="en">DPIA required list (RO)</skos:prefLabel>
    <impacto-old:appliesInJurisdiction rdf:resource="https://w3id.org/dpv/loc#RO"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#RO"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/be#C87p">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">BE C87p: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/be#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Austria and which involves where large-scale data is collected from third parties in order to analyse or predict the economic situation, health, personal preferences or interests, reliability or behaviour, location or displacement of natural persons</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#BE"/>
    <dpv:hasPersonalData rdf:resource="https://tyttikatariina.github.io/IMPACTO/#pd-LocationDisplacement"/>
    <dpv:hasProcessing rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-Predict"/>
    <dpv:hasProcessingScale rdf:resource="https://w3id.org/dpv#LargeScaleProcessing"/>
    <dpv:hasSource rdf:resource="https://w3id.org/dpv#ThirdPartyDataSource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/lt#C11">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">LT C11: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/lt#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Lithuania and which involves processing of Biometric data</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#LT"/>
    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#BiometricData"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/fi#C13a">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">FI C13a: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/fi#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Finland and which involves large-scale processing of communication and location data</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#FI"/>
    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv/pd#Communication"/>
    <dpv:hasProcessingScale rdf:resource="https://w3id.org/dpv#LargeScaleProcessing"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/dpia-conditions#C102">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">DPIA-CONDITIONS C102: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://example.org/dpia-conditions#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of EX and which involves large Scale Processing that might pose a risk of violation of secrecy of correspondence (particularly in communication services)</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#EX"/>
    <dpv:hasProcessingScale rdf:resource="https://w3id.org/dpv#LargeScaleProcessing"/>
    <dpv:hasRisk rdf:resource="https://w3id.org/dpv/risk#ViolatingCodeOfConduct"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/no#C50b">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">NO C50b: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/no#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Norway and which involves electronic monitoring at a school or preschool during the school/storage period. (Systematic and disadvantaged bodies)</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#NO"/>
    <dpv:hasLocation rdf:resource="https://tyttikatariina.github.io/IMPACTO/#loc-PreSchool"/>
    <dpv:hasPurpose rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-Monitoring"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/dpia-conditions#C35d">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">DPIA-CONDITIONS C35d: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://example.org/dpia-conditions#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of EX and which involves the processing of children’s personal data for profiling or automated decision-making purposes or for marketing purposes, or for direct offering of services intended for them </skos:definition>
    <dpv:hasHumanSubject rdf:resource="https://w3id.org/dpv#Child"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#EX"/>
    <dpv:hasPurpose rdf:resource="https://w3id.org/dpv#ServiceProvision"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dcterms:contributor>Harshvardhan J. Pandit</dcterms:contributor>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-02</dcterms:created>
    <dcterms:creator>Tytti Rintamäki</dcterms:creator>
    <dcterms:description xml:lang="en">IMPACTO models Data Protection Impact Assessments (GDPR Art.35)
    and Fundamental Rights Impact Assessments (AI Act Art.27), the conditions that make
    each of them mandatory, the information each must contain, and the points at which
    the two assessments overlap or feed into one another.</dcterms:description>
    <dcterms:source xml:lang="en">AI Act Art.6, Art.27, Annex III</dcterms:source>
    <dcterms:source xml:lang="en">EDPB/WP29 WP248rev.01</dcterms:source>
    <dcterms:source xml:lang="en">GDPR Art.35, Art.36, Recitals 84-95</dcterms:source>
    <dcterms:title xml:lang="en">IMPACTO: Impact Assessment Ontology</dcterms:title>
    <dcterms:title xml:lang="en">IMPACTO: an ontology for GDPR and AI Act impact assessments</dcterms:title>
    <vann:preferredNamespacePrefix>impacto</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://tyttikatariina.github.io/IMPACTO/#</vann:preferredNamespaceUri>
    <rdfs:seeAlso rdf:resource="https://tyttikatariina.github.io/IMPACTO/"/>
    <rdfs:seeAlso rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/"/>
    <owl:imports rdf:resource="https://w3id.org/dpv"/>
    <owl:imports rdf:resource="https://w3id.org/dpv/legal/eu/aiact"/>
    <owl:imports rdf:resource="https://w3id.org/dpv/legal/eu/gdpr"/>
    <skos:editorialNote xml:lang="en">IMPACTO is published under two namespaces. This one carries the ontology specification; the other carries the concept proposals derived from the national DPIA lists. Choosing one and redirecting the other would remove a standing source of broken references.</skos:editorialNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/dpia-conditions#C71d">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">DPIA-CONDITIONS C71d: Processing operations carried out pursuant to Article 14 of the…</rdfs:label>
    <dcterms:source rdf:resource="https://example.org/dpia-conditions#DPIARequiredList"/>
    <skos:definition xml:lang="en">Processing operations carried out pursuant to Article 14 of the General Data Protection Regulation. If the information that should be provided to the data subject is subject to an exception under Art.14 5(a-d)</skos:definition>
    <dpv:hasDataSource rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-NonDataSubjectDataSource"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#EX"/>
    <dpv:hasJustification rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#JustificationA14ConfidentialityCompromised"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#hasResidualRiskLevel">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">has residual risk level</rdfs:label>
    <skos:definition xml:lang="en">The level of risk remaining after treatment.</skos:definition>
    <skos:prefLabel xml:lang="en">has residual risk level</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv#RiskLevelNotHigh">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Risk Level Not High</rdfs:label>
    <dcterms:source xml:lang="en">CN1</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#RiskLevel"/>
    <skos:definition xml:lang="en">A risk level indicating that processing is not likely to result in a high risk to the rights and freedoms of natural persons.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/fr#C33">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">FR C33: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/fr#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of France and which involves large scale processing in the context of fraud prevention</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#FR"/>
    <dpv:hasProcessingScale rdf:resource="https://w3id.org/dpv#LargeScaleProcessing"/>
    <dpv:hasPurpose rdf:resource="https://w3id.org/dpv#FraudPreventionandDetection"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredList">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">DPIA Required List</rdfs:label>
    <dcterms:source xml:lang="en">GDPR Art.35(4)</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPAGuidance"/>
    <skos:broader rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPAGuidance"/>
    <skos:definition xml:lang="en">A national list of processing operations for which a DPIA is mandatory, published by a supervisory authority under GDPR Art.35(4). Commonly called a blacklist.</skos:definition>
    <skos:prefLabel xml:lang="en">DPIA Required List</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv#SwornBailiffs">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Sworn Bailiffs</rdfs:label>
    <dcterms:source xml:lang="en">CN53</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#Entity"/>
    <skos:definition xml:lang="en">An officer sworn to enforce judgments and carry out related legal acts, working individually in the exercise of their professional activities.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/dpia-conditions#C91a">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">DPIA-CONDITIONS C91a: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://example.org/dpia-conditions#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of EX and which involves large-scale Managing alerts and social and health reports or professional reports e.g. COVID-19</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#EX"/>
    <dpv:hasProcessingScale rdf:resource="https://w3id.org/dpv#LargeScaleProcessing"/>
    <dpv:hasPurpose rdf:resource="https://w3id.org/dpv#ManageHealthAlert"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/cy#C43b">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">CY C43b</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/cy#DPIARequiredList"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#CY"/>
    <dpv:hasLocation rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-PublicTransport"/>
    <dpv:hasPurpose rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-Monitoring"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv#OrganisationalTransactions">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Organisational Transactions</rdfs:label>
    <dcterms:source xml:lang="en">CN5</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#Data"/>
    <skos:definition xml:lang="en">Data recording the business transactions of an organisation, as distinct from transaction data relating to an individual.</skos:definition>
    <skos:scopeNote xml:lang="en">Proposed as part of a possible group of data categories relating to an organisation or business rather than to an individual.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/is#C37m">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">IS C37m: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/is#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Iceland and which involves The use of new technologies or technological solutions for the processing of personal data or with the possibility of processing personal data to analyse or predict the economic situation, health, personal preferences or interests, reliability or behaviour, location or movements of natural persons</skos:definition>
    <dpv:hasContext rdf:resource="https://w3id.org/dpv#InnovativeUseOfNewTechnologies"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#IS"/>
    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv/pd#Interest"/>
    <dpv:hasProcessing rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-Predict"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/dpia-conditions#C76">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">DPIA-CONDITIONS C76: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://example.org/dpia-conditions#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of EX and which involves processing of health data implemented by health institutions or social medical institutions for the care of persons</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#EX"/>
    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv/pd#MedicalHealth"/>
    <dpv:hasResponsibleEntity rdf:resource="https://w3id.org/dpv#HealthcareOrganisation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/be#C87m">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">BE C87m: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/be#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Austria and which involves where large-scale data is collected from third parties in order to analyse or predict the economic situation, health, personal preferences or interests, reliability or behaviour, location or displacement of natural persons</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#BE"/>
    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv/pd#Reliability"/>
    <dpv:hasProcessing rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-Predict"/>
    <dpv:hasProcessingScale rdf:resource="https://w3id.org/dpv#LargeScaleProcessing"/>
    <dpv:hasSource rdf:resource="https://w3id.org/dpv#ThirdPartyDataSource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#DPIA-IR-17">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIAInformationRequirement"/>
    <rdfs:label xml:lang="en">Data quality measures</rdfs:label>
    <dcterms:source xml:lang="en">GDPR Art.5(1)(d)</dcterms:source>
    <skos:definition xml:lang="en">The measures taken to ensure that personal data is accurate and kept up to date.</skos:definition>
    <skos:prefLabel xml:lang="en">Data quality measures</skos:prefLabel>
    <impacto-old:hasExpectedProperty rdf:resource="https://w3id.org/dpv#hasOrganisationalMeasure"/>
    <impacto-old:hasExpectedValueClass rdf:resource="https://w3id.org/dpv#DataQualityManagement"/>
    <impacto-old:isMandatory rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</impacto-old:isMandatory>
    <impacto-old:partOfRequirement rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIA-IR-A357d"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/hr#C23">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">HR C23: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/hr#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Croatia and which involves the purpose of data processing is the application of ‘smart meters’ set up by public utilities providers (the monitoring of consumption customs)</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#HR"/>
    <dpv:hasOrganisation rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-PublicUtilityProvider"/>
    <dpv:hasPurpose rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-Monitoring"/>
    <tech:hasInput rdf:resource="https://tyttikatariina.github.io/IMPACTO/#tech-SmartMeter"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/lv#C57b">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">LV C57b: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/lv#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Latvia and which involves the supervision of the data subject, which is carried out in the following cases: a. if it is carried out on a large scale; b. if it is carried out at the workplace; c. if it applies to specially protected data subjects (e.g. health care, social care, prison, prison, educational institution, workplace)</skos:definition>
    <dpv:hasContext rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-MonitoringIndividuals"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#LV"/>
    <dpv:hasLocation rdf:resource="https://tyttikatariina.github.io/IMPACTO/#loc-Workplace"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/cy#C34">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">CY C34: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/cy#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Cyprus and which involves large scale processing of financial data</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#CY"/>
    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv/pd#Financial"/>
    <dpv:hasProcessingScale rdf:resource="https://w3id.org/dpv#LargeScaleProcessing"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/ImpactAssessmentOntology/#HistoricalResearch">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Historical Research</rdfs:label>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceLT"/>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceLU"/>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceLV"/>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceNO"/>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourcePT"/>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceSK"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#ResearchAndDevelopment"/>
    <skos:broader rdf:resource="https://w3id.org/dpv#ResearchAndDevelopment"/>
    <skos:definition xml:lang="en">The processing of personal data for scientific or historical research purposes, conducted without the data subject's consent, and in conjunction with at least one of the legal criteria under the GDPR, such as being necessary for a task carried out in the public interest</skos:definition>
    <skos:notation>C30</skos:notation>
    <skos:prefLabel xml:lang="en">Historical Research</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/hu#C74">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">HU C74: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/hu#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Hungary and which involves the use of the personal data of pupils and students for assessment</skos:definition>
    <dpv:hasHumanSubject rdf:resource="https://w3id.org/dpv#Student"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#HU"/>
    <dpv:hasPurpose rdf:resource="https://w3id.org/dpv/sector/education#StudentPerformanceAssessment"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#DPIA-IR-22">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIAInformationRequirement"/>
    <rdfs:label xml:lang="en">Risk level</rdfs:label>
    <dcterms:source xml:lang="en">GDPR Art.35(7)(c)</dcterms:source>
    <skos:definition xml:lang="en">The resulting level of each risk, derived from likelihood and severity.</skos:definition>
    <skos:prefLabel xml:lang="en">Risk level</skos:prefLabel>
    <impacto-old:hasExpectedProperty rdf:resource="https://w3id.org/dpv#hasRiskLevel"/>
    <impacto-old:isMandatory rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</impacto-old:isMandatory>
    <impacto-old:partOfRequirement rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIA-IR-A357c"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/ImpactAssessmentOntology/#CentralisedLocation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Centralised Location</rdfs:label>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceDE"/>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceSI"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#LocationFixture"/>
    <skos:broader rdf:resource="https://w3id.org/dpv#LocationFixture"/>
    <skos:definition xml:lang="en">A physical or digital point where data is collected and aggregated from multiple sources, typically involving centralised sensors or mobile-based systems for large-scale monitoring or control</skos:definition>
    <skos:notation>C62</skos:notation>
    <skos:prefLabel xml:lang="en">Centralised Location</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/fr#C91a">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">FR C91a: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/fr#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of France and which involves large-scale Managing alerts and social and health reports or professional reports e.g. COVID-19</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#FR"/>
    <dpv:hasProcessingScale rdf:resource="https://w3id.org/dpv#LargeScaleProcessing"/>
    <dpv:hasPurpose rdf:resource="https://w3id.org/dpv#ManageHealthAlert"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#eu-aiact-NotHighRiskAISystem">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Not High Risk AI System</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-aiact-FRIANecessityDetermination"/>
    <skos:broader rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-aiact-FRIANecessityDetermination"/>
    <skos:closeMatch rdf:resource="https://w3id.org/dpv/legal/eu/aiact#RiskLevelNotHigh"/>
    <skos:definition xml:lang="en">A determination that the AI system is not a high-risk AI system, so that the FRIA obligation under Article 27 does not apply.</skos:definition>
    <skos:prefLabel xml:lang="en">Not High Risk AI System</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Proposed for: DPV EU AI Act extension (eu-aiact)</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/pl#C16">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">PL C16: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/pl#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Poland and which involves (Large scale) processing of employee activities</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#PL"/>
    <dpv:hasProcessingScale rdf:resource="https://w3id.org/dpv#LargeScaleProcessing"/>
    <dpv:hasTechnicalMeasure rdf:resource="https://w3id.org/dpv#ActivityMonitoring"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/hu#C37l">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">HU C37l: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/hu#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Hungary and which involves The use of new technologies or technological solutions for the processing of personal data or with the possibility of processing personal data to analyse or predict the economic situation, health, personal preferences or interests, reliability or behaviour, location or movements of natural persons</skos:definition>
    <dpv:hasContext rdf:resource="https://w3id.org/dpv#InnovativeUseOfNewTechnologies"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#HU"/>
    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv/pd#Preference"/>
    <dpv:hasProcessing rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-Predict"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/dpia-conditions#C107">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">DPIA-CONDITIONS C107: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://example.org/dpia-conditions#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of EX and which involves combining special category data of filing systems</skos:definition>
    <dpv:hasDataSource rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-FileSystem"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#EX"/>
    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv#SpecialCategoryPersonalData"/>
    <dpv:hasProcessing rdf:resource="https://w3id.org/dpv#Combine"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/hr#C13b">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">HR C13b: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/hr#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Croatia and which involves large-scale processing of communication and location data</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#HR"/>
    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv/pd#Location"/>
    <dpv:hasProcessingScale rdf:resource="https://w3id.org/dpv#LargeScaleProcessing"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/no#C12">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">NO C12: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/no#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Norway and which involves processing of genetic data</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#NO"/>
    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#Genetic"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/sector/health#Dentist">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Dentist</rdfs:label>
    <dcterms:source xml:lang="en">CN21</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#Organisation"/>
    <skos:definition xml:lang="en">A dentist practising individually who processes patient data for patient management and fee billing.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#legacyTermNote">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
    <rdfs:label xml:lang="en">legacy Term Note</rdfs:label>
    <dcterms:description xml:lang="en">The IMPACTO-specific terms with an impacto:dpv-, impacto:pd-, impacto:risk-, impacto:loc-, impacto:tech-, impacto:ai- or impacto:sector- prefix in the condition set are proposed extensions to the corresponding DPV modules. They are used as-is here; where DPV later adopts them, an exactMatch should be added to this file.</dcterms:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/it#C24c">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">IT C24c: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/it#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Italy and which involves combining and/or matching data sets from two or more processing operations carried out for different purposes and/or by different controllers in the context of data processing that goes beyond the processing normally expected by a data subject, (provided that the use of algorithms can make decisions that significantly affect the data subject.)</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#IT"/>
    <dpv:hasProcessing rdf:resource="https://w3id.org/dpv#Combine"/>
    <dpv:hasProcessing rdf:resource="https://w3id.org/dpv#Match"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/mt#C12">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">MT C12: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/mt#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Malta and which involves processing of genetic data</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#MT"/>
    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#Genetic"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/ImpactAssessmentOntology/#HealthcareLocation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Healthcare Location</rdfs:label>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceLV"/>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceNL"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#LocationLocality"/>
    <skos:broader rdf:resource="https://w3id.org/dpv#LocationLocality"/>
    <skos:definition xml:lang="en">A place where healthcare is provided to individuals</skos:definition>
    <skos:notation>C57</skos:notation>
    <skos:prefLabel xml:lang="en">Healthcare Location</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Context: continuous or large-scale observation of individuals in sensitive contexts involving protected or vulnerable populations</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/gr#C23">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">GR C23: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/gr#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Greece and which involves the purpose of data processing is the application of ‘smart meters’ set up by public utilities providers (the monitoring of consumption customs)</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#GR"/>
    <dpv:hasOrganisation rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-PublicUtilityProvider"/>
    <dpv:hasPurpose rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-Monitoring"/>
    <tech:hasInput rdf:resource="https://tyttikatariina.github.io/IMPACTO/#tech-SmartMeter"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/ImpactAssessmentOntology/#ContractSuspension">
