    <skos:editorialNote xml:lang="en">Used by DPIAConditions_complete.ttl. DPV defines no such term: the class is impacto:eu-gdpr-DPIARequiredProcess. Correcting the condition file at source would remove the need for this statement.</skos:editorialNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/is#C11">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
