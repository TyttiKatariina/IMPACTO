    <tech:hasIntendedUse rdf:resource="https://w3id.org/dpv/tech#Application"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv#Employer">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
