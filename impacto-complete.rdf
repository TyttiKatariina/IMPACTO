    <rdfs:label xml:lang="en">SI C17b: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/si#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Slovenia and which involves processing resulting in access to or exclusion of services</skos:definition>
