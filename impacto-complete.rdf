    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/lt#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Lithuania and which involves processing of personal data for scientific or historical purposes where it is carried out without the data subject consents and together with at least one of the Criteria</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#LT"/>
    <dpv:hasPurpose rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-HistoricResearch"/>
