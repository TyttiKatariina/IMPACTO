  <rdf:Description rdf:about="https://tyttikatariina.github.io/ImpactAssessmentOntology/#PublicSafetyAlertManagement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Public Safety Alert Management</rdfs:label>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceFR"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#PublicBenefit"/>
    <skos:broader rdf:resource="https://w3id.org/dpv#PublicBenefit"/>
    <skos:definition xml:lang="en">Management of health alerts, such as for a patient at risk or for pandemics, through which health professionals and authorities can alert individuals or the public regarding their health</skos:definition>
    <skos:notation>C91</skos:notation>
    <skos:prefLabel xml:lang="en">Public Safety Alert Management</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv#Documentation">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
