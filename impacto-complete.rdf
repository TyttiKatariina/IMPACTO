    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">matches condition</rdfs:label>
    <rdfs:range rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <skos:definition xml:lang="en">Records that a real processing activity or AI system exhibits all the characteristics of a given trigger condition.</skos:definition>
    <skos:prefLabel xml:lang="en">matches condition</skos:prefLabel>
  </rdf:Description>
