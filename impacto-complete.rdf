    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of France and which involves profiling resulting in exclusion/suspension/rupture from a contract</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#FR"/>
    <dpv:hasProcessing rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#Profiling"/>
