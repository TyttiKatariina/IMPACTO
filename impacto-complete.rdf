    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#Purpose"/>
    <skos:definition xml:lang="en">Processing carried out exclusively to document an event, activity or transaction, including the drafting of documents in the course of professional activity.</skos:definition>
  </rdf:Description>
