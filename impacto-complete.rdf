    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">DPIA-CONDITIONS C14a: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://example.org/dpia-conditions#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of EX and which involves Evaluation or scoring of individuals (including profiling or predicting)</skos:definition>
    <dpv:hasContext rdf:resource="https://w3id.org/dpv#EvaluationOfIndividuals"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#EX"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/dpia-conditions#C39a">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">DPIA-CONDITIONS C39a: Large scale systematic processing of personal data concerning health…</rdfs:label>
    <dcterms:source rdf:resource="https://example.org/dpia-conditions#DPIARequiredList"/>
    <skos:definition xml:lang="en">Large scale systematic processing of personal data concerning health and public health for public interest purposes as is the introduction and use of electronic prescription systems and the introduction and use of electronic health records or electronic health cards.</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#EX"/>
    <dpv:hasLegalBasis rdf:resource="https://w3id.org/dpv#PublicInterest"/>
    <dpv:hasPersonalData rdf:resource="https://tyttikatariina.github.io/IMPACTO/#pd-ElectronicHealthRecord"/>
    <dpv:hasPersonalData rdf:resource="https://tyttikatariina.github.io/IMPACTO/#pd-PublicHealthData"/>
    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv/pd#HealthData"/>
    <dpv:hasProcessingScale rdf:resource="https://w3id.org/dpv#LargeScaleProcessing"/>
    <tech:hasSystem rdf:resource="https://tyttikatariina.github.io/IMPACTO/#sector-health-ElectronicPresecriptionSystem"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/de#C37q">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">DE C37q: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/de#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Germany and which involves The use of new technologies or technological solutions for the processing of personal data or with the possibility of processing personal data to analyse or predict the economic situation, health, personal preferences or interests, reliability or behaviour, location or movements of natural persons</skos:definition>
    <dpv:hasContext rdf:resource="https://w3id.org/dpv#InnovativeUseOfNewTechnologies"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#DE"/>
    <dpv:hasPersonalData rdf:resource="https://tyttikatariina.github.io/IMPACTO/#pd-LocationRoute"/>
    <dpv:hasProcessing rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-Predict"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#FRIASource-A6">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#LegislativeSource"/>
    <rdfs:label xml:lang="en">AI Act Article 6</rdfs:label>
    <dcterms:identifier>Regulation (EU) 2024/1689, Article 6</dcterms:identifier>
    <skos:definition xml:lang="en">The provision establishing the classification rules for high-risk AI systems, referring to Annex I (Art.6(1)) and Annex III (Art.6(2)).</skos:definition>
    <skos:prefLabel xml:lang="en">AI Act Article 6</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#excludesAISystemType">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">excludes AI system type</rdfs:label>
    <rdfs:domain rdf:resource="https://tyttikatariina.github.io/IMPACTO/#FRIATriggerCondition"/>
    <rdfs:range rdf:resource="https://w3id.org/dpv/legal/eu/aiact#AISystem"/>
    <skos:definition xml:lang="en">An AI system classification which, if it applies, prevents this condition from being triggered. Used for the Annex III point 2 carve-out in Art.27(1).</skos:definition>
    <skos:prefLabel xml:lang="en">excludes AI system type</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceBE">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Belgium (BE)</rdfs:label>
    <skos:exactMatch rdf:resource="https://w3id.org/dpv/legal/be#DPIARequiredList"/>
    <skos:prefLabel xml:lang="en">Belgium (BE)</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#F2">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#FRIARequiredCondition"/>
    <rdfs:label xml:lang="en">Private entity providing public services deploying an Annex III system</rdfs:label>
    <dcterms:source xml:lang="en">AI Act Art.27(1)</dcterms:source>
    <skos:definition xml:lang="en">A FRIA is required because the deployer is a private entity providing public services and the system is high-risk under Article 6(2), other than a system in the area listed in Annex III point 2.</skos:definition>
    <skos:prefLabel xml:lang="en">Private entity providing public services deploying an Annex III system</skos:prefLabel>
    <impacto-old:excludesAISystemType rdf:resource="https://w3id.org/dpv/legal/eu/aiact#HighRiskAISystem-AnnexIII-2"/>
    <impacto-old:hasObligationSource rdf:resource="https://tyttikatariina.github.io/IMPACTO/#FRIASource-A27"/>
    <impacto-old:requiresAISystemType rdf:resource="https://w3id.org/dpv/legal/eu/aiact#HighRiskAISystem-A6-2"/>
    <impacto-old:requiresDeployerType rdf:resource="https://tyttikatariina.github.io/IMPACTO/#PrivateEntityProvidingPublicService"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#hasUsePeriod">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">has use period</rdfs:label>
    <dcterms:source xml:lang="en">AI Act Art.27(1)(b)</dcterms:source>
    <owl:equivalentProperty rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-aiact-PeriodOfUse"/>
    <skos:definition xml:lang="en">The period of time within which a high-risk AI system is intended to be used.</skos:definition>
    <skos:prefLabel xml:lang="en">has use period</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/no#C14b">
