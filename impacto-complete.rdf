    <impacto-old:reusesDPIA rdf:resource="https://example.org/impacto/DPIA-1"/>
    <impacto-old:usesAIOfficeTemplate rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</impacto-old:usesAIOfficeTemplate>
    <dpv:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FRIA: automated shortlisting of job applicants</dpv:hasName>
    <dpv:hasRisk rdf:resource="https://example.org/impacto/Risk-Bias"/>
