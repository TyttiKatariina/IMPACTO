    <dcterms:source>GDPR Art 35-3c</dcterms:source>
    <skos:definition xml:lang="en">A process which requires a DPIA according to GDPR Article 35-3c and which involves large scale ystematic monitoring of a publicly accessible area</skos:definition>
    <dpv:hasContext rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#SystematicMonitoring"/>
    <dpv:hasLocation rdf:resource="https://w3id.org/dpv#PubliclyAccessibleSpace"/>
    <dpv:hasProcessingScale rdf:resource="https://w3id.org/dpv#LargeScaleProcessing"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/sk#C14b">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
