  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#DPIA-IR-12">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIAInformationRequirement"/>
    <rdfs:label xml:lang="en">Automation and automated decision making</rdfs:label>
    <dcterms:source xml:lang="en">GDPR Art.22, Art.35(3)(a)</dcterms:source>
    <skos:definition xml:lang="en">The degree of automation in the processing, and whether decisions producing legal or similarly significant effects are taken solely by automated means.</skos:definition>
    <skos:prefLabel xml:lang="en">Automation and automated decision making</skos:prefLabel>
    <impacto-old:hasExpectedProperty rdf:resource="https://w3id.org/dpv#hasAutomationLevel"/>
