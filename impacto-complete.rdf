    <rdfs:label xml:lang="en">SI C49: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/si#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Slovenia and which involves the use of a video recording system for monitoring road behaviour on motorways. The controller intends to use a smart video analysis system to isolate vehicles and automatically recognise their plates</skos:definition>
    <dpv:hasData rdf:resource="https://w3id.org/dpv/tech#VideoContent"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#SI"/>
    <dpv:hasLocation rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-PublicRoad"/>
    <dpv:hasProcessing rdf:resource="https://w3id.org/dpv#Analyse"/>
    <dpv:hasPurpose rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-Monitoring"/>
    <ai:hasCapability rdf:resource="https://tyttikatariina.github.io/IMPACTO/#ai-ObjectIsolation"/>
    <tech:hasIntendedUse rdf:resource="https://tyttikatariina.github.io/IMPACTO/#ai-AutomaticObjectRecognition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/tech#StatisticalEvaluations">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Statistical Evaluations</rdfs:label>
    <dcterms:source xml:lang="en">CN7</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#Purpose"/>
    <skos:definition xml:lang="en">The evaluation of data by statistical means, for example the statistical evaluation of personnel data by service authorities and personnel departments.</skos:definition>
  </rdf:Description>
