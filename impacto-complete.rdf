  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv#Refugee">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Refugee</rdfs:label>
    <dcterms:source xml:lang="en">CN58</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#DataSubject"/>
    <skos:definition xml:lang="en">A natural person granted or seeking international protection whose rights are represented by the authority processing their data.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#DPIATriggerCondition">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">DPIA Trigger Condition</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <skos:broader rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <skos:definition xml:lang="en">A condition relevant to determining whether a DPIA is required.</skos:definition>
    <skos:prefLabel xml:lang="en">DPIA Trigger Condition</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv#PreventativeProtection">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Preventative Protection</rdfs:label>
    <dcterms:source xml:lang="en">CN18</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#Purpose"/>
    <skos:definition xml:lang="en">Processing carried out to protect persons or property in advance of harm occurring, for example following violations of law that have already occurred or where a special potential hazard exists.</skos:definition>
    <skos:scopeNote xml:lang="en">Relates to dpv:PreventativeProtectionOfPersons already proposed in IMPACTO but this could be added to relate to data or property without defining the target of the protection.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/sector/finance#RecordKeeping">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Record Keeping</rdfs:label>
    <dcterms:source xml:lang="en">CN25</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv/sector/finance#FinancialServiceManagement"/>
    <skos:definition xml:lang="en">The preparation of financial reports, operating accounts and financial statements, and the retention of the associated records.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv#FundingFees">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
