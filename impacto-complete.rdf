    <dpv:hasRisk rdf:resource="https://tyttikatariina.github.io/IMPACTO/#risk-ServiceExclusion"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/impacto/Risk-GroupDisadvantage">
    <rdf:type rdf:resource="https://w3id.org/dpv#Risk"/>
    <rdfs:label xml:lang="en">Risk  Group Disadvantage</rdfs:label>
    <dcterms:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cumulative exclusion of an applicant group across successive competitions</dcterms:description>
    <skos:note xml:lang="en">Identified only in the FRIA. The DPIA assessed risk to individual data subjects; this risk is to a group over time and is not reducible to a data protection risk.</skos:note>
    <impacto-old:hasAffectedRight rdf:resource="https://w3id.org/dpv/legal/eu/rights#A21-NonDiscrimination"/>
    <dpv:hasRiskLevel rdf:resource="https://w3id.org/dpv/risk#HighRisk"/>
    <risk:hasRiskTreatment rdf:resource="https://w3id.org/dpv/risk#MitigationControl"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#ai-UseOfAI">
