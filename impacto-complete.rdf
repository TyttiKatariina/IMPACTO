    <skos:broader rdf:resource="https://w3id.org/dpv/risk#FinancialLoss"/>
    <skos:definition xml:lang="en">Loss of property</skos:definition>
    <skos:notation>C101</skos:notation>
    <skos:prefLabel xml:lang="en">Property Loss</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/ro#C13b">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
