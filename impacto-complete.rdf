    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/fi#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Finland and which involves processing of personal data in whistleblower systems</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#FI"/>
    <dpv:hasPurpose rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-WhistleblowerManagement"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/at#C25f">
