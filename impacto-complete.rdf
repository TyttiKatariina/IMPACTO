    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">DPIA-CONDITIONS C58: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://example.org/dpia-conditions#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of EX and which involves large-scale tracking of data subjects</skos:definition>
    <dpv:hasDataSubject rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DataSubject"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#EX"/>
    <dpv:hasProcessing rdf:resource="https://w3id.org/dpv#Tracking"/>
    <dpv:hasProcessingScale rdf:resource="https://w3id.org/dpv#LargeScaleProcessing"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/ImpactAssessmentOntology/#NonSystematic">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Non-Systematic</rdfs:label>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceAll"/>
    <rdfs:subClassOf rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#Systematicity"/>
    <skos:broader rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#Systematicity"/>
    <skos:definition xml:lang="en">Indication that processing does not meet the definition of systematic</skos:definition>
    <skos:notation>C29, C39, C45, C51, C50, C55, C82, C89</skos:notation>
    <skos:prefLabel xml:lang="en">Non-Systematic</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIAReviewPending">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">DPIA Review Pending</rdfs:label>
    <dcterms:source xml:lang="en">GDPR Art. 35(11)</dcterms:source>
    <rdfs:seeAlso rdf:resource="https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX%3A32016R0679"/>
    <rdfs:subClassOf rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIAReviewStatus"/>
    <skos:broader rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIAReviewStatus"/>
    <skos:definition xml:lang="en">Status reflecting a review is still pending and waiting to been carried out by the controller, where necessary, to assess whether processing is performed in accordance with the DPIA, at least when there is a change in the risk represented by the processing operations.</skos:definition>
    <skos:prefLabel xml:lang="en">DPIA Review Pending</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Proposed for: DPV EU GDPR  (eu-gdpr)</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv#AccessLogins">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Access Logins</rdfs:label>
    <dcterms:source xml:lang="en">CN14</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#TechnicalMeasure"/>
    <skos:definition xml:lang="en">Records of system access events associated with the management of usernames and passwords.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv#CreditAgency">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Credit Agency</rdfs:label>
    <dcterms:source xml:lang="en">CN5</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#Entity"/>
    <skos:definition xml:lang="en">An entity that assesses or reports on the creditworthiness of third parties with whom it has no business relationship.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/it#C26">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">IT C26: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/it#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Italy and which involves processing of data related to minors </skos:definition>
    <dpv:hasHumanSubject rdf:resource="https://w3id.org/dpv#Child"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#IT"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/dk#C54">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">DK C54: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/dk#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Denmark and which involves the migration of data from existing to new technologies where this is related to large-scale data processing</skos:definition>
    <dpv:hasContext rdf:resource="https://w3id.org/dpv#InnovativeUseOfTechnology"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#DK"/>
    <dpv:hasProcessing rdf:resource="https://w3id.org/dpv#Transfer"/>
    <dpv:hasProcessingScale rdf:resource="https://w3id.org/dpv#LargeScaleProcessing"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/no#C61g">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">NO C61g: Processing personal data with the purpose of providing services or…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/no#DPIARequiredList"/>
    <skos:definition xml:lang="en">Processing personal data with the purpose of providing services or developing products for commercial use that involve predicting working capacity, economic status, health, personal preferences or interests, trustworthiness, behavior, location or route (Sensitive data or data of highly personal nature and evaluation/scoring).</skos:definition>
    <dpv:hasIntendedPurpose rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-CommercialUse"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#NO"/>
    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv/pd#Interest"/>
    <dpv:hasPurpose rdf:resource="https://w3id.org/dpv#ServiceProvision"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/gr#C82a">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">GR C82a: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/gr#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Greece and which involves large scale systematic processing of personal data with the purpose of introducing, organizing, providing and monitoring the use of electronic government services</skos:definition>
    <dpv:hasContext rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-Systematic"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#GR"/>
    <dpv:hasProcessingScale rdf:resource="https://w3id.org/dpv#LargeScaleProcessing"/>
    <dpv:hasPurpose rdf:resource="https://tyttikatariina.github.io/IMPACTO/#sector-publicservices-ProvidingEGovernmentServices"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/dpia-conditions#C93">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">DPIA-CONDITIONS C93: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://example.org/dpia-conditions#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of EX and which involves anonymisation of personal data</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#EX"/>
    <dpv:hasProcessing rdf:resource="https://w3id.org/dpv#Anonymise"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#hasNecessityStatus">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">has necessity status</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/dpv#hasStatus"/>
    <skos:definition xml:lang="en">States whether an assessment has been determined to be required, not required, or undetermined for a given processing activity or AI system.</skos:definition>
    <skos:prefLabel xml:lang="en">has necessity status</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#FRIANecessityUndetermined">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#FRIANecessityStatus"/>
    <rdfs:label xml:lang="en">FRIA Necessity Undetermined</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://tyttikatariina.github.io/IMPACTO/#FRIANecessityStatus"/>
    <skos:broader rdf:resource="https://tyttikatariina.github.io/IMPACTO/#FRIANecessityStatus"/>
    <skos:definition xml:lang="en">The necessity of a FRIA has not yet been determined, typically because the high-risk classification of the system or the category of the deployer is not yet known.</skos:definition>
    <skos:prefLabel xml:lang="en">FRIA Necessity Undetermined</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/fr#C43b">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">FR C43b</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/fr#DPIARequiredList"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#FR"/>
    <dpv:hasLocation rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-PublicTransport"/>
    <dpv:hasPurpose rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-Monitoring"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#dpv-NonDataSubjectDataSource">
    <rdfs:label xml:lang="en">dpv  Non Data Subject Data Source</rdfs:label>
    <owl:sameAs rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#NonDataSubjectDataSource"/>
    <skos:exactMatch rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#NonDataSubjectDataSource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/dpia-conditions#C47">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">DPIA-CONDITIONS C47: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://example.org/dpia-conditions#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of EX and which involves extensive processing of data subject to social, professional or special official secrecy, even if it is not data pursuant to Article 9(1) and (10 GDPR)</skos:definition>
    <dpv:hasData rdf:resource="https://w3id.org/dpv#ConfidentialData"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#EX"/>
    <dpv:hasProcessingScale rdf:resource="https://w3id.org/dpv#LargeScaleProcessing"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/no#C61l">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">NO C61l: Processing personal data with the purpose of providing services or…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/no#DPIARequiredList"/>
    <skos:definition xml:lang="en">Processing personal data with the purpose of providing services or developing products for commercial use that involve predicting working capacity, economic status, health, personal preferences or interests, trustworthiness, behavior, location or route (Sensitive data or data of highly personal nature and evaluation/scoring).</skos:definition>
    <dpv:hasIntendedPurpose rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-CommercialUse"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#NO"/>
    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv/pd#Location"/>
    <dpv:hasPurpose rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-ProductDevelopment"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/ImpactAssessmentOntology/#AtSchool">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">At School</rdfs:label>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceNO"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#LocationLocality"/>
    <skos:broader rdf:resource="https://w3id.org/dpv#LocationLocality"/>
    <skos:definition xml:lang="en">A place of education where monitoring and data processing may occur, particularly affecting minors and their educational data</skos:definition>
    <skos:notation>C50, C70</skos:notation>
    <skos:prefLabel xml:lang="en">At School</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/eu/gdpr#C4c">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">GDPR C4c: A process which requires a DPIA according to GDPR Article 35-3b and…</rdfs:label>
    <dcterms:source>GDPR Art 35-3b</dcterms:source>
    <skos:definition xml:lang="en">A process which requires a DPIA according to GDPR Article 35-3b and which involves profiling and/or processing of vulnerable persons data</skos:definition>
    <dpv:hasHumanSubject rdf:resource="https://w3id.org/dpv#VulnerableHuman"/>
    <dpv:hasProcessing rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#Profiling"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/lv#C15a">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">LV C15a: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/lv#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Latvia and which involves matching or combining separate data sets and registers</skos:definition>
    <dpv:hasDataSource rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-DataRegister"/>
    <dpv:hasDataSource rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-DataSet"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#LV"/>
    <dpv:hasProcessing rdf:resource="https://w3id.org/dpv#Match"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/impacto/CreditScorer">
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/aiact#HighRiskAISystem"/>
    <rdfs:label xml:lang="en">Consumer credit scoring model</rdfs:label>
    <skos:broader rdf:resource="https://w3id.org/dpv/legal/eu/aiact#HighRiskAISystem-A6-2"/>
    <skos:broader rdf:resource="https://w3id.org/dpv/legal/eu/aiact#HighRiskAISystem-AnnexIII-5-b"/>
    <impacto-old:embedsProcessingActivity rdf:resource="https://example.org/impacto/Proc-CreditScoring"/>
    <impacto-old:hasDeployer rdf:resource="https://example.org/impacto/Bank"/>
    <impacto-old:hasNecessityJustification rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Annex III point 5(b) applies. Art.27(1) attaches the FRIA obligation to every deployer of such a system, so the private status of the deployer is immaterial.</impacto-old:hasNecessityJustification>
    <impacto-old:hasNecessityStatus rdf:resource="https://tyttikatariina.github.io/IMPACTO/#FRIARequired"/>
    <impacto-old:matchesCondition rdf:resource="https://tyttikatariina.github.io/IMPACTO/#F3"/>
    <dpv:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Consumer credit scoring model</dpv:hasName>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/gr#C39b">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">GR C39b: Large scale systematic processing of personal data concerning health…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/gr#DPIARequiredList"/>
    <skos:definition xml:lang="en">Large scale systematic processing of personal data concerning health and public health for public interest purposes as is the introduction and use of electronic prescription systems and the introduction and use of electronic health records or electronic health cards.</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#GR"/>
    <dpv:hasLegalBasis rdf:resource="https://w3id.org/dpv#PublicInterest"/>
    <dpv:hasPersonalData rdf:resource="https://tyttikatariina.github.io/IMPACTO/#pd-ElectronicHealthCard"/>
    <dpv:hasPersonalData rdf:resource="https://tyttikatariina.github.io/IMPACTO/#pd-PublicHealthData"/>
    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv/pd#HealthData"/>
    <dpv:hasProcessingScale rdf:resource="https://w3id.org/dpv#LargeScaleProcessing"/>
    <tech:hasSystem rdf:resource="https://tyttikatariina.github.io/IMPACTO/#sector-health-ElectronicPresecriptionSystem"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#sector-health-MedicalSupportServiceProvision">
    <rdfs:label xml:lang="en">sector health  Medical Support Service Provision</rdfs:label>
    <owl:sameAs rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#MedicalSupportService"/>
    <skos:exactMatch rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#MedicalSupportService"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#hasStage">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">has stage</rdfs:label>
    <rdfs:domain rdf:resource="https://tyttikatariina.github.io/IMPACTO/#ImpactAssessmentProcess"/>
    <rdfs:range rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentStage"/>
    <skos:definition xml:lang="en">Associates an assessment process with one of its stages.</skos:definition>
    <skos:prefLabel xml:lang="en">has stage</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/pt#C30a">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">PT C30a: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/pt#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Portugal and which involves processing of personal data for scientific or historical purposes where it is carried out without the data subject consents and together with at least one of the Criteria</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#PT"/>
    <dpv:hasPurpose rdf:resource="https://w3id.org/dpv#ScientificResearch"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/be#C52b">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">BE C52b: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/be#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Austria and which involves where personal data are collected from third parties in order to be subsequently taken into account in the decision to refuse or terminate a specific service contract with a natural person</skos:definition>
    <dpv:hasContext rdf:resource="https://w3id.org/dpv#TerminateContract"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#BE"/>
    <dpv:hasSource rdf:resource="https://w3id.org/dpv#ThirdPartyDataSource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/dk#C85">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">DK C85: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/dk#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Denmark and which involves processing of personal data using neurotechnology</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#DK"/>
    <dpv:isImplementedUsingTechnology rdf:resource="https://tyttikatariina.github.io/IMPACTO/#tech-Neurotechnology"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIAReviewStatus">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">DPIA Review Status</rdfs:label>
    <dcterms:source xml:lang="en">GDPR Art. 35(11)</dcterms:source>
    <rdfs:seeAlso rdf:resource="https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX%3A32016R0679"/>
