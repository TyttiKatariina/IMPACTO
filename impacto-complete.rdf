    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#HealthData"/>
    <dpv:hasProcessingScale rdf:resource="https://w3id.org/dpv#LargeScaleProcessing"/>
  </rdf:Description>
