    <owl:sameAs rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#Neurotechnology"/>
    <skos:exactMatch rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#Neurotechnology"/>
