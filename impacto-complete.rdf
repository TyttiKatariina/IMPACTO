  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#hasNecessityAssessment">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">has necessity assessment</rdfs:label>
    <dcterms:source xml:lang="en">GDPR Art.35(7)(b)</dcterms:source>
    <skos:definition xml:lang="en">The assessment of whether the processing is necessary in relation to its purposes.</skos:definition>
    <skos:prefLabel xml:lang="en">has necessity assessment</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/sector/law#LegalDuties">
