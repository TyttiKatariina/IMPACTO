    <rdfs:label xml:lang="en">NO C14b: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/no#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Norway and which involves Evaluation or scoring of individuals (including profiling or predicting)</skos:definition>
    <dpv:hasContext rdf:resource="https://w3id.org/dpv#ScoringOfIndividuals"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#NO"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/pd#PetitionLists">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
