    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceRO"/>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceSI"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv/tech#Device"/>
    <skos:broader rdf:resource="https://w3id.org/dpv/tech#Device"/>
    <skos:definition xml:lang="en">Devices that are generating signals or data and transmitting this over the internet</skos:definition>
    <skos:notation>C18</skos:notation>
    <skos:prefLabel xml:lang="en">IOT Device</skos:prefLabel>
  </rdf:Description>
