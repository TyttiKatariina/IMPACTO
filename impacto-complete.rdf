    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">DPIA-CONDITIONS C19: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://example.org/dpia-conditions#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of EX and which involves processing related to preventing a data subject from exercising a right</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#EX"/>
    <dpv:hasRisk rdf:resource="https://tyttikatariina.github.io/IMPACTO/#risk-RightsExercisePrevented"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#hasAffectedGroup">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">has affected group</rdfs:label>
    <dcterms:source xml:lang="en">AI Act Art.27(1)(c)</dcterms:source>
    <owl:equivalentProperty rdf:resource="https://tyttikatariina.github.io/IMPACTO/#ai-NaturalPersonCategorySubjects"/>
    <skos:definition xml:lang="en">A category of natural persons or a group likely to be affected by the use of the AI system. Wider than dpv:hasDataSubject, since affected persons need not be data subjects of the processing.</skos:definition>
    <skos:prefLabel xml:lang="en">has affected group</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#RiskAssessmentStage">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Risk Assessment Stage</rdfs:label>
    <dcterms:source xml:lang="en">AI Act Art.27(1)(c),(d)</dcterms:source>
    <dcterms:source xml:lang="en">GDPR Art.35(7)(c)</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentStage"/>
    <skos:broader rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentStage"/>
    <skos:definition xml:lang="en">The stage identifying and evaluating risks: risks to the rights and freedoms of data subjects in a DPIA, risks of harm to affected persons and groups in a FRIA.</skos:definition>
    <skos:prefLabel xml:lang="en">Risk Assessment Stage</skos:prefLabel>
    <impacto-old:hasStage_Requirement rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIA-IR-A357c"/>
    <impacto-old:hasStage_Requirement rdf:resource="https://tyttikatariina.github.io/IMPACTO/#FRIA-IR-c"/>
    <impacto-old:hasStage_Requirement rdf:resource="https://tyttikatariina.github.io/IMPACTO/#FRIA-IR-d"/>
  </rdf:Description>
