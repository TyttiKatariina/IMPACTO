    <dcterms:source rdf:resource="https://example.org/dpia-conditions#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of EX and which involves processing of location data is used systematic monitoring of data subjects</skos:definition>
    <dpv:hasContext rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#SystematicMonitoring"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#EX"/>
    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv/pd#Location"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/it#C21">
