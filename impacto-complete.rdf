    <rdfs:subPropertyOf rdf:resource="https://w3id.org/dpv#hasJurisdiction"/>
    <skos:definition xml:lang="en">The jurisdiction in which a condition or guidance source has effect. Conditions derived from the GDPR itself apply across the EEA; conditions derived from a national list apply only in that Member State.</skos:definition>
