    <dcterms:source rdf:resource="https://example.org/dpia-conditions#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of EX and which involves electronic monitoring at a school or preschool during the school/storage period. (Systematic and disadvantaged bodies)</skos:definition>
