    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">HU C81a: When the data controller is planning to set up an application, tool,…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/hu#DPIARequiredList"/>
    <skos:definition xml:lang="en">When the data controller is planning to set up an application, tool, or platform for use by an entire sector to process also special categories of personal data.</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#HU"/>
    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv#SpecialCategoryPersonalData"/>
    <eu-aiact:IntendedPurpose rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-EntireSector"/>
    <tech:hasIntendedUse rdf:resource="https://w3id.org/dpv/tech#Application"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/eu/gdpr#C1">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">GDPR C1: A process which requires a DPIA according to GDPR Article 35-3b and…</rdfs:label>
    <dcterms:source>GDPR Art 35-3b</dcterms:source>
    <skos:definition xml:lang="en">A process which requires a DPIA according to GDPR Article 35-3b and which involves large scale processing of special category personal data</skos:definition>
    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv#SpecialCategoryPersonalData"/>
    <dpv:hasProcessingScale rdf:resource="https://w3id.org/dpv#LargeScaleProcessing"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/dk#C36">
