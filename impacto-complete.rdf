    <rdfs:label xml:lang="en">DK C36: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/dk#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Denmark and which involves the use of facial recognition technology as part of the monitoring of a public accessible area</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#DK"/>
    <dpv:hasLocation rdf:resource="https://w3id.org/dpv#PubliclyAccessibelSpace"/>
