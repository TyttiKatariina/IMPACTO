    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">DPIA-CONDITIONS C61h: Processing personal data with the purpose of providing services or…</rdfs:label>
    <dcterms:source rdf:resource="https://example.org/dpia-conditions#DPIARequiredList"/>
    <skos:definition xml:lang="en">Processing personal data with the purpose of providing services or developing products for commercial use that involve predicting working capacity, economic status, health, personal preferences or interests, trustworthiness, behavior, location or route (Sensitive data or data of highly personal nature and evaluation/scoring).</skos:definition>
    <dpv:hasIntendedPurpose rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-CommercialUse"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#EX"/>
    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv/pd#Interest"/>
    <dpv:hasPurpose rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-ProductDevelopment"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#sector-publicservices-IntroducingEGovernmentServices">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Introducing E Government Services</rdfs:label>
    <skos:editorialNote xml:lang="en">Used by the DPIA condition set but not yet defined in IMPACTO-concepts.ttl. Proposed for the sector-publicservices namespace.</skos:editorialNote>
    <skos:prefLabel xml:lang="en">Introducing E Government Services</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv#Deputies">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Deputies</rdfs:label>
    <dcterms:source xml:lang="en">CN7</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#Entity"/>
    <skos:definition xml:lang="en">A person holding a deputy office or mandate who is paid by a body responsible for the public sector.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/cy#C14b">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">CY C14b: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/cy#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Cyprus and which involves Evaluation or scoring of individuals (including profiling or predicting)</skos:definition>
    <dpv:hasContext rdf:resource="https://w3id.org/dpv#ScoringOfIndividuals"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#CY"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv#Resident">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Resident</rdfs:label>
    <dcterms:source xml:lang="en">CN58</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#DataSubject"/>
    <skos:definition xml:lang="en">A natural person residing within the territory of an authority, irrespective of citizenship.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/dpia-conditions#C14c">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">DPIA-CONDITIONS C14c: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://example.org/dpia-conditions#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of EX and which involves Evaluation or scoring of individuals (including profiling or predicting)</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#EX"/>
    <dpv:hasProcessing rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#Profiling"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/dpia-conditions#C37i">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">DPIA-CONDITIONS C37i: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://example.org/dpia-conditions#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of EX and which involves The use of new technologies or technological solutions for the processing of personal data or with the possibility of processing personal data to analyse or predict the economic situation, health, personal preferences or interests, reliability or behaviour, location or movements of natural persons</skos:definition>
    <dpv:hasContext rdf:resource="https://w3id.org/dpv#InnovativeUseOfNewTechnologies"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#EX"/>
    <dpv:hasPersonalData rdf:resource="https://tyttikatariina.github.io/IMPACTO/#pd-LocationRoute"/>
    <dpv:hasProcessing rdf:resource="https://w3id.org/dpv#Analyse"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/ImpactAssessmentOntology/#TrustService">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Trust Service</rdfs:label>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceEE"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv/tech#Service"/>
    <skos:broader rdf:resource="https://w3id.org/dpv/tech#Service"/>
    <skos:definition xml:lang="en">Services that involve the processing of personal data to authenticate identity, verify electronic transactions, or provide secure communication and document exchange, where the nature of processing may pose a risk of identity theft or fraud</skos:definition>
    <skos:notation>C103</skos:notation>
    <skos:prefLabel xml:lang="en">Trust Service</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#tech-LifeLoggingApplication">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Life Logging Application</rdfs:label>
    <skos:editorialNote xml:lang="en">Used by the DPIA condition set but not yet defined in IMPACTO-concepts.ttl. Proposed for the tech namespace.</skos:editorialNote>
    <skos:prefLabel xml:lang="en">Life Logging Application</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv#Lawyer">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Lawyer</rdfs:label>
    <dcterms:source xml:lang="en">CN22</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#LegalAgent"/>
    <skos:definition xml:lang="en">A legal professional providing legal services to clients within the framework of their professional practice.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#DPIAInputInFRIA">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">DPIA Input in FRIA</rdfs:label>
    <dcterms:source xml:lang="en">AI Act Art.27(4)</dcterms:source>
    <owl:equivalentClass rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-aiact-ExistingDPIAInput"/>
    <skos:definition xml:lang="en">A record that content produced for a DPIA is being relied upon within a FRIA. Under AI Act Art.27(4), where an obligation of Art.27 is already met through the DPIA conducted under GDPR Art.35, the FRIA complements that DPIA.</skos:definition>
    <skos:prefLabel xml:lang="en">DPIA Input in FRIA</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#FRIANotRequired">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#FRIANecessityStatus"/>
    <rdfs:label xml:lang="en">FRIA Not Required</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://tyttikatariina.github.io/IMPACTO/#FRIANecessityStatus"/>
    <owl:equivalentClass rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-aiact-FRIANotRequired"/>
    <skos:broader rdf:resource="https://tyttikatariina.github.io/IMPACTO/#FRIANecessityStatus"/>
    <skos:definition xml:lang="en">Condition where a FRIA is not required, because the AI system is not within Art.6(2), falls under the Annex III point 2 carve-out, or the deployer does not meet the Art.27(1) criteria.</skos:definition>
    <skos:prefLabel xml:lang="en">FRIA Not Required</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/sector/law#RoadVehicleDriverSobrietyVerification">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Road Vehicle Driver Sobriety Verification</rdfs:label>
    <dcterms:source xml:lang="en">CN57</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv/sector/infra#RoadSafetyMonitoring"/>
    <skos:definition xml:lang="en">The verification of a driver's state of sobriety within the framework of transport activities arising from legal requirements.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceBG">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Bulgaria (BG)</rdfs:label>
    <skos:exactMatch rdf:resource="https://w3id.org/dpv/legal/bg#DPIARequiredList"/>
    <skos:prefLabel xml:lang="en">Bulgaria (BG)</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/es#C17b">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">ES C17b: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/es#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Spain and which involves processing resulting in access to or exclusion of services</skos:definition>
    <dpv:hasConsequence rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-LegalEffect"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#ES"/>
    <dpv:hasRisk rdf:resource="https://tyttikatariina.github.io/IMPACTO/#risk-ServiceExclusion"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv#NotEmploymentRelationship">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Not Employment Relationship</rdfs:label>
    <dcterms:source xml:lang="en">CN37</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#Entity"/>
    <skos:definition xml:lang="en">An indication that the entity carrying out the processing does not stand in an employment relationship, for example a self-employed practitioner.</skos:definition>
    <skos:scopeNote xml:lang="en">Intended as a value for dpv:hasRelationWithDataSubject; the parent recorded in the analysis (dpv:Entity) may require revision.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/impacto/Group-UnderrepresentedApplicants">
    <rdf:type rdf:resource="https://w3id.org/dpv#DataSubject"/>
    <rdfs:label xml:lang="en">Applicants from groups historically underrepresented in the workforce</rdfs:label>
    <skos:note xml:lang="en">Identified as an affected group for the FRIA under Art.27(1)(c). Not separately identified in the DPIA, which described data subjects as job applicants.</skos:note>
    <skos:prefLabel xml:lang="en">Applicants from groups historically underrepresented in the workforce</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourcePT">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Portugal (PT)</rdfs:label>
    <skos:exactMatch rdf:resource="https://w3id.org/dpv/legal/pt#DPIARequiredList"/>
    <skos:prefLabel xml:lang="en">Portugal (PT)</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/lu#C14d">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">LU C14d: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/lu#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Luxembourg and which involves Evaluation or scoring of individuals (including profiling or predicting)</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#LU"/>
    <dpv:hasProcessing rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-Predict"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/gr#C40">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">GR C40: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/gr#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Greece and which involves large scale data collection from third parties</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#GR"/>
    <dpv:hasProcessingScale rdf:resource="https://w3id.org/dpv#LargeScaleProcessing"/>
    <dpv:hasSource rdf:resource="https://w3id.org/dpv#ThirdPartyDataSource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/eu/gdpr#C3">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">GDPR C3: A process which requires a DPIA according to Recital 91 and which…</rdfs:label>
    <dcterms:source>Recital 91</dcterms:source>
    <skos:definition xml:lang="en">A process which requires a DPIA according to Recital 91 and which involves large scale processing for all purposes</skos:definition>
    <dpv:hasProcessingScale rdf:resource="https://w3id.org/dpv#LargeScaleProcessing"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/pl#C45b">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">PL C45b: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/pl#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Poland and which involves Processing of personal data for the purpose of systematic assessment of skills, competences, outcomes of tests, mental health or development. (Sensitive personal data or other information reveals a sensitive nature and systematic monitoring)</skos:definition>
    <dpv:hasContext rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-Systematic"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#PL"/>
    <dpv:hasPersonalData rdf:resource="https://tyttikatariina.github.io/IMPACTO/#pd-Competency"/>
    <dpv:hasProcessing rdf:resource="https://w3id.org/dpv#Assess"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/de#C93">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">DE C93: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/de#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Germany and which involves anonymisation of personal data</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#DE"/>
    <dpv:hasProcessing rdf:resource="https://w3id.org/dpv#Anonymise"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/is#C20c">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">IS C20c: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/is#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Iceland and which involves profiling resulting in exclusion/suspension/rupture from a contract</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#IS"/>
    <dpv:hasProcessing rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#Profiling"/>
    <dpv:hasRisk rdf:resource="https://tyttikatariina.github.io/IMPACTO/#risk-ContractTerminated"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv#TravelOrganisation">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Travel Organisation</rdfs:label>
    <dcterms:source xml:lang="en">CN31</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#EventManagement"/>
    <skos:definition xml:lang="en">The organisation of trips undertaken in connection with an event.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/de#C37b">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">DE C37b: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/de#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Germany and which involves The use of new technologies or technological solutions for the processing of personal data or with the possibility of processing personal data to analyse or predict the economic situation, health, personal preferences or interests, reliability or behaviour, location or movements of natural persons</skos:definition>
    <dpv:hasContext rdf:resource="https://w3id.org/dpv#InnovativeUseOfNewTechnologies"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#DE"/>
    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv/pd#FinancialStatus"/>
    <dpv:hasProcessing rdf:resource="https://w3id.org/dpv#Analyse"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#dpv-DigitalTrustServiceProvision">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Digital Trust Service Provision</rdfs:label>
    <skos:editorialNote xml:lang="en">Used by the DPIA condition set but not yet defined in IMPACTO-concepts.ttl. Proposed for the dpv namespace.</skos:editorialNote>
    <skos:prefLabel xml:lang="en">Digital Trust Service Provision</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/eu/gdpr#C7">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">GDPR C7: A process which requires a DPIA according to GDPR Article 35-3a and…</rdfs:label>
    <dcterms:source>GDPR Art 35-3a</dcterms:source>
    <skos:definition xml:lang="en">A process which requires a DPIA according to GDPR Article 35-3a and which involves large scale profiling</skos:definition>
    <dpv:hasProcessing rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#Profiling"/>
    <dpv:hasProcessingScale rdf:resource="https://w3id.org/dpv#LargeScaleProcessing"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceFI">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Finland (FI)</rdfs:label>
    <skos:exactMatch rdf:resource="https://w3id.org/dpv/legal/fi#DPIARequiredList"/>
    <skos:prefLabel xml:lang="en">Finland (FI)</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/dpia-conditions#C30b">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">DPIA-CONDITIONS C30b: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://example.org/dpia-conditions#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of EX and which involves processing of personal data for scientific or historical purposes where it is carried out without the data subject consents and together with at least one of the Criteria</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#EX"/>
    <dpv:hasPurpose rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-HistoricResearch"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#InformationRequirement">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Information Requirement</rdfs:label>
    <skos:definition xml:lang="en">An item of information that an impact assessment must contain in order to be legally complete.</skos:definition>
    <skos:prefLabel xml:lang="en">Information Requirement</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv#Archive">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Archive</rdfs:label>
    <dcterms:source xml:lang="en">CN23</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#Purpose"/>
    <skos:definition xml:lang="en">Processing of personal data for archival purposes in the public interest.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#dpv-ContractualObligation">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Contractual Obligation</rdfs:label>
    <skos:editorialNote xml:lang="en">Used by the DPIA condition set but not yet defined in IMPACTO-concepts.ttl. Proposed for the dpv namespace.</skos:editorialNote>
    <skos:prefLabel xml:lang="en">Contractual Obligation</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#eu-aiact-ConsultationWithProvider">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Consultation with Provider</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#Consultation"/>
    <skos:broader rdf:resource="https://w3id.org/dpv#Consultation"/>
    <skos:definition xml:lang="en">Consultation with the provider of the AI system, for example regarding the information provided under Article 13 or existing impact assessments.</skos:definition>
    <skos:prefLabel xml:lang="en">Consultation with Provider</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Proposed for: DPV EU AI Act extension (eu-aiact)</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/at#C25b">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">AT C25b</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/at#DPIARequiredList"/>
    <dpv:hasData rdf:resource="https://w3id.org/dpv/tech#VideoContent"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#AT"/>
    <dpv:hasPurpose rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-Monitoring"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/fi#C61n">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">FI C61n: Processing personal data with the purpose of providing services or…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/fi#DPIARequiredList"/>
    <skos:definition xml:lang="en">Processing personal data with the purpose of providing services or developing products for commercial use that involve predicting working capacity, economic status, health, personal preferences or interests, trustworthiness, behavior, location or route (Sensitive data or data of highly personal nature and evaluation/scoring).</skos:definition>
    <dpv:hasIntendedPurpose rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-CommercialUse"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#FI"/>
    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv/pd#Behavioural"/>
    <dpv:hasPurpose rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-ProductDevelopment"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#dpv-ControlHumanActivity">
    <rdfs:label xml:lang="en">dpv  Control Human Activity</rdfs:label>
    <skos:closeMatch rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#InfluenceHumanActivity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#risk-InsufficientProtection">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Insufficient Protection</rdfs:label>
    <skos:editorialNote xml:lang="en">Used by the DPIA condition set but not yet defined in IMPACTO-concepts.ttl. Proposed for the risk namespace.</skos:editorialNote>
    <skos:prefLabel xml:lang="en">Insufficient Protection</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#dpv-EntireSector">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Entire Sector</rdfs:label>
    <skos:editorialNote xml:lang="en">Used by the DPIA condition set but not yet defined in IMPACTO-concepts.ttl. Proposed for the dpv namespace.</skos:editorialNote>
    <skos:prefLabel xml:lang="en">Entire Sector</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#eu-aiact-FRIANotRequired">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">FRIA Not Required</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-aiact-FRIANecessityStatus"/>
    <skos:broader rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-aiact-FRIANecessityStatus"/>
    <skos:definition xml:lang="en">A FRIA necessity status indicating that the organisation is not required to conduct a FRIA.</skos:definition>
    <skos:prefLabel xml:lang="en">FRIA Not Required</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Proposed for: DPV EU AI Act extension (eu-aiact)</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/ee#C13a">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">EE C13a: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/ee#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Estonia and which involves large-scale processing of communication and location data</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#EE"/>
    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv/pd#Communication"/>
    <dpv:hasProcessingScale rdf:resource="https://w3id.org/dpv#LargeScaleProcessing"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/ee#C103b">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">EE C103b: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/ee#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Estonia and which involves large Scale Processing that might pose a risk of identity theft or fraud (particularly in digital trust services and in comparable identity management services)</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#EE"/>
    <dpv:hasProcessingScale rdf:resource="https://w3id.org/dpv#LargeScaleProcessing"/>
    <dpv:hasRisk rdf:resource="https://w3id.org/dpv/risk#Fraud"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/eu/gdpr#C4b">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">GDPR C4b: A process which requires a DPIA according to GDPR Article 35-3b and…</rdfs:label>
    <dcterms:source>GDPR Art 35-3b</dcterms:source>
    <skos:definition xml:lang="en">A process which requires a DPIA according to GDPR Article 35-3b and which involves profiling and/or processing of vulnerable persons data</skos:definition>
    <dpv:hasHumanSubject rdf:resource="https://w3id.org/dpv#VulnerableHuman"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv#hasProcessor">
    <owl:equivalentProperty rdf:resource="https://w3id.org/dpv#hasDataProcessor"/>
    <skos:editorialNote xml:lang="en">Legacy name. Current DPV uses dpv:hasDataProcessor.</skos:editorialNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/ie#C15b">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">IE C15b: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/ie#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Ireland and which involves matching or combining separate data sets and registers</skos:definition>
    <dpv:hasDataSource rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-DataRegister"/>
    <dpv:hasDataSource rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-DataSet"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#IE"/>
    <dpv:hasProcessing rdf:resource="https://w3id.org/dpv#Combine"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/lu#C24b">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">LU C24b: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/lu#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Luxembourg and which involves combining and/or matching data sets from two or more processing operations carried out for different purposes and/or by different controllers in the context of data processing that goes beyond the processing normally expected by a data subject, (provided that the use of algorithms can make decisions that significantly affect the data subject.)</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#LU"/>
    <dpv:hasProcessing rdf:resource="https://w3id.org/dpv#Combine"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/dpia-conditions#C78b">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">DPIA-CONDITIONS C78b: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://example.org/dpia-conditions#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of EX and which involves treatments for the purpose of social or medico-social support for persons</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#EX"/>
    <dpv:hasPurpose rdf:resource="https://tyttikatariina.github.io/IMPACTO/#sector-health-MedicalSupportServiceProvision"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/fi#C61i">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">FI C61i: Processing personal data with the purpose of providing services or…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/fi#DPIARequiredList"/>
    <skos:definition xml:lang="en">Processing personal data with the purpose of providing services or developing products for commercial use that involve predicting working capacity, economic status, health, personal preferences or interests, trustworthiness, behavior, location or route (Sensitive data or data of highly personal nature and evaluation/scoring).</skos:definition>
    <dpv:hasIntendedPurpose rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-CommercialUse"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#FI"/>
    <dpv:hasPersonalData rdf:resource="https://tyttikatariina.github.io/IMPACTO/#pd-Trustworthiness"/>
    <dpv:hasPurpose rdf:resource="https://w3id.org/dpv#ServiceProvision"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#ai-ObjectIsolation">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Object Isolation</rdfs:label>
    <skos:editorialNote xml:lang="en">Used by the DPIA condition set but not yet defined in IMPACTO-concepts.ttl. Proposed for the ai namespace.</skos:editorialNote>
    <skos:prefLabel xml:lang="en">Object Isolation</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/fr#C29">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">FR C29: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/fr#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of France and which involves data processing to assess the credibility of the data subject by way of evaluating personal data in large scale or systematically (credit score) </skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#FR"/>
    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv/pd#CreditScore"/>
    <dpv:hasPurpose rdf:resource="https://w3id.org/dpv/sector/finance#CreditChecking"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#ai-AutomaticObjectRecognition">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Automatic Object Recognition</rdfs:label>
    <skos:editorialNote xml:lang="en">Used by the DPIA condition set but not yet defined in IMPACTO-concepts.ttl. Proposed for the ai namespace.</skos:editorialNote>
    <skos:prefLabel xml:lang="en">Automatic Object Recognition</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/dpia-conditions#C37b">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">DPIA-CONDITIONS C37b: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://example.org/dpia-conditions#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of EX and which involves The use of new technologies or technological solutions for the processing of personal data or with the possibility of processing personal data to analyse or predict the economic situation, health, personal preferences or interests, reliability or behaviour, location or movements of natural persons</skos:definition>
    <dpv:hasContext rdf:resource="https://w3id.org/dpv#InnovativeUseOfNewTechnologies"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#EX"/>
    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv/pd#FinancialStatus"/>
    <dpv:hasProcessing rdf:resource="https://w3id.org/dpv#Analyse"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/hu#C37b">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">HU C37b: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/hu#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Hungary and which involves The use of new technologies or technological solutions for the processing of personal data or with the possibility of processing personal data to analyse or predict the economic situation, health, personal preferences or interests, reliability or behaviour, location or movements of natural persons</skos:definition>
    <dpv:hasContext rdf:resource="https://w3id.org/dpv#InnovativeUseOfNewTechnologies"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#HU"/>
    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv/pd#FinancialStatus"/>
    <dpv:hasProcessing rdf:resource="https://w3id.org/dpv#Analyse"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/si#C15a">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">SI C15a: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/si#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Slovenia and which involves matching or combining separate data sets and registers</skos:definition>
    <dpv:hasDataSource rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-DataRegister"/>
    <dpv:hasDataSource rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-DataSet"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#SI"/>
    <dpv:hasProcessing rdf:resource="https://w3id.org/dpv#Match"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv#hasRiskSource">
    <owl:equivalentProperty rdf:resource="https://w3id.org/dpv/risk#hasRiskSource"/>
    <skos:editorialNote xml:lang="en">The property now lives in the RISK extension as risk:hasRiskSource.</skos:editorialNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv#TrainingManagement">
    <skos:editorialNote xml:lang="en">Current DPV uses dpv:StaffTraining.</skos:editorialNote>
    <skos:exactMatch rdf:resource="https://w3id.org/dpv#StaffTraining"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#OverlappingCondition">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Overlapping Condition</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <skos:broader rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <skos:definition xml:lang="en">A situation in which the same use case triggers both a DPIA and a FRIA: a high-risk processing activity that is carried out through a high-risk AI system deployed by a deployer within the scope of AI Act Art.27(1).</skos:definition>
    <skos:prefLabel xml:lang="en">Overlapping Condition</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/sector/law#RoadVehicleDriverAlcoholLevelVerification">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Road Vehicle Driver Alcohol Level Verification</rdfs:label>
    <dcterms:source xml:lang="en">CN57</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv/sector/infra#RoadSafetyMonitoring"/>
    <skos:definition xml:lang="en">The verification that a driver is not under the influence of alcohol, carried out under legal requirements applicable to transport activities.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/at#C41">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">AT C41: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/at#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Austria and which involves processing of data used to assess the behaviour and other personal aspects of natural persons</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#AT"/>
    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv/pd#Behavioural"/>
    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv/pd#Personality"/>
    <dpv:hasProcessing rdf:resource="https://w3id.org/dpv#Assess"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/ImpactAssessmentOntology/#PersonnelSupervision">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Personnel Supervision</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#PersonnelManagement"/>
    <skos:broader rdf:resource="https://w3id.org/dpv#PersonnelManagement"/>
    <skos:definition xml:lang="en">Activities that constitute supervision as part of oversight or management of humans as personnel</skos:definition>
    <skos:prefLabel xml:lang="en">Personnel Supervision</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/lv#C11">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">LV C11: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/lv#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Latvia and which involves processing of Biometric data</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#LV"/>
    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#BiometricData"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#pd-DigitalTwin">
    <rdfs:label xml:lang="en">pd  Digital Twin</rdfs:label>
    <owl:sameAs rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#DigitalTwin"/>
    <skos:exactMatch rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#DigitalTwin"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#DPIA-IR-15">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIAInformationRequirement"/>
    <rdfs:label xml:lang="en">Technical measures</rdfs:label>
    <dcterms:source xml:lang="en">GDPR Art.32, Art.35(7)(d)</dcterms:source>
    <skos:definition xml:lang="en">The technical measures implemented to protect personal data, such as encryption, access control and pseudonymisation.</skos:definition>
    <skos:prefLabel xml:lang="en">Technical measures</skos:prefLabel>
    <impacto-old:hasExpectedProperty rdf:resource="https://w3id.org/dpv#hasTechnicalMeasure"/>
    <impacto-old:hasExpectedValueClass rdf:resource="https://w3id.org/dpv#TechnicalMeasure"/>
    <impacto-old:isMandatory rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</impacto-old:isMandatory>
    <impacto-old:partOfRequirement rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIA-IR-A357d"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv#ThirdPartyDataSOurce">
    <skos:editorialNote xml:lang="en">Capitalisation error in 'Source'. Appears twice.</skos:editorialNote>
    <skos:exactMatch rdf:resource="https://w3id.org/dpv#ThirdPartyDataSource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#concernsAISystem">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">concerns AI system</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/dpv/legal/eu/aiact#AISystem"/>
    <skos:definition xml:lang="en">The AI system to which this condition or assessment relates.</skos:definition>
    <skos:prefLabel xml:lang="en">concerns AI system</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/impacto/DPIA-1">
    <rdf:type rdf:resource="https://w3id.org/dpv#DPIA"/>
    <rdfs:label xml:lang="en">DPIA: automated shortlisting of job applicants</rdfs:label>
    <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-10</dcterms:date>
    <impacto-old:conductedBy rdf:resource="https://example.org/impacto/CityCouncil"/>
    <impacto-old:conductedByRole rdf:resource="https://w3id.org/dpv#DataController"/>
    <impacto-old:providesInputTo rdf:resource="https://example.org/impacto/FRIA-1"/>
    <dpv:hasDataController rdf:resource="https://example.org/impacto/CityCouncil"/>
    <dpv:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DPIA: automated shortlisting of job applicants</dpv:hasName>
    <dpv:hasOutcome rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIAOutcomeRisksMitigated"/>
    <dpv:hasPersonalDataHandling rdf:resource="https://example.org/impacto/Proc-Shortlisting"/>
    <dpv:hasRisk rdf:resource="https://example.org/impacto/Risk-Bias"/>
    <dpv:hasRisk rdf:resource="https://example.org/impacto/Risk-Opacity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv#NationalLevelRegisters">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">National Level Registers</rdfs:label>
    <dcterms:source xml:lang="en">CN13</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#Data"/>
    <skos:definition xml:lang="en">Registers established at national level under the law of a Member State.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/sector/law#NotarialActivities">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Notarial Activities</rdfs:label>
    <dcterms:source xml:lang="en">CN48</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#Purpose"/>
    <skos:definition xml:lang="en">The carrying out of notarial activities, including the drafting of documents for notarial offices.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceMT">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Malta (MT)</rdfs:label>
    <skos:exactMatch rdf:resource="https://w3id.org/dpv/legal/mt#DPIARequiredList"/>
    <skos:prefLabel xml:lang="en">Malta (MT)</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/eu/gdpr#SystematicMonitoring">
    <skos:editorialNote xml:lang="en">The concept is defined in DPV core; the eu-gdpr form is used throughout DPIAConditions_complete.ttl and is retained for matching.</skos:editorialNote>
    <skos:exactMatch rdf:resource="https://w3id.org/dpv#SystematicMonitoring"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#sector-publicservices-ProvidingEGovernmentServices">
