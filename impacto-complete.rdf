    <rdfs:label xml:lang="en">Processing Context Evaluation</rdfs:label>
    <dcterms:source xml:lang="en">GDPR Art. 35(3)(a)</dcterms:source>
    <rdfs:seeAlso rdf:resource="https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX%3A32016R0679"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#ProcessingContext"/>
    <skos:broader rdf:resource="https://w3id.org/dpv#ProcessingContext"/>
    <skos:definition xml:lang="en">A processing context in which personal data is used to evaluate personal aspects relating to natural persons, such as in systematic and extensive evaluation.</skos:definition>
    <skos:prefLabel xml:lang="en">Processing Context Evaluation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Proposed for: DPV core (dpv)</skos:scopeNote>
  </rdf:Description>
