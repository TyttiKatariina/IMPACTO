    <skos:broader rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPAGuidance"/>
    <skos:definition xml:lang="en">A national list of processing operations for which no DPIA is required, published by a supervisory authority under GDPR Art.35(5). Commonly called a whitelist.</skos:definition>
    <skos:prefLabel xml:lang="en">DPIA Exempt List</skos:prefLabel>
  </rdf:Description>
