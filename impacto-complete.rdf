    <rdfs:label xml:lang="en">CZ C15b: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/cz#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Czech Republic and which involves matching or combining separate data sets and registers</skos:definition>
    <dpv:hasDataSource rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-DataRegister"/>
    <dpv:hasDataSource rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-DataSet"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#CZ"/>
    <dpv:hasProcessing rdf:resource="https://w3id.org/dpv#Combine"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/sector/law#RoadVehicleAlcoholTesting">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Road Vehicle Alcohol Testing</rdfs:label>
    <dcterms:source xml:lang="en">CN51</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv/sector/law#RoadVehicleSubstanceImpairmentPrevention"/>
    <skos:definition xml:lang="en">The testing of drivers for alcohol in order to prevent them from operating a vehicle while under its influence.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#HighRiskProcessingActivity">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">High-Risk Processing Activity</rdfs:label>
    <dcterms:source xml:lang="en">GDPR Art.35(1)</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#Process"/>
    <skos:broader rdf:resource="https://w3id.org/dpv#Process"/>
    <skos:definition xml:lang="en">A real processing activity that is likely to result in a high risk to the rights and freedoms of natural persons and therefore requires a DPIA. Determined by matching the activity against at least one DPIA Required Condition.</skos:definition>
    <skos:prefLabel xml:lang="en">High-Risk Processing Activity</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/ImpactAssessmentOntology/#EffectOnSalary">
