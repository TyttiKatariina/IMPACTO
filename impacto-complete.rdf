    <skos:broader rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentStage"/>
    <skos:definition xml:lang="en">The stage in which an existing assessment is reviewed and updated because the risk or the use has changed. In the AI Act this also covers relying on a previously conducted FRIA and updating outdated elements.</skos:definition>
    <skos:prefLabel xml:lang="en">Review Stage</skos:prefLabel>
  </rdf:Description>
