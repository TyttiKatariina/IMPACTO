    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#ES"/>
    <dpv:hasPurpose rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-ControlHumanActivity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/no#C61i">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">NO C61i: Processing personal data with the purpose of providing services or…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/no#DPIARequiredList"/>
    <skos:definition xml:lang="en">Processing personal data with the purpose of providing services or developing products for commercial use that involve predicting working capacity, economic status, health, personal preferences or interests, trustworthiness, behavior, location or route (Sensitive data or data of highly personal nature and evaluation/scoring).</skos:definition>
    <dpv:hasIntendedPurpose rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-CommercialUse"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#NO"/>
    <dpv:hasPersonalData rdf:resource="https://tyttikatariina.github.io/IMPACTO/#pd-Trustworthiness"/>
    <dpv:hasPurpose rdf:resource="https://w3id.org/dpv#ServiceProvision"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#FRIA-IR-e">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#FRIAInformationRequirement"/>
    <rdfs:label xml:lang="en">Human oversight measures</rdfs:label>
    <dcterms:source xml:lang="en">AI Act Art.27(1)(e), Art.14, Art.26</dcterms:source>
    <skos:definition xml:lang="en">A description of the implementation of human oversight measures, according to the instructions for use.</skos:definition>
    <skos:prefLabel xml:lang="en">Human oversight measures</skos:prefLabel>
    <impacto-old:correspondsToDPIARequirement rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIA-IR-12"/>
    <impacto-old:correspondsToDPIARequirement rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIA-IR-16"/>
    <impacto-old:hasExpectedProperty rdf:resource="https://tyttikatariina.github.io/IMPACTO/#hasHumanOversightMeasure"/>
    <impacto-old:hasReuseGap xml:lang="en">Organisational measures recorded in a DPIA may include human review of automated decisions under GDPR Art.22(3). The FRIA requires the implementation of human oversight in accordance with the provider's instructions for use under Art.14 and Art.26, which is more specific and is documented against those instructions.</impacto-old:hasReuseGap>
    <impacto-old:hasReuseLevel rdf:resource="https://tyttikatariina.github.io/IMPACTO/#PartiallyReusable"/>
    <impacto-old:isMandatory rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</impacto-old:isMandatory>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv#EventOrganisation">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Event Organisation</rdfs:label>
    <dcterms:source xml:lang="en">CN31</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#EventManagement"/>
    <skos:definition xml:lang="en">The organisation of the logistics and running of an event.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/lu#C14c">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">LU C14c: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/lu#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Luxembourg and which involves Evaluation or scoring of individuals (including profiling or predicting)</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#LU"/>
    <dpv:hasProcessing rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#Profiling"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/lt#C25f">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
