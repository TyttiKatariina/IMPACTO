    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/lt#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Lithuania and which involves recording of telephone conversations</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#LT"/>
    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv/pd#VoiceCommunicationRecording"/>
    <dpv:hasProcessing rdf:resource="https://w3id.org/dpv#Record"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/mt#C21">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
