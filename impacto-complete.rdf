    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/at#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Austria and which involves processing operations including image and acoustic processing for the preventive protection of persons or property on private residential properties not exclusively used by the person responsible and by all persons living in the common household</skos:definition>
    <dpv:hasData rdf:resource="https://w3id.org/dpv/tech#AudioData"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#AT"/>
    <dpv:hasPurpose rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-PreventativeProtectionOfProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/gr#DPIARequiredList">
