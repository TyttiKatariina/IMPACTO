  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">DPIA Required Process</rdfs:label>
    <dcterms:source xml:lang="en">GDPR Art. 35</dcterms:source>
    <rdfs:seeAlso rdf:resource="https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX%3A32016R0679"/>
    <rdfs:subClassOf rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIAProcess"/>
    <skos:broader rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIAProcess"/>
    <skos:definition xml:lang="en">A personal data processing activity that requires a DPIA according to GDPR Article 35.</skos:definition>
    <skos:prefLabel xml:lang="en">DPIA Required Process</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Proposed for: DPV GDPR extension (eu-gdpr)</skos:scopeNote>
    <skos:scopeNote xml:lang="en">The requirements for whether a DPIA is required for a specific process can be found in GDPR Art 35 and also in specific lists published by Member State Data Protection Authorities.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/at#C64">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
