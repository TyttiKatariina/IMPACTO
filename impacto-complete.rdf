    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Netherlands and which involves large-scale processing of communication and location data</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#NL"/>
    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv/pd#Location"/>
    <dpv:hasProcessingScale rdf:resource="https://w3id.org/dpv#LargeScaleProcessing"/>
  </rdf:Description>
