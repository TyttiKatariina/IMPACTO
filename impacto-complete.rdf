  <rdf:Description rdf:about="https://tyttikatariina.github.io/ImpactAssessmentOntology/#ClassificationOfIndividuals">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Classification Of Individuals</rdfs:label>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceAT"/>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceHU"/>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourcePL"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#ProcessingContext"/>
    <skos:broader rdf:resource="https://w3id.org/dpv#ProcessingContext"/>
    <skos:definition xml:lang="en">Processing that evaluates, ranks, or categorises natural persons, often based on behavioural, demographic, or personal data</skos:definition>
    <skos:notation>C48</skos:notation>
    <skos:prefLabel xml:lang="en">Classification Of Individuals</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Phrasing follows Article 29 Data Protection Working Party and EDPB guidelines</skos:scopeNote>
  </rdf:Description>
