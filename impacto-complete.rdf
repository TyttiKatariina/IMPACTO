    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of EX and which involves processing of data generated by devices connected to the Internet of things</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#EX"/>
    <tech:hasDevice rdf:resource="https://w3id.org/dpv/tech#IOTDevice"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#hasReuseLevel">
