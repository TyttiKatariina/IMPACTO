    <rdfs:label xml:lang="en">EE C47: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/ee#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Estonia and which involves extensive processing of data subject to social, professional or special official secrecy, even if it is not data pursuant to Article 9(1) and (10 GDPR)</skos:definition>
    <dpv:hasData rdf:resource="https://w3id.org/dpv#ConfidentialData"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#EE"/>
    <dpv:hasProcessingScale rdf:resource="https://w3id.org/dpv#LargeScaleProcessing"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/ro#C35c">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">RO C35c: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/ro#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Romania and which involves the processing of children’s personal data for profiling or automated decision-making purposes or for marketing purposes, or for direct offering of services intended for them </skos:definition>
    <dpv:hasHumanSubject rdf:resource="https://w3id.org/dpv#Child"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#RO"/>
    <dpv:hasPurpose rdf:resource="https://w3id.org/dpv#Marketing"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/at#C27">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
