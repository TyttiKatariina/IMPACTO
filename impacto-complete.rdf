    <dpv:hasRisk rdf:resource="https://tyttikatariina.github.io/IMPACTO/#risk-ContractSuspension"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/ImpactAssessmentOntology/#PublicUtilityProvider">
