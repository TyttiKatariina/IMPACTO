    <dcterms:source xml:lang="en">GDPR Art.4(4), Art.35(3)(a)</dcterms:source>
    <skos:definition xml:lang="en">Whether the processing involves profiling, and what inferences about behaviour, preferences or characteristics are drawn.</skos:definition>
    <skos:prefLabel xml:lang="en">Profiling and inferences</skos:prefLabel>
    <impacto-old:hasExpectedProperty rdf:resource="https://w3id.org/dpv#hasProcessing"/>
