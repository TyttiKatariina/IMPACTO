    <skos:broader rdf:resource="https://w3id.org/dpv/legal/eu/aiact#AIDeployer"/>
    <skos:definition xml:lang="en">A category of deployer used by AI Act Art.27(1) to determine who must conduct a FRIA.</skos:definition>
    <skos:prefLabel xml:lang="en">Deployer Category</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/ie#C13b">
