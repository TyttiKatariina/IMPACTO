  <rdf:Description rdf:about="https://w3id.org/dpv/pd#Legal">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Legal</rdfs:label>
    <dcterms:source xml:lang="en">CN22</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#SpecialCategoryPersonalData"/>
    <skos:definition xml:lang="en">Personal data relating to an individual's legal affairs, processed in the course of legal advisory services.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/impacto/WorkerMonitor">
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/aiact#HighRiskAISystem"/>
    <rdfs:label xml:lang="en">Warehouse productivity monitoring system</rdfs:label>
    <skos:broader rdf:resource="https://w3id.org/dpv/legal/eu/aiact#HighRiskAISystem-A6-2"/>
    <skos:broader rdf:resource="https://w3id.org/dpv/legal/eu/aiact#HighRiskAISystem-AnnexIII-4-b"/>
    <impacto-old:embedsProcessingActivity rdf:resource="https://example.org/impacto/Proc-WorkerMonitoring"/>
    <impacto-old:hasDeployer rdf:resource="https://example.org/impacto/Logistics"/>
    <impacto-old:hasNecessityJustification rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The system is high-risk under Art.6(2) via Annex III point 4(b), but no Art.27(1) deployer criterion is met, so no FRIA is owed. The deployer obligations in Art.26 continue to apply.</impacto-old:hasNecessityJustification>
    <impacto-old:hasNecessityStatus rdf:resource="https://tyttikatariina.github.io/IMPACTO/#FRIANotRequired"/>
    <impacto-old:matchesCondition rdf:resource="https://tyttikatariina.github.io/IMPACTO/#FN3"/>
    <dpv:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Warehouse productivity monitoring system</dpv:hasName>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/be#C56">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
