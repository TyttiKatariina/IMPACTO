  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv#hasController">
    <owl:equivalentProperty rdf:resource="https://w3id.org/dpv#hasDataController"/>
    <skos:editorialNote xml:lang="en">Legacy name. Current DPV uses dpv:hasDataController.</skos:editorialNote>
  </rdf:Description>
