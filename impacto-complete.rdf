    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">IT C21: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/it#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Italy and which involves processing data concerning asylum seekers</skos:definition>
    <dpv:hasHumanSubject rdf:resource="https://w3id.org/dpv#AsylumSeeker"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#IT"/>
  </rdf:Description>
