    <impacto-old:hasUseFrequency rdf:datatype="http://www.w3.org/2001/XMLSchema#string">each recruitment competition, approximately 40 times per year</impacto-old:hasUseFrequency>
    <impacto-old:hasUsePeriod rdf:datatype="http://www.w3.org/2001/XMLSchema#string">continuous from May 2026, reviewed annually</impacto-old:hasUsePeriod>
