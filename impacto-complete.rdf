    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Gait</rdfs:label>
    <dcterms:source xml:lang="en">CN16</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#PersonalData"/>
    <skos:definition xml:lang="en">Data capturing the manner in which an individual walks, as may be recorded by video surveillance.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#risk-UnauthorisedReversal">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Unauthorised Reversal</rdfs:label>
    <skos:editorialNote xml:lang="en">Used by the DPIA condition set but not yet defined in IMPACTO-concepts.ttl. Proposed for the risk namespace.</skos:editorialNote>
    <skos:prefLabel xml:lang="en">Unauthorised Reversal</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/impacto/Oversight-HumanReview">
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/aiact#DeployerHumanOversightMeasure"/>
    <rdfs:label xml:lang="en">Human review of every ranked shortlist</rdfs:label>
    <skos:definition xml:lang="en">A recruitment officer reviews the full applicant pool alongside the ranking, and records written reasons where the shortlist departs from or follows the ranking.</skos:definition>
    <skos:prefLabel xml:lang="en">Human review of every ranked shortlist</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#pd-LocationRoute">
    <rdfs:label xml:lang="en">pd  Location Route</rdfs:label>
    <owl:sameAs rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#LocationRoute"/>
    <skos:exactMatch rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#LocationRoute"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv#HighRisk">
    <skos:editorialNote xml:lang="en">Risk levels now live in the RISK extension.</skos:editorialNote>
    <skos:exactMatch rdf:resource="https://w3id.org/dpv/risk#HighRisk"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#dpv-WhistleblowerManagement">
    <rdfs:label xml:lang="en">dpv  Whistleblower Management</rdfs:label>
    <owl:sameAs rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#WhistleblowerManagement"/>
    <skos:exactMatch rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#WhistleblowerManagement"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/eu/gdpr#DPIANotRequired">
    <owl:equivalentClass rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIANotRequired"/>
    <skos:editorialNote xml:lang="en">The published IMPACTO term is impacto:eu-gdpr-DPIANotRequired.</skos:editorialNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#sector-health-ElectronicPresecriptionSystem">
    <rdfs:label xml:lang="en">sector health  Electronic Presecription System</rdfs:label>
    <owl:sameAs rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#ElectronicPrescriptionSystem"/>
    <skos:exactMatch rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#ElectronicPrescriptionSystem"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv#PartiallyAutomated">
    <skos:editorialNote xml:lang="en">Current DPV uses dpv:PartialAutomation.</skos:editorialNote>
    <skos:exactMatch rdf:resource="https://w3id.org/dpv#PartialAutomation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv#InnovativeUseofNewTechnologies">
    <skos:editorialNote xml:lang="en">Lower-case 'of'. Appears once, in eu-gdpr:C9.</skos:editorialNote>
    <skos:exactMatch rdf:resource="https://w3id.org/dpv#InnovativeUseOfNewTechnologies"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/sector/health#Physician">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Physician</rdfs:label>
    <dcterms:source xml:lang="en">CN62</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#Entity"/>
    <skos:definition xml:lang="en">A physician working on an individual basis in the exercise of their professional duties.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/sector/finance#LiquidityManagement">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Liquidity Management</rdfs:label>
    <dcterms:source xml:lang="en">CN25</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#Purpose"/>
    <skos:definition xml:lang="en">The management of an organisation's liquidity, including the evaluation of data supporting liquidity decisions.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv#Controller">
    <owl:equivalentClass rdf:resource="https://w3id.org/dpv#DataController"/>
    <skos:editorialNote xml:lang="en">Legacy name used in the existing IMPACTO files. Current DPV uses dpv:DataController.</skos:editorialNote>
    <skos:exactMatch rdf:resource="https://w3id.org/dpv#DataController"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/pd#TestOutcome">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
    <skos:editorialNote xml:lang="en">Used by several national DPIA conditions. Not present in the PD extension; a candidate for submission to the DPVCG.</skos:editorialNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#risk-ContractTerminated">
