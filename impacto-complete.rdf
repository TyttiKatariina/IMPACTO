    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">DPIA-CONDITIONS C85: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://example.org/dpia-conditions#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of EX and which involves processing of personal data using neurotechnology</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#EX"/>
    <dpv:isImplementedUsingTechnology rdf:resource="https://tyttikatariina.github.io/IMPACTO/#tech-Neurotechnology"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#eu-aiact-ConsultationWithAffectedEntities">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Consultation with Affected Entities</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#Consultation"/>
    <skos:broader rdf:resource="https://w3id.org/dpv#Consultation"/>
    <skos:definition xml:lang="en">Consultation with the natural persons, groups or other entities likely to be affected by the use of the AI system, or with their representatives.</skos:definition>
    <skos:prefLabel xml:lang="en">Consultation with Affected Entities</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Proposed for: DPV EU AI Act extension (eu-aiact)</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/dpia-conditions#C97">
