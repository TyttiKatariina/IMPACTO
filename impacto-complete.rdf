    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">NL C44: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/nl#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Netherlands and which involves the processing of considerable amounts of personal data for law enforcement purposes</skos:definition>
    <dpv:hasDataVolume rdf:resource="https://w3id.org/dpv#LargeDataVolume"/>
