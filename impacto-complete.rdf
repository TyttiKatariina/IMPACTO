    <risk:hasRiskSource rdf:resource="https://w3id.org/dpv/risk#LackOfSystemTransparency"/>
    <risk:hasRiskTreatment rdf:resource="https://w3id.org/dpv/risk#MitigationControl"/>
  </rdf:Description>
