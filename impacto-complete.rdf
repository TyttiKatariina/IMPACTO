    <impacto-old:partOfRequirement rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIA-IR-A357a"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/impacto/Risk-Bias">
    <rdf:type rdf:resource="https://w3id.org/dpv#Risk"/>
    <rdfs:label xml:lang="en">Risk  Bias</rdfs:label>
    <dcterms:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Systematic disadvantage to applicants with non-linear career histories</dcterms:description>
    <impacto-old:hasAffectedRight rdf:resource="https://w3id.org/dpv/legal/eu/rights#A21-NonDiscrimination"/>
    <impacto-old:hasResidualRiskLevel rdf:resource="https://w3id.org/dpv/risk#ModerateRisk"/>
    <impacto-old:hasThreat rdf:resource="https://w3id.org/dpv/risk#Discrimination"/>
    <impacto-old:hasTreatmentDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Quarterly outcome testing across protected characteristics; ranking withheld where disparity exceeds threshold.</impacto-old:hasTreatmentDescription>
    <dpv:hasImpact rdf:resource="https://w3id.org/dpv/risk#Discrimination"/>
    <dpv:hasLikelihood rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</dpv:hasLikelihood>
    <dpv:hasRiskLevel rdf:resource="https://w3id.org/dpv/risk#HighRisk"/>
    <dpv:hasSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</dpv:hasSeverity>
    <risk:hasRiskSource rdf:resource="https://w3id.org/dpv/risk#Bias"/>
    <risk:hasRiskTreatment rdf:resource="https://w3id.org/dpv/risk#MitigationControl"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#hasObligationSource">
