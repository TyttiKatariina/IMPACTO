    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Denmark and which involves Evaluation or scoring of individuals (including profiling or predicting)</skos:definition>
    <dpv:hasContext rdf:resource="https://w3id.org/dpv#EvaluationOfIndividuals"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#DK"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#ReviewStage">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Review Stage</rdfs:label>
    <dcterms:source xml:lang="en">AI Act Art.27(2)</dcterms:source>
    <dcterms:source xml:lang="en">GDPR Art.35(11)</dcterms:source>
