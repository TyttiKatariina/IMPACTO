    <skos:broader rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#UtilityProvider"/>
    <skos:definition xml:lang="en">A public organisation providing utilities</skos:definition>
    <skos:notation>C23</skos:notation>
    <skos:prefLabel xml:lang="en">Public Utility Provider</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/justifications#CollectiveLegalNorm">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Collective Legal Norm</rdfs:label>
    <dcterms:source xml:lang="en">CN6</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#Justification"/>
    <skos:definition xml:lang="en">A norm of collective legal design, such as a collective agreement or works agreement, on the basis of which processing is carried out.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/bg#C89c">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">BG C89c: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/bg#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Bulgaria and which involves regular and systematic processing where the provision of information under Article 19 of Regulation (EU) 2016/679</skos:definition>
    <dpv:hasContext rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-PersonalDataRestriction"/>
    <dpv:hasContext rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-Systematic"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#BG"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/fr#C31b">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">FR C31b: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/fr#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of France and which involves processing concerned with evaluating individuals for various insurance purposes</skos:definition>
    <dpv:hasContext rdf:resource="https://w3id.org/dpv#EvaluationOfIndividuals"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#FR"/>
    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv/pd#Insurance"/>
    <dpv:hasPurpose rdf:resource="https://w3id.org/dpv/sector/health#InsuranceManagement"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/no#C14d">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">NO C14d: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/no#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Norway and which involves Evaluation or scoring of individuals (including profiling or predicting)</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#NO"/>
    <dpv:hasProcessing rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-Predict"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/pl#C24b">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">PL C24b: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/pl#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Poland and which involves combining and/or matching data sets from two or more processing operations carried out for different purposes and/or by different controllers in the context of data processing that goes beyond the processing normally expected by a data subject, (provided that the use of algorithms can make decisions that significantly affect the data subject.)</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#PL"/>
    <dpv:hasProcessing rdf:resource="https://w3id.org/dpv#Combine"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/cz#C25e">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">CZ C25e</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/cz#DPIARequiredList"/>
    <dpv:hasData rdf:resource="https://w3id.org/dpv/tech#VideoContent"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#CZ"/>
    <dpv:hasPurpose rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-ControlHumanActivity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/ImpactAssessmentOntology/#ContractTerminated">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Contract Terminated</rdfs:label>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceBE"/>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceCY"/>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceES"/>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceFR"/>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceGR"/>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceHR"/>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceIS"/>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceIT"/>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceLI"/>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceSE"/>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceSI"/>
    <rdfs:subClassOf rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#ImpactOnContract"/>
    <skos:broader rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#ImpactOnContract"/>
    <skos:definition xml:lang="en">Where an existing contract is cancelled or terminated, such as by revoking a loan, ending a subscription, or dismissing an employee</skos:definition>
    <skos:notation>C20, C52</skos:notation>
    <skos:prefLabel xml:lang="en">Contract Terminated</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceDK">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Denmark (DK)</rdfs:label>
    <skos:exactMatch rdf:resource="https://w3id.org/dpv/legal/dk#DPIARequiredList"/>
    <skos:prefLabel xml:lang="en">Denmark (DK)</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv#Patent">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Patent</rdfs:label>
    <dcterms:source xml:lang="en">CN22</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#IntellectualPropertyData"/>
    <skos:definition xml:lang="en">Data relating to a patent held or applied for, processed in the course of professional practice.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#hasProportionalityAssessment">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">has proportionality assessment</rdfs:label>
    <dcterms:source xml:lang="en">GDPR Art.35(7)(b)</dcterms:source>
    <skos:definition xml:lang="en">The assessment of whether the processing is proportionate in relation to its purposes.</skos:definition>
    <skos:prefLabel xml:lang="en">has proportionality assessment</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv#Language">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Language</rdfs:label>
    <dcterms:source xml:lang="en">CN35</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#DataType"/>
    <skos:definition xml:lang="en">The language in which a processing activity or communication is carried out.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#hasComplaintMechanism">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">has complaint mechanism</rdfs:label>
    <dcterms:source xml:lang="en">AI Act Art.27(1)(f)</dcterms:source>
    <owl:equivalentProperty rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-aiact-ComplaintMeasures"/>
    <skos:definition xml:lang="en">Arrangements for internal governance and complaint mechanisms to be used if the identified risks materialise.</skos:definition>
    <skos:prefLabel xml:lang="en">has complaint mechanism</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/fr#C26">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">FR C26: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/fr#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of France and which involves processing of data related to minors </skos:definition>
    <dpv:hasHumanSubject rdf:resource="https://w3id.org/dpv#Child"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#FR"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#indicatesDPIACondition">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">indicates DPIA condition</rdfs:label>
    <rdfs:range rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <skos:definition xml:lang="en">Records that the processing typically entailed by a class of high-risk AI system corresponds to a condition under which a DPIA is required.</skos:definition>
    <skos:prefLabel xml:lang="en">indicates DPIA condition</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/sector/law#RoadVehicleSubstanceImpairmentPrevention">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Road Vehicle Substance Impairment Prevention</rdfs:label>
    <dcterms:source xml:lang="en">CN51</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#Purpose"/>
    <skos:definition xml:lang="en">Processing carried out to prevent drivers from operating a vehicle while under the influence of alcohol or narcotics.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIANotRequiredProcess">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">DPIA Not Required Process</rdfs:label>
    <dcterms:source xml:lang="en">GDPR Art. 35(5); Member State DPA Not-Required Lists (AT, CZ, FR, HR, IT, LV, NL, ES)</dcterms:source>
    <rdfs:seeAlso rdf:resource="https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX%3A32016R0679"/>
    <rdfs:subClassOf rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIAProcess"/>
    <skos:broader rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIAProcess"/>
    <skos:definition xml:lang="en">A personal data processing activity that does not require a DPIA according to the whitelists of processing activities published by Member State Data Protection Authorities.</skos:definition>
    <skos:prefLabel xml:lang="en">DPIA Not Required Process</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Proposed for: DPV GDPR extension (eu-gdpr)</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/si#C38">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">SI C38: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/si#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Slovenia and which involves the processing of personal data by linking, comparing or verifying matches from multiple sources</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#SI"/>
    <dpv:hasProcessing rdf:resource="https://w3id.org/dpv#Match"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/se#C17b">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">SE C17b: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/se#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Sweden and which involves processing resulting in access to or exclusion of services</skos:definition>
    <dpv:hasConsequence rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-LegalEffect"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#SE"/>
    <dpv:hasRisk rdf:resource="https://tyttikatariina.github.io/IMPACTO/#risk-ServiceExclusion"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/sector/health#IndividualDoctor">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Individual Doctor</rdfs:label>
    <dcterms:source xml:lang="en">CN21</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#LegalEntity"/>
    <skos:definition xml:lang="en">A doctor practising individually who processes patient data for patient management and fee billing.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/lv#C19">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">LV C19: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/lv#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Latvia and which involves processing related to preventing a data subject from exercising a right</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#LV"/>
    <dpv:hasRisk rdf:resource="https://tyttikatariina.github.io/IMPACTO/#risk-RightsExercisePrevented"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/de#C25e">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">DE C25e</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/de#DPIARequiredList"/>
    <dpv:hasData rdf:resource="https://w3id.org/dpv/tech#VideoContent"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#DE"/>
    <dpv:hasPurpose rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-ControlHumanActivity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv#ServiceSupplier">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Service Supplier</rdfs:label>
    <dcterms:source xml:lang="en">CN5</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#Entity"/>
    <skos:definition xml:lang="en">An entity that supplies goods or services to an organisation within a business relationship.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/eu/at-gdpr#C11">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">AT-GDPR C11: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/eu/at-gdpr#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Austria and which involves processing of Biometric data</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#AT"/>
    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#BiometricData"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv#PrivateEventOrganisation">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Private Event Organisation</rdfs:label>
    <dcterms:source xml:lang="en">CN31</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#EventManagement"/>
    <skos:definition xml:lang="en">The organisation of an event by a private entity.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv#PublicInquiryManagement">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Public Inquiry Management</rdfs:label>
    <dcterms:source xml:lang="en">CN29</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#Purpose"/>
    <skos:definition xml:lang="en">Managing and responding to inquiries received from members of the public, particularly where there is a general need for information due to a large number of inquiries on a specific topic.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/se#C20c">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">SE C20c: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/se#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Sweden and which involves profiling resulting in exclusion/suspension/rupture from a contract</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#SE"/>
    <dpv:hasProcessing rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#Profiling"/>
    <dpv:hasRisk rdf:resource="https://tyttikatariina.github.io/IMPACTO/#risk-ContractTerminated"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv#AwardingDecorations">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Awarding Decorations</rdfs:label>
    <dcterms:source xml:lang="en">CN32</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#Purpose"/>
    <skos:definition xml:lang="en">Processing carried out for the awarding of decorations or similar honours, including the related preliminary examinations.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/ImpactAssessmentOntology/#Prison">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Prison</rdfs:label>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceLV"/>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceNL"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#LocationLocality"/>
    <skos:broader rdf:resource="https://w3id.org/dpv#LocationLocality"/>
    <skos:definition xml:lang="en">A place in which individuals are held due to committing a crime or awaiting trial</skos:definition>
    <skos:notation>C57</skos:notation>
    <skos:prefLabel xml:lang="en">Prison</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Context: continuous or large-scale observation of individuals in sensitive contexts involving protected or vulnerable populations</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#eu-aiact-ComplaintMeasures">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Complaint Measures</rdfs:label>
    <dcterms:source xml:lang="en">AI Act Art. 27(1)(f)</dcterms:source>
    <rdfs:seeAlso rdf:resource="https://eur-lex.europa.eu/eli/reg/2024/1689/oj/eng"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#AIGovernance"/>
    <skos:broader rdf:resource="https://w3id.org/dpv#AIGovernance"/>
    <skos:definition xml:lang="en">Complaint mechanisms to be used by the deployer in the case of the materialisation of risks to fundamental rights.</skos:definition>
    <skos:prefLabel xml:lang="en">Complaint Measures</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Proposed for: DPV EU AI Act extension (eu-aiact)</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/dpia-conditions#C71e">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">DPIA-CONDITIONS C71e: Processing operations carried out pursuant to Article 14 of the…</rdfs:label>
    <dcterms:source rdf:resource="https://example.org/dpia-conditions#DPIARequiredList"/>
    <skos:definition xml:lang="en">Processing operations carried out pursuant to Article 14 of the General Data Protection Regulation. If the information that should be provided to the data subject is subject to an exception under Art.14 5(a-d)</skos:definition>
    <dpv:hasDataSource rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-NonDataSubjectDataSource"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#EX"/>
    <dpv:hasJustification rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#JustificationA14LegallyExempted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv#WorkCouncilActivityManagement">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Work Council Activity Management</rdfs:label>
    <dcterms:source xml:lang="en">CN43</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#Purpose"/>
    <skos:definition xml:lang="en">The management of the activities of a works council.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv#ProtectionOfPersons">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Protection Of Persons</rdfs:label>
    <dcterms:source xml:lang="en">CN18</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#Purpose"/>
    <skos:definition xml:lang="en">Processing carried out for the purpose of protecting the safety of persons.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#NotificationStage">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Notification Stage</rdfs:label>
    <dcterms:source xml:lang="en">AI Act Art.27(3)</dcterms:source>
    <dcterms:source xml:lang="en">GDPR Art.36(1)</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentStage"/>
    <skos:broader rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentStage"/>
    <skos:definition xml:lang="en">The stage in which the results of the assessment are notified: prior consultation of the supervisory authority for a DPIA with high residual risk, or notification of the market surveillance authority for a FRIA.</skos:definition>
    <skos:prefLabel xml:lang="en">Notification Stage</skos:prefLabel>
    <impacto-old:hasStage_Requirement rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIA-IR-26"/>
    <impacto-old:hasStage_Requirement rdf:resource="https://tyttikatariina.github.io/IMPACTO/#FRIA-IR-notification"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv#DetectiveAgencies">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Detective Agencies</rdfs:label>
    <dcterms:source xml:lang="en">CN5</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#Entity"/>
    <skos:definition xml:lang="en">An entity that carries out investigative activities in respect of third parties with whom it has no business relationship.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/lt#C114b">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">LT C114b: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/lt#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Lithuania and which involves processing of personal video data when video surveillance is conducted in areas not owned by the controller or healthcare settings or combined with sound recordings</skos:definition>
    <dpv:hasData rdf:resource="https://w3id.org/dpv/tech#VideoContent"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#LT"/>
    <dpv:hasLocation rdf:resource="https://tyttikatariina.github.io/IMPACTO/#loc-Healthcare"/>
    <dpv:hasTechnicalOrganisationalMeasure rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-CameraSurveillance"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/nl#C57g">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">NL C57g: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/nl#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Netherlands and which involves the supervision of the data subject, which is carried out in the following cases: a. if it is carried out on a large scale; b. if it is carried out at the workplace; c. if it applies to specially protected data subjects (e.g. health care, social care, prison, prison, educational institution, workplace)</skos:definition>
    <dpv:hasContext rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-MonitoringIndividuals"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#NL"/>
    <dpv:hasLocation rdf:resource="https://tyttikatariina.github.io/IMPACTO/#loc-EducationalInstitution"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/tech#AutomatedAccess">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Automated System</rdfs:label>
    <dcterms:source xml:lang="en">CN15</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv/tech#Technology"/>
    <skos:definition xml:lang="en">A system that processes personal data with automated assistance, such as a system controlling authorisation of access to buildings and delimited areas.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/dpia-conditions#C57c">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">DPIA-CONDITIONS C57c: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://example.org/dpia-conditions#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of EX and which involves the supervision of the data subject, which is carried out in the following cases: a. if it is carried out on a large scale; b. if it is carried out at the workplace; c. if it applies to specially protected data subjects (e.g. health care, social care, prison, prison, educational institution, workplace)</skos:definition>
    <dpv:hasContext rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-MonitoringIndividuals"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#EX"/>
    <dpv:hasLocation rdf:resource="https://tyttikatariina.github.io/IMPACTO/#loc-Healthcare"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/dpia-conditions#C61k">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">DPIA-CONDITIONS C61k: Processing personal data with the purpose of providing services or…</rdfs:label>
    <dcterms:source rdf:resource="https://example.org/dpia-conditions#DPIARequiredList"/>
    <skos:definition xml:lang="en">Processing personal data with the purpose of providing services or developing products for commercial use that involve predicting working capacity, economic status, health, personal preferences or interests, trustworthiness, behavior, location or route (Sensitive data or data of highly personal nature and evaluation/scoring).</skos:definition>
    <dpv:hasIntendedPurpose rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-CommercialUse"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#EX"/>
    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv/pd#Location"/>
    <dpv:hasPurpose rdf:resource="https://w3id.org/dpv#ServiceProvision"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/at#C67c">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">AT C67c: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/at#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Austria and which involves processing operations including image and acoustic processing for the preventive protection of persons or property on private residential properties not exclusively used by the person responsible and by all persons living in the common household</skos:definition>
    <dpv:hasData rdf:resource="https://w3id.org/dpv/tech#ImageData"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#AT"/>
    <dpv:hasPurpose rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-PreventativeProtectionOfProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/loc#CooperativeSocietyOfApartments">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Cooperative Society Of Apartments</rdfs:label>
    <dcterms:source xml:lang="en">CN55</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv/loc#Locality"/>
    <skos:definition xml:lang="en">A cooperative society of apartments responsible for the management of multi-apartment residential buildings, related buildings and land.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv#AccommodationOrganisation">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Accommodation Organisation</rdfs:label>
    <dcterms:source xml:lang="en">CN31</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#EventManagement"/>
    <skos:definition xml:lang="en">The organisation of stays and accommodation in connection with an event.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/dpia-conditions#C37e">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">DPIA-CONDITIONS C37e: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://example.org/dpia-conditions#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of EX and which involves The use of new technologies or technological solutions for the processing of personal data or with the possibility of processing personal data to analyse or predict the economic situation, health, personal preferences or interests, reliability or behaviour, location or movements of natural persons</skos:definition>
    <dpv:hasContext rdf:resource="https://w3id.org/dpv#InnovativeUseOfNewTechnologies"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#EX"/>
    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv/pd#Interest"/>
    <dpv:hasProcessing rdf:resource="https://w3id.org/dpv#Analyse"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#DPIA-IR-A357b">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIAInformationRequirement"/>
    <rdfs:label xml:lang="en">Necessity and proportionality</rdfs:label>
    <dcterms:source xml:lang="en">GDPR Art.35(7)(b)</dcterms:source>
    <skos:definition xml:lang="en">An assessment of the necessity and proportionality of the processing operations in relation to the purposes.</skos:definition>
    <skos:prefLabel xml:lang="en">Necessity and proportionality</skos:prefLabel>
    <impacto-old:isMandatory rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</impacto-old:isMandatory>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/bg#C13b">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">BG C13b: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/bg#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Bulgaria and which involves large-scale processing of communication and location data</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#BG"/>
    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv/pd#Location"/>
    <dpv:hasProcessingScale rdf:resource="https://w3id.org/dpv#LargeScaleProcessing"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/it#C14a">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">IT C14a: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/it#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Italy and which involves Evaluation or scoring of individuals (including profiling or predicting)</skos:definition>
    <dpv:hasContext rdf:resource="https://w3id.org/dpv#EvaluationOfIndividuals"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#IT"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv#AncillaryRecords">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Ancillary Records</rdfs:label>
    <dcterms:source xml:lang="en">CN12</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#Accounting"/>
    <skos:definition xml:lang="en">Records kept in support of an organisation's principal accounting records.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/nl#C57b">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">NL C57b: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/nl#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Netherlands and which involves the supervision of the data subject, which is carried out in the following cases: a. if it is carried out on a large scale; b. if it is carried out at the workplace; c. if it applies to specially protected data subjects (e.g. health care, social care, prison, prison, educational institution, workplace)</skos:definition>
    <dpv:hasContext rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-MonitoringIndividuals"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#NL"/>
    <dpv:hasLocation rdf:resource="https://tyttikatariina.github.io/IMPACTO/#loc-Workplace"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/dpia-conditions#C82d">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">DPIA-CONDITIONS C82d: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://example.org/dpia-conditions#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of EX and which involves large scale systematic processing of personal data with the purpose of introducing, organizing, providing and monitoring the use of electronic government services</skos:definition>
    <dpv:hasContext rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-Systematic"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#EX"/>
    <dpv:hasProcessingScale rdf:resource="https://w3id.org/dpv#LargeScaleProcessing"/>
    <dpv:hasPurpose rdf:resource="https://tyttikatariina.github.io/IMPACTO/#sector-publicservices-MonitoringEGovernmentServices"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/cy#C112">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">CY C112: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/cy#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Cyprus and which involves applications offering users the possibility to store documents, emails, diaries, notes and very personal information from life-logging applications</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#CY"/>
    <dpv:hasProcessing rdf:resource="https://w3id.org/dpv#Store"/>
    <dpv:isImplementedUsingTechnology rdf:resource="https://tyttikatariina.github.io/IMPACTO/#tech-LifeLoggingApplication"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/cz#C24c">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">CZ C24c: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/cz#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Czech Republic and which involves combining and/or matching data sets from two or more processing operations carried out for different purposes and/or by different controllers in the context of data processing that goes beyond the processing normally expected by a data subject, (provided that the use of algorithms can make decisions that significantly affect the data subject.)</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#CZ"/>
    <dpv:hasProcessing rdf:resource="https://w3id.org/dpv#Combine"/>
    <dpv:hasProcessing rdf:resource="https://w3id.org/dpv#Match"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/ee#C61o">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">EE C61o: Processing personal data with the purpose of providing services or…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/ee#DPIARequiredList"/>
    <skos:definition xml:lang="en">Processing personal data with the purpose of providing services or developing products for commercial use that involve predicting working capacity, economic status, health, personal preferences or interests, trustworthiness, behavior, location or route (Sensitive data or data of highly personal nature and evaluation/scoring).</skos:definition>
    <dpv:hasIntendedPurpose rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-CommercialUse"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#EE"/>
    <dpv:hasPersonalData rdf:resource="https://tyttikatariina.github.io/IMPACTO/#pd-LocationRoute"/>
    <dpv:hasPurpose rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-ProductDevelopment"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv#OfferOfGoods">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Offer Of Goods</rdfs:label>
    <dcterms:source xml:lang="en">CN36</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#ServiceProvision"/>
    <skos:definition xml:lang="en">The display or offering of goods to a customer, for example through items placed on a controller's website.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/no#C11">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">NO C11: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/no#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Norway and which involves processing of Biometric data</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#NO"/>
    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#BiometricData"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/ImpactAssessmentOntology/#FileSystem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">File System</rdfs:label>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceLU"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv/tech#System"/>
    <skos:broader rdf:resource="https://w3id.org/dpv/tech#System"/>
    <skos:definition xml:lang="en">A structured set of personal data that is accessible according to specific criteria, whether centralised, decentralised, or dispersed functionally or geographically, as defined in the GDPR</skos:definition>
    <skos:notation>C79</skos:notation>
    <skos:prefLabel xml:lang="en">File System</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#FRIANotRequiredCondition">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">FRIA Not Required Condition</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://tyttikatariina.github.io/IMPACTO/#FRIATriggerCondition"/>
    <rdfs:subClassOf rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-aiact-FRIANecessity"/>
    <skos:broader rdf:resource="https://tyttikatariina.github.io/IMPACTO/#FRIATriggerCondition"/>
    <skos:definition xml:lang="en">A combination of AI system classification and deployer category which falls outside the scope of AI Act Art.27(1), so that no FRIA is required.</skos:definition>
    <skos:prefLabel xml:lang="en">FRIA Not Required Condition</skos:prefLabel>
    <skos:related rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-aiact-FRIANotRequired"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#eu-aiact-HighRiskAISystem">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">High Risk AI System</rdfs:label>
    <dcterms:source xml:lang="en">AI Act Art. 6(2), Art. 27(1)</dcterms:source>
    <rdfs:seeAlso rdf:resource="https://eur-lex.europa.eu/eli/reg/2024/1689/oj/eng"/>
    <rdfs:subClassOf rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-aiact-FRIANecessityDetermination"/>
    <skos:broader rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-aiact-FRIANecessityDetermination"/>
    <skos:definition xml:lang="en">A determination that the AI system is a high-risk AI system referred to in AI Act Article 6(2), bringing its deployment within the scope of Article 27.</skos:definition>
    <skos:editorialNote xml:lang="en">The published IMPACTO term and the DPV AI Act term denote the same class. DPV additionally subdivides it by Article 6(1), Article 6(2) and each Annex III point, which IMPACTO's conditions rely on.</skos:editorialNote>
    <skos:exactMatch rdf:resource="https://w3id.org/dpv/legal/eu/aiact#HighRiskAISystem"/>
    <skos:prefLabel xml:lang="en">High Risk AI System</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Proposed for: DPV EU AI Act extension (eu-aiact)</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/se#C14d">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">SE C14d: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/se#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Sweden and which involves Evaluation or scoring of individuals (including profiling or predicting)</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#SE"/>
    <dpv:hasProcessing rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-Predict"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/ie#C26">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">IE C26: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/ie#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Ireland and which involves processing of data related to minors </skos:definition>
    <dpv:hasHumanSubject rdf:resource="https://w3id.org/dpv#Child"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#IE"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv#hasDPIAOutcome">
    <owl:equivalentProperty rdf:resource="https://w3id.org/dpv#hasOutcome"/>
    <skos:editorialNote xml:lang="en">Legacy name. Current DPV expresses the outcome with dpv:hasOutcome and an eu-gdpr:DPIAOutcome value.</skos:editorialNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/lu#C24a">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">LU C24a: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/lu#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Luxembourg and which involves combining and/or matching data sets from two or more processing operations carried out for different purposes and/or by different controllers in the context of data processing that goes beyond the processing normally expected by a data subject, (provided that the use of algorithms can make decisions that significantly affect the data subject.)</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#LU"/>
    <dpv:hasProcessing rdf:resource="https://w3id.org/dpv#Match"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#FN3">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#FRIANotRequiredCondition"/>
    <rdfs:label xml:lang="en">Private deployer outside the public service and Annex III 5(b),(c) scope</rdfs:label>
    <dcterms:source xml:lang="en">AI Act Art.27(1)</dcterms:source>
    <skos:definition xml:lang="en">No FRIA is required where the deployer is neither a body governed by public law nor a private entity providing public services, and the system does not fall under Annex III points 5(b) or 5(c), even though the system is high-risk under Article 6(2).</skos:definition>
    <skos:note xml:lang="en">This is the condition that makes the FRIA obligation narrower than the high-risk classification itself.</skos:note>
    <skos:prefLabel xml:lang="en">Private deployer outside the public service and Annex III 5(b),(c) scope</skos:prefLabel>
    <impacto-old:excludesAISystemType rdf:resource="https://w3id.org/dpv/legal/eu/aiact#HighRiskAISystem-AnnexIII-5-b"/>
    <impacto-old:excludesAISystemType rdf:resource="https://w3id.org/dpv/legal/eu/aiact#HighRiskAISystem-AnnexIII-5-c"/>
    <impacto-old:hasObligationSource rdf:resource="https://tyttikatariina.github.io/IMPACTO/#FRIASource-A27"/>
    <impacto-old:requiresAISystemType rdf:resource="https://w3id.org/dpv/legal/eu/aiact#HighRiskAISystem-A6-2"/>
    <impacto-old:requiresDeployerType rdf:resource="https://tyttikatariina.github.io/IMPACTO/#OtherDeployer"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/lu#C19">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
