    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Member State Territory</rdfs:label>
    <dcterms:source xml:lang="en">CN33</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#Locality"/>
