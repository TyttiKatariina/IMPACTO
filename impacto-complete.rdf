  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#DPIA-IR-7">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIAInformationRequirement"/>
    <rdfs:label xml:lang="en">Scale of processing</rdfs:label>
    <dcterms:source xml:lang="en">Recital 91; WP248rev.01</dcterms:source>
    <skos:definition xml:lang="en">The scale of the processing, including the number of data subjects and the volume of data.</skos:definition>
    <skos:prefLabel xml:lang="en">Scale of processing</skos:prefLabel>
    <impacto-old:hasExpectedProperty rdf:resource="https://tyttikatariina.github.io/IMPACTO/#hasDataSubjectCount"/>
    <impacto-old:hasExpectedProperty rdf:resource="https://w3id.org/dpv#hasProcessingScale"/>
    <impacto-old:isMandatory rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</impacto-old:isMandatory>
    <impacto-old:partOfRequirement rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIA-IR-A357a"/>
  </rdf:Description>
