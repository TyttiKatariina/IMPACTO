    <rdfs:label xml:lang="en">CZ C25a: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/cz#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Czech Republic and which involves processing operations aimed at monitoring or controlling data subjects, in particular by means of image or video and associated acoustic data processing</skos:definition>
