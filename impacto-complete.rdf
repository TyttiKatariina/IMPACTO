    <rdfs:label xml:lang="en">DPIA-CONDITIONS C62a: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://example.org/dpia-conditions#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of EX and which involves innovate sensor or mobile based, centralised data collection</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#EX"/>
    <dpv:hasLocation rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-CentralisedLocation"/>
    <tech:hasComponent rdf:resource="https://tyttikatariina.github.io/IMPACTO/#tech-Sensor"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/dpia-conditions#C85">
