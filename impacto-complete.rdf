    <rdfs:label xml:lang="en">FR C12: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/fr#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of France and which involves processing of genetic data</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#FR"/>
    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#Genetic"/>
  </rdf:Description>
