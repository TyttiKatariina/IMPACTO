    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/gr#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Greece and which involves processing concerned with evaluating individuals for various insurance purposes</skos:definition>
