    <rdfs:label xml:lang="en">Private Utility Provider</rdfs:label>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceBE"/>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceGR"/>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceHR"/>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceHU"/>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceNL"/>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourcePL"/>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceRO"/>
    <rdfs:subClassOf rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#UtilityProvider"/>
    <skos:broader rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#UtilityProvider"/>
    <skos:definition xml:lang="en">A private organisation providing utilities</skos:definition>
    <skos:notation>C23</skos:notation>
    <skos:prefLabel xml:lang="en">Private Utility Provider</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/dpia-conditions#C28">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">DPIA-CONDITIONS C28: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://example.org/dpia-conditions#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of EX and which involves processing concerns personal data that has not been obtained from the data subject, and providing this information would prove difficult/ impossible</skos:definition>
    <dpv:hasDataSource rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-NonDataSubjectDataSource"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#EX"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#hasDeployer">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">has deployer</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/dpv/legal/eu/aiact#AIDeployer"/>
    <skos:definition xml:lang="en">The entity deploying an AI system under its own authority.</skos:definition>
    <skos:prefLabel xml:lang="en">has deployer</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#pd-UnlawfulActivity">
    <rdfs:label xml:lang="en">pd  Unlawful Activity</rdfs:label>
    <owl:sameAs rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#UnlawfulActivity"/>
    <skos:exactMatch rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#UnlawfulActivity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/ImpactAssessmentOntology/#LabourBrokeringService">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Labour Brokering Service</rdfs:label>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceEE"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#HumanResourceManagement"/>
    <skos:broader rdf:resource="https://w3id.org/dpv#HumanResourceManagement"/>
    <skos:definition xml:lang="en">Service that facilitates labour provision through a brokering process, including matching workers with jobs or facilitating labour based on demand</skos:definition>
    <skos:notation>C105</skos:notation>
    <skos:prefLabel xml:lang="en">Labour Brokering Service</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#ImpactAssessmentProcess">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Impact Assessment Process</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#Process"/>
    <skos:broader rdf:resource="https://w3id.org/dpv#Process"/>
    <skos:definition xml:lang="en">The procedure by which an impact assessment is carried out, from determining whether it is required through to documenting its outcome.</skos:definition>
    <skos:prefLabel xml:lang="en">Impact Assessment Process</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#providesInputTo">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">provides input to</rdfs:label>
    <owl:inverseOf rdf:resource="https://tyttikatariina.github.io/IMPACTO/#reusesDPIA"/>
    <skos:definition xml:lang="en">Indicates that this DPIA supplies content used in a FRIA.</skos:definition>
    <skos:prefLabel xml:lang="en">provides input to</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/li#C15a">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">LI C15a: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/li#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Liechtenstein and which involves matching or combining separate data sets and registers</skos:definition>
    <dpv:hasDataSource rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-DataRegister"/>
    <dpv:hasDataSource rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-DataSet"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#LI"/>
    <dpv:hasProcessing rdf:resource="https://w3id.org/dpv#Match"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/pl#C13b">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">PL C13b: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/pl#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Poland and which involves large-scale processing of communication and location data</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#PL"/>
    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv/pd#Location"/>
    <dpv:hasProcessingScale rdf:resource="https://w3id.org/dpv#LargeScaleProcessing"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/hu#C23">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">HU C23: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/hu#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Hungary and which involves the purpose of data processing is the application of ‘smart meters’ set up by public utilities providers (the monitoring of consumption customs)</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#HU"/>
    <dpv:hasOrganisation rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-PublicUtilityProvider"/>
    <dpv:hasPurpose rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-Monitoring"/>
    <tech:hasInput rdf:resource="https://tyttikatariina.github.io/IMPACTO/#tech-SmartMeter"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv#AuthorisedProcessing">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Authorised Processing</rdfs:label>
    <dcterms:source xml:lang="en">CN59</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#AuditStatus"/>
    <skos:definition xml:lang="en">Processing carried out strictly under guidelines previously established or authorised by a supervisory body, by way of circulars or decisions, and unchanged since that authorisation.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/no#C61h">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">NO C61h: Processing personal data with the purpose of providing services or…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/no#DPIARequiredList"/>
    <skos:definition xml:lang="en">Processing personal data with the purpose of providing services or developing products for commercial use that involve predicting working capacity, economic status, health, personal preferences or interests, trustworthiness, behavior, location or route (Sensitive data or data of highly personal nature and evaluation/scoring).</skos:definition>
    <dpv:hasIntendedPurpose rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-CommercialUse"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#NO"/>
    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv/pd#Interest"/>
    <dpv:hasPurpose rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-ProductDevelopment"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/pl#C43d">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">PL C43d</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/pl#DPIARequiredList"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#PL"/>
    <dpv:hasLocation rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-PublicTransport"/>
    <dpv:hasPurpose rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-ControlHumanActivity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/de#C37g">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">DE C37g: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/de#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Germany and which involves The use of new technologies or technological solutions for the processing of personal data or with the possibility of processing personal data to analyse or predict the economic situation, health, personal preferences or interests, reliability or behaviour, location or movements of natural persons</skos:definition>
    <dpv:hasContext rdf:resource="https://w3id.org/dpv#InnovativeUseOfNewTechnologies"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#DE"/>
    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv/pd#Behavioural"/>
    <dpv:hasProcessing rdf:resource="https://w3id.org/dpv#Analyse"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#eu-aiact-ExistingFRIA">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Existing FRIA</rdfs:label>
    <dcterms:source xml:lang="en">AI Act Art. 27(2)</dcterms:source>
    <rdfs:seeAlso rdf:resource="https://eur-lex.europa.eu/eli/reg/2024/1689/oj/eng"/>
    <rdfs:subClassOf rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-aiact-ImpactAssessmentReuse"/>
    <skos:broader rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-aiact-ImpactAssessmentReuse"/>
    <skos:definition xml:lang="en">A previously conducted FRIA, or an existing impact assessment carried out by the provider, on which a deployer may rely in similar cases.</skos:definition>
    <skos:prefLabel xml:lang="en">Existing FRIA</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Proposed for: DPV EU AI Act extension (eu-aiact)</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/dpia-conditions#C110b">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">DPIA-CONDITIONS C110b: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://example.org/dpia-conditions#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of EX and which involves the transfer of special category data to a third country or to an international organisation</skos:definition>
    <dpv:hasEntity rdf:resource="https://w3id.org/dpv#InternationalOrganisation"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#EX"/>
    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv#SpecialCategoryPersonalData"/>
    <dpv:hasProcessing rdf:resource="https://w3id.org/dpv#CrossBoarderTransfer"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/dpia-conditions#C81b">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">DPIA-CONDITIONS C81b: When the data controller is planning to set up an application, tool,…</rdfs:label>
    <dcterms:source rdf:resource="https://example.org/dpia-conditions#DPIARequiredList"/>
    <skos:definition xml:lang="en">When the data controller is planning to set up an application, tool, or platform for use by an entire sector to process also special categories of personal data.</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#EX"/>
    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv#SpecialCategoryPersonalData"/>
    <eu-aiact:IntendedPurpose rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-EntireSector"/>
    <tech:hasIntendedUse rdf:resource="https://tyttikatariina.github.io/IMPACTO/#tech-Tool"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/is#C37b">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">IS C37b: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/is#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Iceland and which involves The use of new technologies or technological solutions for the processing of personal data or with the possibility of processing personal data to analyse or predict the economic situation, health, personal preferences or interests, reliability or behaviour, location or movements of natural persons</skos:definition>
    <dpv:hasContext rdf:resource="https://w3id.org/dpv#InnovativeUseOfNewTechnologies"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#IS"/>
    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv/pd#FinancialStatus"/>
    <dpv:hasProcessing rdf:resource="https://w3id.org/dpv#Analyse"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/ImpactAssessmentOntology/#OnPublicRoad">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">On Public Road</rdfs:label>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceAT"/>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceCY"/>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceFR"/>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourcePL"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#PubliclyAccessibleSpace"/>
    <skos:broader rdf:resource="https://w3id.org/dpv#PubliclyAccessibleSpace"/>
    <skos:definition xml:lang="en">Any location accessible to the general public, particularly roads and streets used by public or private transportation, where monitoring or control of individuals is conducted via processing operations such as video surveillance or traffic sensors</skos:definition>
    <skos:notation>C43</skos:notation>
    <skos:prefLabel xml:lang="en">On Public Road</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Proposed as subclass of dpv:PubliclyAccessibleSpace pending group discussion on modelling specific locations</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/cy#C110b">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">CY C110b: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/cy#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Cyprus and which involves the transfer of special category data to a third country or to an international organisation</skos:definition>
    <dpv:hasEntity rdf:resource="https://w3id.org/dpv#InternationalOrganisation"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#CY"/>
    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv#SpecialCategoryPersonalData"/>
    <dpv:hasProcessing rdf:resource="https://w3id.org/dpv#CrossBoarderTransfer"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/ImpactAssessmentOntology/#MonitoringIndividuals">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Monitoring Individuals</rdfs:label>
    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceAll"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#ProcessingContext"/>
    <skos:broader rdf:resource="https://w3id.org/dpv#ProcessingContext"/>
    <skos:definition xml:lang="en">Monitoring of humans (as individuals or as groups) which includes a systematic observation or surveillance of behaviour, movements, or activities</skos:definition>
    <skos:notation>C5, C43, C46, C53, C55, C61, C76, C87, C97</skos:notation>
    <skos:prefLabel xml:lang="en">Monitoring Individuals</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Proposed as addition to dpv: — differs from existing dpv:Monitor (which monitors data for criteria) by focusing specifically on monitoring of data subjects themselves</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/cy#C15b">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">CY C15b: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/cy#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Cyprus and which involves matching or combining separate data sets and registers</skos:definition>
    <dpv:hasDataSource rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-DataRegister"/>
    <dpv:hasDataSource rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-DataSet"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#CY"/>
    <dpv:hasProcessing rdf:resource="https://w3id.org/dpv#Combine"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#DPIA-IR-5">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIAInformationRequirement"/>
    <rdfs:label xml:lang="en">Entities involved</rdfs:label>
    <dcterms:source xml:lang="en">WP248rev.01</dcterms:source>
    <skos:definition xml:lang="en">The controller, any joint controllers, processors and recipients involved in the processing.</skos:definition>
    <skos:prefLabel xml:lang="en">Entities involved</skos:prefLabel>
    <impacto-old:hasExpectedProperty rdf:resource="https://w3id.org/dpv#hasDataProcessor"/>
    <impacto-old:hasExpectedProperty rdf:resource="https://w3id.org/dpv#hasRecipient"/>
    <impacto-old:isMandatory rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</impacto-old:isMandatory>
    <impacto-old:partOfRequirement rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIA-IR-A357a"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/de#C25a">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">DE C25a: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/de#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Germany and which involves processing operations aimed at monitoring or controlling data subjects, in particular by means of image or video and associated acoustic data processing</skos:definition>
    <dpv:hasData rdf:resource="https://w3id.org/dpv/tech#ImageContent"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#DE"/>
    <dpv:hasPurpose rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-Monitoring"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/lv#C22">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">LV C22: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/lv#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Latvia and which involves processing of data revealing political opinions</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#LV"/>
    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv/pd#PoliticalOpinion"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/gr#C17a">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">GR C17a: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/gr#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Greece and which involves processing resulting in access to or exclusion of services</skos:definition>
    <dpv:hasConsequence rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-LegalEffect"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#GR"/>
    <dpv:hasRisk rdf:resource="https://tyttikatariina.github.io/IMPACTO/#risk-ServiceAccessDenied"/>
  </rdf:Description>
