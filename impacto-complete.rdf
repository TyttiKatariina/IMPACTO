    <rdfs:label xml:lang="en">Employer</rdfs:label>
    <dcterms:source xml:lang="en">CN8</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#Organisation"/>
    <skos:definition xml:lang="en">An organisation that employs individuals and processes their personal data in connection with the employment relationship.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/sk#C71e">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
