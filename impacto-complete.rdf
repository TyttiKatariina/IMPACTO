    <dcterms:source rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SourceAll"/>
    <rdfs:subClassOf rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SignificantEffect"/>
    <skos:broader rdf:resource="https://tyttikatariina.github.io/ImpactAssessmentOntology/#SignificantEffect"/>
