    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Czech Republic and which involves processing concerns personal data that has not been obtained from the data subject, and providing this information would prove difficult/ impossible</skos:definition>
    <dpv:hasDataSource rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-NonDataSubjectDataSource"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#CZ"/>
  </rdf:Description>
