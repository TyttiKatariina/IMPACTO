    <dcterms:source rdf:resource="https://example.org/dpia-conditions#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of EX and which involves data processing to assess the credibility of the data subject by way of evaluating personal data in large scale or systematically (credit score) </skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#EX"/>
    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv/pd#CreditScore"/>
    <dpv:hasPurpose rdf:resource="https://w3id.org/dpv/sector/finance#CreditChecking"/>
  </rdf:Description>
