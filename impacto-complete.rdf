    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">LT C114a: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/lt#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Lithuania and which involves processing of personal video data when video surveillance is conducted in areas not owned by the controller or healthcare settings or combined with sound recordings</skos:definition>
    <dpv:hasData rdf:resource="https://w3id.org/dpv/tech#VideoContent"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#LT"/>
    <dpv:hasLocation rdf:resource="https://w3id.org/dpv#PublicLocation"/>
    <dpv:hasTechnicalOrganisationalMeasure rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-CameraSurveillance"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#hasImpactAssessment">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">has impact assessment</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/dpv#Process"/>
    <rdfs:range rdf:resource="https://tyttikatariina.github.io/IMPACTO/#ImpactAssessment"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/dpv#hasImpactAssessment"/>
    <skos:definition xml:lang="en">Associates a processing activity or AI use with the impact assessment carried out for it.</skos:definition>
    <skos:prefLabel xml:lang="en">has impact assessment</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#F1">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#FRIARequiredCondition"/>
    <rdfs:label xml:lang="en">Public law body deploying an Annex III system</rdfs:label>
    <dcterms:source xml:lang="en">AI Act Art.27(1)</dcterms:source>
    <skos:definition xml:lang="en">A FRIA is required because the deployer is a body governed by public law and the system is high-risk under Article 6(2), other than a system in the area listed in Annex III point 2.</skos:definition>
    <skos:prefLabel xml:lang="en">Public law body deploying an Annex III system</skos:prefLabel>
    <impacto-old:excludesAISystemType rdf:resource="https://w3id.org/dpv/legal/eu/aiact#HighRiskAISystem-AnnexIII-2"/>
    <impacto-old:hasObligationSource rdf:resource="https://tyttikatariina.github.io/IMPACTO/#FRIASource-A27"/>
    <impacto-old:requiresAISystemType rdf:resource="https://w3id.org/dpv/legal/eu/aiact#HighRiskAISystem-A6-2"/>
    <impacto-old:requiresDeployerType rdf:resource="https://tyttikatariina.github.io/IMPACTO/#BodyGovernedByPublicLaw"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/at#C67a">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">AT C67a: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/at#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Austria and which involves processing operations including image and acoustic processing for the preventive protection of persons or property on private residential properties not exclusively used by the person responsible and by all persons living in the common household</skos:definition>
    <dpv:hasData rdf:resource="https://w3id.org/dpv/tech#ImageData"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#AT"/>
    <dpv:hasPurpose rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-PreventativeProtectionOfPersons"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/es#C20c">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">ES C20c: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/es#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Spain and which involves profiling resulting in exclusion/suspension/rupture from a contract</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#ES"/>
    <dpv:hasProcessing rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#Profiling"/>
    <dpv:hasRisk rdf:resource="https://tyttikatariina.github.io/IMPACTO/#risk-ContractTerminated"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/dpia-conditions#C37f">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
