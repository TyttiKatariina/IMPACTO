  <rdf:Description rdf:about="https://example.org/impacto/Risk-Opacity">
    <rdf:type rdf:resource="https://w3id.org/dpv#Risk"/>
    <rdfs:label xml:lang="en">Risk  Opacity</rdfs:label>
    <dcterms:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Applicants cannot understand how their ranking was produced</dcterms:description>
    <impacto-old:hasResidualRiskLevel rdf:resource="https://w3id.org/dpv/risk#LowRisk"/>
    <impacto-old:hasTreatmentDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Published explanation of ranking factors and a right to request reasons.</impacto-old:hasTreatmentDescription>
