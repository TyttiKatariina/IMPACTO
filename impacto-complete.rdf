    <skos:exactMatch rdf:resource="https://w3id.org/dpv/legal/at#DPIARequiredList"/>
    <skos:prefLabel xml:lang="en">Austria (AT)</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#DPIA-IR-4">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIAInformationRequirement"/>
    <rdfs:label xml:lang="en">Categories of data subject</rdfs:label>
    <dcterms:source xml:lang="en">GDPR Art.35(7)(a); WP248rev.01</dcterms:source>
    <skos:definition xml:lang="en">The categories of data subject whose personal data is processed, noting any vulnerable groups.</skos:definition>
    <skos:prefLabel xml:lang="en">Categories of data subject</skos:prefLabel>
    <impacto-old:hasExpectedProperty rdf:resource="https://w3id.org/dpv#hasDataSubject"/>
    <impacto-old:hasExpectedValueClass rdf:resource="https://w3id.org/dpv#DataSubject"/>
    <impacto-old:isMandatory rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</impacto-old:isMandatory>
    <impacto-old:partOfRequirement rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIA-IR-A357a"/>
