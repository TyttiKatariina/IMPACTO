    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#Technology"/>
    <skos:broader rdf:resource="https://w3id.org/dpv#Technology"/>
    <skos:definition xml:lang="en">The contextual application of an AI system's intended purpose in a specific deployment scenario. Distinct from eu-aiact:IntendedPurpose in that the same AI system with one intended purpose may have multiple intended uses, varying by input/output data, human subjects involved, or hardware and software used.</skos:definition>
    <skos:prefLabel xml:lang="en">Intended Use</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Distinct from eu-aiact:IntendedPurpose: while an AI system has a single intended purpose, it may have multiple intended uses depending on deployment context.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Proposed for: DPV EU AI Act extension (eu-aiact)</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/ee#C61f">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">EE C61f: Processing personal data with the purpose of providing services or…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/ee#DPIARequiredList"/>
    <skos:definition xml:lang="en">Processing personal data with the purpose of providing services or developing products for commercial use that involve predicting working capacity, economic status, health, personal preferences or interests, trustworthiness, behavior, location or route (Sensitive data or data of highly personal nature and evaluation/scoring).</skos:definition>
    <dpv:hasIntendedPurpose rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-CommercialUse"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#EE"/>
    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv/pd#Preference"/>
    <dpv:hasPurpose rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-ProductDevelopment"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/de#C13b">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">DE C13b: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/de#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Germany and which involves large-scale processing of communication and location data</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#DE"/>
    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv/pd#Location"/>
    <dpv:hasProcessingScale rdf:resource="https://w3id.org/dpv#LargeScaleProcessing"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/fi#C37j">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">FI C37j: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/fi#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Finland and which involves The use of new technologies or technological solutions for the processing of personal data or with the possibility of processing personal data to analyse or predict the economic situation, health, personal preferences or interests, reliability or behaviour, location or movements of natural persons</skos:definition>
    <dpv:hasContext rdf:resource="https://w3id.org/dpv#InnovativeUseOfNewTechnologies"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#FI"/>
    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv/pd#FinancialStatus"/>
    <dpv:hasProcessing rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-Predict"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#FRIATriggerCondition">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">FRIA Trigger Condition</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdfs:subClassOf rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-aiact-FRIANecessity"/>
    <skos:broader rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <skos:broader rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-aiact-FRIANecessity"/>
    <skos:definition xml:lang="en">A condition relevant to determining whether a FRIA is required. Unlike DPIA conditions, a FRIA condition constrains BOTH the classification of the AI system and the category of the deployer.</skos:definition>
    <skos:prefLabel xml:lang="en">FRIA Trigger Condition</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/dpia-conditions#C82b">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">DPIA-CONDITIONS C82b: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://example.org/dpia-conditions#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of EX and which involves large scale systematic processing of personal data with the purpose of introducing, organizing, providing and monitoring the use of electronic government services</skos:definition>
    <dpv:hasContext rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-Systematic"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#EX"/>
    <dpv:hasProcessingScale rdf:resource="https://w3id.org/dpv#LargeScaleProcessing"/>
    <dpv:hasPurpose rdf:resource="https://tyttikatariina.github.io/IMPACTO/#sector-publicservices-OrganisingEGovernmentServices"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/cy#C19">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">CY C19: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/cy#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Cyprus and which involves processing related to preventing a data subject from exercising a right</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#CY"/>
    <dpv:hasRisk rdf:resource="https://tyttikatariina.github.io/IMPACTO/#risk-RightsExercisePrevented"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/fi#C61d">
