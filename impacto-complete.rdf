    <rdfs:domain rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentStage"/>
    <rdfs:range rdf:resource="https://tyttikatariina.github.io/IMPACTO/#InformationRequirement"/>
    <skos:definition xml:lang="en">The information requirements addressed at a given stage of the assessment process.</skos:definition>
    <skos:prefLabel xml:lang="en">stage addresses requirement</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv#ManagementConsultants">
