  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#FRIA-IR-f">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#FRIAInformationRequirement"/>
    <rdfs:label xml:lang="en">Measures on materialisation of risks</rdfs:label>
    <dcterms:source xml:lang="en">AI Act Art.27(1)(f)</dcterms:source>
    <skos:definition xml:lang="en">The measures to be taken if the identified risks materialise, including the arrangements for internal governance and complaint mechanisms.</skos:definition>
    <skos:prefLabel xml:lang="en">Measures on materialisation of risks</skos:prefLabel>
    <impacto-old:correspondsToDPIARequirement rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIA-IR-15"/>
    <impacto-old:correspondsToDPIARequirement rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIA-IR-16"/>
    <impacto-old:correspondsToDPIARequirement rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIA-IR-24"/>
    <impacto-old:correspondsToDPIARequirement rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIA-IR-A357d"/>
    <impacto-old:hasExpectedProperty rdf:resource="https://tyttikatariina.github.io/IMPACTO/#hasComplaintMechanism"/>
    <impacto-old:hasExpectedProperty rdf:resource="https://w3id.org/dpv/risk#hasRiskTreatment"/>
    <impacto-old:hasReuseGap xml:lang="en">Risk treatment measures in a DPIA can be relied on where the same risk is in issue. The FRIA additionally requires internal governance arrangements and complaint mechanisms for affected persons, which the DPIA does not ordinarily record.</impacto-old:hasReuseGap>
    <impacto-old:hasReuseLevel rdf:resource="https://tyttikatariina.github.io/IMPACTO/#PartiallyReusable"/>
    <impacto-old:isMandatory rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</impacto-old:isMandatory>
  </rdf:Description>
