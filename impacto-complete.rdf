  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#eu-aiact-PotentiallyHighRiskAISystem">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Potentially High Risk AI System</rdfs:label>
    <dcterms:source xml:lang="en">AI Act Art. 6(3)</dcterms:source>
