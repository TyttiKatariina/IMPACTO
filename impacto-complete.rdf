    <skos:broader rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentStage"/>
    <skos:definition xml:lang="en">The stage that produces a systematic description of the processing operations or of the deployer's processes in which the AI system will be used.</skos:definition>
    <skos:prefLabel xml:lang="en">Description Stage</skos:prefLabel>
    <impacto-old:hasStage_Requirement rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIA-IR-A357a"/>
