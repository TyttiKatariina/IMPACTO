    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#Purpose"/>
    <skos:definition xml:lang="en">Processing carried out by funders and paying agencies in the context of the administration of public subsidies.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/dpia-conditions#C109">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
