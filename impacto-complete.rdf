    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">NL C23: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/nl#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Netherlands and which involves the purpose of data processing is the application of ‘smart meters’ set up by public utilities providers (the monitoring of consumption customs)</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#NL"/>
    <dpv:hasOrganisation rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-PublicUtilityProvider"/>
    <dpv:hasPurpose rdf:resource="https://tyttikatariina.github.io/IMPACTO/#dpv-Monitoring"/>
    <tech:hasInput rdf:resource="https://tyttikatariina.github.io/IMPACTO/#tech-SmartMeter"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/mt#C11">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">MT C11: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://w3id.org/dpv/legal/mt#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of Malta and which involves processing of Biometric data</skos:definition>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#MT"/>
    <dpv:hasPersonalData rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#BiometricData"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/dpia-conditions#C106">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#eu-gdpr-DPIARequiredProcess"/>
    <rdf:type rdf:resource="https://w3id.org/dpv/legal/eu/gdpr#DPIARequiredProcess"/>
    <rdfs:label xml:lang="en">DPIA-CONDITIONS C106: A process which requires a DPIA according to the Data Protection…</rdfs:label>
    <dcterms:source rdf:resource="https://example.org/dpia-conditions#DPIARequiredList"/>
    <skos:definition xml:lang="en">A process which requires a DPIA according to the Data Protection Authorities of EX and which involves large Scale Processing that might pose a risk of loss of statutory confidentiality of information (restricted information, professional secrecy)</skos:definition>
    <dpv:hasContext rdf:resource="https://w3id.org/dpv/justifications#ConfidentialityObligationCompromised"/>
    <dpv:hasJurisdiction rdf:resource="https://w3id.org/dpv/loc#EX"/>
    <dpv:hasProcessingScale rdf:resource="https://w3id.org/dpv#LargeScaleProcessing"/>
    <dpv:hasRisk rdf:resource="https://w3id.org/dpv/risk#UnauthorisedDataDisclosure"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv#ExpenseData">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Expense Data</rdfs:label>
    <dcterms:source xml:lang="en">CN5</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#Data"/>
    <skos:definition xml:lang="en">Data relating to the expenses of an organisation.</skos:definition>
    <skos:scopeNote xml:lang="en">Relates to the organisation rather than to the individual.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://tyttikatariina.github.io/IMPACTO/#DPIA-IR-A357d">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIAInformationRequirement"/>
    <rdfs:label xml:lang="en">Measures to address the risks</rdfs:label>
    <dcterms:source xml:lang="en">GDPR Art.35(7)(d)</dcterms:source>
    <skos:definition xml:lang="en">The measures envisaged to address the risks, including safeguards, security measures and mechanisms to ensure the protection of personal data and to demonstrate compliance.</skos:definition>
    <skos:prefLabel xml:lang="en">Measures to address the risks</skos:prefLabel>
    <impacto-old:isMandatory rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</impacto-old:isMandatory>
    <impacto-old:providesInputTo rdf:resource="https://tyttikatariina.github.io/IMPACTO/#FRIA-IR-f"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv#MunicipalityElectoralRegisterManagement">
