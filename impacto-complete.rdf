    <skos:prefLabel xml:lang="en">Affected persons partly reused</skos:prefLabel>
    <impacto-old:hasReuseGap rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The DPIA identified job applicants as data subjects. The FRIA adds underrepresented applicant groups as a distinct affected group.</impacto-old:hasReuseGap>
    <impacto-old:hasReuseLevel rdf:resource="https://tyttikatariina.github.io/IMPACTO/#PartiallyReusable"/>
    <impacto-old:reusedElement rdf:resource="https://w3id.org/dpv#JobApplicant"/>
    <impacto-old:satisfiesRequirement rdf:resource="https://tyttikatariina.github.io/IMPACTO/#FRIA-IR-c"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv#PropertyPreventativeProtection">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Property Preventative Protection</rdfs:label>
    <dcterms:source xml:lang="en">CN17</dcterms:source>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#PhysicalMeasure"/>
    <skos:definition xml:lang="en">A measure serving the preventive protection of things or property on private property used for residential purposes.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/at#C26">
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#AssessmentTriggerCondition"/>
    <rdf:type rdf:resource="https://tyttikatariina.github.io/IMPACTO/#DPIARequiredCondition"/>
