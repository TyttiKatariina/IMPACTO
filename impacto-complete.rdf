    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#Organisation"/>
    <skos:definition xml:lang="en">A professional acting as a trustee in respect of the affairs of a business.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dpv/legal/fi#C95b">
